string getTaskRejections()
{
	returnstring = "";
	try
	{
		// getTaskRejections - 2026-09-18, user request ("do the same thing for the
		// Task_Rejections_Report in vendorPerformance, get the info with refresh
		// token"). Same shape and same reasoning as getVehicleNames.deluge.
		//
		// Vendor/Technician/Driver portal profiles are refused
		// Task_Rejections_Report with {"code":2898,"message":"Permission denied to
		// view record(s)."}, and apiGetReport turns that refusal into an empty
		// array - so vendorPerformance silently reported zero rejections for every
		// vendor rather than saying it could not read them.
		//
		// This reads the report server-side with the app owner's own OAuth
		// credentials, the same refresh-token mechanism already proven in
		// submitCustomerLocation.deluge, paymentWebhook.deluge and
		// getVehicleNames.deluge.
		//
		// WHY A CUSTOM API: these credentials grant full Creator Data API access to
		// the whole application. Widget JavaScript is downloaded to every user's
		// browser, so a refresh token placed there would be readable by anyone who
		// opens the vendor app. Server-side Deluge is the only safe home for it.
		//
		// DELIBERATELY NARROW: returns only the three fields vendorPerformance
		// actually consumes - the record id, RSP_Name (how a rejection is matched
		// to a vendor, since Task_Rejections carries no confirmed vendor Lookup)
		// and Rejected_At (what the date-range filter reads). Not a general
		// report reader, which would let any portal user read anything.
		//
		// THIS IS THE PRIMARY AND ONLY PATH as of 2026-09-18. vendorPerformance no
		// longer reads Task_Rejections_Report directly - that call was removed on
		// the user's instruction once this API was working. If this API stops
		// working, the Vendor Performance page reports zero rejections; there is no
		// second route behind it any more.
		//
		// Granting the Vendor profile View on Task_Rejections_Report would still be
		// the simpler arrangement, and would let this API be retired.
		ZC_CLIENT_ID = "1000.7BYOUWK2Q2XMJQWU62E6WHCRZOY9VW";
		ZC_CLIENT_SECRET = "a714fc6ab6c76d058196ceef8b49cad735422987fd";
		ZC_REFRESH_TOKEN = "1000.568bbdff83b5b398edb888ff31951dea.a5cbb7bbdd283c79ec801ebd10be426a";
		ZC_REPORT_URL = "https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/report/Task_Rejections_Report?max_records=1000&field_config=all";
		info "getTaskRejections - start " + zoho.currenttime;
		tokenResp = invokeurl
		[
			url :"https://accounts.zoho.in/oauth/v2/token?refresh_token=" + ZC_REFRESH_TOKEN + "&client_id=" + ZC_CLIENT_ID + "&client_secret=" + ZC_CLIENT_SECRET + "&grant_type=refresh_token"
			type :POST
		];
		accessToken = tokenResp.get("access_token");
		if(accessToken == null)
		{
			info "getTaskRejections - no access_token. Raw token response: " + tokenResp.toString();
			return "{\"code\": \"ERROR\", \"message\": \"Could not get an access token from the refresh token. See this Custom API execution log for the raw response.\", \"rejections\": []}";
		}
		readResp = invokeurl
		[
			url :ZC_REPORT_URL
			type :GET
			headers:{"Authorization":"Bearer " + accessToken}
		];
		respCode = readResp.get("code");
		info "getTaskRejections - read response code = " + ifnull(respCode,"(null)");
		if(respCode != 3000)
		{
			info "getTaskRejections - read FAILED. Raw response: " + readResp.toString();
			return "{\"code\": \"ERROR\", \"message\": \"Reading Task_Rejections_Report over the Data API did not return code 3000. See this Custom API execution log for the raw response.\", \"rejections\": []}";
		}
		// rejectionsList is initialised as a real List() before anything goes into
		// it. Deluge cannot infer the type of a value returned by .get(), and a
		// for-each over such a value fails to SAVE with "Variable is not defined"
		// - the exact error paymentWebhook.deluge hit on 2026-09-18.
		rejectionsList = List();
		if(readResp.get("data") != null)
		{
			rejectionsList = readResp.get("data").toList();
		}
		jsonParts = "";
		rowCount = 0;
		for each rejectionRec in rejectionsList
		{
			idText = "";
			if(rejectionRec.get("ID") != null)
			{
				idText = rejectionRec.get("ID").toString().trim();
			}
			nameText = "";
			if(rejectionRec.get("RSP_Name") != null)
			{
				nameText = rejectionRec.get("RSP_Name").toString().trim();
			}
			rejectedAtText = "";
			if(rejectionRec.get("Rejected_At") != null)
			{
				rejectedAtText = rejectionRec.get("Rejected_At").toString().trim();
			}
			if(idText != "")
			{
				if(rowCount > 0)
				{
					jsonParts = jsonParts + ",";
				}
				jsonParts = jsonParts + "{\"id\":\"" + idText + "\",\"RSP_Name\":\"" + nameText + "\",\"Rejected_At\":\"" + rejectedAtText + "\"}";
				rowCount = rowCount + 1;
			}
		}
		info "getTaskRejections - returning " + rowCount + " rejection row(s).";
		returnstring = "{\"code\": \"SUCCESS\", \"count\": " + rowCount + ", \"rejections\": [" + jsonParts + "]}";
	}
	catch (e)
	{
		info "getTaskRejections threw: " + e.toString();
		return "{\"code\": \"ERROR\", \"message\": \"getTaskRejections threw an exception. See this Custom API execution log.\", \"rejections\": []}";
	}
	return returnstring;
}
