string createTicket(string customerName, string mobile, string email, string vehicle, string issue, string recordId, string callerID, string ucid, string monitorUcid)
{
	returnstring = "";
	try
	{
		result = Map();
		wantedId = ifnull(recordId,"").trim();
		targetId = 0;
		if(wantedId != "")
		{
			maybeId = 0;
			try
			{
				maybeId = wantedId.toLong();
			}
			catch (idEx)
			{
				maybeId = 0;
			}
			if(maybeId > 0)
			{
				for each existingRec in Create_Case[ID == maybeId]
				{
					targetId = maybeId;
				}
			}
		}
		isUpdate = false;
		if(targetId > 0)
		{
			isUpdate = true;
		}
		if(wantedId != "")
		{
			if(isUpdate == false)
			{
				result.put("code","ERROR");
				result.put("message","recordId " + wantedId + " was supplied but no Create_Case record with that ID exists. Nothing was created or updated. Omit recordId entirely to create a new ticket.");
				return result.toString();
			}
		}
		hasName = false;
		if(ifnull(customerName,"").trim() != "")
		{
			hasName = true;
		}
		hasMobile = false;
		if(ifnull(mobile,"").trim() != "")
		{
			hasMobile = true;
		}
		hasEmail = false;
		if(ifnull(email,"").trim() != "")
		{
			hasEmail = true;
		}
		hasVehicle = false;
		if(ifnull(vehicle,"").trim() != "")
		{
			hasVehicle = true;
		}
		hasIssue = false;
		if(ifnull(issue,"").trim() != "")
		{
			hasIssue = true;
		}
		/* callerID / UCID added 2026-09-28 so a ticket raised from an incoming call
		   carries the call that produced it, and searchTickets can find it by either.

		   Both are OPTIONAL and purely additive: every existing caller sends neither,
		   they arrive null, and the ticket is written exactly as it was before.

		   A value still holding a placeholder such as $CallerID$ is treated as absent.
		   That is a real failure mode, not a hypothetical one - Ozonetel's ScreenPop
		   sends its own token unsubstituted when misconfigured, and storing that
		   literal text would make the ticket look like it came from a call it did not.
		   Same guard recordRingingCall.deluge already applies. */
		callerIdText = ifnull(callerID,"").trim();
		if(callerIdText.contains("$"))
		{
			callerIdText = "";
		}
		ucidText = ifnull(ucid,"").trim();
		if(ucidText.contains("$"))
		{
			ucidText = "";
		}
		hasCallerId = false;
		if(callerIdText != "")
		{
			hasCallerId = true;
		}
		hasUcid = false;
		if(ucidText != "")
		{
			hasUcid = true;
		}
		/* monitorUcid - 2026-10-22. The id Ozonetel's end-of-call push uses for this
		   call (the pop shows it as "Monitor UCID", 2650...), as opposed to the
		   ScreenPop's own ucid (1622...). OPTIONAL: every existing caller omits it
		   and nothing below changes for them. Same placeholder guard as above. */
		monitorUcidText = ifnull(monitorUcid,"").trim();
		if(monitorUcidText.contains("$"))
		{
			monitorUcidText = "";
		}
		// The ticket this request created or updated - set in each branch below,
		// read by the Call_Log link after them.
		linkTicketId = 0;
		/* The "at least one field must be supplied" gate on UPDATE was removed
		   2026-09-29 (user request). An update that sends only a recordId now
		   succeeds as a no-op instead of returning ERROR: the record is found,
		   nothing is written, and the reply comes back SUCCESS / mode "updated"
		   with an empty updatedFields, which tells the caller plainly that no
		   field changed.
		
		   Deliberately only the UPDATE path. The create-side required checks in
		   the else branch below (Customer Name, Mobile, Vehicle, Issue) are
		   untouched — a NEW ticket with no customer or vehicle would be broken
		   data, not a harmless no-op.
		
		   Still guarded above, and unchanged: a recordId that matches no
		   Create_Case record is still rejected outright, so a bad ID can never
		   be mistaken for a successful no-op. */
	
		resolvedVehicleId = 0;
		if(hasVehicle)
		{
			vehicleTrim = vehicle.trim();
			vehicleFound = false;
			vehicleMaybeId = 0;
			try
			{
				vehicleMaybeId = vehicleTrim.toLong();
			}
			catch (vehicleIdEx)
			{
				vehicleMaybeId = 0;
			}
			if(vehicleMaybeId > 0)
			{
				for each vehicleById in vehicle_master[ID == vehicleMaybeId]
				{
					resolvedVehicleId = vehicleMaybeId;
					vehicleFound = true;
				}
			}
			if(vehicleFound == false)
			{
				vehicleWanted = vehicleTrim.toLowerCase();
				for each vehicleRec in vehicle_master[ID != 0]
				{
					if(vehicleFound == false)
					{
						vehicleNameText = ifnull(vehicleRec.Name,"").toString().trim().toLowerCase();
						if(vehicleNameText == vehicleWanted)
						{
							resolvedVehicleId = vehicleRec.ID.toString().toLong();
							vehicleFound = true;
						}
					}
				}
			}
			if(vehicleFound == false)
			{
				result.put("code","ERROR");
				result.put("message","Vehicle not recognised: " + vehicleTrim + ". Send either a Vehicle Master record ID, or the vehicle name exactly as it appears in Vehicle Master (case does not matter).");
				return result.toString();
			}
		}
		issueLongIds = List();
		unmatchedIssues = "";
		isTow = false;
		if(hasIssue)
		{
			issueNameList = issue.toList(",");
			for each issueNameRaw in issueNameList
			{
				issueNameTrim = issueNameRaw.trim();
				if(issueNameTrim != "")
				{
					issueMatched = false;
					matchedIssueType = "";
					issueMaybeId = 0;
					try
					{
						issueMaybeId = issueNameTrim.toLong();
					}
					catch (issueIdEx)
					{
						issueMaybeId = 0;
					}
					if(issueMaybeId > 0)
					{
						for each issueById in Vehicle_Issue[ID == issueMaybeId]
						{
							issueLongIds.add(issueMaybeId);
							issueMatched = true;
							matchedIssueType = ifnull(issueById.Issue_Type,"").toString().toLowerCase();
						}
					}
					if(issueMatched == false)
					{
						issueWanted = issueNameTrim.toLowerCase();
						for each issueRec in Vehicle_Issue[ID != 0]
						{
							if(issueMatched == false)
							{
								issueNameText = ifnull(issueRec.Issue_Name,"").toString().trim().toLowerCase();
								if(issueNameText == issueWanted)
								{
									issueLongIds.add(issueRec.ID.toString().toLong());
									issueMatched = true;
									matchedIssueType = ifnull(issueRec.Issue_Type,"").toString().toLowerCase();
								}
							}
						}
					}
					if(issueMatched)
					{
						if(matchedIssueType.contains("tow"))
						{
							isTow = true;
						}
					}
					else
					{
						if(unmatchedIssues == "")
						{
							unmatchedIssues = issueNameTrim;
						}
						else
						{
							unmatchedIssues = unmatchedIssues + ", " + issueNameTrim;
						}
					}
				}
			}
			if(issueLongIds.size() == 0)
			{
				result.put("code","ERROR");
				result.put("message","Issue not recognised: " + unmatchedIssues + ". Send either a Vehicle Issue record ID, or the issue name exactly as it appears in Vehicle Issue (case does not matter).");
				return result.toString();
			}
		}
		serviceType = "RSR";
		if(isTow)
		{
			serviceType = "TOW";
		}
		if(isUpdate)
		{
			updateRec = Create_Case[ID == targetId];
			changedFields = "";
			if(hasName)
			{
				updateRec.Customer_Name = customerName.trim();
				changedFields = changedFields + "Customer_Name ";
			}
			if(hasMobile)
			{
				updateRec.Phone_Number1 = mobile.trim();
				updateRec.Phone_Number = mobile.trim();
				changedFields = changedFields + "Phone_Number1 Phone_Number ";
			}
			if(hasEmail)
			{
				updateRec.Email = email.trim();
				changedFields = changedFields + "Email ";
			}
			if(hasVehicle)
			{
				updateRec.Vehicle = resolvedVehicleId;
				changedFields = changedFields + "Vehicle ";
			}
			if(hasIssue)
			{
				updateRec.Vehicle_Issue = issueLongIds;
				updateRec.Service_Type = serviceType;
				changedFields = changedFields + "Vehicle_Issue Service_Type ";
			}
			if(hasCallerId)
			{
				updateRec.callerID = callerIdText;
				changedFields = changedFields + "callerID ";
			}
			if(hasUcid)
			{
				updateRec.UCID = ucidText;
				changedFields = changedFields + "UCID ";
			}
			result.put("code","SUCCESS");
			linkTicketId = targetId;
			result.put("mode","updated");
			result.put("message","Service request updated");
			result.put("recordId",targetId);
			result.put("caseId",ifnull(updateRec.Case_ID,"").toString());
			result.put("updatedFields",changedFields.trim());
			if(hasIssue)
			{
				result.put("serviceType",serviceType);
			}
			if(unmatchedIssues != "")
			{
				result.put("unmatchedIssues",unmatchedIssues);
			}
			returnstring = result.toString();
		}
		else
		{
			// Status "NEW" - 2026-10-14, client rule: a ticket that has arrived but that
			// no agent has opened yet is NEW. It becomes SERVICE FEE QUOTE only when an
			// agent submits the pre-filled Create page in getRescueTicket, which is also
			// what stamps the Agent (Owner). Writing SERVICE FEE QUOTE here claimed work
			// nobody had done, and made the agent app resume the ticket at the Quote step
			// instead of at Create. All three inbound creators were changed together.
			//
			// This note sits OUTSIDE the insert block on purpose: Deluge parses everything
			// between the square brackets as field assignments, so a // line in there is a
			// syntax error - reported against the enclosing try, not against itself.
			newId = insert into Create_Case
			[
				Customer_Name=customerName.trim()
				Phone_Number1=mobile.trim()
				Phone_Number=mobile.trim()
				Email=ifnull(email,"").trim()
				Vehicle=resolvedVehicleId
				Vehicle_Issue=issueLongIds
				Vehicle_Status="ONROAD"
				Service_Type=serviceType
				Time_of_service="NOW"
				Remarks="Whatsapp."
				Lead_Source="Whatsapp"
				Status="NEW"
				Added_User=zoho.loginuser
				callerID=callerIdText
				UCID=ucidText
				Client="ON DEMAND"
			];
			caseId = "RSID" + newId.toString().subText(newId.toString().length() - 6);
			updateRec = Create_Case[ID == newId];
			updateRec.Case_ID=caseId;
			linkTicketId = newId;
			result.put("code","SUCCESS");
			result.put("mode","created");
			result.put("message","Service request created");
			result.put("recordId",newId);
			result.put("caseId",caseId);
			result.put("serviceType",serviceType);
			// Echoed back so the caller can see what was actually stored - a blank here
			// after sending a value means the placeholder guard above rejected it.
			result.put("callerID",callerIdText);
			result.put("ucid",ucidText);
			if(unmatchedIssues != "")
			{
				result.put("unmatchedIssues",unmatchedIssues);
			}
			returnstring = result.toString();
		}
		/* CALL_LOG LINK - 2026-10-22. See this change's own note: the pop's "Link
		   call" arrives here, and the end-of-call push completes whichever Call_Log
		   row carries its id - so the row is keyed by monitorUcid and linked HERE,
		   instead of the link living only on the ticket. Runs only when the request
		   carried a call id; its own try/catch means it can never fail the ticket. */
		callKey = monitorUcidText;
		if(callKey == "")
		{
			callKey = ucidText;
		}
		doCallLink = false;
		if(linkTicketId > 0)
		{
			if(callKey != "")
			{
				doCallLink = true;
			}
		}
		if(doCallLink)
		{
			callLogNote = "";
			try
			{
				// Last 10 digits, the shape every other Call_Log writer stores.
				callPhone = callerIdText;
				if(callPhone == "")
				{
					callPhone = ifnull(mobile,"").trim();
				}
				callPhone = callPhone.replaceAll("[^0-9]","");
				if(callPhone.length() > 10)
				{
					callPhone = callPhone.subText(callPhone.length() - 10);
				}
				// 1. A row already under this id: the push got here first (linked after
				//    hang-up), or getRescueTicket created it from the Dashboard pop.
				callRowId = 0;
				for each keyRow in Call_Log[UCID == callKey]
				{
					if(callRowId == 0)
					{
						callRowId = keyRow.ID.toString().toLong();
					}
				}
				// 2. A row under the pop's plain ucid, written before rows were keyed by
				//    monitorUcid. Linked either way; RE-KEYED only while still pending, so
				//    the push can find it - a completed row keeps the id it has.
				reKey = false;
				tryLegacy = false;
				if(callRowId == 0)
				{
					if(monitorUcidText != "")
					{
						if(ucidText != "")
						{
							if(ucidText != monitorUcidText)
							{
								tryLegacy = true;
							}
						}
					}
				}
				if(tryLegacy)
				{
					pendingStatuses = "|RINGING|INCOMING|PLACED|";
					for each legacyRow in Call_Log[UCID == ucidText]
					{
						if(callRowId == 0)
						{
							callRowId = legacyRow.ID.toString().toLong();
							legacyStatusText = ifnull(legacyRow.Call_Status,"").toString();
							legacyKey = "|" + legacyStatusText.trim().toUpperCase() + "|";
							if(pendingStatuses.contains(legacyKey))
							{
								reKey = true;
							}
						}
					}
				}
				if(callRowId > 0)
				{
					// Only Create_Case is set (plus the re-key and a blank phone). Status,
					// duration and everything the push wrote are left exactly as they are.
					// An existing link is replaced: the agent clicking Link call on this
					// ticket is the most direct statement of which ticket the call is for.
					logRec = Call_Log[ID == callRowId];
					previousLink = "";
					prevRef = logRec.Create_Case;
					if(prevRef != null)
					{
						previousLink = prevRef.toString().trim();
					}
					logRec.Create_Case = linkTicketId;
					if(reKey)
					{
						logRec.UCID = monitorUcidText;
					}
					existingPhone = ifnull(logRec.Phone_Number,"").toString().trim();
					if(existingPhone == "")
					{
						if(callPhone != "")
						{
							logRec.Phone_Number = callPhone;
						}
					}
					callLogNote = "LINKED_EXISTING";
					result.put("callLogRowId",callRowId.toString());
					if(previousLink != "")
					{
						if(previousLink != linkTicketId.toString())
						{
							result.put("callLogPreviousTicket",previousLink);
						}
					}
					if(reKey)
					{
						result.put("callLogReKeyedFrom",ucidText);
					}
					reKeyNote = "";
					if(reKey)
					{
						reKeyNote = " and re-keyed " + ucidText + " -> " + monitorUcidText;
					}
					info "createTicket: Call_Log " + callRowId + " linked to ticket " + linkTicketId + reKeyNote + ".";
				}
				else
				{
					// 3. No row yet - the call is still in progress. Created now, keyed by
					//    the push's id, so the push completes this row at hang-up.
					newLogId = insert into Call_Log
					[
						UCID=callKey
						Phone_Number=callPhone
						Call_Status="Incoming"
						Create_Case=linkTicketId
					];
					callLogNote = "CREATED_LINKED";
					result.put("callLogRowId",newLogId.toString());
					info "createTicket: Call_Log " + newLogId + " created under " + callKey + ", linked to ticket " + linkTicketId + ".";
				}
			}
			catch (callLogEx)
			{
				callLogNote = "FAILED - the ticket itself was saved. " + callLogEx.toString();
				info "createTicket: Call_Log link failed (ticket unaffected): " + callLogEx.toString();
			}
			result.put("callLog",callLogNote);
			result.put("callLogKey",callKey);
			if(monitorUcidText == "")
			{
				result.put("callLogWarning","No monitorUcid was sent, so the row is keyed by the ScreenPop ucid. The end-of-call push may not recognise it and can create a second, unlinked row. Send monitorUcid.");
			}
			returnstring = result.toString();
		}
	}
	catch (e)
	{
		errResult = Map();
		errResult.put("code","ERROR");
		errResult.put("message",e.toString());
		returnstring = errResult.toString();
	}
	return returnstring;
}
