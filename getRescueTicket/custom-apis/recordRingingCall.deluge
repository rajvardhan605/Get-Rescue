string recordRingingCall(string callerID, string ucid, string type, string agentID)
{
	try
	{
		info "========== RINGING CALL (SCREENPOP SERVER SIDE) ==========";
		info "  time     = " + zoho.currenttime;
		info "  callerID = [" + ifnull(callerID,"(null)") + "]";
		info "  ucid     = [" + ifnull(ucid,"(null)") + "]";
		info "  type     = [" + ifnull(type,"(null)") + "]";
		info "  agentID  = [" + ifnull(agentID,"(null)") + "]";
		rawPhone = ifnull(callerID,"").trim();
		digitsOnly = rawPhone.replaceAll("[^0-9]","");
		last10 = digitsOnly;
		if(last10.length() > 10)
		{
			last10 = last10.subText(last10.length() - 10);
		}
		info "  digits = [" + digitsOnly + "] | last10 = [" + last10 + "]";
		if(last10.length() < 6)
		{
			info "  NO USABLE NUMBER - nothing recorded.";
			echoCaller = ifnull(callerID,"(null)").toString().replaceAll("\"","'");
			echoUcid = ifnull(ucid,"(null)").toString().replaceAll("\"","'");
			echoType = ifnull(type,"(null)").toString().replaceAll("\"","'");
			echoAgent = ifnull(agentID,"(null)").toString().replaceAll("\"","'");
			return "{\"code\": \"SUCCESS\", \"result\": \"NO_PHONE\", \"created\": false, \"received_callerID\": \"" + echoCaller + "\", \"received_ucid\": \"" + echoUcid + "\", \"received_type\": \"" + echoType + "\", \"received_agentID\": \"" + echoAgent + "\", \"digits_found\": \"" + digitsOnly + "\", \"message\": \"No usable caller number arrived, so no ringing row was recorded. The received_* fields above show exactly what each parameter arrived as. (null) means the parameter never reached this function at all - it is either not registered on the Custom API setup screen, or the caller did not send it. A literal placeholder such as $CallerID$ means the calling system opened the URL without substituting its own token.\"}";
		}
		resolvedUcid = ifnull(ucid,"").trim();
		if(resolvedUcid.contains("$"))
		{
			resolvedUcid = "";
		}
		if(resolvedUcid != "")
		{
			existingId = "";
			for each dupRow in Call_Log[UCID == resolvedUcid]
			{
				if(existingId == "")
				{
					existingId = dupRow.ID.toString();
				}
			}
			if(existingId != "")
			{
				info "  Call_Log " + existingId + " already carries this UCID - nothing inserted.";
				return "{\"code\": \"SUCCESS\", \"result\": \"ALREADY_RECORDED\", \"created\": false, \"recordId\": \"" + existingId + "\", \"phone\": \"" + last10 + "\", \"ucid\": \"" + resolvedUcid + "\", \"message\": \"A Call_Log row already exists for this UCID, so this hit was ignored. This is expected when ScreenPop is set to Client&Server, which fires twice for one call.\"}";
			}
		}
		vType = "Inbound";
		typeLower = ifnull(type,"").trim().toLowerCase();
		if(typeLower.contains("out"))
		{
			vType = "Outbound";
		}
		agentText = ifnull(agentID,"").trim();
		if(agentText.contains("$"))
		{
			agentText = "";
		}
		newRowId = insert into Call_Log
		[
			Phone_Number=last10
			UCID=resolvedUcid
			Call_Status="RINGING"
			Call_Direction=vType
			Agent_Name=agentText
		];
		newRowIdText = newRowId.toString();
		info "  Created Call_Log " + newRowIdText + " for the ringing call.";
		matchedCaseId = 0;
		matchedCaseLabel = "";
		// Closed work is not what a new call is about - see this change's own 2026-10-09 note.
		// A delimited string rather than a list literal: Deluge reads {} as a map.
		closedStatuses = "|CLOSED|RSP CLOSED|RSP CANCELLED|CX REJECT|";
		skippedClosed = 0;
		for each caseRec in Create_Case[Phone_Number1.contains(last10) || Phone_Number.contains(last10)]
		{
			recIdNum = caseRec.ID.toString().toLong();
			caseStatusText = ifnull(caseRec.Status,"").toString().trim();
			// Wrapped in pipes so "CLOSED" cannot match inside "RSP CLOSED".
			statusKey = "|" + caseStatusText + "|";
			if(closedStatuses.contains(statusKey))
			{
				skippedClosed = skippedClosed + 1;
			}
			else
			{
				// Highest id wins, compared explicitly rather than relying on the
				// fetch order - the previous "sort by ID desc" was not taking effect
				// and this loop kept the OLDEST case.
				if(recIdNum > matchedCaseId)
				{
					matchedCaseId = recIdNum;
					matchedCaseLabel = ifnull(caseRec.Case_ID,"").toString().trim();
				}
			}
		}
		info "  skipped " + skippedClosed + " closed/cancelled case(s) for this number.";
		// NOT LINKED HERE - 2026-10-09. Step 2 of the Ozonetel spec attaches the
		// RSID when the agent creates the case or saves the assignment, which is the
		// only moment anything knows which case the call is actually about. Guessing
		// it from the phone number at ring time attached calls to old cases AND
		// blocked the real link, because the widget will not overwrite an existing
		// one. The match is still reported below so the screen-pop can show the
		// agent which case this caller already has.
		if(matchedCaseId > 0)
		{
			info "  Caller has a live case (" + matchedCaseLabel + ") - reported to the screen-pop, deliberately NOT linked. See step 2.";
		}
		info "===========================================";
		return "{\"code\": \"SUCCESS\", \"result\": \"RINGING_RECORDED\", \"created\": true, \"recordId\": \"" + newRowIdText + "\", \"phone\": \"" + last10 + "\", \"ucid\": \"" + resolvedUcid + "\", \"direction\": \"" + vType + "\", \"agent\": \"" + agentText + "\", \"caseId\": \"" + matchedCaseLabel + "\", \"message\": \"A Call_Log row was created with Call_Status RINGING. The Call Center page polls for it and opens the screen-pop; getCallbackStatus completes this same row when the call ends.\"}";
	}
	catch (e)
	{
		info "recordRingingCall threw: " + e.toString();
		return "{\"code\": \"ERROR\", \"result\": \"EXCEPTION\", \"created\": false, \"message\": \"" + e.toString().replaceAll("\"","'") + "\"}";
	}
	return "{\"code\": \"ERROR\", \"result\": \"NO_RESULT\", \"created\": false, \"message\": \"The script finished without reaching any known outcome.\"}";
}
