		function recalcAccountsPayableTotals(){
		  const selected = apSelectedCasesWithFees();
		  // Rows are refreshed from the SAME allocation the totals and the write-back
		  // use (2026-09-14). A case's TDS share depends on which other cases are in
		  // the batch, so a row's figure genuinely changes as the selection changes -
		  // showing a stale per-case number next to a batch-derived total is exactly
		  // the mismatch this whole fix exists to remove. Unselected rows keep showing
		  // their standalone "if paid on its own" figure, which is the only meaningful
		  // value for a case that isn't in a batch yet.
		  const vendorRawForRows = apVendorRaw($("apVendor").value);
		  const tdsPctForRows = Number(vendorRawForRows && vendorRawForRows.TDS_Percentage)||0;
		  const selectedById = {};
		  selected.forEach(function(x){ selectedById[String(x.r.ID)] = x; });
		  // AMOUNT PAID — the PDF's own rule, verbatim: "equal to Final Payable, when
		  // transaction Date is entered". So it stays "—" until a Transaction Date is
		  // actually filled in, then mirrors that row's Final Payable. A case that was
		  // already settled shows its own recorded Vendor_Amount_Paid instead, which is
		  // the real historical figure rather than a recomputed one.
		  const txnDateEntered = !!($("apPaymentDate") && $("apPaymentDate").value);
		  AP_CASES.forEach(function(r){
			const tdsCell = $("apTds_"+r.ID), payCell = $("apPayable_"+r.ID), paidCell = $("apPaid_"+r.ID);
			if(!tdsCell || !payCell) return;
			const hit = selectedById[String(r.ID)];
