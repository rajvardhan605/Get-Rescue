		function clientDisplayName(r){
		  if(String(r.Client||"").trim().toUpperCase()==="ON DEMAND") return "ON DEMAND";
		=== computeClosureTSF ===
		function computeClosureTSF(r){
		  const bf = bookingFeeConfirmedPaid(r) ? (Number(r.Booking_Fee)||0) : 0;
		  const balf = remainingFeeConfirmedPaid(r) ? (Number(r.Remaining_Fee)||0) : 0;
		  const refund = r.Refund_Due==="Yes" ? (Number(r.Refund_Amount)||0) : 0;
		  return bf + balf - refund;
		}
		/* Dashboard shows exactly 3 report lists (by explicit request) — anything
		   whose Status isn't in one of these three sets simply won't appear on the
		   dashboard (still findable via phone search, which lists every status). */
		const BUCKETS = [
		  { name:"New & Open", sub:"Just came in", statuses:["NEW","OPEN","SERVICE FEE QUOTE","BOOKING FEE PENDING","LOCATION REQUEST","LOCATION PENDING"], accent:"var(--info)", pill:"b-new",
		Write C:\Users\CLOUDA~1\AppData\Local\Temp\claude\c--Users-Cloud-Analogy-OneDrive-Desktop-GetRescued\bba2f23d-b0ee-488c-958b-2a159e08d95f\scratchpad\examples.js
		26 lines
		const r2=n=>Math.round(n*100)/100;
		const gst=a=>{const sc=r2(a*100/118),c=r2(sc*0.09),s=r2(sc*0.09);return{sc,c,s,ro:r2(a-(sc+c+s))};};
		function vendor(base,km,extras,cash,tdsPct,gstApplicable){
		  const gross=r2(base+km), net=r2(gross+extras), bal=r2(net-cash);
		  const tds=r2(net*tdsPct/100), fin=r2(net-tds-cash);
		  const gstP=gstApplicable?Math.round(net*18)/100:0;
		  return {gross,net,bal,tds,fin,gstP,rejected:fin<0};
		}
		const show=(t,o)=>console.log(t, JSON.stringify(o));
		
		console.log('EX1  ON DEMAND RSR, both fees by gateway');
		const tsf1=r2(500+2000-0);
		show('  closure TSF (BF+RF-refund) =', tsf1);
		show('  invoice 2500 =', gst(2500));
		show('  vendor (cash collected 0)  =', vendor(1000,500,200,0,1,true));
		
		console.log('\nEX2  same job, remaining fee taken in CASH by the vendor');
		show('  cash collected = Remaining_Fee =', 2000);
		show('  vendor (cash collected 2000) =', vendor(1000,500,200,2000,1,true));
		
		console.log('\nEX3  B2B client, invoice basis is Rescue_Charge');
		const rescue=r2(2500-2000-0);
		show('  Rescue_Charge (TSF-Client_Charge-BF) =', rescue);
		show('  invoice 500 =', gst(500));
		show('  vendor, no GSTIN =', vendor(800,0,0,0,2,false));
