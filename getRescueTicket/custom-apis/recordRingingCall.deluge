		Write C:\Users\CLOUDA~1\AppData\Local\Temp\claude\c--Users-Cloud-Analogy-OneDrive-Desktop-GetRescued\bba2f23d-b0ee-488c-958b-2a159e08d95f\scratchpad\pdfcheck.js
		37 lines
		// Check computeGstBreakup() against the two worked examples in
		// "Ondemand Workflow for Invoicing.pdf".
		const round2=(n)=>Math.round(n*100)/100;
		function computeGstBreakup(amount){
		  const serviceCharges=round2(amount*100/118);
		  const cgst=round2(serviceCharges*0.09);
		  const sgst=round2(serviceCharges*0.09);
		  const roundOff=round2(amount-(serviceCharges+cgst+sgst));
		  return { serviceCharges, cgst, sgst, roundOff };
		}
		const cases=[
		  { amount:2500, want:{ serviceCharges:2118.64, cgst:190.68, sgst:190.68, roundOff:0.00 } },
		  { amount:999,  want:{ serviceCharges:846.61,  cgst:76.19,  sgst:76.19,  roundOff:0.01 } }
		];
		let allOk=true;
		cases.forEach(function(c){
		  const got=computeGstBreakup(c.amount);
		  const ok = got.serviceCharges===c.want.serviceCharges && got.cgst===c.want.cgst
				  && got.sgst===c.want.sgst && got.roundOff===c.want.roundOff;
		  if(!ok) allOk=false;
		  console.log('₹'+c.amount+'  got', JSON.stringify(got));
		  console.log('       pdf', JSON.stringify(c.want), ok?'✓':'✗');
		});
		
		// Vendor Accounting PDF worked example.
		const baseFee=1000, kmFee=500, extras=200, cash=300, tdsPct=1;
		const gross=round2(baseFee+kmFee);
		const net=round2(gross+extras);
		const balance=round2(net-cash);
		const tds=round2(net*tdsPct/100);
		const finalPayable=round2(net-tds-cash);
		const gstPayable=round2(net*0.18);
		console.log('\nVendor: gross',gross,'(pdf 1500) net',net,'(pdf 1700) balance',balance,'(pdf 1400)');
		console.log('        tds',tds,'(pdf 17) finalPayable',finalPayable,'(pdf 1383) gstPayable',gstPayable,'(pdf 306)');
		const vOk = gross===1500 && net===1700 && balance===1400 && tds===17 && finalPayable===1383 && gstPayable===306;
		console.log(allOk && vOk ? '\nPASS — both PDFs reproduce' : '\nFAIL');
