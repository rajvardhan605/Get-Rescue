		const fs=require('fs');
		function patch(file, pairs){
		  let s=fs.readFileSync(file,'utf8');
		  const crlf=s.indexOf('\r\n')>=0;
		  const nl=t=>crlf?t.replace(/\n/g,'\r\n'):t;
		  const bad=[];
		  pairs.forEach(p=>{ const n=s.split(nl(p[0])).length-1; if(n!==1) bad.push(p[2]+' x'+n); });
		  if(bad.length){ console.log('ANCHOR PROBLEM in '+file+': '+bad.join(', ')); return false; }
		  pairs.forEach(p=>{ s=s.split(nl(p[0])).join(nl(p[1])); });
		  fs.writeFileSync(file,s);
		  console.log('updated '+file);
		  return true;
		}
		
