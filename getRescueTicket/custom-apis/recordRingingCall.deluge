		function onDemandInvoiceEligibility(r, finalTsf){
		  const status = String(r.Closure_Status||"").trim();
		  const isOnDemand = isOnDemandClient(r);
		  if(isOnDemand){
			if(!closureCountsAsFeeBearing(status)) return null;
		  } else {
			if(status!=="Completed") return null;
		  }
		  // Extra_Payable folded in 2026-09-14 (explicit user decision, "Add to
		  // invoice amount only") — this field has been agent-editable on the Agent
		  // Closure page since 2026-08-17 and is saved on every close (see
		  // saveClosure()'s own payload), but had NO reader anywhere: it reached
		  // neither Total_Service_Fee nor the invoice, so an extra charge the agent
		  // entered was simply lost. Deliberately added HERE rather than inside
		  // computeClosureTSF(): that function implements the user's own written
		  // "VALIDATIONS ON AGENT CLOSURE" #3 formula verbatim (BOOKING FEE +
		  // REMAINING FEE - REFUND), and changing it would shift Total_Service_Fee for
		  // every ticket and every existing reader of it. Putting it in this one
		  // function instead means the real Books invoice AND
		  // maybeCreateOnDemandInvoice()'s own internal tracking record (the only two
		  // things that consume `amount`) stay automatically in sync, with nothing
		  // else affected.
		  //
		Bash Read the invoice amount rule and closure TSF
		IN
		cd "C:/Users/Cloud Analogy/OneDrive/Desktop/GetRescued/getRescueTicket" && sed -n "$(($(grep -n 'function onDemandInvoiceEligibility' app/widget.html | cut -d: -f1)+23)),+22p" app/widget.html && echo "=== computeClosureTSF ===" && sed -n "$(grep -n 'function computeClosureTSF' app/widget.html | cut -d: -f1),+10p" app/widget.html
		
		OUT
		  // Because the already-collected booking/remaining fees are capped to
		  // `amount` in onDemandInvoicing()'s own JS wrapper, the invoice correctly
		  // ends up with a remaining balance of exactly Extra_Payable — i.e. it shows
		  // as genuinely still owed, which is the point.
		  //
		  // ON DEMAND only — the B2B branch is deliberately untouched (user decision
		  // 2026-09-14, "No — ON DEMAND only"), so a contracted client's
		  // Rescue_Charge invoicing basis is exactly as it was.
		  const extraPayable = isOnDemand ? (Number(r.Extra_Payable)||0) : 0;
		  const amount = isOnDemand ? ((Number(finalTsf)||0) + extraPayable) : (Number(r.Rescue_Charge)||0);
		  if(!(amount>0)) return null;
		  return { isOnDemand, amount, extraPayable };
		}
