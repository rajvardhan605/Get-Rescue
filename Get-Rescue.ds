				BASE_KMS_DAY_TOW_2W_FBT as "BASE KMS DAY - TOW 2W FBT"
				EXTRA_KM_DAY_TOW_2W_FBT as "EXTRA KM DAY - TOW 2W FBT"
				BASE_PAY_DAY_TOW_4W_FBT as "BASE PAY DAY - TOW 4W FBT"
				BASE_KMS_DAY_TOW_4W_FBT as "BASE KMS DAY - TOW 4W FBT"
				EXTRA_KM_DAY_TOW_4W_FBT as "EXTRA KM DAY - TOW 4W FBT"
				BASE_PAY_DAY_TOW_4W_MT as "BASE PAY DAY - TOW 4W MT"
				BASE_KMS_DAY_TOW_4W_MT as "BASE KMS DAY - TOW 4W MT"
				EXTRA_KM_DAY_TOW_4W_MT as "EXTRA KM DAY - TOW 4W MT"
				WAIT_CHARGES_EVERY_60_MINS as "WAIT CHARGES (EVERY 60 MINS)"
				NIGHT_START_HOUR as "NIGHT START HOUR"
				NIGHT_END_HOUR as "NIGHT END HOUR"
				Last_Seen_At as "Last_Seen_At "
			)
			sort by
			(
				Added_Time descending
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (service_type == "Battery Jumpstart")
				fields = [service_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (service_type == "Towing")
				fields = [service_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
