			CreateServiceTicket as "CreateServiceTicket"
			{
				type =  form
				form = Web_Form

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											try 
										{
											rawIssueText = input.Vehicle_Issue;
											issueList = List();
											if(rawIssueText != null)
											{
												issueList = rawIssueText.toList(";");
											}
											cleanIssues = List();
											for each  issueItem in issueList
											{
												trimmedItem = issueItem.trim();
												if(trimmedItem != "")
												{
													cleanIssues.add(trimmedItem);
												}
											}
											allIssues = Vehicle_Issue[ID != 0];
											matchedIssueIds = List();
											// Service_Type - 2026-10-14. This workflow never wrote the field, so every
											// ticket from the website form landed with it blank. Blank is not "TOW", so
											// the agent app built the RSR path: no Loading / At Drop / Unload steps and no
											// drop-location fields on the Location page. Same rule as createTicket.deluge
											// and createServiceRequest.deluge - the matched issue's Issue_Type containing
											// "tow", case-insensitive - deliberately copied rather than reinvented.
											isTowWeb = false;
											for each  wantedIssue in cleanIssues
											{
												for each  issueRec in allIssues
												{
													issueName = issueRec.Issue_Name;
													if(issueName != null)
													{
														if(issueName.trim().equalsIgnoreCase(wantedIssue))
														{
															matchedIssueIds.add(issueRec.ID);
															issueTypeWeb = "";
															if(issueRec.Issue_Type != null)
															{
																issueTypeWeb = issueRec.Issue_Type.toString();
															}
															if(issueTypeWeb.toLowerCase().contains("tow"))
															{
																isTowWeb = true;
															}
															break;
														}
													}
												}
											}
											serviceTypeWeb = "RSR";
											if(isTowWeb)
											{
												serviceTypeWeb = "TOW";
											}
											info "Service_Type resolved to " + serviceTypeWeb + " from the matched issues.";
											info "Vehicle Issue matched IDs: " + matchedIssueIds.toString();
											// Status "NEW" - 2026-10-14, client rule: a ticket that has arrived but that
											// no agent has opened yet is NEW. It becomes SERVICE FEE QUOTE only when an
											// agent submits the pre-filled Create page in getRescueTicket, which is also
											// what stamps the Agent (Owner). Writing SERVICE FEE QUOTE here claimed work
											// nobody had done, and made the agent app resume the ticket at the Quote step
											// instead of at Create. All three inbound creators were changed together.
											//
											// This note sits OUTSIDE the insert block on purpose: Deluge parses everything
											// between the square brackets as field assignments, so a // line in there is a
											// syntax error - reported against the enclosing try, not against itself.
											newRecordId = insert into Create_Case
											[
												Customer_Name=input.Name
												Phone_Number1=input.Phone_Number
												Phone_Number=input.Phone_Number
												Email=input.Email
												Vehicle_Registration_Number=input.Vehicle_Registration_Number
												Lead_Source="Website"
												Time_of_service=input.Time_of_service
												Schedule_Date=input.Schedule_Date
												Service_Time=input.Service_Time
												Status="NEW"
												Service_Type=serviceTypeWeb
												Added_User=zoho.loginuser
												Vehicle=input.Vehicle
												Vehicle_Issue=matchedIssueIds
												Client="ON DEMAND"
											];
											idStr = newRecordId.toString();
											last6 = idStr;
											if(idStr.length() > 6)
											{
												last6 = idStr.subString(idStr.length() - 6);
											}
											caseId = "RSID" + last6;
											newRec = Create_Case[ID == newRecordId];
											newRec.Case_ID=caseId;
										}catch (e)
										{
											info "CreateServiceTicket workflow failed: " + e.toString();
										}
						)
					}
				}

			}
			Create_Zoho_Books_Invoice as "Create Zoho Books Invoice"
			{
				type =  form
				form = On_Demand_Invoicing

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ============================================================
										// Workflow: On Add - On_Demand_Invoicing
										// DEMO INVOICE - RESCUE PROJECT
										// Hardcoded Sample Data Based on Project
										// ============================================================
										organization_id = "60078911104";
										books_base_url = "https://www.zohoapis.in/books/v3";
										// FIXED VALUES
										tax_exemption_id = "3988332000000091002";
										customer_id = "3988332000000072001";
										custEmail = "sagar.tomer@cloudanalogy.com";
										recId = input.ID;
										// ========== DEMO DATA - HARDCODED ==========
										// Based on RESCUE Project: Roadside Assistance Service
										// Example 1: Battery Jumpstart
										issueType = "Battery Jumpstart";
										distance = 5;
										// km
										baseCharge = 500;
										// ₹
										distanceCharge = distance * 50;
										// ₹50/km
										totalPrice = baseCharge + distanceCharge;
										// ₹750
										// Create description
										description = issueType + " | Distance: " + distance + " km | Rate: ₹50/km";
										// Example invoice data
										quantity = 1;
										unitPrice = totalPrice;
										info "========== INVOICE CREATION STARTED ==========";
										info "✅ DEMO MODE - RESCUE PROJECT";
										info "========== DEMO DATA (HARDCODED) ==========";
										info "📍 Issue Type: " + issueType;
										info "📍 Distance: " + distance + " km";
										info "📍 Base Charge: ₹" + baseCharge;
										info "📍 Distance Charge: ₹" + distanceCharge + " (₹50/km × " + distance + " km)";
										info "📍 Total Price: ₹" + totalPrice;
										info "📍 Description: " + description;
										info "📍 Quantity: " + quantity;
										info "📍 Customer ID: " + customer_id;
										info "========== END DEMO DATA ==========";
										// Guard
										if(input.Sync_Status != "Created in Creator")
										{
											info "⚠️ Skipping - Sync_Status: " + input.Sync_Status;
											return;
										}
										info "✅ Sync_Status check passed";
										// ========== VALIDATION ==========
										info "🔍 Validating data...";
										if(description == null)
										{
											info "❌ STOP: description is NULL";
											return;
										}
										if(description == "")
										{
											info "❌ STOP: description is EMPTY";
											return;
										}
										if(quantity <= 0)
										{
											info "❌ STOP: quantity must be > 0";
											return;
										}
										if(unitPrice <= 0)
										{
											info "❌ STOP: unitPrice must be > 0";
											return;
										}
										info "✅ ALL VALIDATIONS PASSED";
										// ========== BUILD AND CREATE INVOICE ==========
										try 
										{
											info "📋 Building RESCUE invoice...";
											priceStr = unitPrice.toString();
											info "Line Description: " + description;
											info "Line Quantity: " + quantity;
											info "Line Unit Price: ₹" + priceStr;
											// CUSTOM LINE ITEM - NO ITEM_ID
											lineItem = Map();
											lineItem.put("description",description);
											lineItem.put("quantity",quantity.toString());
											lineItem.put("unit_price",priceStr);
											lineItem.put("tax_exemption_id",tax_exemption_id);
											lineItems = List();
											lineItems.add(lineItem);
											info "Line item: " + lineItem.toString();
											// Build invoice map
											invoiceMap = Map();
											invoiceMap.put("customer_id",customer_id);
											invoiceMap.put("line_items",lineItems);
											invoiceMap.put("gst_treatment","consumer");
											invoiceMap.put("reference_number",recId.toString());
											info "Invoice map: " + invoiceMap.toString();
											// Convert map to JSON string
											info "🌐 Converting to JSON string...";
											jsonPayload = invoiceMap.toString();
											info "JSON Payload: " + jsonPayload;
											info "🌐 Sending to Zoho Books API...";
											createInvoiceResp = invokeurl
											[
												url :books_base_url + "/invoices?organization_id=" + organization_id
												type :POST
												parameters:jsonPayload
												headers:{"Content-Type":"application/json"}
												connection:"zoho_books_connection"
											];
											info "Invoice response code: " + createInvoiceResp.get("code");
											info "Invoice response: " + createInvoiceResp.toString();
											invoiceRespCode = createInvoiceResp.get("code");
											if(invoiceRespCode != 0)
											{
												errMsg = createInvoiceResp.get("message");
												info "❌ Invoice creation FAILED: " + errMsg;
												input.Sync_Status = "Error";
												return;
											}
											invoiceRec = createInvoiceResp.get("invoice");
											if(invoiceRec == null)
											{
												info "❌ No invoice in response";
												input.Sync_Status = "Error";
												return;
											}
											invoice_id = invoiceRec.get("invoice_id");
											invoice_number = invoiceRec.get("invoice_number");
											info "✅ ✅ ✅ INVOICE CREATED IN ZOHO BOOKS ✅ ✅ ✅";
											info "Invoice ID: " + invoice_id;
											info "Invoice Number: " + invoice_number;
										}catch (e)
										{
											info "❌ Exception: " + e.toString();
											input.Sync_Status = "Error";
											return;
										}
										// ========== 3. SEND EMAIL ==========
										try 
										{
											info "📧 Sending invoice email...";
											emailParams = Map();
											emailParams.put("send_customer_statement","false");
											emailResp = invokeurl
											[
												url :books_base_url + "/invoices/" + invoice_id + "/email?organization_id=" + organization_id
												type :POST
												parameters:emailParams.toString()
												headers:{"Content-Type":"application/json"}
												connection:"zoho_books_connection"
											];
											emailCode = emailResp.get("code");
											if(emailCode == 0)
											{
												info "✅ Email sent successfully";
											}
											else
											{
												info "⚠️ Email failed: " + emailResp.get("message");
											}
										}catch (e)
										{
											info "⚠️ Email exception: " + e.toString();
										}
										// ========== 4. SAVE RESULTS ==========
										try 
										{
											info "💾 Saving to record...";
											rec = On_Demand_Invoicing[ID == recId];
											rec.Zoho_Books_Contact_ID=customer_id;
											rec.Zoho_Books_Invoice_ID=invoice_id;
											rec.Invoice_Number=invoice_number;
											invoice_pdf_url = "https://books.zoho.in/invoices/" + invoice_id + "?organization_id=" + organization_id;
											rec.Invoice_PDF_URL=invoice_pdf_url;
											rec.Sync_Status="Success - Invoice Created";
											rec.Emailed_At=zoho.currenttime;
											info "✅ Record saved";
											info "URL: " + invoice_pdf_url;
										}catch (e)
										{
											info "❌ Save error: " + e.toString();
											input.Sync_Status = "Error";
											return;
										}
										info "========== ✅ ✅ COMPLETE ✅ ✅ ==========";
						)
					}
				}

			}
			fillVendors as "fillVendors"
			{
				type =  form
				form = technicians

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											loginEmail = ifnull(zoho.loginuserid,"").trim().toLowerCase();
										currentVendor = input.vendors;
										if(loginEmail == "accounts@getrescued.in")
										{
											vendorList = vendors[ID != 0];
										}
										else
										{
											vendorList = vendors[Email.contains(zoho.loginuserid)];
										}
										clear vendors;
										input.vendors:ui.add(vendorList.ID.getall());
										if(currentVendor != null)
										{
											input.vendors = currentVendor;
										}
						)
					}
				}

			}
		}






	}
