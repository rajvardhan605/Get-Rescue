	reports
	{
		list Technicians_Report
		{
			displayName = "All Technicians"
			show all rows from technicians  [vendors.Email.contains(zoho.loginuserid) || Vendor_Email.contains(zoho.loginuserid)]  
			(
				technician_name as "Technician Name"
				phone as "Phone"
				Email
				service_capability as "Service Capability"
				last_location_updated as "Last Location Updated"
				Availability_Status as "Availability Status"
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				vendors.vendor_name as "Vendor Name"
				Vehicle_Type as "Vehicle Type"
				Added_Time as "Added Time"
				Latitude
				Longitude
				Current_Latitude
				Current_Longitude
				Last_Online_At
				Location_Last_Updated_At
				Last_Seen_At as "Last_Seen_At "
				Status
			)
			sort by
			(
				Added_Time descending
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (service_capability == "Both")
				fields = [service_capability]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (service_capability == "RSR")
				fields = [service_capability]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (service_capability == "Towing")
				fields = [service_capability]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban technicians_by_service_capability
		{
			displayName = "Service Capabilities"
			show all rows from technicians    
			(
				technician_name as "Technician Name"
				phone as "Phone"
				Email
				service_capability as "Service Capability"
				last_location_updated as "Last Location Updated"
				Availability_Status as "Availability Status"
			)
			options
			(
	 			display field = service_capability
	 		)
		}
		list Vehicle_Master_Report
		{
			displayName = "All Vehicle Masters"
			show all rows from vehicle_master    
