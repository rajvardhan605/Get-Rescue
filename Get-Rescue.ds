		 functions
		 {
			 Deluge
			 {
				 string backfillInvoiceNumbers()
                 {
                 	// ONE-TIME BACKFILL OF Invoice_number - 2026-10-26.
                 	//
                 	// New tickets get Invoice_number automatically: the agent app saves Zoho
                 	// Books' own invoice_number the moment an invoice is generated. Tickets
                 	// invoiced BEFORE that carry only Zoho_Books_Invoice_ID. This reads each of
                 	// those invoices from Zoho Books and copies its number onto the ticket.
                 	//
                 	// READ-ONLY towards Zoho Books: one GET per invoice, nothing created, sent,
                 	// emailed or changed in Books. On the ticket it writes Invoice_number and
                 	// nothing else, and only where Invoice_number is still empty - so it is safe
                 	// to run more than once. A run stops after MAX_PER_RUN invoices to stay
                 	// inside Deluge's per-execution limits; run it again until "remaining" is 0.
                 	//
                 	// HOW TO RUN: Creator -> this app -> Workflow -> Functions -> New Function
                 	// (namespace e.g. "backfill", return type string, no arguments), paste this,
                 	// Save, then Execute. Uses the same Books connection and organization as
                 	// onDemandInvoicing.deluge.
                 	organization_id = "60078911104";
                 	books_base_url = "https://www.zohoapis.in/books/v3";
                 	MAX_PER_RUN = 100;
                 	filled = 0;
                 	failed = 0;
                 	alreadyHad = 0;
                 	remaining = 0;
                 	attempted = 0;
                 	failures = List();
                 	tickets = Create_Case[ID != 0];
                 	for each  rec in tickets
                 	{
                 		// .toString() first, as getCustomerTicketInfo.deluge does - this field
                 		// reads back as DECIMAL in Deluge, and comparing it straight to "" fails.
                 		invIdText = "";
                 		if(rec.Zoho_Books_Invoice_ID != null)
                 		{
                 			invIdText = rec.Zoho_Books_Invoice_ID.toString().trim();
                 		}
                 		if(invIdText != "")
                 		{
                 			numText = "";
                 			if(rec.Invoice_number != null)
                 			{
                 				numText = rec.Invoice_number.toString().trim();
                 			}
                 			if(numText != "")
                 			{
                 				alreadyHad = alreadyHad + 1;
                 			}
                 			else
                 			{
                 				if(attempted >= MAX_PER_RUN)
                 				{
                 					remaining = remaining + 1;
                 				}
                 				else
                 				{
                 					attempted = attempted + 1;
                 					try 
                 					{
                 						invResp = invokeurl
                 						[
                 							url :books_base_url + "/invoices/" + invIdText + "?organization_id=" + organization_id
                 							type :GET
                 							connection:"zoho_books_connection"
                 						];
                 						invNumber = "";
                 						invRec = invResp.get("invoice");
                 						if(invRec != null)
                 						{
                 							if(invRec.get("invoice_number") != null)
                 							{
                 								invNumber = invRec.get("invoice_number").toString().trim();
                 							}
                 						}
                 						if(invNumber != "")
                 						{
                 							rec.Invoice_number=invNumber;
                 							filled = filled + 1;
                 							info "backfillInvoiceNumbers - ticket " + rec.ID + " invoice " + invIdText + " -> " + invNumber;
                 						}
                 						else
                 						{
                 							failed = failed + 1;
                 							failures.add(rec.ID.toString() + ": Books returned no invoice_number for invoice " + invIdText + " - " + ifnull(invResp.get("message"),""));
                 						}
                 					}					catch (bfEx)
                 					{
                 						failed = failed + 1;
                 						failures.add(rec.ID.toString() + ": " + bfEx.toString());
                 					}
                 				}
                 			}
                 		}
                 	}
                 	result = Map();
                 	result.put("filled",filled);
                 	result.put("failed",failed);
                 	result.put("already_had_number",alreadyHad);
                 	result.put("remaining_for_next_run",remaining);
                 	result.put("failures",failures);
                 	info "backfillInvoiceNumbers - " + result.toString();
                 	return result.toString();
                 }
				 string checkOperationsManagerPermission()
                 {
                 	result = "";
                 	try 
                 	{
                 		isOpsManager = thisapp.permissions.isUserInProfile("Operations Manager");
                 		result = "false";
                 		if(isOpsManager == true)
                 		{
                 			result = "true";
                 		}
                 		return "{\"code\": \"SUCCESS\", \"isOperationsManager\": " + result + "}";
                 	}	catch (e)
                 	{
                 		return "{\"code\": \"ERROR\", \"message\": \"" + e.toString() + "\", \"isOperationsManager\": false}";
                 	}
                 	return result;
                 }
				 string createServiceRequest(string customerName, string phone, string whatsappNumber, string email, string vehicleId, string vehicleRegNumber, string vehicleIssueIds, string customerLocation, string computedServiceTime, string timeOfService)
                 {
                 	returnstring = "";
                 	try 
                 	{
                 		result = Map();
                 		if(customerName == null || customerName.trim() == "")
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","Name is required");
                 			returnstring = result.toString();
                 		}
                 		else if(phone == null || phone.trim() == "")
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","Phone is required");
                 			returnstring = result.toString();
                 		}
                 		else if(vehicleId == null || vehicleId.trim() == "")
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","Vehicle is required");
                 			returnstring = result.toString();
                 		}
                 		else
                 		{
                 			// Vehicle Issue no longer required (2026-09-10, explicit user
                 			// request: "remove vehicle issue validation") — the matching
                 			// widget-side check (renderStep2()'s own next2Btn handler) was
                 			// removed the same way. vehicleIssueIds can now legitimately
                 			// arrive null/blank; ifnull() below keeps the existing
                 			// toList()/for-each loop safe either way — an empty string still
                 			// yields nothing to iterate, same as before, just no longer
                 			// rejected up front.
                 			// Real vehicle picker restored 2026-09-09 (explicit user request:
                 			// "vehicle issue and vehicle like we already did in other
                 			// widgets") — vehicleId is a real Vehicle_Master record ID
                 			// (matching getRescueTicket's own Vehicle field), an exact
                 			// lookup by ID rather than the earlier best-effort match by
                 			// Category. .toLong() before the ID comparison — this project
                 			// has repeatedly confirmed a Lookup ID arriving from a widget
                 			// as a STRING param reads back as TEXT, not NUMBER, and fails
                 			// Zoho's own type checker against a Number field without it.
                 			vehicleToUse = vehicle_master[ID == vehicleId.trim().toLong()];
                 			if(vehicleToUse == null)
                 			{
                 				result.put("code","ERROR");
                 				result.put("message","Selected vehicle not found - check Vehicle_Master_Report in Zoho.");
                 				returnstring = result.toString();
                 			}
                 			else
                 			{
                 				// ifnull() guard added 2026-09-10 alongside the "no longer
                 				// required" change above — vehicleIssueIds can now genuinely
                 				// arrive null (not just ""), and .toList() on a null string
                 				// is untested territory; ifnull(...,"") keeps this the exact
                 				// same safe "" case already handled by the loop's own
                 				// if(issueIdTrim != "") guard below.
                 				issueIdList = ifnull(vehicleIssueIds,"").toList(",");
                 				issueLongIds = List();
                 				isTow = false;
                 				for each  issueIdRaw in issueIdList
                 				{
                 					issueIdTrim = issueIdRaw.trim();
                 					if(issueIdTrim != "")
                 					{
                 						issueLongIds.add(issueIdTrim.toLong());
                 						issueRec = Vehicle_Issue[ID == issueIdTrim.toLong()];
                 						if(issueRec != null)
                 						{
                 							issueTypeText = "";
                 							if(issueRec.Issue_Type != null)
                 							{
                 								issueTypeText = issueRec.Issue_Type.toString();
                 							}
                 							if(issueTypeText.toLowerCase().contains("tow"))
                 							{
                 								isTow = true;
                 							}
                 						}
                 					}
                 				}
                 				serviceType = "RSR";
                 				if(isTow)
                 				{
                 					serviceType = "TOW";
                 				}
                 				remarksLines = "Submitted via website Service Request.";
                 				locationTrim = ifnull(customerLocation,"").trim();
                 				if(locationTrim != "")
                 				{
                 					remarksLines = remarksLines + "\nLocation (as entered): " + locationTrim;
                 				}
                 				// Real value now (2026-09-09, was hardcoded "NOW") — the
                 				// widget's Time of Service step (added same day) sends the
                 				// customer's real NOW/LATER choice. Normalized defensively:
                 				// anything other than exactly "LATER" falls back to "NOW",
                 				// so a missing/old-shaped payload (e.g. SHOW_SAMPLE_DATA
                 				// testing, or this param not yet registered in the Custom
                 				// API's own setup screen) still writes a valid dropdown
                 				// value instead of risking an invalid one.
                 				timeOfServiceResolved = "NOW";
                 				if(timeOfService != null)
                 				{
                 					if(timeOfService.trim().toUpperCase() == "LATER")
                 					{
                 						timeOfServiceResolved = "LATER";
                 					}
                 				}
                 				newId = insert into Create_Case
                 				[
                 					Customer_Name=customerName.trim()
                 					Phone_Number1=phone.trim()
                 					Phone_Number=phone.trim()
                 					Alternate_Phone_Number=ifnull(whatsappNumber,"").trim()
                 					Email=ifnull(email,"").trim()
                 					Vehicle=vehicleToUse.ID
                 					Vehicle_Registration_Number=ifnull(vehicleRegNumber,"").trim()
                 					Vehicle_Issue=issueLongIds
                 					Vehicle_Status="ONROAD"
                 					Service_Type=serviceType
                 					Time_of_service=timeOfServiceResolved
                 					Computed_Service_Time=ifnull(computedServiceTime,"")
                 					Remarks=remarksLines
                 					Lead_Source="Website"
                 					Status="NEW"
                 					Added_User=zoho.loginuser
                 				];
                 				caseId = "RSID" + newId.toString().subText(newId.toString().length() - 6);
                 				// Two-step fetch-then-write (2026-09-09, corrected same day)
                 				// — a combined "Form[criteria].Field = value;" statement was
                 				// tried here first (and in customerPage's own Custom APIs)
                 				// but hit a genuine "Improper Statement" save-time error in
                 				// submitCustomerLocation.deluge, meaning that form isn't
                 				// valid syntax at all in this Zoho instance. Reverted to
                 				// this exact shape, already confirmed working
                 				// (CreateServiceTicket.deluge).
                 				updateRec = Create_Case[ID == newId];
                 				updateRec.Case_ID=caseId;
                 				result.put("code","SUCCESS");
                 				result.put("recordId",newId);
                 				result.put("caseId",caseId);
                 				returnstring = result.toString();
                 			}
                 		}
                 	}	catch (e)
                 	{
                 		errResult = Map();
                 		errResult.put("code","ERROR");
                 		errResult.put("message",e.toString());
                 		returnstring = errResult.toString();
                 	}
                 	return returnstring;
                 }
				 string createTicket(string customerName, string mobile, string email, string vehicle, string issue, string recordId, string callerID, string ucid, string monitorUcid)
                 {
                 	returnstring = "";
                 	try 
                 	{
                 		result = Map();
                 		wantedId = ifnull(recordId,"").trim();
                 		targetId = 0;
                 		if(wantedId != "")
                 		{
                 			maybeId = 0;
                 			try 
                 			{
                 				maybeId = wantedId.toLong();
                 			}			catch (idEx)
                 			{
                 				maybeId = 0;
                 			}
                 			if(maybeId > 0)
                 			{
                 				for each  existingRec in Create_Case[ID == maybeId]
                 				{
                 					targetId = maybeId;
                 				}
                 			}
                 		}
                 		isUpdate = false;
                 		if(targetId > 0)
                 		{
                 			isUpdate = true;
                 		}
                 		if(wantedId != "")
                 		{
                 			if(isUpdate == false)
                 			{
                 				result.put("code","ERROR");
                 				result.put("message","recordId " + wantedId + " was supplied but no Create_Case record with that ID exists. Nothing was created or updated. Omit recordId entirely to create a new ticket.");
                 				return result.toString();
                 			}
                 		}
                 		hasName = false;
                 		if(ifnull(customerName,"").trim() != "")
                 		{
                 			hasName = true;
                 		}
                 		hasMobile = false;
                 		if(ifnull(mobile,"").trim() != "")
                 		{
                 			hasMobile = true;
                 		}
                 		hasEmail = false;
                 		if(ifnull(email,"").trim() != "")
                 		{
                 			hasEmail = true;
                 		}
                 		hasVehicle = false;
                 		if(ifnull(vehicle,"").trim() != "")
                 		{
                 			hasVehicle = true;
                 		}
                 		hasIssue = false;
                 		if(ifnull(issue,"").trim() != "")
                 		{
                 			hasIssue = true;
                 		}
                 		/* callerID / UCID added 2026-09-28 so a ticket raised from an incoming call
                 		   carries the call that produced it, and searchTickets can find it by either.
                 
                 		   Both are OPTIONAL and purely additive: every existing caller sends neither,
                 		   they arrive null, and the ticket is written exactly as it was before.
                 
                 		   A value still holding a placeholder such as $CallerID$ is treated as absent.
                 		   That is a real failure mode, not a hypothetical one - Ozonetel's ScreenPop
                 		   sends its own token unsubstituted when misconfigured, and storing that
                 		   literal text would make the ticket look like it came from a call it did not.
                 		   Same guard recordRingingCall.deluge already applies. */
                 		callerIdText = ifnull(callerID,"").trim();
                 		if(callerIdText.contains("$"))
                 		{
                 			callerIdText = "";
                 		}
                 		ucidText = ifnull(ucid,"").trim();
                 		if(ucidText.contains("$"))
                 		{
                 			ucidText = "";
                 		}
                 		hasCallerId = false;
                 		if(callerIdText != "")
                 		{
                 			hasCallerId = true;
                 		}
                 		hasUcid = false;
                 		if(ucidText != "")
                 		{
                 			hasUcid = true;
                 		}
                 		/* monitorUcid - 2026-10-22. The id Ozonetel's end-of-call push uses for this
                 		   call (the pop shows it as "Monitor UCID", 2650...), as opposed to the
                 		   ScreenPop's own ucid (1622...). OPTIONAL: every existing caller omits it
                 		   and nothing below changes for them. Same placeholder guard as above. */
                 		monitorUcidText = ifnull(monitorUcid,"").trim();
                 		if(monitorUcidText.contains("$"))
                 		{
                 			monitorUcidText = "";
                 		}
                 		// The ticket this request created or updated - set in each branch below,
                 		// read by the Call_Log link after them.
                 		linkTicketId = 0;
                 		/* The "at least one field must be supplied" gate on UPDATE was removed
                 		   2026-09-29 (user request). An update that sends only a recordId now
                 		   succeeds as a no-op instead of returning ERROR: the record is found,
                 		   nothing is written, and the reply comes back SUCCESS / mode "updated"
                 		   with an empty updatedFields, which tells the caller plainly that no
                 		   field changed.
                 		
                 		   Deliberately only the UPDATE path. The create-side required checks in
                 		   the else branch below (Customer Name, Mobile, Vehicle, Issue) are
                 		   untouched — a NEW ticket with no customer or vehicle would be broken
                 		   data, not a harmless no-op.
                 		
                 		   Still guarded above, and unchanged: a recordId that matches no
                 		   Create_Case record is still rejected outright, so a bad ID can never
                 		   be mistaken for a successful no-op. */
                 		resolvedVehicleId = 0;
                 		if(hasVehicle)
                 		{
                 			vehicleTrim = vehicle.trim();
                 			vehicleFound = false;
                 			vehicleMaybeId = 0;
                 			try 
                 			{
                 				vehicleMaybeId = vehicleTrim.toLong();
                 			}			catch (vehicleIdEx)
                 			{
                 				vehicleMaybeId = 0;
                 			}
                 			if(vehicleMaybeId > 0)
                 			{
                 				for each  vehicleById in vehicle_master[ID == vehicleMaybeId]
                 				{
                 					resolvedVehicleId = vehicleMaybeId;
                 					vehicleFound = true;
                 				}
                 			}
                 			if(vehicleFound == false)
                 			{
                 				vehicleWanted = vehicleTrim.toLowerCase();
                 				for each  vehicleRec in vehicle_master[ID != 0]
                 				{
                 					if(vehicleFound == false)
                 					{
                 						vehicleNameText = ifnull(vehicleRec.Name,"").toString().trim().toLowerCase();
                 						if(vehicleNameText == vehicleWanted)
                 						{
                 							resolvedVehicleId = vehicleRec.ID.toString().toLong();
                 							vehicleFound = true;
                 						}
                 					}
                 				}
                 			}
                 			if(vehicleFound == false)
                 			{
                 				result.put("code","ERROR");
                 				result.put("message","Vehicle not recognised: " + vehicleTrim + ". Send either a Vehicle Master record ID, or the vehicle name exactly as it appears in Vehicle Master (case does not matter).");
                 				return result.toString();
                 			}
                 		}
                 		issueLongIds = List();
                 		unmatchedIssues = "";
                 		isTow = false;
                 		/* Old and new issue names - Task Tracker #70 (2026-10-29). The client is renaming FBT,
                 		   MT and zero degree in the issue master. A name sent in either form finds the issue,
                 		   so WhatsApp and web tickets keep working whichever name the sender still uses.
                 		   Only tried after the exact match below has failed. */
                 		issueAliases = Map();
                 		issueAliases.put("fbt","flat bed towing");
                 		issueAliases.put("flat bed towing","fbt");
                 		issueAliases.put("mt","wheel lift towing");
                 		issueAliases.put("wheel lift towing","mt");
                 		issueAliases.put("zero degree","zero degree towing");
                 		issueAliases.put("zero degree towing","zero degree");
                 		if(hasIssue)
                 		{
                 			issueNameList = issue.toList(",");
                 			for each  issueNameRaw in issueNameList
                 			{
                 				issueNameTrim = issueNameRaw.trim();
                 				if(issueNameTrim != "")
                 				{
                 					issueMatched = false;
                 					matchedIssueType = "";
                 					issueMaybeId = 0;
                 					try 
                 					{
                 						issueMaybeId = issueNameTrim.toLong();
                 					}					catch (issueIdEx)
                 					{
                 						issueMaybeId = 0;
                 					}
                 					if(issueMaybeId > 0)
                 					{
                 						for each  issueById in Vehicle_Issue[ID == issueMaybeId]
                 						{
                 							issueLongIds.add(issueMaybeId);
                 							issueMatched = true;
                 							matchedIssueType = ifnull(issueById.Issue_Type,"").toString().toLowerCase();
                 						}
                 					}
                 					if(issueMatched == false)
                 					{
                 						issueWanted = issueNameTrim.toLowerCase();
                 						for each  issueRec in Vehicle_Issue[ID != 0]
                 						{
                 							if(issueMatched == false)
                 							{
                 								issueNameText = ifnull(issueRec.Issue_Name,"").toString().trim().toLowerCase();
                 								if(issueNameText == issueWanted)
                 								{
                 									issueLongIds.add(issueRec.ID.toString().toLong());
                 									issueMatched = true;
                 									matchedIssueType = ifnull(issueRec.Issue_Type,"").toString().toLowerCase();
                 								}
                 							}
                 						}
                 					}
                 					if(issueMatched == false)
                 					{
                 						aliasWanted = "";
                 						if(issueAliases.containKey(issueWanted))
                 						{
                 							aliasWanted = issueAliases.get(issueWanted);
                 						}
                 						if(aliasWanted != "")
                 						{
                 							for each  aliasRec in Vehicle_Issue[ID != 0]
                 							{
                 								if(issueMatched == false)
                 								{
                 									aliasNameText = ifnull(aliasRec.Issue_Name,"").toString().trim().toLowerCase();
                 									if(aliasNameText == aliasWanted)
                 									{
                 										issueLongIds.add(aliasRec.ID.toString().toLong());
                 										issueMatched = true;
                 										matchedIssueType = ifnull(aliasRec.Issue_Type,"").toString().toLowerCase();
                 									}
                 								}
                 							}
                 						}
                 					}
                 					if(issueMatched)
                 					{
                 						if(matchedIssueType.contains("tow"))
                 						{
                 							isTow = true;
                 						}
                 					}
                 					else
                 					{
                 						if(unmatchedIssues == "")
                 						{
                 							unmatchedIssues = issueNameTrim;
                 						}
                 						else
                 						{
                 							unmatchedIssues = unmatchedIssues + ", " + issueNameTrim;
                 						}
                 					}
                 				}
                 			}
                 			if(issueLongIds.size() == 0)
                 			{
                 				result.put("code","ERROR");
                 				result.put("message","Issue not recognised: " + unmatchedIssues + ". Send either a Vehicle Issue record ID, or the issue name exactly as it appears in Vehicle Issue (case does not matter).");
                 				return result.toString();
                 			}
                 		}
                 		serviceType = "RSR";
                 		if(isTow)
                 		{
                 			serviceType = "TOW";
                 		}
                 		if(isUpdate)
                 		{
                 			updateRec = Create_Case[ID == targetId];
                 			changedFields = "";
                 			if(hasName)
                 			{
                 				updateRec.Customer_Name=customerName.trim();
                 				changedFields = changedFields + "Customer_Name ";
                 			}
                 			if(hasMobile)
                 			{
                 				updateRec.Phone_Number1=mobile.trim();
                 				updateRec.Phone_Number=mobile.trim();
                 				changedFields = changedFields + "Phone_Number1 Phone_Number ";
                 			}
                 			if(hasEmail)
                 			{
                 				updateRec.Email=email.trim();
                 				changedFields = changedFields + "Email ";
                 			}
                 			if(hasVehicle)
                 			{
                 				updateRec.Vehicle=resolvedVehicleId;
                 				changedFields = changedFields + "Vehicle ";
                 			}
                 			if(hasIssue)
                 			{
                 				updateRec.Vehicle_Issue=issueLongIds;
                 				updateRec.Service_Type=serviceType;
                 				changedFields = changedFields + "Vehicle_Issue Service_Type ";
                 			}
                 			if(hasCallerId)
                 			{
                 				updateRec.callerID=callerIdText;
                 				changedFields = changedFields + "callerID ";
                 			}
                 			if(hasUcid)
                 			{
                 				updateRec.UCID=ucidText;
                 				changedFields = changedFields + "UCID ";
                 			}
                 			result.put("code","SUCCESS");
                 			linkTicketId = targetId;
                 			result.put("mode","updated");
                 			result.put("message","Service request updated");
                 			result.put("recordId",targetId);
                 			result.put("caseId",ifnull(updateRec.Case_ID,"").toString());
                 			result.put("updatedFields",changedFields.trim());
                 			if(hasIssue)
                 			{
                 				result.put("serviceType",serviceType);
                 			}
                 			if(unmatchedIssues != "")
                 			{
                 				result.put("unmatchedIssues",unmatchedIssues);
                 			}
                 			returnstring = result.toString();
                 		}
                 		else
                 		{
                 			// Status "NEW" - 2026-10-14, client rule: a ticket that has arrived but that
                 			// no agent has opened yet is NEW. It becomes SERVICE FEE QUOTE only when an
                 			// agent submits the pre-filled Create page in getRescueTicket, which is also
                 			// what stamps the Agent (Owner). Writing SERVICE FEE QUOTE here claimed work
                 			// nobody had done, and made the agent app resume the ticket at the Quote step
                 			// instead of at Create. All three inbound creators were changed together.
                 			//
                 			// This note sits OUTSIDE the insert block on purpose: Deluge parses everything
                 			// between the square brackets as field assignments, so a // line in there is a
                 			// syntax error - reported against the enclosing try, not against itself.
                 			newId = insert into Create_Case
                 			[
                 				Customer_Name=customerName.trim()
                 				Phone_Number1=mobile.trim()
                 				Phone_Number=mobile.trim()
                 				Email=ifnull(email,"").trim()
                 				Vehicle=resolvedVehicleId
                 				Vehicle_Issue=issueLongIds
                 				Vehicle_Status="ONROAD"
                 				Service_Type=serviceType
                 				Time_of_service="NOW"
                 				Remarks="Whatsapp."
                 				Lead_Source="Whatsapp"
                 				Status="NEW"
                 				Added_User=zoho.loginuser
                 				callerID=callerIdText
                 				UCID=ucidText
                 				Client="ON DEMAND"
                 			];
                 			caseId = "RSID" + newId.toString().subText(newId.toString().length() - 6);
                 			updateRec = Create_Case[ID == newId];
                 			updateRec.Case_ID=caseId;
                 			linkTicketId = newId;
                 			result.put("code","SUCCESS");
                 			result.put("mode","created");
                 			result.put("message","Service request created");
                 			result.put("recordId",newId);
                 			result.put("caseId",caseId);
                 			result.put("serviceType",serviceType);
                 			// Echoed back so the caller can see what was actually stored - a blank here
                 			// after sending a value means the placeholder guard above rejected it.
                 			result.put("callerID",callerIdText);
                 			result.put("ucid",ucidText);
                 			if(unmatchedIssues != "")
                 			{
                 				result.put("unmatchedIssues",unmatchedIssues);
                 			}
                 			returnstring = result.toString();
                 		}
                 		/* CALL_LOG LINK - 2026-10-22. See this change's own note: the pop's "Link
                 		   call" arrives here, and the end-of-call push completes whichever Call_Log
                 		   row carries its id - so the row is keyed by monitorUcid and linked HERE,
                 		   instead of the link living only on the ticket. Runs only when the request
                 		   carried a call id; its own try/catch means it can never fail the ticket. */
                 		callKey = monitorUcidText;
                 		if(callKey == "")
                 		{
                 			callKey = ucidText;
                 		}
                 		doCallLink = false;
                 		if(linkTicketId > 0)
                 		{
                 			if(callKey != "")
                 			{
                 				doCallLink = true;
                 			}
                 		}
                 		if(doCallLink)
                 		{
                 			callLogNote = "";
                 			try 
                 			{
                 				// Last 10 digits, the shape every other Call_Log writer stores.
                 				callPhone = callerIdText;
                 				if(callPhone == "")
                 				{
                 					callPhone = ifnull(mobile,"").trim();
                 				}
                 				callPhone = callPhone.replaceAll("[^0-9]","");
                 				if(callPhone.length() > 10)
                 				{
                 					callPhone = callPhone.subText(callPhone.length() - 10);
                 				}
                 				// 1. A row already under this id: the push got here first (linked after
                 				//    hang-up), or getRescueTicket created it from the Dashboard pop.
                 				callRowId = 0;
                 				for each  keyRow in Call_Log[UCID == callKey]
                 				{
                 					if(callRowId == 0)
                 					{
                 						callRowId = keyRow.ID.toString().toLong();
                 					}
                 				}
                 				// 2. A row under the pop's plain ucid, written before rows were keyed by
                 				//    monitorUcid. Linked either way; RE-KEYED only while still pending, so
                 				//    the push can find it - a completed row keeps the id it has.
                 				reKey = false;
                 				tryLegacy = false;
                 				if(callRowId == 0)
                 				{
                 					if(monitorUcidText != "")
                 					{
                 						if(ucidText != "")
                 						{
                 							if(ucidText != monitorUcidText)
                 							{
                 								tryLegacy = true;
                 							}
                 						}
                 					}
                 				}
                 				if(tryLegacy)
                 				{
                 					pendingStatuses = "|RINGING|INCOMING|PLACED|";
                 					for each  legacyRow in Call_Log[UCID == ucidText]
                 					{
                 						if(callRowId == 0)
                 						{
                 							callRowId = legacyRow.ID.toString().toLong();
                 							legacyStatusText = ifnull(legacyRow.Call_Status,"").toString();
                 							legacyKey = "|" + legacyStatusText.trim().toUpperCase() + "|";
                 							if(pendingStatuses.contains(legacyKey))
                 							{
                 								reKey = true;
                 							}
                 						}
                 					}
                 				}
                 				if(callRowId > 0)
                 				{
                 					// Only Create_Case is set (plus the re-key and a blank phone). Status,
                 					// duration and everything the push wrote are left exactly as they are.
                 					// An existing link is replaced: the agent clicking Link call on this
                 					// ticket is the most direct statement of which ticket the call is for.
                 					logRec = Call_Log[ID == callRowId];
                 					previousLink = "";
                 					prevRef = logRec.Create_Case;
                 					if(prevRef != null)
                 					{
                 						previousLink = prevRef.toString().trim();
                 					}
                 					logRec.Create_Case=linkTicketId;
                 					if(reKey)
                 					{
                 						logRec.UCID=monitorUcidText;
                 					}
                 					existingPhone = ifnull(logRec.Phone_Number,"").toString().trim();
                 					if(existingPhone == "")
                 					{
                 						if(callPhone != "")
                 						{
                 							logRec.Phone_Number=callPhone;
                 						}
                 					}
                 					callLogNote = "LINKED_EXISTING";
                 					result.put("callLogRowId",callRowId.toString());
                 					if(previousLink != "")
                 					{
                 						if(previousLink != linkTicketId.toString())
                 						{
                 							result.put("callLogPreviousTicket",previousLink);
                 						}
                 					}
                 					if(reKey)
                 					{
                 						result.put("callLogReKeyedFrom",ucidText);
                 					}
                 					reKeyNote = "";
                 					if(reKey)
                 					{
                 						reKeyNote = " and re-keyed " + ucidText + " -> " + monitorUcidText;
                 					}
                 					info "createTicket: Call_Log " + callRowId + " linked to ticket " + linkTicketId + reKeyNote + ".";
                 				}
                 				else
                 				{
                 					// 3. No row yet - the call is still in progress. Created now, keyed by
                 					//    the push's id, so the push completes this row at hang-up.
                 					newLogId = insert into Call_Log
                 					[
                 						UCID=callKey
                 						Phone_Number=callPhone
                 						Call_Status="Incoming"
                 						Create_Case=linkTicketId
                 						Added_User=zoho.loginuser
                 					];
                 					callLogNote = "CREATED_LINKED";
                 					result.put("callLogRowId",newLogId.toString());
                 					info "createTicket: Call_Log " + newLogId + " created under " + callKey + ", linked to ticket " + linkTicketId + ".";
                 				}
                 			}			catch (callLogEx)
                 			{
                 				callLogNote = "FAILED - the ticket itself was saved. " + callLogEx.toString();
                 				info "createTicket: Call_Log link failed (ticket unaffected): " + callLogEx.toString();
                 			}
                 			result.put("callLog",callLogNote);
                 			result.put("callLogKey",callKey);
                 			if(monitorUcidText == "")
                 			{
                 				result.put("callLogWarning","No monitorUcid was sent, so the row is keyed by the ScreenPop ucid. The end-of-call push may not recognise it and can create a second, unlinked row. Send monitorUcid.");
                 			}
                 			returnstring = result.toString();
                 		}
                 	}	catch (e)
                 	{
                 		errResult = Map();
                 		errResult.put("code","ERROR");
                 		errResult.put("message",e.toString());
                 		returnstring = errResult.toString();
                 	}
                 	return returnstring;
                 }
				 string fetchInvoicePdf(string recordId, string invoiceId)
                 {
                 	// PULLS THE ZOHO BOOKS INVOICE PDF ONTO A TICKET, ON DEMAND — 2026-10-07.
                 	//
                 	// WHY THIS EXISTS SEPARATELY FROM onDemandInvoicing. That function captures
                 	// the PDF as the last step of CREATING an invoice, so the only way to retry a
                 	// capture that failed is to create a second invoice — a real duplicate in the
                 	// live Books org, for a ticket that is already billed. Every invoice raised
                 	// before the PDF work therefore has no document and no way to get one.
                 	//
                 	// This does the capture and nothing else: no invoice, no payment, no email.
                 	// It can be run on any ticket that already carries a Zoho_Books_Invoice_ID,
                 	// as many times as needed, and the worst case is that it overwrites
                 	// Invoice_PDF with the same document.
                 	//
                 	// ⚠ REGISTER BOTH PARAMETERS (recordId, invoiceId) on the Custom API setup
                 	// screen. A parameter named only in this signature arrives null no matter
                 	// what the widget sends — this project has lost days to that three times.
                 	organization_id = "60078911104";
                 	books_base_url = "https://www.zohoapis.in/books/v3";
                 	try 
                 	{
                 		info "fetchInvoicePdf called with recordId=" + recordId + " | invoiceId=" + invoiceId;
                 		if(recordId == null)
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"recordId is missing.\"}";
                 		}
                 		recId = recordId.trim();
                 		if(recId == "")
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"recordId is empty.\"}";
                 		}
                 		ticketRec = Create_Case[ID == recId.toLong()];
                 		if(ticketRec == null)
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"No Create_Case record has ID " + recId + ".\"}";
                 		}
                 		// The caller may pass the invoice id, but the ticket already stores it -
                 		// so a blank parameter is not an error, just a reason to read the record.
                 		invId = "";
                 		if(invoiceId != null)
                 		{
                 			invId = invoiceId.trim();
                 		}
                 		if(invId == "")
                 		{
                 			if(ticketRec.Zoho_Books_Invoice_ID != null)
                 			{
                 				invId = ticketRec.Zoho_Books_Invoice_ID.toString().trim();
                 			}
                 		}
                 		if(invId == "")
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"This ticket has no Zoho Books invoice yet, so there is no PDF to fetch. Generate the invoice first.\"}";
                 		}
                 		// SAME TWO REQUEST FORMS onDemandInvoicing USES, in the same order. Books
                 		// takes the query parameter or the Accept header; which one actually
                 		// returns a document has not been established for this org, so both are
                 		// tried and the log says which won.
                 		pdfResp = invokeurl
                 		[
                 			url :books_base_url + "/invoices/" + invId + "?organization_id=" + organization_id + "&accept=pdf"
                 			type :GET
                 			connection:"zoho_books_connection"
                 		];
                 		// A response that cannot be read as text IS the document: JSON and HTML
                 		// stringify cleanly, a PDF's bytes do not.
                 		pdfThrew = "no";
                 		pdfPeek = "";
                 		try 
                 		{
                 			pdfPeek = pdfResp.toString();
                 			if(pdfPeek.length() > 60)
                 			{
                 				pdfPeek = pdfPeek.subString(0,60);
                 			}
                 		}		catch (peekEx)
                 		{
                 			pdfThrew = "yes";
                 			pdfPeek = "(not readable as text)";
                 		}
                 		pdfKind = "something else - see this execution log";
                 		if(pdfThrew == "yes")
                 		{
                 			pdfKind = "a real PDF";
                 		}
                 		else if(pdfPeek.contains("%PDF-"))
                 		{
                 			pdfKind = "a real PDF";
                 		}
                 		else if(pdfPeek.toUpperCase().contains("DOCTYPE"))
                 		{
                 			pdfKind = "an HTML page - not a document";
                 		}
                 		else if(pdfPeek.contains("message"))
                 		{
                 			pdfKind = "JSON - Books refused the request";
                 		}
                 		info "fetchInvoicePdf - ?accept=pdf returned [" + pdfKind + "], first 60 chars: [" + pdfPeek + "]";
                 		usedForm = "accept=pdf query parameter";
                 		if(pdfKind != "a real PDF")
                 		{
                 			try 
                 			{
                 				pdfRespAlt = invokeurl
                 				[
                 					url :books_base_url + "/invoices/" + invId + "?organization_id=" + organization_id
                 					type :GET
                 					headers:{"Accept":"application/pdf"}
                 					connection:"zoho_books_connection"
                 				];
                 				altThrew = "no";
                 				peekAlt = "";
                 				try 
                 				{
                 					peekAlt = pdfRespAlt.toString();
                 					if(peekAlt.length() > 60)
                 					{
                 						peekAlt = peekAlt.subString(0,60);
                 					}
                 				}				catch (peekAltEx)
                 				{
                 					altThrew = "yes";
                 					peekAlt = "(not readable as text)";
                 				}
                 				info "fetchInvoicePdf - Accept header returned, first 60 chars: [" + peekAlt + "]";
                 				if(altThrew == "yes")
                 				{
                 					pdfResp = pdfRespAlt;
                 					pdfKind = "a real PDF";
                 					usedForm = "Accept: application/pdf header";
                 				}
                 				else if(peekAlt.contains("%PDF-"))
                 				{
                 					pdfResp = pdfRespAlt;
                 					pdfKind = "a real PDF";
                 					usedForm = "Accept: application/pdf header";
                 				}
                 			}			catch (altEx)
                 			{
                 				info "fetchInvoicePdf - Accept header attempt threw (non-fatal): " + altEx.toString();
                 			}
                 		}
                 		if(pdfKind != "a real PDF")
                 		{
                 			info "fetchInvoicePdf - NOTHING WRITTEN. Neither request form returned a document for invoice " + invId + ".";
                 			return "{\"code\": \"ERROR\", \"message\": \"Zoho Books returned " + pdfKind + " instead of a document, for both request forms. Nothing was written to Invoice_PDF. The execution log holds the first 60 characters of each response.\", \"invoice_pdf_type\": \"" + pdfKind + "\"}";
                 		}
                 		/* THE ASSIGNMENT GETS ITS OWN GUARD - 2026-10-07, from a live error:
                 		   "Value of the field Invoice_PDF length should be lesser than or equal to
                 		   MaxLength 255." That length check only exists on a TEXT field, so it says
                 		   plainly that Invoice_PDF was created as Single Line rather than File
                 		   Upload - and the raw exception that surfaced it named a line number, not
                 		   the cause. Reaching this line at all proves the fetch WORKED: nothing gets
                 		   here unless Books returned a real document. */
                 		try 
                 		{
                 			ticketRec.Invoice_PDF=pdfResp;
                 		}		catch (attachEx)
                 		{
                 			attachMsg = attachEx.toString();
                 			info "fetchInvoicePdf - the PDF was fetched successfully but could NOT be stored: " + attachMsg;
                 			if(attachMsg.contains("MaxLength"))
                 			{
                 				return "{\"code\": \"ERROR\", \"message\": \"Zoho Books returned the invoice PDF correctly, but it could not be saved: Invoice_PDF on Create_Case is a TEXT field (max 255 characters) and a text field cannot hold a file. Change Invoice_PDF to a FILE UPLOAD field in Zoho Creator, then press Fetch PDF again. Nothing else about the invoice is affected.\"}";
                 			}
                 			return "{\"code\": \"ERROR\", \"message\": \"The invoice PDF was fetched but could not be saved onto the ticket. See this Custom API execution log for what Zoho refused.\"}";
                 		}
                 		info "fetchInvoicePdf - invoice " + invId + " PDF attached to ticket " + recId + " using the " + usedForm + ".";
                 		return "{\"code\": \"SUCCESS\", \"message\": \"Invoice PDF attached to the ticket.\", \"invoice_id\": \"" + invId + "\", \"used_form\": \"" + usedForm + "\"}";
                 	}	catch (mainEx)
                 	{
                 		info "fetchInvoicePdf - EXCEPTION: " + mainEx.toString();
                 		return "{\"code\": \"ERROR\", \"message\": \"Exception: " + mainEx.toString() + "\"}";
                 	}
                 	// Deluge requires a terminal return for a `string` function even when every
                 	// path above already returns one - it will not save without this. Same
                 	// closing shape paymentWebhook.deluge and onDemandInvoicing.deluge both use,
                 	// and reaching it would mean a path was added above without a return.
                 	return "{\"code\": \"ERROR\", \"message\": \"fetchInvoicePdf finished without reaching any known outcome. This should not happen - send the execution log over.\"}";
                 }
				 string generateZohoPaymentLink(string recordId, string amount, string email, string phoneDigits, string referenceId, string description, string expiresAt, string paymentUrlField)
                 {
                 	// New, standalone Custom API (2026-09-10, explicit user request: "create
                 	// new custom api for that and now dont use onDemandInvoicing function
                 	// we will work on this later") — the Zoho Payments "Payment Links" call
                 	// that used to live inside onDemandInvoicing.deluge (alongside Zoho
                 	// Books invoice creation) is pulled out here as its own independent
                 	// function, with no dependency on that file or on an invoice ever being
                 	// created. onDemandInvoicing.deluge itself is left untouched — its own
                 	// copy of this same logic is now unused/dormant, not deleted, so it's
                 	// easy to pick back up later per the user's own "later" framing.
                 	returnstring = "";
                 	try 
                 	{
                 		result = Map();
                 		// Entry log added 2026-09-17 (live: this function returned "recordId is
                 		// required" on a real button click). Prints EVERY parameter exactly as
                 		// Zoho bound it, because there are only two possible causes and they
                 		// need completely different fixes:
                 		//   (a) EVERY value below is "(null)" -> the parameters are not
                 		//       registered on this Custom API's own setup screen. A parameter
                 		//       named only in the signature above arrives null no matter what
                 		//       the widget sends. This project has been caught by exactly that
                 		//       five times (applyTax, the four invoice params, token, param3,
                 		//       buttonParam) - it is the single most likely cause.
                 		//   (b) recordId alone is "(null)"/blank while the others carry real
                 		//       values -> the parameter IS registered and the widget genuinely
                 		//       sent nothing, i.e. record.ID was empty at click time.
                 		// Same diagnostic pattern onDemandInvoicing.deluge already uses.
                 		info "generateZohoPaymentLink received - recordId=[" + ifnull(recordId,"(null)") + "] | amount=[" + ifnull(amount,"(null)") + "] | email=[" + ifnull(email,"(null)") + "] | phoneDigits=[" + ifnull(phoneDigits,"(null)") + "] | referenceId=[" + ifnull(referenceId,"(null)") + "] | description=[" + ifnull(description,"(null)") + "] | expiresAt=[" + ifnull(expiresAt,"(null)") + "] | paymentUrlField=[" + ifnull(paymentUrlField,"(null)") + "]";
                 		if(recordId == null || recordId.trim() == "")
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","recordId is required");
                 			info "generateZohoPaymentLink - REFUSED: recordId arrived empty. Read the log line above: if every other parameter is also (null), the parameters are not registered on this Custom API's setup screen. If the others hold real values, the widget sent no record ID.";
                 			returnstring = result.toString();
                 		}
                 		else if(amount == null || amount.trim() == "")
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","amount is required");
                 			returnstring = result.toString();
                 		}
                 		else
                 		{
                 			// Real bug fixed 2026-09-10, live: "Unable to cast the
                 			// '448881000000543009 ' value into a 'Long' value" — note the
                 			// trailing space in the quoted value itself. .trim() added
                 			// before .toLong() (same defensive pattern already proven
                 			// elsewhere in this project — see createServiceRequest.deluge's
                 			// own "vehicleId.trim().toLong()") so a stray leading/trailing
                 			// space in recordId (e.g. from a manual test-panel paste, or any
                 			// future caller) doesn't crash the whole function before it
                 			// even gets to check whether the ticket exists.
                 			rec = Create_Case[ID == recordId.trim().toLong()];
                 			if(rec == null)
                 			{
                 				result.put("code","ERROR");
                 				result.put("message","Ticket not found");
                 				returnstring = result.toString();
                 			}
                 			else
                 			{
                 				// Real refresh-token -> access-token OAuth exchange — same
                 				// credentials/reasoning as onDemandInvoicing.deluge's own
                 				// matching block (explicit user decision, 2026-09-10: "I
                 				// don't create connections use the Refresh token and access
                 				// token methodology"). Kept as this function's OWN
                 				// independent copy (this project has no shared Deluge
                 				// modules — every Custom API is self-contained) so it works
                 				// standalone, with zero dependency on onDemandInvoicing.deluge.
                 				zoho_payments_client_id = "1000.7BYOUWK2Q2XMJQWU62E6WHCRZOY9VW";
                 				zoho_payments_client_secret = "a714fc6ab6c76d058196ceef8b49cad735422987fd";
                 				zoho_payments_refresh_token = "1000.7b9a45adfe6300ed5fb43cf9d29eef7b.65c3a6df18bedb83f887bf1f4fbc44d6";
                 				zoho_payments_account_id = "60078772586";
                 				zoho_payments_base_url = "https://payments.zoho.in/api/v1";
                 				// return_url (revised 2026-09-22, client feedback on a live
                 				// REPAIR case: "the customer is not being redirected to the
                 				// next page as expected").
                 				//
                 				// It used to be the static "https://creatorapp.zoho.in/
                 				// getrescued/get-rescue" (user decision 2026-09-10, "return
                 				// url will be the provided url"). That is the AGENT app's own
                 				// root - a login-protected Creator URL a customer has no
                 				// access to at all - so after paying, the customer landed on
                 				// a sign-in wall instead of the next step of their journey.
                 				//
                 				// Now it points back at the public Customer Page the customer
                 				// was already on, carrying this ticket's own recordId and the
                 				// mode of the NEXT step, which mirrors exactly what
                 				// customerPage's own advanceAfterPayment() does for the tab
                 				// that stays open: Booking Fee -> breakdown location,
                 				// Remaining Fee -> feedback.
                 				//
                 				// This matters because Pay Now opens in a NEW tab. The existing
                 				// poll only ever advances the ORIGINAL tab, which the customer
                 				// has usually lost by then; the return_url is what moves the
                 				// tab the customer is actually looking at. Both paths are kept
                 				// - whichever fires first, the customer ends up on the right
                 				// screen.
                 				customer_page_base = "https://creatorapp.zohopublic.in/getrescued/get-rescue/page-perma/Customer_Page/0gVCSNX48ASbYtRFUJ563eAbKzNFNnaVwH8fPFZCqaROx4z5T6QRyEQVTshspvvXSgyt5vuyPJSQQC0dwZGyYQKdMeySnUS6mYJr";
                 				zoho_payments_return_url = customer_page_base + "?recordId=" + recordId.trim() + "&mode=location&locationType=breakdown";
                 				if(paymentUrlField == "Zoho_Payment_URL_Remaining")
                 				{
                 					zoho_payments_return_url = customer_page_base + "?recordId=" + recordId.trim() + "&mode=feedback";
                 				}
                 				info "generateZohoPaymentLink - return_url for this link = " + zoho_payments_return_url;
                 				tokenResp = invokeurl
                 				[
                 					url :"https://accounts.zoho.in/oauth/v2/token?refresh_token=" + zoho_payments_refresh_token + "&client_id=" + zoho_payments_client_id + "&client_secret=" + zoho_payments_client_secret + "&grant_type=refresh_token"
                 					type :POST
                 				];
                 				info "generateZohoPaymentLink — token refresh raw response: " + tokenResp.toString();
                 				access_token = tokenResp.get("access_token");
                 				if(access_token == null)
                 				{
                 					result.put("code","ERROR");
                 					result.put("message","Could not get an access token from the refresh token — see this Custom API's own execution log for the raw token-refresh response");
                 					returnstring = result.toString();
                 				}
                 				else
                 				{
                 					paymentLinkMap = Map();
                 					// .toDecimal().toString() — same "always send numeric
                 					// fields as strings" convention used throughout this
                 					// project's other Deluge files (e.g. onDemandInvoicing.
                 					// deluge's own lineItem.put("rate",...)).
                 					paymentLinkMap.put("amount",amount.toDecimal().toString());
                 					paymentLinkMap.put("currency","INR");
                 					if(email != null)
                 					{
                 						if(email != "")
                 						{
                 							paymentLinkMap.put("email",email);
                 						}
                 					}
                 					// Bare 10-digit number expected here (confirmed example:
                 					// "phone": "8127112543", no "+91"/spaces) — cleaned by
                 					// the widget's own JS caller before this is ever called,
                 					// same as onDemandInvoicing.deluge's own matching
                 					// parameter — no confirmed-safe way in this codebase to
                 					// strip non-digit characters from a string in Deluge
                 					// itself.
                 					if(phoneDigits != null)
                 					{
                 						if(phoneDigits != "")
                 						{
                 							paymentLinkMap.put("phone",phoneDigits);
                 							paymentLinkMap.put("phone_country_code","IN");
                 						}
                 					}
                 					referenceIdResolved = referenceId;
                 					if(referenceIdResolved == null)
                 					{
                 						referenceIdResolved = recordId;
                 					}
                 					if(referenceIdResolved == "")
                 					{
                 						referenceIdResolved = recordId;
                 					}
                 					paymentLinkMap.put("reference_id",referenceIdResolved);
                 					descriptionResolved = description;
                 					if(descriptionResolved == null)
                 					{
                 						descriptionResolved = "Service Charge";
                 					}
                 					if(descriptionResolved == "")
                 					{
                 						descriptionResolved = "Service Charge";
                 					}
                 					paymentLinkMap.put("description",descriptionResolved);
                 					if(expiresAt != null)
                 					{
                 						if(expiresAt != "")
                 						{
                 							paymentLinkMap.put("expires_at",expiresAt);
                 						}
                 					}
                 					// Both false deliberately — the caller sends its OWN
                 					// WhatsApp message with the link right after this
                 					// returns; Zoho Payments' own email/SMS notification
                 					// would be a second, separate, unrequested message to
                 					// the same customer.
                 					notifyMap = Map();
                 					notifyMap.put("email",false);
                 					notifyMap.put("sms",false);
                 					paymentLinkMap.put("notify_customer",notifyMap);
                 					paymentLinkMap.put("return_url",zoho_payments_return_url);
                 					configMap = Map();
                 					allowedMethods = List();
                 					allowedMethods.add("upi");
                 					allowedMethods.add("card");
                 					configMap.put("allowed_payment_methods",allowedMethods);
                 					paymentLinkMap.put("configurations",configMap);
                 					metaList = List();
                 					metaEntry = Map();
                 					metaEntry.put("key","Case_ID");
                 					metaEntry.put("value",referenceIdResolved);
                 					metaList.add(metaEntry);
                 					// recordId metadata (2026-09-11, explicit user request) — the
                 					// real Create_Case record ID this payment link was generated
                 					// for, distinct from Case_ID/referenceIdResolved above (which
                 					// is the human-facing "RSID..." label, plus a "-BF"/"-RF"
                 					// suffix for Booking/Remaining Fee — never the raw Zoho record
                 					// ID). Passed straight through from this function's own
                 					// `recordId` parameter — the exact same value already used a
                 					// few lines up to fetch `rec` via
                 					// Create_Case[ID == recordId.trim().toLong()], so this is
                 					// guaranteed to identify the correct ticket. Purely additive:
                 					// a second entry in the same meta_data list, Case_ID's own
                 					// entry above is untouched, and nothing else in this payload
                 					// changes. .trim() applied here too (same defensive
                 					// convention as that lookup line above) — keeps a stray
                 					// leading/trailing space out of the value actually sent to
                 					// Zoho Payments; cosmetic only here, since this value is
                 					// never parsed back into a number the way the .toLong()
                 					// lookup above needs to be.
                 					recordIdMetaEntry = Map();
                 					recordIdMetaEntry.put("key","recordId");
                 					recordIdMetaEntry.put("value",recordId.trim());
                 					metaList.add(recordIdMetaEntry);
                 					paymentLinkMap.put("meta_data",metaList);
                 					createPaymentLinkResp = invokeurl
                 					[
                 						url :zoho_payments_base_url + "/paymentlinks?account_id=" + zoho_payments_account_id
                 						type :POST
                 						parameters:paymentLinkMap.toString()
                 						headers:{"Content-Type":"application/json","Authorization":"Zoho-oauthtoken " + access_token}
                 					];
                 					info "generateZohoPaymentLink — payment link raw response: " + createPaymentLinkResp.toString();
                 					paymentLinkRespCode = createPaymentLinkResp.get("code");
                 					if(paymentLinkRespCode != 0)
                 					{
                 						errMsg = createPaymentLinkResp.get("message");
                 						result.put("code","ERROR");
                 						result.put("message","Zoho Payments error: " + errMsg);
                 						returnstring = result.toString();
                 					}
                 					else
                 					{
                 						paymentLinksRec = createPaymentLinkResp.get("payment_links");
                 						paymentUrl = "";
                 						paymentLinkId = "";
                 						if(paymentLinksRec != null)
                 						{
                 							if(paymentLinksRec.get("url") != null)
                 							{
                 								paymentUrl = paymentLinksRec.get("url").toString();
                 							}
                 							if(paymentLinksRec.get("payment_link_id") != null)
                 							{
                 								paymentLinkId = paymentLinksRec.get("payment_link_id").toString();
                 							}
                 						}
                 						if(paymentUrl == "")
                 						{
                 							result.put("code","ERROR");
                 							result.put("message","Zoho Payments returned no payment_links.url — see this Custom API's own execution log for the raw response");
                 							returnstring = result.toString();
                 						}
                 						else
                 						{
                 							// Real bug fixed 2026-09-10, live: "'updateRec' has
                 							// no matching records. Unable to update the value
                 							// updateRec.Zoho_Payment_URL." — this used to
                 							// re-fetch the SAME record a second time right
                 							// here (Create_Case[ID == recordId.toLong()]) even
                 							// though `rec` above (the null-check fetch) is the
                 							// exact same record, already confirmed to exist.
                 							// Comparing every write in this project: the ones
                 							// that work (createServiceRequest.deluge/
                 							// CreateServiceTicket.deluge) only ever fetch a
                 							// record ONCE, immediately before the write; the
                 							// ones that failed this exact way
                 							// (submitCustomerLocation.deluge's own earlier,
                 							// still-unresolved "no matching records" bug, and
                 							// this one) all fetched the SAME record TWICE —
                 							// once to check it exists, then again for the
                 							// write. Fixed by writing directly onto `rec`
                 							// instead of re-fetching — no second query at all.
                 							// Dynamic field NAME picked via if/else on a
                 							// literal value, not a runtime bracket-lookup
                 							// (e.g. rec[fieldToWrite]) — Deluge field
                 							// assignment needs a literal field name at each
                 							// call site; no confirmed-safe dynamic-field-name
                 							// pattern exists anywhere else in this codebase.
                 							if(paymentUrlField == "Zoho_Payment_URL_Remaining")
                 							{
                 								rec.Zoho_Payment_URL_Remaining=paymentUrl;
                 							}
                 							else
                 							{
                 								rec.Zoho_Payment_URL=paymentUrl;
                 							}
                 							result.put("code","SUCCESS");
                 							result.put("message","Payment link generated");
                 							result.put("url",paymentUrl);
                 							result.put("payment_link_id",paymentLinkId);
                 							returnstring = result.toString();
                 						}
                 					}
                 				}
                 			}
                 		}
                 	}	catch (e)
                 	{
                 		errResult = Map();
                 		errResult.put("code","ERROR");
                 		errResult.put("message",e.toString());
                 		returnstring = errResult.toString();
                 	}
                 	return returnstring;
                 }
				 string getCallbackStatus(string data, string ucid, string callbackId)
                 {
                 	try 
                 	{
                 		ZC_CLIENT_ID = "1000.7BYOUWK2Q2XMJQWU62E6WHCRZOY9VW";
                 		ZC_CLIENT_SECRET = "a714fc6ab6c76d058196ceef8b49cad735422987fd";
                 		ZC_REFRESH_TOKEN = "1000.4de5086eb114fdcfef03ea973af4328e.a3846f28e4c7a981e9950189893e7adb";
                 		ZC_CALLLOG_URL_BASE = "https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/report/Call_Log_Report/";
                 		ZC_CALLLOG_FORM_URL = "https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/form/Call_Log";
                 		info "========== OZONETEL CALLBACK RECEIVED ==========";
                 		info "  Time       : " + zoho.currenttime;
                 		info "  ucid param = [" + ifnull(ucid,"(null)") + "]";
                 		info "  callbackId = [" + ifnull(callbackId,"(null)") + "]";
                 		payloadText = ifnull(data,"");
                 		payloadLength = payloadText.length();
                 		info "  data length = " + payloadLength;
                 		shownText = payloadText;
                 		if(payloadLength > 2000)
                 		{
                 			shownText = payloadText.subText(0,2000);
                 		}
                 		info "  data = " + shownText;
                 		if(payloadText.trim() == "")
                 		{
                 			if(ifnull(ucid,"").trim() == "")
                 			{
                 				if(ifnull(callbackId,"").trim() == "")
                 				{
                 					info "  NOTHING BOUND - no data, ucid or callbackId arrived. Register 'data' in this Custom API's setup screen and confirm the campaign URL to push is configured. Nothing updated.";
                 					return "{\"code\": \"SUCCESS\", \"result\": \"NOTHING_BOUND\", \"updated\": false, \"message\": \"No data, ucid or callbackId reached this script. Check that 'data' is registered on the Custom API setup screen and that the campaign's URL to Push is configured.\"}";
                 				}
                 			}
                 		}
                 		wantedKeys = List();
                 		wantedKeys.add("monitorUCID");
                 		wantedKeys.add("UCID");
                 		wantedKeys.add("Type");
                 		wantedKeys.add("CallerID");
                 		wantedKeys.add("StartTime");
                 		wantedKeys.add("TimeToAnswer");
                 		wantedKeys.add("EndTime");
                 		wantedKeys.add("CallDuration");
                 		wantedKeys.add("Duration");
                 		wantedKeys.add("AgentName");
                 		wantedKeys.add("DialStatus");
                 		wantedKeys.add("HangupBy");
                 		wantedKeys.add("AudioFile");
                 		wantedKeys.add("CallerConfAudioFile");
                 		wantedKeys.add("ConfDuration");
                 		wantedKeys.add("TransferredTo");
                 		wantedKeys.add("CallFlow");
                 		wantedKeys.add("Call_Flow");
                 		wantedKeys.add("CallFlowDetails");
                 		wantedKeys.add("Status");
                 		wantedKeys.add("Disposition");
                 		extracted = Map();
                 		for each  wantedKey in wantedKeys
                 		{
                 			valueFound = "";
                 			keyVariants = List();
                 			keyVariants.add("\"" + wantedKey + "\"");
                 			keyVariants.add("'" + wantedKey + "'");
                 			keyVariants.add(wantedKey);
                 			for each  keyVariant in keyVariants
                 			{
                 				if(valueFound == "")
                 				{
                 					keyParts = payloadText.toList(keyVariant);
                 					if(keyParts.size() > 1)
                 					{
                 						afterKey = keyParts.get(1);
                 						commaParts = afterKey.toList(",");
                 						firstSeg = commaParts.get(0);
                 						sqTokens = firstSeg.toList("'");
                 						for each  sqTok in sqTokens
                 						{
                 							if(valueFound == "")
                 							{
                 								cand = sqTok.trim();
                 								if(cand != "")
                 								{
                 									if(cand != ":")
                 									{
                 										valueFound = cand;
                 									}
                 								}
                 							}
                 						}
                 						if(valueFound == "")
                 						{
                 							dqTokens = firstSeg.toList("\"");
                 							for each  dqTok in dqTokens
                 							{
                 								if(valueFound == "")
                 								{
                 									cand2 = dqTok.trim();
                 									if(cand2 != "")
                 									{
                 										if(cand2 != ":")
                 										{
                 											valueFound = cand2;
                 										}
                 									}
                 								}
                 							}
                 						}
                 					}
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				if(valueFound.subText(0,1) == ":")
                 				{
                 					valueFound = valueFound.subText(1).trim();
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				if(valueFound.subText(0,1) == "=")
                 				{
                 					valueFound = valueFound.subText(1).trim();
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				lastChar = valueFound.subText(valueFound.length() - 1);
                 				if(lastChar == "}")
                 				{
                 					valueFound = valueFound.subText(0,valueFound.length() - 1).trim();
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				lastChar2 = valueFound.subText(valueFound.length() - 1);
                 				if(lastChar2 == "]")
                 				{
                 					valueFound = valueFound.subText(0,valueFound.length() - 1).trim();
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				firstChar = valueFound.subText(0,1);
                 				if(firstChar == "\"")
                 				{
                 					valueFound = valueFound.subText(1).trim();
                 				}
                 				if(firstChar == "'")
                 				{
                 					valueFound = valueFound.subText(1).trim();
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				lastChar3 = valueFound.subText(valueFound.length() - 1);
                 				if(lastChar3 == "\"")
                 				{
                 					valueFound = valueFound.subText(0,valueFound.length() - 1).trim();
                 				}
                 				if(lastChar3 == "'")
                 				{
                 					valueFound = valueFound.subText(0,valueFound.length() - 1).trim();
                 				}
                 			}
                 			/* Repeat strip, added 2026-09-25 — user-reported live: UCID stored as
                 			   :"93361501267909269 across 55 Call_Log rows.
                 			
                 			   The passes above each run ONCE, in a fixed order: leading ":", leading "=",
                 			   trailing "}", trailing "]", leading quote, trailing quote. A value arriving
                 			   with two junk characters at the front loses the colon on the first pass, but
                 			   the quote pass has already been reached by then and never runs again, so the
                 			   remaining quote is stored. Order-dependence was the whole bug.
                 			
                 			   This repeats the strip until nothing junk is left at either end, six passes
                 			   being far more than any real payload needs. Deluge has no while loop (it is a
                 			   compile error, confirmed live), hence the fixed pass list.
                 			
                 			   Purely additive: it runs AFTER the existing chain, so a value that chain
                 			   already cleaned begins with a digit or a letter, matches nothing here, and is
                 			   left exactly as it is today. No real value in this payload — a UCID, a
                 			   timestamp, an agent name, a recording URL — legitimately starts or ends with
                 			   any of these characters. */
                 			dqCh = "\"";
                 			bsCh = "\\";
                 			leadJunk = ":=," + dqCh + "'" + bsCh + " ";
                 			trailJunk = "}]," + dqCh + "'" + bsCh + " ";
                 			stripPasses = List();
                 			stripPasses.add(1);
                 			stripPasses.add(2);
                 			stripPasses.add(3);
                 			stripPasses.add(4);
                 			stripPasses.add(5);
                 			stripPasses.add(6);
                 			for each  stripPass in stripPasses
                 			{
                 				if(valueFound != "")
                 				{
                 					leadCh = valueFound.subText(0,1);
                 					if(leadJunk.contains(leadCh))
                 					{
                 						valueFound = valueFound.subText(1).trim();
                 					}
                 				}
                 				if(valueFound != "")
                 				{
                 					tailCh = valueFound.subText(valueFound.length() - 1);
                 					if(trailJunk.contains(tailCh))
                 					{
                 						valueFound = valueFound.subText(0,valueFound.length() - 1).trim();
                 					}
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				extracted.put(wantedKey,valueFound);
                 			}
                 		}
                 		info "  extracted (" + extracted.size() + " of " + wantedKeys.size() + " keys) = " + extracted.toString();
                 		vMonitorUcid = ifnull(extracted.get("monitorUCID"),"").toString().trim();
                 		vUcid = ifnull(extracted.get("UCID"),"").toString().trim();
                 		vType = ifnull(extracted.get("Type"),"").toString().trim();
                 		vCallerId = ifnull(extracted.get("CallerID"),"").toString().trim();
                 		vStartTime = ifnull(extracted.get("StartTime"),"").toString().trim();
                 		vTimeToAnswer = ifnull(extracted.get("TimeToAnswer"),"").toString().trim();
                 		vEndTime = ifnull(extracted.get("EndTime"),"").toString().trim();
                 		vCallDuration = ifnull(extracted.get("CallDuration"),"").toString().trim();
                 		vDuration = ifnull(extracted.get("Duration"),"").toString().trim();
                 		vAgentName = ifnull(extracted.get("AgentName"),"").toString().trim();
                 		vDialStatus = ifnull(extracted.get("DialStatus"),"").toString().trim();
                 		vHangupBy = ifnull(extracted.get("HangupBy"),"").toString().trim();
                 		vAudioFile = ifnull(extracted.get("AudioFile"),"").toString().trim();
                 		vConfAudioFile = ifnull(extracted.get("CallerConfAudioFile"),"").toString().trim();
                 		vConfDuration = ifnull(extracted.get("ConfDuration"),"").toString().trim();
                 		vTransferredTo = ifnull(extracted.get("TransferredTo"),"").toString().trim();
                 		vCallFlow = ifnull(extracted.get("CallFlow"),"").toString().trim();
                 		if(vCallFlow == "")
                 		{
                 			vCallFlow = ifnull(extracted.get("Call_Flow"),"").toString().trim();
                 		}
                 		if(vCallFlow == "")
                 		{
                 			vCallFlow = ifnull(extracted.get("CallFlowDetails"),"").toString().trim();
                 		}
                 		vStatus = ifnull(extracted.get("Status"),"").toString().trim();
                 		vDisposition = ifnull(extracted.get("Disposition"),"").toString().trim();
                 		clockFields = List();
                 		clockFields.add(vCallDuration);
                 		clockFields.add(vDuration);
                 		clockFields.add(vTimeToAnswer);
                 		clockFields.add(vConfDuration);
                 		clockSeconds = List();
                 		for each  clockText in clockFields
                 		{
                 			convertedText = clockText;
                 			if(clockText.contains(":"))
                 			{
                 				clockParts = clockText.toList(":");
                 				if(clockParts.size() == 3)
                 				{
                 					hourPart = clockParts.get(0).trim().toLong();
                 					minutePart = clockParts.get(1).trim().toLong();
                 					secondPart = clockParts.get(2).trim().toLong();
                 					totalSeconds = hourPart * 3600 + minutePart * 60 + secondPart;
                 					convertedText = totalSeconds.toString();
                 				}
                 			}
                 			clockSeconds.add(convertedText);
                 		}
                 		vCallDuration = clockSeconds.get(0);
                 		vDuration = clockSeconds.get(1);
                 		vTimeToAnswer = clockSeconds.get(2);
                 		vConfDuration = clockSeconds.get(3);
                 		info "  durations normalised to seconds - talk=[" + vCallDuration + "] total=[" + vDuration + "] answerIn=[" + vTimeToAnswer + "] conf=[" + vConfDuration + "]";
                 		vTypeLower = vType.toLowerCase();
                 		if(vTypeLower != "")
                 		{
                 			vType = "Outbound";
                 		}
                 		if(vTypeLower.contains("inbound"))
                 		{
                 			vType = "Inbound";
                 		}
                 		info "  call direction resolved to [" + vType + "]";
                 		resolvedUcid = vUcid;
                 		if(resolvedUcid == "")
                 		{
                 			resolvedUcid = vMonitorUcid;
                 		}
                 		if(resolvedUcid == "")
                 		{
                 			resolvedUcid = ifnull(ucid,"").trim();
                 		}
                 		if(resolvedUcid == "")
                 		{
                 			resolvedUcid = ifnull(callbackId,"").trim();
                 		}
                 		info "  resolvedUcid = [" + resolvedUcid + "]";
                 		resolvedPhone = vCallerId;
                 		if(resolvedPhone.length() > 10)
                 		{
                 			resolvedPhone = resolvedPhone.subText(resolvedPhone.length() - 10);
                 		}
                 		info "  resolvedPhone (last 10) = [" + resolvedPhone + "]";
                 		tokenResp = invokeurl
                 		[
                 			url :"https://accounts.zoho.in/oauth/v2/token?refresh_token=" + ZC_REFRESH_TOKEN + "&client_id=" + ZC_CLIENT_ID + "&client_secret=" + ZC_CLIENT_SECRET + "&grant_type=refresh_token"
                 			type :POST
                 		];
                 		zcAccessToken = tokenResp.get("access_token");
                 		if(zcAccessToken == null)
                 		{
                 			info "  TOKEN FAILED - no access_token returned. Raw response: " + tokenResp.toString();
                 			return "{\"code\": \"SUCCESS\", \"result\": \"TOKEN_FAILED\", \"updated\": false, \"message\": \"Could not get an access token from the refresh token, so nothing was written. See this Custom API execution log for the raw response.\"}";
                 		}
                 		// Set when the row was found under an id OTHER than the one this callback
                 		// calls the UCID - 2026-10-10. Recorded in the history line below so the
                 		// screen-pop's original id is not simply overwritten and lost.
                 		matchedByAlt = "";
                 		// The id a still-pending row was carrying when this callback claimed it -
                 		// 2026-10-12. Recorded in the history line below, because the row's UCID
                 		// is about to be replaced with Ozonetel's own.
                 		claimedPendingUcid = "";
                 		logRecId = "";
                 		if(resolvedUcid != "")
                 		{
                 			for each  ucidRow in Call_Log[UCID == resolvedUcid]
                 			{
                 				if(logRecId == "")
                 				{
                 					logRecId = ucidRow.ID.toString();
                 					info "  Matched Call_Log " + logRecId + " by UCID.";
                 				}
                 			}
                 		}
                 		if(logRecId == "null")
                 		{
                 			logRecId = "";
                 		}
                 		/* ALTERNATE CALL IDS - 2026-10-10, the client's duplicate-record report.
                 		   Ozonetel hands the screen-pop one id and this callback another for the
                 		   same call. Before this, the mismatch produced a SECOND Call_Log row: the
                 		   exact match missed, and the phone fallback below only claims rows whose
                 		   UCID is blank - the pop's row has one, just not this one.
                 
                 		   Tries every id that actually arrived, skipping the one already tried.
                 		   When none of them matches anything the behaviour is exactly as before. */
                 		if(logRecId == "")
                 		{
                 			altUcids = List();
                 			if(vUcid != "")
                 			{
                 				altUcids.add(vUcid);
                 			}
                 			if(vMonitorUcid != "")
                 			{
                 				altUcids.add(vMonitorUcid);
                 			}
                 			paramUcid = ifnull(ucid,"").trim();
                 			if(paramUcid != "")
                 			{
                 				altUcids.add(paramUcid);
                 			}
                 			paramCallbackId = ifnull(callbackId,"").trim();
                 			if(paramCallbackId != "")
                 			{
                 				altUcids.add(paramCallbackId);
                 			}
                 			for each  altUcid in altUcids
                 			{
                 				if(logRecId == "")
                 				{
                 					if(altUcid != resolvedUcid)
                 					{
                 						for each  altRow in Call_Log[UCID == altUcid]
                 						{
                 							if(logRecId == "")
                 							{
                 								logRecId = altRow.ID.toString();
                 								matchedByAlt = altUcid;
                 								info "  Matched Call_Log " + logRecId + " by the ALTERNATE id [" + altUcid + "] rather than [" + resolvedUcid + "]. This is the screen-pop's own row - the pop stored whichever id Ozonetel put in the ScreenPop URL, and this callback calls the same call something else. The row is completed in place, which is what stops a second one being created.";
                 							}
                 						}
                 					}
                 				}
                 			}
                 			if(logRecId == "null")
                 			{
                 				logRecId = "";
                 			}
                 		}
                 		/* STILL-PENDING ROW FOR THIS NUMBER - 2026-10-12, the client's own
                 		   "UCID and Call_status" suggestion. See this change's note for the full
                 		   reasoning; in short, RINGING / Incoming / Placed are words only a
                 		   row-creator writes and no callback ever writes, so a row still carrying
                 		   one is waiting for exactly this callback - whatever id it holds.
                 
                 		   This is what resolves the duplicate WITHOUT knowing which id the
                 		   screen-pop stored. The alternate-id pass above stays because it is the
                 		   more precise of the two and runs first.
                 
                 		   Only the NEWEST row for the number is eligible, so a RINGING row left
                 		   over from an earlier call whose callback never arrived is passed over
                 		   instead of being overwritten by an unrelated call. */
                 		if(logRecId == "")
                 		{
                 			if(resolvedPhone != "")
                 			{
                 				pendingStatuses = "|RINGING|INCOMING|PLACED|";
                 				newestId = 0;
                 				newestIdText = "";
                 				newestStatus = "";
                 				newestUcid = "";
                 				for each  phoneRow in Call_Log[Phone_Number == resolvedPhone]
                 				{
                 					rowId = phoneRow.ID;
                 					if(rowId > newestId)
                 					{
                 						newestId = rowId;
                 						newestIdText = phoneRow.ID.toString();
                 						// Two methods off ifnull, then two off a plain variable - the
                 						// shapes this codebase has proven Deluge accepts.
                 						rowStatusText = ifnull(phoneRow.Call_Status,"").toString();
                 						newestStatus = rowStatusText.trim().toUpperCase();
                 						newestUcid = ifnull(phoneRow.UCID,"").toString().trim();
                 					}
                 				}
                 				if(newestId > 0)
                 				{
                 					// Wrapped in pipes so a status cannot match inside a longer one.
                 					pendingKey = "|" + newestStatus + "|";
                 					if(pendingStatuses.contains(pendingKey))
                 					{
                 						logRecId = newestIdText;
                 						claimedPendingUcid = newestUcid;
                 						info "  Matched Call_Log " + logRecId + " as the newest STILL-PENDING row for " + resolvedPhone + " (Call_Status was [" + newestStatus + "], id on it was [" + newestUcid + "]). No callback had completed it, so this is the row this call belongs to and it is completed in place rather than a second one being created.";
                 					}
                 					else
                 					{
                 						info "  Newest row for " + resolvedPhone + " is Call_Log " + newestIdText + " with Call_Status [" + newestStatus + "], which is not a pending status - leaving it alone and trying the remaining rules.";
                 					}
                 				}
                 			}
                 		}
                 		if(logRecId == "")
                 		{
                 			if(resolvedPhone != "")
                 			{
                 				bestId = 0;
                 				bestIdText = "";
                 				for each  pendingRow in Call_Log[Phone_Number == resolvedPhone]
                 				{
                 					existingUcid = ifnull(pendingRow.UCID,"").toString().trim();
                 					if(existingUcid == "")
                 					{
                 						thisId = pendingRow.ID;
                 						if(thisId > bestId)
                 						{
                 							bestId = thisId;
                 							bestIdText = pendingRow.ID.toString();
                 						}
                 					}
                 				}
                 				if(bestId > 0)
                 				{
                 					logRecId = bestIdText;
                 					numericIdText = bestId.toString();
                 					info "  Matched Call_Log " + logRecId + " by phone number (newest row for this number that has no UCID yet).";
                 					info "  Record id as text = [" + bestIdText + "] | same id after passing through a NUMBER variable = [" + numericIdText + "]. If these two differ, Deluge lost precision on the 18-digit id and the text one is the real record.";
                 				}
                 			}
                 		}
                 		createdNewRow = false;
                 		if(logRecId == "")
                 		{
                 			info "  No existing Call_Log row matched. Creating one - every call must be logged whether it was placed from this app, from the Ozonetel iframe, or came in as an inbound call.";
                 			matchedTicketId = 0;
                 			if(resolvedPhone != "")
                 			{
                 				phoneVariants = List();
                 				phoneVariants.add(resolvedPhone);
                 				phoneVariants.add("+91" + resolvedPhone);
                 				phoneVariants.add("91" + resolvedPhone);
                 				phoneVariants.add("0" + resolvedPhone);
                 				for each  phoneVariant in phoneVariants
                 				{
                 					if(matchedTicketId == 0)
                 					{
                 						for each  ticketRow in Create_Case[Phone_Number1 == phoneVariant]
                 						{
                 							if(ticketRow.ID > matchedTicketId)
                 							{
                 								matchedTicketId = ticketRow.ID;
                 							}
                 						}
                 					}
                 				}
                 				if(matchedTicketId == 0)
                 				{
                 					for each  phoneVariant2 in phoneVariants
                 					{
                 						if(matchedTicketId == 0)
                 						{
                 							for each  ticketRow2 in Create_Case[Phone_Number == phoneVariant2]
                 							{
                 								if(ticketRow2.ID > matchedTicketId)
                 								{
                 									matchedTicketId = ticketRow2.ID;
                 								}
                 							}
                 						}
                 					}
                 				}
                 			}
                 			if(matchedTicketId > 0)
                 			{
                 				info "  Caller's newest ticket with this number is " + matchedTicketId + " - logged for diagnosis only, NOT linked. The RSID is attached when the agent creates the case or saves the assignment.";
                 			}
                 			else
                 			{
                 				info "  No ticket carries this phone number. The row is created unlinked either way - the RSID is attached at step 2.";
                 			}
                 			createMap = Map();
                 			createMap.put("Phone_Number",resolvedPhone);
                 			if(resolvedUcid != "")
                 			{
                 				createMap.put("UCID",resolvedUcid);
                 			}
                 			if(vType != "")
                 			{
                 				createMap.put("Call_Direction",vType);
                 			}
                 			// DELIBERATELY NOT LINKED - 2026-10-09. The RSID is attached at step 2,
                 			// when the agent creates the case or saves the assignment. Guessing it
                 			// from the phone number here attached calls to old cases and blocked the
                 			// real link. See this change's own note.
                 			createBody = Map();
                 			createBody.put("data",createMap);
                 			createResp = invokeurl
                 			[
                 				url :ZC_CALLLOG_FORM_URL
                 				type :POST
                 				parameters:createBody.toString()
                 				headers:{"Content-Type":"application/json","Authorization":"Bearer " + zcAccessToken}
                 			];
                 			info "  CREATE Call_Log response: " + createResp.toString();
                 			newRowId = "";
                 			if(createResp.get("code") == 3000)
                 			{
                 				createdData = createResp.get("data");
                 				if(createdData != null)
                 				{
                 					if(createdData.get("ID") != null)
                 					{
                 						newRowId = createdData.get("ID").toString();
                 					}
                 				}
                 			}
                 			if(newRowId == "")
                 			{
                 				info "  CREATE FAILED - could not add a Call_Log row for this call. Nothing recorded.";
                 				createDiag = "url=" + ZC_CALLLOG_FORM_URL + " || sent=" + createBody.toString() + " || reply=" + createResp.toString();
                 				if(createDiag.length() > 700)
                 				{
                 					createDiag = createDiag.subText(0,700);
                 				}
                 				createDiagSafe = createDiag.replaceAll("\"","'");
                 				return "{\"code\": \"SUCCESS\", \"result\": \"CREATE_FAILED\", \"updated\": false, \"ucid\": \"" + resolvedUcid + "\", \"phone\": \"" + resolvedPhone + "\", \"create_response\": \"" + createDiagSafe + "\", \"message\": \"No Call_Log row matched this callback and creating one failed. The create_response field above carries the exact URL, the payload sent, and Zoho's raw reply.\"}";
                 			}
                 			logRecId = newRowId;
                 			createdNewRow = true;
                 			info "  Created Call_Log " + logRecId + " for this call.";
                 		}
                 		statusText = vDialStatus;
                 		if(statusText == "")
                 		{
                 			statusText = vStatus;
                 		}
                 		outcomeText = vDisposition;
                 		if(outcomeText == "")
                 		{
                 			if(vHangupBy != "")
                 			{
                 				outcomeText = "Hangup by " + vHangupBy;
                 			}
                 		}
                 		coreFieldMap = Map();
                 		fullFieldMap = Map();
                 		if(resolvedUcid != "")
                 		{
                 			coreFieldMap.put("UCID",resolvedUcid);
                 			fullFieldMap.put("UCID",resolvedUcid);
                 		}
                 		if(statusText != "")
                 		{
                 			coreFieldMap.put("Call_Status",statusText);
                 			fullFieldMap.put("Call_Status",statusText);
                 		}
                 		if(vCallDuration != "")
                 		{
                 			coreFieldMap.put("Call_Duration",vCallDuration);
                 			fullFieldMap.put("Call_Duration",vCallDuration);
                 		}
                 		if(outcomeText != "")
                 		{
                 			coreFieldMap.put("Call_Outcome",outcomeText);
                 			fullFieldMap.put("Call_Outcome",outcomeText);
                 		}
                 		if(vType != "")
                 		{
                 			coreFieldMap.put("Call_Direction",vType);
                 			fullFieldMap.put("Call_Direction",vType);
                 		}
                 		extraFieldMap = Map();
                 		if(vStartTime != "")
                 		{
                 			extraFieldMap.put("Call_Start_Time",vStartTime);
                 			fullFieldMap.put("Call_Start_Time",vStartTime);
                 		}
                 		if(vEndTime != "")
                 		{
                 			extraFieldMap.put("Call_End_Time",vEndTime);
                 			fullFieldMap.put("Call_End_Time",vEndTime);
                 		}
                 		if(vTimeToAnswer != "")
                 		{
                 			extraFieldMap.put("Time_To_Answer",vTimeToAnswer);
                 			fullFieldMap.put("Time_To_Answer",vTimeToAnswer);
                 		}
                 		if(vDuration != "")
                 		{
                 			extraFieldMap.put("Total_Duration",vDuration);
                 			fullFieldMap.put("Total_Duration",vDuration);
                 		}
                 		if(vAgentName != "")
                 		{
                 			extraFieldMap.put("Agent_Name",vAgentName);
                 			fullFieldMap.put("Agent_Name",vAgentName);
                 		}
                 		if(vAudioFile != "")
                 		{
                 			extraFieldMap.put("Audio_File_URL",vAudioFile);
                 			fullFieldMap.put("Audio_File_URL",vAudioFile);
                 		}
                 		if(vConfAudioFile != "")
                 		{
                 			extraFieldMap.put("Conference_Audio_URL",vConfAudioFile);
                 			fullFieldMap.put("Conference_Audio_URL",vConfAudioFile);
                 		}
                 		if(vConfDuration != "")
                 		{
                 			extraFieldMap.put("Conference_Duration",vConfDuration);
                 			fullFieldMap.put("Conference_Duration",vConfDuration);
                 		}
                 		if(vTransferredTo != "")
                 		{
                 			extraFieldMap.put("Transferred_To",vTransferredTo);
                 			fullFieldMap.put("Transferred_To",vTransferredTo);
                 		}
                 		if(vCallFlow != "")
                 		{
                 			extraFieldMap.put("Call_Flow",vCallFlow);
                 			fullFieldMap.put("Call_Flow",vCallFlow);
                 		}
                 		existingHistory = "";
                 		try 
                 		{
                 			readBackResp = invokeurl
                 			[
                 				url :ZC_CALLLOG_URL_BASE + logRecId
                 				type :GET
                 				headers:{"Authorization":"Bearer " + zcAccessToken}
                 			];
                 			if(readBackResp.get("code") == 3000)
                 			{
                 				readBackData = readBackResp.get("data");
                 				if(readBackData != null)
                 				{
                 					if(readBackData.get("Call_Callback_History") != null)
                 					{
                 						existingHistory = readBackData.get("Call_Callback_History").toString();
                 					}
                 				}
                 			}
                 			else
                 			{
                 				info "  Could not read back Call_Log " + logRecId + " for its existing history (non-fatal, this callback will simply start a fresh history): " + readBackResp.toString();
                 			}
                 		}		catch (readBackEx)
                 		{
                 			info "  Read-back of the existing history threw (non-fatal): " + readBackEx.toString();
                 		}
                 		historyLine = "--- " + zoho.currenttime.toString("dd-MMM-yyyy hh:mm:ss a") + " ---";
                 		if(resolvedUcid != "")
                 		{
                 			historyLine = historyLine + "\nUCID: " + resolvedUcid;
                 		}
                 		if(vType != "")
                 		{
                 			historyLine = historyLine + "\nType: " + vType;
                 		}
                 		if(vCallerId != "")
                 		{
                 			historyLine = historyLine + "\nCallerID: " + vCallerId;
                 		}
                 		if(vAgentName != "")
                 		{
                 			historyLine = historyLine + "\nAgentName: " + vAgentName;
                 		}
                 		if(vStartTime != "")
                 		{
                 			historyLine = historyLine + "\nStartTime: " + vStartTime;
                 		}
                 		if(vTimeToAnswer != "")
                 		{
                 			historyLine = historyLine + "\nTimeToAnswer: " + vTimeToAnswer;
                 		}
                 		if(vEndTime != "")
                 		{
                 			historyLine = historyLine + "\nEndTime: " + vEndTime;
                 		}
                 		if(vCallDuration != "")
                 		{
                 			historyLine = historyLine + "\nCallDuration (talk): " + vCallDuration;
                 		}
                 		if(vDuration != "")
                 		{
                 			historyLine = historyLine + "\nDuration (total): " + vDuration;
                 		}
                 		if(statusText != "")
                 		{
                 			historyLine = historyLine + "\nDialStatus: " + statusText;
                 		}
                 		if(vHangupBy != "")
                 		{
                 			historyLine = historyLine + "\nHangupBy: " + vHangupBy;
                 		}
                 		if(vTransferredTo != "")
                 		{
                 			historyLine = historyLine + "\nTransferredTo: " + vTransferredTo;
                 		}
                 		if(vConfDuration != "")
                 		{
                 			historyLine = historyLine + "\nConfDuration: " + vConfDuration;
                 		}
                 		if(vAudioFile != "")
                 		{
                 			historyLine = historyLine + "\nAudioFile: " + vAudioFile;
                 		}
                 		if(vConfAudioFile != "")
                 		{
                 			historyLine = historyLine + "\nCallerConfAudioFile: " + vConfAudioFile;
                 		}
                 		if(vCallFlow != "")
                 		{
                 			historyLine = historyLine + "\nCall Flow: " + vCallFlow;
                 		}
                 		if(matchedByAlt != "")
                 		{
                 			historyLine = historyLine + "\nMatched this row by its screen-pop id: " + matchedByAlt;
                 		}
                 		if(claimedPendingUcid != "")
                 		{
                 			historyLine = historyLine + "\nClaimed a still-pending row whose id was: " + claimedPendingUcid;
                 		}
                 		if(existingHistory.trim() == "")
                 		{
                 			extraFieldMap.put("Call_Callback_History",historyLine);
                 			fullFieldMap.put("Call_Callback_History",historyLine);
                 		}
                 		else
                 		{
                 			appendedHistory = existingHistory + "\n\n" + historyLine;
                 			extraFieldMap.put("Call_Callback_History",appendedHistory);
                 			fullFieldMap.put("Call_Callback_History",appendedHistory);
                 		}
                 		if(fullFieldMap.size() == 0)
                 		{
                 			info "  Callback carried nothing usable, so there is nothing to write onto Call_Log " + logRecId + ".";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NOTHING_TO_WRITE\", \"updated\": false, \"recordId\": \"" + logRecId + "\", \"message\": \"A Call_Log row was matched but the callback carried no readable values, so nothing was written.\"}";
                 		}
                 		info "  Fields to write on Call_Log " + logRecId + " (" + fullFieldMap.size() + " total, " + coreFieldMap.size() + " core + " + extraFieldMap.size() + " extended): " + fullFieldMap.toString();
                 		rowMode = "existing";
                 		if(createdNewRow)
                 		{
                 			rowMode = "created";
                 		}
                 		writtenMode = "none";
                 		patchBody = Map();
                 		patchBody.put("data",fullFieldMap);
                 		patchDiag = "";
                 		patchResp = invokeurl
                 		[
                 			url :ZC_CALLLOG_URL_BASE + logRecId
                 			type :PATCH
                 			parameters:patchBody.toString()
                 			headers:{"Content-Type":"application/json","Authorization":"Bearer " + zcAccessToken}
                 		];
                 		info "  PATCH (full) response: " + patchResp.toString();
                 		patchDiag = "url=" + ZC_CALLLOG_URL_BASE + logRecId + " || full=" + patchResp.toString();
                 		if(patchResp.get("code") == 3000)
                 		{
                 			writtenMode = "full";
                 			info "  WRITE OK - Call_Log " + logRecId + " updated with all " + fullFieldMap.size() + " fields, history appended.";
                 		}
                 		else
                 		{
                 			if(patchResp.get("code") == 1000)
                 			{
                 				info "  FULL WRITE REFUSED with code 1000 (Invalid API URL format). This is NOT a missing-field problem - the record id in the PATCH URL is empty or not a number, so no Call_Log row was actually addressed. The id used was [" + logRecId + "]. Check the row-matching log lines above.";
                 			}
                 			else
                 			{
                 				info "  FULL WRITE REFUSED - most likely one of the new Call_Log fields does not exist yet. Retrying with the core fields only. Create these on Call_Log to capture everything: Call_Start_Time, Call_End_Time, Time_To_Answer, Total_Duration, Agent_Name, Audio_File_URL, Conference_Audio_URL, Conference_Duration, Transferred_To, Call_Flow, Call_Callback_History.";
                 			}
                 			if(coreFieldMap.size() > 0)
                 			{
                 				coreBody = Map();
                 				coreBody.put("data",coreFieldMap);
                 				coreResp = invokeurl
                 				[
                 					url :ZC_CALLLOG_URL_BASE + logRecId
                 					type :PATCH
                 					parameters:coreBody.toString()
                 					headers:{"Content-Type":"application/json","Authorization":"Bearer " + zcAccessToken}
                 				];
                 				info "  PATCH (core only) response: " + coreResp.toString();
                 				patchDiag = patchDiag + " || core=" + coreResp.toString();
                 				if(coreResp.get("code") == 3000)
                 				{
                 					writtenMode = "core";
                 					info "  WRITE OK (core fields only) - Call_Log " + logRecId + " updated. The extended fields were skipped.";
                 				}
                 				else
                 				{
                 					info "  WRITE FAILED on both attempts - " + coreResp.get("message");
                 				}
                 			}
                 		}
                 		info "===============================================";
                 		if(writtenMode == "none")
                 		{
                 			probeResp = invokeurl
                 			[
                 				url :"https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/report/Call_Log_Report?max_records=200"
                 				type :GET
                 				headers:{"Authorization":"Bearer " + zcAccessToken}
                 			];
                 			probeText = probeResp.toString();
                 			if(probeText.length() > 300)
                 			{
                 				probeText = probeText.subText(0,300);
                 			}
                 			info "  PROBE - plain list GET on Call_Log_Report: " + probeText;
                 			patchDiag = patchDiag + " || report_list_probe=" + probeText;
                 			patchDiagSafe = patchDiag.replaceAll("\"","'");
                 			return "{\"code\": \"SUCCESS\", \"result\": \"WRITE_FAILED\", \"updated\": false, \"recordId\": \"" + logRecId + "\", \"patch_responses\": \"" + patchDiagSafe + "\", \"message\": \"A Call_Log row was matched and the callback was parsed, but both the full and the core write were refused. The patch_responses field above carries the raw PATCH replies and the exact URL used.\"}";
                 		}
                 		return "{\"code\": \"SUCCESS\", \"result\": \"UPDATED\", \"updated\": true, \"row\": \"" + rowMode + "\", \"written\": \"" + writtenMode + "\", \"recordId\": \"" + logRecId + "\", \"fields_written\": " + fullFieldMap.size() + ", \"keys_extracted\": " + extracted.size() + ", \"ucid\": \"" + resolvedUcid + "\", \"type\": \"" + vType + "\", \"caller_id\": \"" + vCallerId + "\", \"agent\": \"" + vAgentName + "\", \"start_time\": \"" + vStartTime + "\", \"end_time\": \"" + vEndTime + "\", \"time_to_answer\": \"" + vTimeToAnswer + "\", \"talk_time\": \"" + vCallDuration + "\", \"total_duration\": \"" + vDuration + "\", \"dial_status\": \"" + statusText + "\", \"hangup_by\": \"" + vHangupBy + "\", \"transferred_to\": \"" + vTransferredTo + "\", \"conf_duration\": \"" + vConfDuration + "\", \"audio_file\": \"" + vAudioFile + "\", \"conf_audio_file\": \"" + vConfAudioFile + "\", \"call_flow\": \"" + vCallFlow + "\", \"message\": \"Call_Log " + logRecId + " updated from the Ozonetel callback and one timestamped entry appended to its history.\"}";
                 	}	catch (e)
                 	{
                 		info "getCallbackStatus threw (nothing was updated by this call): " + e.toString();
                 		return "{\"code\": \"SUCCESS\", \"result\": \"EXCEPTION\", \"updated\": false, \"exception\": \"" + e.toString() + "\", \"message\": \"The script threw an error and nothing was updated. The exception text is in the exception field above and in this Custom API execution log.\"}";
                 	}
                 	return "{\"code\": \"SUCCESS\", \"result\": \"NO_RESULT\", \"updated\": false, \"message\": \"The script finished without reaching any known outcome. This should not happen - send the execution log over.\"}";
                 }
				 string getCallbackStatusGet(string data, string ucid, string callbackId)
                 {
                 	try 
                 	{
                 		ZC_CLIENT_ID = "1000.7BYOUWK2Q2XMJQWU62E6WHCRZOY9VW";
                 		ZC_CLIENT_SECRET = "a714fc6ab6c76d058196ceef8b49cad735422987fd";
                 		ZC_REFRESH_TOKEN = "1000.4de5086eb114fdcfef03ea973af4328e.a3846f28e4c7a981e9950189893e7adb";
                 		ZC_CALLLOG_URL_BASE = "https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/report/Call_Log_Report/";
                 		ZC_CALLLOG_FORM_URL = "https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/form/Call_Log";
                 		info "========== OZONETEL CALLBACK RECEIVED ==========";
                 		info "  Time       : " + zoho.currenttime;
                 		info "  ucid param = [" + ifnull(ucid,"(null)") + "]";
                 		info "  callbackId = [" + ifnull(callbackId,"(null)") + "]";
                 		payloadText = ifnull(data,"");
                 		payloadLength = payloadText.length();
                 		info "  data length = " + payloadLength;
                 		shownText = payloadText;
                 		if(payloadLength > 2000)
                 		{
                 			shownText = payloadText.subText(0,2000);
                 		}
                 		info "  data = " + shownText;
                 		if(payloadText.trim() == "")
                 		{
                 			if(ifnull(ucid,"").trim() == "")
                 			{
                 				if(ifnull(callbackId,"").trim() == "")
                 				{
                 					info "  NOTHING BOUND - no data, ucid or callbackId arrived. Register 'data' in this Custom API's setup screen and confirm the campaign URL to push is configured. Nothing updated.";
                 					return "{\"code\": \"SUCCESS\", \"result\": \"NOTHING_BOUND\", \"updated\": false, \"message\": \"No data, ucid or callbackId reached this script. Check that 'data' is registered on the Custom API setup screen and that the campaign's URL to Push is configured.\"}";
                 				}
                 			}
                 		}
                 		wantedKeys = List();
                 		wantedKeys.add("monitorUCID");
                 		wantedKeys.add("UCID");
                 		wantedKeys.add("Type");
                 		wantedKeys.add("CallerID");
                 		wantedKeys.add("StartTime");
                 		wantedKeys.add("TimeToAnswer");
                 		wantedKeys.add("EndTime");
                 		wantedKeys.add("CallDuration");
                 		wantedKeys.add("Duration");
                 		wantedKeys.add("AgentName");
                 		wantedKeys.add("DialStatus");
                 		wantedKeys.add("HangupBy");
                 		wantedKeys.add("AudioFile");
                 		wantedKeys.add("CallerConfAudioFile");
                 		wantedKeys.add("ConfDuration");
                 		wantedKeys.add("TransferredTo");
                 		wantedKeys.add("CallFlow");
                 		wantedKeys.add("Call_Flow");
                 		wantedKeys.add("CallFlowDetails");
                 		wantedKeys.add("Status");
                 		wantedKeys.add("Disposition");
                 		extracted = Map();
                 		for each  wantedKey in wantedKeys
                 		{
                 			valueFound = "";
                 			keyVariants = List();
                 			keyVariants.add("\"" + wantedKey + "\"");
                 			keyVariants.add("'" + wantedKey + "'");
                 			keyVariants.add(wantedKey);
                 			for each  keyVariant in keyVariants
                 			{
                 				if(valueFound == "")
                 				{
                 					keyParts = payloadText.toList(keyVariant);
                 					if(keyParts.size() > 1)
                 					{
                 						afterKey = keyParts.get(1);
                 						commaParts = afterKey.toList(",");
                 						firstSeg = commaParts.get(0);
                 						sqTokens = firstSeg.toList("'");
                 						for each  sqTok in sqTokens
                 						{
                 							if(valueFound == "")
                 							{
                 								cand = sqTok.trim();
                 								if(cand != "")
                 								{
                 									if(cand != ":")
                 									{
                 										valueFound = cand;
                 									}
                 								}
                 							}
                 						}
                 						if(valueFound == "")
                 						{
                 							dqTokens = firstSeg.toList("\"");
                 							for each  dqTok in dqTokens
                 							{
                 								if(valueFound == "")
                 								{
                 									cand2 = dqTok.trim();
                 									if(cand2 != "")
                 									{
                 										if(cand2 != ":")
                 										{
                 											valueFound = cand2;
                 										}
                 									}
                 								}
                 							}
                 						}
                 					}
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				if(valueFound.subText(0,1) == ":")
                 				{
                 					valueFound = valueFound.subText(1).trim();
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				lastChar = valueFound.subText(valueFound.length() - 1);
                 				if(lastChar == "}")
                 				{
                 					valueFound = valueFound.subText(0,valueFound.length() - 1).trim();
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				lastChar2 = valueFound.subText(valueFound.length() - 1);
                 				if(lastChar2 == "]")
                 				{
                 					valueFound = valueFound.subText(0,valueFound.length() - 1).trim();
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				firstChar = valueFound.subText(0,1);
                 				if(firstChar == "\"")
                 				{
                 					valueFound = valueFound.subText(1).trim();
                 				}
                 				if(firstChar == "'")
                 				{
                 					valueFound = valueFound.subText(1).trim();
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				lastChar3 = valueFound.subText(valueFound.length() - 1);
                 				if(lastChar3 == "\"")
                 				{
                 					valueFound = valueFound.subText(0,valueFound.length() - 1).trim();
                 				}
                 				if(lastChar3 == "'")
                 				{
                 					valueFound = valueFound.subText(0,valueFound.length() - 1).trim();
                 				}
                 			}
                 			if(valueFound != "")
                 			{
                 				extracted.put(wantedKey,valueFound);
                 			}
                 		}
                 		info "  extracted (" + extracted.size() + " of " + wantedKeys.size() + " keys) = " + extracted.toString();
                 		vMonitorUcid = ifnull(extracted.get("monitorUCID"),"").toString().trim();
                 		vUcid = ifnull(extracted.get("UCID"),"").toString().trim();
                 		vType = ifnull(extracted.get("Type"),"").toString().trim();
                 		vCallerId = ifnull(extracted.get("CallerID"),"").toString().trim();
                 		vStartTime = ifnull(extracted.get("StartTime"),"").toString().trim();
                 		vTimeToAnswer = ifnull(extracted.get("TimeToAnswer"),"").toString().trim();
                 		vEndTime = ifnull(extracted.get("EndTime"),"").toString().trim();
                 		vCallDuration = ifnull(extracted.get("CallDuration"),"").toString().trim();
                 		vDuration = ifnull(extracted.get("Duration"),"").toString().trim();
                 		vAgentName = ifnull(extracted.get("AgentName"),"").toString().trim();
                 		vDialStatus = ifnull(extracted.get("DialStatus"),"").toString().trim();
                 		vHangupBy = ifnull(extracted.get("HangupBy"),"").toString().trim();
                 		vAudioFile = ifnull(extracted.get("AudioFile"),"").toString().trim();
                 		vConfAudioFile = ifnull(extracted.get("CallerConfAudioFile"),"").toString().trim();
                 		vConfDuration = ifnull(extracted.get("ConfDuration"),"").toString().trim();
                 		vTransferredTo = ifnull(extracted.get("TransferredTo"),"").toString().trim();
                 		vCallFlow = ifnull(extracted.get("CallFlow"),"").toString().trim();
                 		if(vCallFlow == "")
                 		{
                 			vCallFlow = ifnull(extracted.get("Call_Flow"),"").toString().trim();
                 		}
                 		if(vCallFlow == "")
                 		{
                 			vCallFlow = ifnull(extracted.get("CallFlowDetails"),"").toString().trim();
                 		}
                 		vStatus = ifnull(extracted.get("Status"),"").toString().trim();
                 		vDisposition = ifnull(extracted.get("Disposition"),"").toString().trim();
                 		resolvedUcid = vUcid;
                 		if(resolvedUcid == "")
                 		{
                 			resolvedUcid = vMonitorUcid;
                 		}
                 		if(resolvedUcid == "")
                 		{
                 			resolvedUcid = ifnull(ucid,"").trim();
                 		}
                 		if(resolvedUcid == "")
                 		{
                 			resolvedUcid = ifnull(callbackId,"").trim();
                 		}
                 		info "  resolvedUcid = [" + resolvedUcid + "]";
                 		resolvedPhone = vCallerId;
                 		if(resolvedPhone.length() > 10)
                 		{
                 			resolvedPhone = resolvedPhone.subText(resolvedPhone.length() - 10);
                 		}
                 		info "  resolvedPhone (last 10) = [" + resolvedPhone + "]";
                 		tokenResp = invokeurl
                 		[
                 			url :"https://accounts.zoho.in/oauth/v2/token?refresh_token=" + ZC_REFRESH_TOKEN + "&client_id=" + ZC_CLIENT_ID + "&client_secret=" + ZC_CLIENT_SECRET + "&grant_type=refresh_token"
                 			type :POST
                 		];
                 		zcAccessToken = tokenResp.get("access_token");
                 		if(zcAccessToken == null)
                 		{
                 			info "  TOKEN FAILED - no access_token returned. Raw response: " + tokenResp.toString();
                 			return "{\"code\": \"SUCCESS\", \"result\": \"TOKEN_FAILED\", \"updated\": false, \"message\": \"Could not get an access token from the refresh token, so nothing was written. See this Custom API execution log for the raw response.\"}";
                 		}
                 		logRecId = "";
                 		if(resolvedUcid != "")
                 		{
                 			for each  ucidRow in Call_Log[UCID == resolvedUcid]
                 			{
                 				if(logRecId == "")
                 				{
                 					logRecId = ucidRow.ID.toString();
                 					info "  Matched Call_Log " + logRecId + " by UCID.";
                 				}
                 			}
                 		}
                 		if(logRecId == "null")
                 		{
                 			logRecId = "";
                 		}
                 		if(logRecId == "")
                 		{
                 			if(resolvedPhone != "")
                 			{
                 				bestId = 0;
                 				bestIdText = "";
                 				for each  pendingRow in Call_Log[Phone_Number == resolvedPhone]
                 				{
                 					existingUcid = ifnull(pendingRow.UCID,"").toString().trim();
                 					if(existingUcid == "")
                 					{
                 						thisId = pendingRow.ID;
                 						if(thisId > bestId)
                 						{
                 							bestId = thisId;
                 							bestIdText = pendingRow.ID.toString();
                 						}
                 					}
                 				}
                 				if(bestId > 0)
                 				{
                 					logRecId = bestIdText;
                 					numericIdText = bestId.toString();
                 					info "  Matched Call_Log " + logRecId + " by phone number (newest row for this number that has no UCID yet).";
                 					info "  Record id as text = [" + bestIdText + "] | same id after passing through a NUMBER variable = [" + numericIdText + "]. If these two differ, Deluge lost precision on the 18-digit id and the text one is the real record.";
                 				}
                 			}
                 		}
                 		createdNewRow = false;
                 		if(logRecId == "")
                 		{
                 			info "  No existing Call_Log row matched. Creating one - every call must be logged whether it was placed from this app, from the Ozonetel iframe, or came in as an inbound call.";
                 			matchedTicketId = 0;
                 			if(resolvedPhone != "")
                 			{
                 				phoneVariants = List();
                 				phoneVariants.add(resolvedPhone);
                 				phoneVariants.add("+91" + resolvedPhone);
                 				phoneVariants.add("91" + resolvedPhone);
                 				phoneVariants.add("0" + resolvedPhone);
                 				for each  phoneVariant in phoneVariants
                 				{
                 					if(matchedTicketId == 0)
                 					{
                 						for each  ticketRow in Create_Case[Phone_Number1 == phoneVariant]
                 						{
                 							if(ticketRow.ID > matchedTicketId)
                 							{
                 								matchedTicketId = ticketRow.ID;
                 							}
                 						}
                 					}
                 				}
                 				if(matchedTicketId == 0)
                 				{
                 					for each  phoneVariant2 in phoneVariants
                 					{
                 						if(matchedTicketId == 0)
                 						{
                 							for each  ticketRow2 in Create_Case[Phone_Number == phoneVariant2]
                 							{
                 								if(ticketRow2.ID > matchedTicketId)
                 								{
                 									matchedTicketId = ticketRow2.ID;
                 								}
                 							}
                 						}
                 					}
                 				}
                 			}
                 			if(matchedTicketId > 0)
                 			{
                 				info "  Linked to ticket " + matchedTicketId + " (newest ticket carrying this phone number).";
                 			}
                 			else
                 			{
                 				info "  No ticket carries this phone number, so the row is created unlinked. It is still captured, and an agent can attach it by hand.";
                 			}
                 			createMap = Map();
                 			createMap.put("Phone_Number",resolvedPhone);
                 			if(resolvedUcid != "")
                 			{
                 				createMap.put("UCID",resolvedUcid);
                 			}
                 			if(vType != "")
                 			{
                 				createMap.put("Call_Direction",vType);
                 			}
                 			if(matchedTicketId > 0)
                 			{
                 				createMap.put("Create_Case",matchedTicketId.toString());
                 			}
                 			createBody = Map();
                 			createBody.put("data",createMap);
                 			createResp = invokeurl
                 			[
                 				url :ZC_CALLLOG_FORM_URL
                 				type :POST
                 				parameters:createBody.toString()
                 				headers:{"Content-Type":"application/json","Authorization":"Bearer " + zcAccessToken}
                 			];
                 			info "  CREATE Call_Log response: " + createResp.toString();
                 			newRowId = "";
                 			if(createResp.get("code") == 3000)
                 			{
                 				createdData = createResp.get("data");
                 				if(createdData != null)
                 				{
                 					if(createdData.get("ID") != null)
                 					{
                 						newRowId = createdData.get("ID").toString();
                 					}
                 				}
                 			}
                 			if(newRowId == "")
                 			{
                 				info "  CREATE FAILED - could not add a Call_Log row for this call. Nothing recorded.";
                 				createDiag = "url=" + ZC_CALLLOG_FORM_URL + " || sent=" + createBody.toString() + " || reply=" + createResp.toString();
                 				if(createDiag.length() > 700)
                 				{
                 					createDiag = createDiag.subText(0,700);
                 				}
                 				createDiagSafe = createDiag.replaceAll("\"","'");
                 				return "{\"code\": \"SUCCESS\", \"result\": \"CREATE_FAILED\", \"updated\": false, \"ucid\": \"" + resolvedUcid + "\", \"phone\": \"" + resolvedPhone + "\", \"create_response\": \"" + createDiagSafe + "\", \"message\": \"No Call_Log row matched this callback and creating one failed. The create_response field above carries the exact URL, the payload sent, and Zoho's raw reply.\"}";
                 			}
                 			logRecId = newRowId;
                 			createdNewRow = true;
                 			info "  Created Call_Log " + logRecId + " for this call.";
                 		}
                 		statusText = vDialStatus;
                 		if(statusText == "")
                 		{
                 			statusText = vStatus;
                 		}
                 		outcomeText = vDisposition;
                 		if(outcomeText == "")
                 		{
                 			if(vHangupBy != "")
                 			{
                 				outcomeText = "Hangup by " + vHangupBy;
                 			}
                 		}
                 		coreFieldMap = Map();
                 		fullFieldMap = Map();
                 		if(resolvedUcid != "")
                 		{
                 			coreFieldMap.put("UCID",resolvedUcid);
                 			fullFieldMap.put("UCID",resolvedUcid);
                 		}
                 		if(statusText != "")
                 		{
                 			coreFieldMap.put("Call_Status",statusText);
                 			fullFieldMap.put("Call_Status",statusText);
                 		}
                 		if(vCallDuration != "")
                 		{
                 			coreFieldMap.put("Call_Duration",vCallDuration);
                 			fullFieldMap.put("Call_Duration",vCallDuration);
                 		}
                 		if(outcomeText != "")
                 		{
                 			coreFieldMap.put("Call_Outcome",outcomeText);
                 			fullFieldMap.put("Call_Outcome",outcomeText);
                 		}
                 		if(vType != "")
                 		{
                 			coreFieldMap.put("Call_Direction",vType);
                 			fullFieldMap.put("Call_Direction",vType);
                 		}
                 		extraFieldMap = Map();
                 		if(vStartTime != "")
                 		{
                 			extraFieldMap.put("Call_Start_Time",vStartTime);
                 			fullFieldMap.put("Call_Start_Time",vStartTime);
                 		}
                 		if(vEndTime != "")
                 		{
                 			extraFieldMap.put("Call_End_Time",vEndTime);
                 			fullFieldMap.put("Call_End_Time",vEndTime);
                 		}
                 		if(vTimeToAnswer != "")
                 		{
                 			extraFieldMap.put("Time_To_Answer",vTimeToAnswer);
                 			fullFieldMap.put("Time_To_Answer",vTimeToAnswer);
                 		}
                 		if(vDuration != "")
                 		{
                 			extraFieldMap.put("Total_Duration",vDuration);
                 			fullFieldMap.put("Total_Duration",vDuration);
                 		}
                 		if(vAgentName != "")
                 		{
                 			extraFieldMap.put("Agent_Name",vAgentName);
                 			fullFieldMap.put("Agent_Name",vAgentName);
                 		}
                 		if(vAudioFile != "")
                 		{
                 			extraFieldMap.put("Audio_File_URL",vAudioFile);
                 			fullFieldMap.put("Audio_File_URL",vAudioFile);
                 		}
                 		if(vConfAudioFile != "")
                 		{
                 			extraFieldMap.put("Conference_Audio_URL",vConfAudioFile);
                 			fullFieldMap.put("Conference_Audio_URL",vConfAudioFile);
                 		}
                 		if(vConfDuration != "")
                 		{
                 			extraFieldMap.put("Conference_Duration",vConfDuration);
                 			fullFieldMap.put("Conference_Duration",vConfDuration);
                 		}
                 		if(vTransferredTo != "")
                 		{
                 			extraFieldMap.put("Transferred_To",vTransferredTo);
                 			fullFieldMap.put("Transferred_To",vTransferredTo);
                 		}
                 		if(vCallFlow != "")
                 		{
                 			extraFieldMap.put("Call_Flow",vCallFlow);
                 			fullFieldMap.put("Call_Flow",vCallFlow);
                 		}
                 		existingHistory = "";
                 		try 
                 		{
                 			readBackResp = invokeurl
                 			[
                 				url :ZC_CALLLOG_URL_BASE + logRecId
                 				type :GET
                 				headers:{"Authorization":"Bearer " + zcAccessToken}
                 			];
                 			if(readBackResp.get("code") == 3000)
                 			{
                 				readBackData = readBackResp.get("data");
                 				if(readBackData != null)
                 				{
                 					if(readBackData.get("Call_Callback_History") != null)
                 					{
                 						existingHistory = readBackData.get("Call_Callback_History").toString();
                 					}
                 				}
                 			}
                 			else
                 			{
                 				info "  Could not read back Call_Log " + logRecId + " for its existing history (non-fatal, this callback will simply start a fresh history): " + readBackResp.toString();
                 			}
                 		}		catch (readBackEx)
                 		{
                 			info "  Read-back of the existing history threw (non-fatal): " + readBackEx.toString();
                 		}
                 		historyLine = "--- " + zoho.currenttime.toString("dd-MMM-yyyy hh:mm:ss a") + " ---";
                 		if(resolvedUcid != "")
                 		{
                 			historyLine = historyLine + "\nUCID: " + resolvedUcid;
                 		}
                 		if(vType != "")
                 		{
                 			historyLine = historyLine + "\nType: " + vType;
                 		}
                 		if(vCallerId != "")
                 		{
                 			historyLine = historyLine + "\nCallerID: " + vCallerId;
                 		}
                 		if(vAgentName != "")
                 		{
                 			historyLine = historyLine + "\nAgentName: " + vAgentName;
                 		}
                 		if(vStartTime != "")
                 		{
                 			historyLine = historyLine + "\nStartTime: " + vStartTime;
                 		}
                 		if(vTimeToAnswer != "")
                 		{
                 			historyLine = historyLine + "\nTimeToAnswer: " + vTimeToAnswer;
                 		}
                 		if(vEndTime != "")
                 		{
                 			historyLine = historyLine + "\nEndTime: " + vEndTime;
                 		}
                 		if(vCallDuration != "")
                 		{
                 			historyLine = historyLine + "\nCallDuration (talk): " + vCallDuration;
                 		}
                 		if(vDuration != "")
                 		{
                 			historyLine = historyLine + "\nDuration (total): " + vDuration;
                 		}
                 		if(statusText != "")
                 		{
                 			historyLine = historyLine + "\nDialStatus: " + statusText;
                 		}
                 		if(vHangupBy != "")
                 		{
                 			historyLine = historyLine + "\nHangupBy: " + vHangupBy;
                 		}
                 		if(vTransferredTo != "")
                 		{
                 			historyLine = historyLine + "\nTransferredTo: " + vTransferredTo;
                 		}
                 		if(vConfDuration != "")
                 		{
                 			historyLine = historyLine + "\nConfDuration: " + vConfDuration;
                 		}
                 		if(vAudioFile != "")
                 		{
                 			historyLine = historyLine + "\nAudioFile: " + vAudioFile;
                 		}
                 		if(vConfAudioFile != "")
                 		{
                 			historyLine = historyLine + "\nCallerConfAudioFile: " + vConfAudioFile;
                 		}
                 		if(vCallFlow != "")
                 		{
                 			historyLine = historyLine + "\nCall Flow: " + vCallFlow;
                 		}
                 		if(existingHistory.trim() == "")
                 		{
                 			extraFieldMap.put("Call_Callback_History",historyLine);
                 			fullFieldMap.put("Call_Callback_History",historyLine);
                 		}
                 		else
                 		{
                 			appendedHistory = existingHistory + "\n\n" + historyLine;
                 			extraFieldMap.put("Call_Callback_History",appendedHistory);
                 			fullFieldMap.put("Call_Callback_History",appendedHistory);
                 		}
                 		if(fullFieldMap.size() == 0)
                 		{
                 			info "  Callback carried nothing usable, so there is nothing to write onto Call_Log " + logRecId + ".";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NOTHING_TO_WRITE\", \"updated\": false, \"recordId\": \"" + logRecId + "\", \"message\": \"A Call_Log row was matched but the callback carried no readable values, so nothing was written.\"}";
                 		}
                 		info "  Fields to write on Call_Log " + logRecId + " (" + fullFieldMap.size() + " total, " + coreFieldMap.size() + " core + " + extraFieldMap.size() + " extended): " + fullFieldMap.toString();
                 		rowMode = "existing";
                 		if(createdNewRow)
                 		{
                 			rowMode = "created";
                 		}
                 		writtenMode = "none";
                 		patchBody = Map();
                 		patchBody.put("data",fullFieldMap);
                 		patchDiag = "";
                 		patchResp = invokeurl
                 		[
                 			url :ZC_CALLLOG_URL_BASE + logRecId
                 			type :PATCH
                 			parameters:patchBody.toString()
                 			headers:{"Content-Type":"application/json","Authorization":"Bearer " + zcAccessToken}
                 		];
                 		info "  PATCH (full) response: " + patchResp.toString();
                 		patchDiag = "url=" + ZC_CALLLOG_URL_BASE + logRecId + " || full=" + patchResp.toString();
                 		if(patchResp.get("code") == 3000)
                 		{
                 			writtenMode = "full";
                 			info "  WRITE OK - Call_Log " + logRecId + " updated with all " + fullFieldMap.size() + " fields, history appended.";
                 		}
                 		else
                 		{
                 			if(patchResp.get("code") == 1000)
                 			{
                 				info "  FULL WRITE REFUSED with code 1000 (Invalid API URL format). This is NOT a missing-field problem - the record id in the PATCH URL is empty or not a number, so no Call_Log row was actually addressed. The id used was [" + logRecId + "]. Check the row-matching log lines above.";
                 			}
                 			else
                 			{
                 				info "  FULL WRITE REFUSED - most likely one of the new Call_Log fields does not exist yet. Retrying with the core fields only. Create these on Call_Log to capture everything: Call_Start_Time, Call_End_Time, Time_To_Answer, Total_Duration, Agent_Name, Audio_File_URL, Conference_Audio_URL, Conference_Duration, Transferred_To, Call_Flow, Call_Callback_History.";
                 			}
                 			if(coreFieldMap.size() > 0)
                 			{
                 				coreBody = Map();
                 				coreBody.put("data",coreFieldMap);
                 				coreResp = invokeurl
                 				[
                 					url :ZC_CALLLOG_URL_BASE + logRecId
                 					type :PATCH
                 					parameters:coreBody.toString()
                 					headers:{"Content-Type":"application/json","Authorization":"Bearer " + zcAccessToken}
                 				];
                 				info "  PATCH (core only) response: " + coreResp.toString();
                 				patchDiag = patchDiag + " || core=" + coreResp.toString();
                 				if(coreResp.get("code") == 3000)
                 				{
                 					writtenMode = "core";
                 					info "  WRITE OK (core fields only) - Call_Log " + logRecId + " updated. The extended fields were skipped.";
                 				}
                 				else
                 				{
                 					info "  WRITE FAILED on both attempts - " + coreResp.get("message");
                 				}
                 			}
                 		}
                 		info "===============================================";
                 		if(writtenMode == "none")
                 		{
                 			probeResp = invokeurl
                 			[
                 				url :"https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/report/Call_Log_Report?max_records=200"
                 				type :GET
                 				headers:{"Authorization":"Bearer " + zcAccessToken}
                 			];
                 			probeText = probeResp.toString();
                 			if(probeText.length() > 300)
                 			{
                 				probeText = probeText.subText(0,300);
                 			}
                 			info "  PROBE - plain list GET on Call_Log_Report: " + probeText;
                 			patchDiag = patchDiag + " || report_list_probe=" + probeText;
                 			patchDiagSafe = patchDiag.replaceAll("\"","'");
                 			return "{\"code\": \"SUCCESS\", \"result\": \"WRITE_FAILED\", \"updated\": false, \"recordId\": \"" + logRecId + "\", \"patch_responses\": \"" + patchDiagSafe + "\", \"message\": \"A Call_Log row was matched and the callback was parsed, but both the full and the core write were refused. The patch_responses field above carries the raw PATCH replies and the exact URL used.\"}";
                 		}
                 		return "{\"code\": \"SUCCESS\", \"result\": \"UPDATED\", \"updated\": true, \"row\": \"" + rowMode + "\", \"written\": \"" + writtenMode + "\", \"recordId\": \"" + logRecId + "\", \"fields_written\": " + fullFieldMap.size() + ", \"keys_extracted\": " + extracted.size() + ", \"ucid\": \"" + resolvedUcid + "\", \"type\": \"" + vType + "\", \"caller_id\": \"" + vCallerId + "\", \"agent\": \"" + vAgentName + "\", \"start_time\": \"" + vStartTime + "\", \"end_time\": \"" + vEndTime + "\", \"time_to_answer\": \"" + vTimeToAnswer + "\", \"talk_time\": \"" + vCallDuration + "\", \"total_duration\": \"" + vDuration + "\", \"dial_status\": \"" + statusText + "\", \"hangup_by\": \"" + vHangupBy + "\", \"transferred_to\": \"" + vTransferredTo + "\", \"conf_duration\": \"" + vConfDuration + "\", \"audio_file\": \"" + vAudioFile + "\", \"conf_audio_file\": \"" + vConfAudioFile + "\", \"call_flow\": \"" + vCallFlow + "\", \"message\": \"Call_Log " + logRecId + " updated from the Ozonetel callback and one timestamped entry appended to its history.\"}";
                 	}	catch (e)
                 	{
                 		info "getCallbackStatus threw (nothing was updated by this call): " + e.toString();
                 		return "{\"code\": \"SUCCESS\", \"result\": \"EXCEPTION\", \"updated\": false, \"exception\": \"" + e.toString() + "\", \"message\": \"The script threw an error and nothing was updated. The exception text is in the exception field above and in this Custom API execution log.\"}";
                 	}
                 	return "{\"code\": \"SUCCESS\", \"result\": \"NO_RESULT\", \"updated\": false, \"message\": \"The script finished without reaching any known outcome. This should not happen - send the execution log over.\"}";
                 }
				 string getCustomerTicketInfo(string recordId, string mode)
                 {
                 	try 
                 	{
                 		result = Map();
                 		// .trim() added 2026-09-17 — the same stray-trailing-space crash already
                 		// hit live twice in this project (generateZohoPaymentLink.deluge:
                 		// "Unable to cast the '448881000000543009 ' value into a 'Long' value",
                 		// and submitCustomerLocation.deluge, whose own entry log showed
                 		// recordId = [448881000000482018 ] with a trailing space). This is the
                 		// one remaining customerPage script that still parsed it raw, and it is
                 		// the FIRST call every customer link makes - so a space here blanks the
                 		// whole page rather than failing one action.
                 		rec = Create_Case[ID == recordId.trim().toLong()];
                 		if(rec == null)
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","Ticket not found");
                 			return result.toString();
                 		}
                 		customerName = rec.Customer_Name;
                 		if(customerName == null || customerName == "")
                 		{
                 			customerName = "Customer";
                 		}
                 		result.put("code","SUCCESS");
                 		result.put("customerName",customerName);
                 		result.put("serviceType",rec.Service_Type);
                 		// Vehicle / Issue / Total Service Fee (2026-09-07, user request:
                 		// "in the beginning we can display to the customer vehicle name,
                 		// issue and total service fee") — returned on EVERY mode (not just
                 		// one), shared context strip shown across all 4 customer-facing
                 		// pages. Wrapped in their own try/catch each — Vehicle/Vehicle_Issue
                 		// are Lookup fields and this project has no prior confirmed pattern
                 		// for traversing a Lookup's own display value inside a Deluge
                 		// script (every other place that needs Vehicle Issue names resolves
                 		// them client-side in getRescueTicket via a separate options report
                 		// fetch, not inside Deluge) — .toString() is the safest fallback
                 		// that cannot itself throw a save-time or run-time error regardless
                 		// of the exact underlying value shape, but may show a raw ID rather
                 		// than a friendly name until confirmed live. Flagged, not guessed
                 		// silently — test this specifically and report back what actually
                 		// displays.
                 		// Real bug fixed 2026-09-09 (user-confirmed live: raw record IDs shown
                 		// instead of names, e.g. "448881000000057692 - 448881000000056038")
                 		// — .toString() on a Lookup field returns its raw ID, not its
                 		// display value. FIELDS.md confirms Vehicle is a single Lookup ->
                 		// Vehicle_Master (display field Name) and Vehicle_Issue is a
                 		// MULTI-select Lookup -> Vehicle_Issue (display field Issue_Name),
                 		// so each needs its own resolution. Each attempt below keeps the
                 		// already-working raw-ID string as its fallback (set first, in the
                 		// SAME try block) and only overwrites it if the friendly-name
                 		// resolution actually succeeds — an inner try/catch around just the
                 		// name lookup, so a wrong assumption about either field's exact
                 		// shape can only fall back to today's raw-ID behavior, never break
                 		// the whole response.
                 		vehicleName = "";
                 		try 
                 		{
                 			if(rec.Vehicle != null)
                 			{
                 				vehicleName = rec.Vehicle.toString();
                 				try 
                 				{
                 					vehRec = vehicle_master[ID == rec.Vehicle.toLong()];
                 					if(vehRec != null)
                 					{
                 						vLookupName = vehRec.Name;
                 						if(vLookupName != null)
                 						{
                 							if(vLookupName.toString() != "")
                 							{
                 								vehicleName = vLookupName.toString();
                 							}
                 						}
                 					}
                 				}				catch (vehicleNameEx)
                 				{
                 				}
                 			}
                 		}		catch (vehicleEx)
                 		{
                 			vehicleName = "";
                 		}
                 		issueNames = "";
                 		try 
                 		{
                 			if(rec.Vehicle_Issue != null)
                 			{
                 				issueNames = rec.Vehicle_Issue.toString();
                 				try 
                 				{
                 					issueNameList = List();
                 					for each  issId in rec.Vehicle_Issue
                 					{
                 						issRec = Vehicle_Issue[ID == issId];
                 						if(issRec != null)
                 						{
                 							issNameVal = issRec.Issue_Name;
                 							if(issNameVal != null)
                 							{
                 								if(issNameVal.toString() != "")
                 								{
                 									issueNameList.add(issNameVal.toString());
                 								}
                 							}
                 						}
                 					}
                 					if(issueNameList.size() > 0)
                 					{
                 						joined = "";
                 						for each  nm in issueNameList
                 						{
                 							if(joined == "")
                 							{
                 								joined = nm;
                 							}
                 							else
                 							{
                 								joined = joined + ", " + nm;
                 							}
                 						}
                 						issueNames = joined;
                 					}
                 				}				catch (issueNameEx)
                 				{
                 				}
                 			}
                 		}		catch (issueEx)
                 		{
                 			issueNames = "";
                 		}
                 		// Same DECIMAL-blank-value fix as Booking_Fee/Remaining_Fee below
                 		// (2026-09-09) — this field was missed the first time around and
                 		// still used a plain "== null" check, which this project has already
                 		// confirmed doesn't catch every blank shape a Decimal field can
                 		// come back as.
                 		totalFee = rec.Total_Service_Fee;
                 		totalFeeText = "";
                 		if(totalFee != null)
                 		{
                 			totalFeeText = totalFee.toString();
                 		}
                 		if(totalFeeText == "")
                 		{
                 			totalFee = 0;
                 		}
                 		result.put("vehicle",vehicleName);
                 		result.put("issue",issueNames);
                 		result.put("totalServiceFee",totalFee);
                 		// Real bug fixed 2026-09-07 (user-reported live: "Missing return
                 		// statement: Provide STRING expression to return") — this function
                 		// used to have ONE shared "return result.toString();" placed after
                 		// the whole if/else-if/else mode-dispatch chain below, relying on
                 		// every branch falling through to it. Deluge's own static
                 		// return-path checker couldn't prove every branch reaches that
                 		// point (this got harder to follow once the DECIMAL/TEXT fix above
                 		// added nested if-blocks inside some branches) and refused to save
                 		// the script at all. Fixed the only fully robust way: every branch
                 		// below now returns explicitly, on its own, so there's no shared
                 		// fall-through return left to prove reachability for.
                 		if(mode == "booking_payment")
                 		{
                 			// Real bug fixed 2026-09-09 (user-reported live: portal showed
                 			// Booking Fee 200, Customer Page showed ₹0.00 for the same
                 			// ticket) — plain "amount == null" wasn't catching every blank
                 			// shape this Number field can come back as (same class of
                 			// Deluge type quirk already fixed for Zoho_Books_Invoice_ID
                 			// above/Remaining_Fee below — DECIMAL/Number fields don't
                 			// always read back as a clean null when blank). Normalized via
                 			// .toString() first, same established pattern, before falling
                 			// back to 0 — only when genuinely blank now, not on a real
                 			// non-null-but-not-exactly-null value.
                 			amount = rec.Booking_Fee;
                 			amountText = "";
                 			if(amount != null)
                 			{
                 				amountText = amount.toString();
                 			}
                 			if(amountText == "")
                 			{
                 				amount = 0;
                 			}
                 			paid = false;
                 			if(rec.Payment_Status == "PAID")
                 			{
                 				paid = true;
                 			}
                 			result.put("amountDue",amount);
                 			result.put("paid",paid);
                 			// Real bug fixed 2026-09-07 (user-reported live: "In Criteria left
                 			// expression is of type DECIMAL and right expression is of type
                 			// TEXT and the operator != is not valid") — Zoho_Books_Invoice_ID
                 			// reads back as a DECIMAL here even though it was documented as
                 			// Single Line Text; comparing it directly against the TEXT
                 			// literal "" is exactly what Deluge's own type checker rejects.
                 			// Normalized via .toString() before the empty-check (same fix
                 			// applied to every other numeric-looking field in this function),
                 			// and split into a nested if rather than one "!= null &&" —
                 			// matching the established, already-proven-safe pattern this
                 			// project's OTHER Deluge scripts already use (onDemandInvoicing.
                 			// deluge, recordVendorPayment.deluge) instead of combining a
                 			// null-check and a type-sensitive comparison into one expression.
                 			// Real payment page (2026-09-09, user request: "open the Zoho
                 			// Books payment page directly instead of opening the invoice
                 			// separately") — Zoho_Payment_URL is the REAL, payable link the
                 			// Zoho Payments "Payment Links" API returned (see
                 			// onDemandInvoicing.deluge's own comment), now stored directly
                 			// on the ticket alongside the invoice ID. Field renamed
                 			// 2026-09-10 to Zoho_Payment_URL (was Zoho_Books_Payment_URL) —
                 			// the user's own real, created field, replacing the earlier
                 			// placeholder name that was never confirmed to exist in Zoho.
                 			// Preferred over the old hand-built URL below whenever present;
                 			// falls back to the exact same hand-built format as before for
                 			// any ticket invoiced before this field existed, or if
                 			// payment-link generation ever fails.
                 			paymentUrl = rec.Zoho_Payment_URL;
                 			paymentUrlText = "";
                 			if(paymentUrl != null)
                 			{
                 				paymentUrlText = paymentUrl.toString();
                 			}
                 			if(paymentUrlText != "")
                 			{
                 				result.put("invoiceUrl",paymentUrlText);
                 			}
                 			else
                 			{
                 				invoiceId = rec.Zoho_Books_Invoice_ID;
                 				if(invoiceId != null)
                 				{
                 					invoiceIdText = invoiceId.toString();
                 					if(invoiceIdText != "")
                 					{
                 						result.put("invoiceUrl","https://books.zoho.in/invoices/" + invoiceIdText + "?organization_id=60078911104");
                 					}
                 				}
                 			}
                 			return result.toString();
                 		}
                 		else if(mode == "remaining_payment")
                 		{
                 			// Same fix as booking_payment above, same date/reason —
                 			// Remaining_Fee is documented as Decimal (FIELDS.md), the exact
                 			// field type this file already knows can misbehave against a
                 			// plain "== null" check.
                 			amount = rec.Remaining_Fee;
                 			amountText = "";
                 			if(amount != null)
                 			{
                 				amountText = amount.toString();
                 			}
                 			if(amountText == "")
                 			{
                 				amount = 0;
                 			}
                 			paid = false;
                 			if(rec.Payment_received == "Yes")
                 			{
                 				paid = true;
                 			}
                 			result.put("amountDue",amount);
                 			result.put("paid",paid);
                 			// Zoho_Books_Invoice_ID_Remaining (2026-09-07, user decision:
                 			// "split into two invoices") — a SEPARATE invoice from the
                 			// booking-payment one above, created by getRescueTicket's own
                 			// Send_Payment_Link1 action for exactly Remaining_Fee. New
                 			// field, mirrors the booking_payment branch's own pattern
                 			// exactly (including the same 2026-09-07 DECIMAL/TEXT fix just
                 			// above) so renderBookingOrRemainingPayment() (shared by both
                 			// modes on the widget side) picks it up with no widget-side
                 			// change needed.
                 			// Same real-payment-page preference as booking_payment above —
                 			// see that branch's own comment.
                 			// Real bug fixed 2026-09-12 (found during a full-application audit,
                 			// not live-reported): this read the OLD placeholder field name
                 			// (Zoho_Books_Payment_URL_Remaining), which nothing in this project
                 			// ever writes to — confirmed via a repo-wide search. The real,
                 			// user-confirmed field getRescueTicket/app/widget.html actually
                 			// writes/reads is Zoho_Payment_URL_Remaining (same rename that
                 			// already applied correctly to the Booking Fee side just above:
                 			// Zoho_Books_Payment_URL -> Zoho_Payment_URL, 2026-09-10). This
                 			// branch always silently fell through to the hand-built Books
                 			// invoice-view URL fallback below, even when a real, payable Zoho
                 			// Payments link existed — every Remaining Fee "Pay Now" link a
                 			// customer has ever received was the older, non-preferred URL.
                 			paymentUrlRemaining = rec.Zoho_Payment_URL_Remaining;
                 			paymentUrlRemainingText = "";
                 			if(paymentUrlRemaining != null)
                 			{
                 				paymentUrlRemainingText = paymentUrlRemaining.toString();
                 			}
                 			if(paymentUrlRemainingText != "")
                 			{
                 				result.put("invoiceUrl",paymentUrlRemainingText);
                 			}
                 			else
                 			{
                 				invoiceIdRemaining = rec.Zoho_Books_Invoice_ID_Remaining;
                 				if(invoiceIdRemaining != null)
                 				{
                 					invoiceIdRemainingText = invoiceIdRemaining.toString();
                 					if(invoiceIdRemainingText != "")
                 					{
                 						result.put("invoiceUrl","https://books.zoho.in/invoices/" + invoiceIdRemainingText + "?organization_id=60078911104");
                 					}
                 				}
                 			}
                 			return result.toString();
                 		}
                 		else if(mode == "feedback")
                 		{
                 			// Reverted 2026-09-07 (later same day, explicit user feedback:
                 			// "Single feedback as you have now is good enough") — back to
                 			// ONE score, matching submitCustomerFeedback.deluge's own
                 			// matching revert. Kept the safe DECIMAL/TEXT-normalization
                 			// pattern (nested if + .toString()) from the earlier fix rather
                 			// than reverting all the way to the original riskier
                 			// "!= null && != ''" combined expression — that part of the fix
                 			// stands regardless of the 1-score-vs-3-score decision.
                 			already = false;
                 			score = rec.Cx_Feedback_Score;
                 			if(score != null)
                 			{
                 				if(score.toString() != "")
                 				{
                 					already = true;
                 				}
                 			}
                 			result.put("alreadySubmitted",already);
                 			return result.toString();
                 		}
                 		else if(mode == "location")
                 		{
                 			// Same 2026-09-07 fix as the invoice checks above — this
                 			// nested if + .toString() pattern was originally needed because
                 			// Latitude/DropLocationLat were Decimal fields at the time (a
                 			// direct "!= ''" comparison against a Decimal throws a DECIMAL-
                 			// vs-TEXT criteria error in Deluge). Both fields were converted
                 			// to Single Line Text on 2026-09-11 (user-confirmed) — the
                 			// pattern is no longer strictly necessary (.toString() on an
                 			// already-string value is a harmless no-op), but left exactly
                 			// as-is since it still produces the correct result either way.
                 			hasBreakdown = false;
                 			lat = rec.Latitude;
                 			if(lat != null)
                 			{
                 				if(lat.toString() != "")
                 				{
                 					hasBreakdown = true;
                 				}
                 			}
                 			hasDrop = false;
                 			dropLat = rec.DropLocationLat;
                 			if(dropLat != null)
                 			{
                 				if(dropLat.toString() != "")
                 				{
                 					hasDrop = true;
                 				}
                 			}
                 			result.put("hasBreakdownLocation",hasBreakdown);
                 			result.put("hasDropLocation",hasDrop);
                 			return result.toString();
                 		}
                 		else
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","Unknown mode: " + mode);
                 			return result.toString();
                 		}
                 	}	catch (e)
                 	{
                 		errResult = Map();
                 		errResult.put("code","ERROR");
                 		errResult.put("message",e.toString());
                 		return errResult.toString();
                 	}
                 }
				 string getInboundCallerInfo(string phone)
                 {
                 	try 
                 	{
                 		info "========== INBOUND CALLER LOOKUP ==========";
                 		info "  time  = " + zoho.currenttime;
                 		info "  phone = [" + ifnull(phone,"(null)") + "]";
                 		rawPhone = ifnull(phone,"").trim();
                 		digitsOnly = rawPhone.replaceAll("[^0-9]","");
                 		last10 = digitsOnly;
                 		if(last10.length() > 10)
                 		{
                 			last10 = last10.subText(last10.length() - 10);
                 		}
                 		info "  digits = [" + digitsOnly + "] | last10 = [" + last10 + "]";
                 		if(last10.length() < 6)
                 		{
                 			info "  TOO SHORT - not a usable phone number. Nothing looked up.";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NO_PHONE\", \"phone\": \"" + last10 + "\", \"count\": 0, \"tickets\": [], \"message\": \"No usable phone number arrived, so no lookup was done. If this reads like an unsubstituted placeholder such as $CallerID$, the calling system opened the URL without replacing its own token.\"}";
                 		}
                 		ticketsJson = "";
                 		foundCount = 0;
                 		for each  caseRec in Create_Case[Phone_Number1.contains(last10) || Phone_Number.contains(last10)] sort by ID desc
                 		{
                 			if(foundCount < 5)
                 			{
                 				recId = caseRec.ID.toString();
                 				caseIdText = ifnull(caseRec.Case_ID,"").toString().trim();
                 				nameText = ifnull(caseRec.Customer_Name,"").toString().trim();
                 				statusText = ifnull(caseRec.Status,"").toString().trim();
                 				serviceText = ifnull(caseRec.Service_Type,"").toString().trim();
                 				closureText = ifnull(caseRec.Closure_Status,"").toString().trim();
                 				addedText = ifnull(caseRec.Added_Time,"").toString().trim();
                 				vehicleText = "";
                 				vehicleRef = caseRec.Vehicle;
                 				if(vehicleRef != null)
                 				{
                 					vehicleIdText = vehicleRef.toString().trim();
                 					if(vehicleIdText != "")
                 					{
                 						vehicleLong = 0;
                 						try 
                 						{
                 							vehicleLong = vehicleIdText.toLong();
                 						}						catch (vehEx)
                 						{
                 							vehicleLong = 0;
                 						}
                 						if(vehicleLong > 0)
                 						{
                 							for each  vehRec in vehicle_master[ID == vehicleLong]
                 							{
                 								vehicleText = ifnull(vehRec.Name,"").toString().trim();
                 							}
                 						}
                 						if(vehicleText == "")
                 						{
                 							vehicleText = vehicleIdText;
                 						}
                 					}
                 				}
                 				nameText = nameText.replaceAll("\"","'");
                 				vehicleText = vehicleText.replaceAll("\"","'");
                 				statusText = statusText.replaceAll("\"","'");
                 				closureText = closureText.replaceAll("\"","'");
                 				rowJson = "{\"id\": \"" + recId + "\", \"caseId\": \"" + caseIdText + "\", \"customerName\": \"" + nameText + "\", \"status\": \"" + statusText + "\", \"serviceType\": \"" + serviceText + "\", \"vehicle\": \"" + vehicleText + "\", \"closureStatus\": \"" + closureText + "\", \"addedTime\": \"" + addedText + "\"}";
                 				if(ticketsJson == "")
                 				{
                 					ticketsJson = rowJson;
                 				}
                 				else
                 				{
                 					ticketsJson = ticketsJson + ", " + rowJson;
                 				}
                 				foundCount = foundCount + 1;
                 			}
                 		}
                 		info "  matched " + foundCount + " ticket(s) for " + last10;
                 		info "===========================================";
                 		if(foundCount == 0)
                 		{
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NO_MATCH\", \"phone\": \"" + last10 + "\", \"count\": 0, \"tickets\": [], \"message\": \"No existing ticket carries this number. Treat as a new customer.\"}";
                 		}
                 		return "{\"code\": \"SUCCESS\", \"result\": \"MATCHED\", \"phone\": \"" + last10 + "\", \"count\": " + foundCount + ", \"tickets\": [" + ticketsJson + "], \"message\": \"Up to five most recent tickets for this number, newest first.\"}";
                 	}	catch (e)
                 	{
                 		info "getInboundCallerInfo threw: " + e.toString();
                 		return "{\"code\": \"ERROR\", \"result\": \"EXCEPTION\", \"phone\": \"\", \"count\": 0, \"tickets\": [], \"message\": \"" + e.toString().replaceAll("\"","'") + "\"}";
                 	}
                 	return "{\"code\": \"ERROR\", \"result\": \"NO_RESULT\", \"count\": 0, \"tickets\": [], \"message\": \"The script finished without reaching any known outcome.\"}";
                 }
				 string getIssueOptions()
                 {
                 	returnstring = "";
                 	try 
                 	{
                 		issueList = List();
                 		for each  iss in Vehicle_Issue[ID != 0]
                 		{
                 			displayStatus = "";
                 			if(iss.DISPLAY_STATUS != null)
                 			{
                 				displayStatus = iss.DISPLAY_STATUS.toString();
                 			}
                 			if(displayStatus.toUpperCase() == "SHOW")
                 			{
                 				i = Map();
                 				i.put("id",iss.ID);
                 				issueName = iss.Issue_Name;
                 				if(issueName == null)
                 				{
                 					issueName = "";
                 				}
                 				if(issueName.toString() == "")
                 				{
                 					issueName = "Issue " + iss.ID;
                 				}
                 				i.put("name",issueName);
                 				vehicleTypes = "";
                 				if(iss.VEHICLE_TYPE != null)
                 				{
                 					vehicleTypes = iss.VEHICLE_TYPE.toString();
                 				}
                 				i.put("vehicleTypes",vehicleTypes);
                 				issueType = "";
                 				if(iss.Issue_Type != null)
                 				{
                 					issueType = iss.Issue_Type.toString();
                 				}
                 				i.put("issueType",issueType);
                 				issueList.add(i);
                 			}
                 		}
                 		result = Map();
                 		result.put("code","SUCCESS");
                 		result.put("issues",issueList);
                 		returnstring = result.toString();
                 	}	catch (e)
                 	{
                 		errResult = Map();
                 		errResult.put("code","ERROR");
                 		errResult.put("message",e.toString());
                 		errResult.put("issues",List());
                 		returnstring = errResult.toString();
                 	}
                 	return returnstring;
                 }
				 string getMyInviteOutcomes(string vendorId)
                 {
                 	/* getMyInviteOutcomes - 2026-10-27, client request: "reject/timed out report
                 	   needs to be shown to the vendor (only cases of that particular vendor)".
                 	   Feeds the Rejected / Timed Out list on the vendorPerformance page.
                 
                 	   RETURNS RAW FACTS, NOT VERDICTS. Per ticket this vendor was invited to or
                 	   rejected: the invite's own times and response fields, any Task_Rejections
                 	   entry, and a few case fields (Case ID, service, vehicle, issue, status, who
                 	   it was assigned to and when it was accepted). The widget turns these into
                 	   Rejected / Timed Out with the same 2-minute rule the agent app uses, so the
                 	   two screens can never disagree about an invite.
                 
                 	   ONLY THIS VENDOR, decided here - the same identity check as
                 	   getVendorPayments: zoho.loginuser is matched to a Vendors record by Email; a
                 	   request naming a different vendor is refused with no data; with no login
                 	   match the requested vendorId is used, as getVendorTickets already does.
                 	   REQUIRE_LOGIN_MATCH = true closes that route once "verifiedBy" is seen to
                 	   read "login" for real vendors.
                 
                 	   TWO SOURCES, merged per ticket:
                 	     - Invites, matched on the Vendor lookup id (exact, survives renames).
                 	     - Task_Rejections, matched on RSP_Name (the vendor name the vendor app
                 	       writes) - kept so a reject still counts when the app could not update
                 	       its invite row, and so rejects from before invites existed still show.
                 
                 	   NO CUSTOMER DATA: no name, phone, email, address or location leaves here.
                 	   READ-ONLY: no insert, update or delete. Forms are read directly, as
                 	   getVendorPayments does, so report layouts and portal report permissions do
                 	   not matter and no OAuth token is involved.
                 
                 	   Deluge shapes as elsewhere in this repo: no &&, no ternary, lookups and
                 	   date-times null-checked before .toString(), containKey (not containsKey),
                 	   and the reply built as a Map. */
                 	REQUIRE_LOGIN_MATCH = false;
                 	result = Map();
                 	emptyList = List();
                 	try 
                 	{
                 		requested = ifnull(vendorId,"").trim();
                 		/* ---------- 1. who is calling ---------- */
                 		callerEmail = ifnull(zoho.loginuser,"").trim();
                 		callerEmail = callerEmail.toLowerCase();
                 		verifiedId = "";
                 		if(callerEmail != "")
                 		{
                 			for each  vRec in vendors[ID != 0]
                 			{
                 				if(verifiedId == "")
                 				{
                 					vEmail = ifnull(vRec.Email,"").trim();
                 					if(vEmail.toLowerCase() == callerEmail)
                 					{
                 						verifiedId = vRec.ID.toString();
                 					}
                 				}
                 			}
                 		}
                 		wanted = "";
                 		verifiedBy = "";
                 		if(verifiedId != "")
                 		{
                 			if(requested != "")
                 			{
                 				if(requested != verifiedId)
                 				{
                 					info "getMyInviteOutcomes - REFUSED: login " + callerEmail + " is vendor " + verifiedId + " but asked for vendor " + requested;
                 					result.put("code","ERROR");
                 					result.put("message","This login belongs to a different vendor than the one requested, so nothing was returned.");
                 					result.put("rows",emptyList);
                 					return result.toString();
                 				}
                 			}
                 			wanted = verifiedId;
                 			verifiedBy = "login";
                 		}
                 		else
                 		{
                 			if(REQUIRE_LOGIN_MATCH)
                 			{
                 				result.put("code","ERROR");
                 				result.put("message","This login is not linked to any vendor record, so nothing can be shown.");
                 				result.put("rows",emptyList);
                 				return result.toString();
                 			}
                 			wanted = requested;
                 			verifiedBy = "request";
                 		}
                 		if(wanted == "")
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","No vendor could be identified for this login, and no vendorId was sent.");
                 			result.put("rows",emptyList);
                 			return result.toString();
                 		}
                 		wantedLong = 0;
                 		try 
                 		{
                 			wantedLong = wanted.toLong();
                 		}		catch (idEx)
                 		{
                 			wantedLong = 0;
                 		}
                 		vendorFound = false;
                 		vendorName = "";
                 		for each  meRec in vendors[ID == wantedLong]
                 		{
                 			vendorFound = true;
                 			vendorName = ifnull(meRec.vendor_name,"").trim();
                 		}
                 		if(vendorFound == false)
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","No vendor record exists with id " + wanted + ".");
                 			result.put("rows",emptyList);
                 			return result.toString();
                 		}
                 		vendorNameLower = vendorName.toLowerCase();
                 		info "getMyInviteOutcomes - vendor " + wanted + " (" + vendorName + ", identified by " + verifiedBy + ", login " + callerEmail + ")";
                 		/* ---------- 2. this vendor's invites, by ticket id ---------- */
                 		inviteByTicket = Map();
                 		for each  inv in Invites[ID != 0]
                 		{
                 			invVendor = "";
                 			if(inv.Vendor != null)
                 			{
                 				invVendor = inv.Vendor.toString().trim();
                 			}
                 			if(invVendor == wanted)
                 			{
                 				ticketKey = "";
                 				if(inv.RSID != null)
                 				{
                 					ticketKey = inv.RSID.toString().trim();
                 				}
                 				if(ticketKey != "")
                 				{
                 					invMap = Map();
                 					invitedAtText = "";
                 					if(inv.Invited_At != null)
                 					{
                 						invitedAtText = inv.Invited_At.toString();
                 					}
                 					addedText = "";
                 					if(inv.Added_Time != null)
                 					{
                 						addedText = inv.Added_Time.toString();
                 					}
                 					respondedText = "";
                 					if(inv.Responded_At != null)
                 					{
                 						respondedText = inv.Responded_At.toString();
                 					}
                 					invMap.put("Invited_At",invitedAtText);
                 					invMap.put("Added_Time",addedText);
                 					invMap.put("Responded_At",respondedText);
                 					invMap.put("Status",ifnull(inv.Status,"").toString());
                 					invMap.put("Reject_Reason",ifnull(inv.Reject_Reason,"").toString());
                 					invMap.put("Service_Acceptance_Next",ifnull(inv.Service_Acceptance_Next,"").toString());
                 					// One row per vendor per ticket is the rule; if a duplicate exists,
                 					// the later record (higher id) wins - it carries the latest round.
                 					inviteByTicket.put(ticketKey,invMap);
                 				}
                 			}
                 		}
                 		/* ---------- 3. this vendor's Task_Rejections, by ticket label ---------- */
                 		rejectByLabel = Map();
                 		if(vendorNameLower != "")
                 		{
                 			for each  tr in Task_Rejections[ID != 0]
                 			{
                 				trName = ifnull(tr.RSP_Name,"").trim();
                 				if(trName.toLowerCase() == vendorNameLower)
                 				{
                 					trLabel = ifnull(tr.RSID,"").toString().trim();
                 					if(trLabel != "")
                 					{
                 						trMap = Map();
                 						trAt = "";
                 						if(tr.Rejected_At != null)
                 						{
                 							trAt = tr.Rejected_At.toString();
                 						}
                 						trMap.put("Rejected_At",trAt);
                 						trMap.put("Reason",ifnull(tr.Reason,"").toString());
                 						rejectByLabel.put(trLabel,trMap);
                 					}
                 				}
                 			}
                 		}
                 		/* ---------- 4. the cases behind them ---------- */
                 		rows = List();
                 		seenTickets = List:String();
                 		vehicleNames = Map();
                 		issueNames = Map();
                 		// Every ticket to look at: invited ones by id, then rejection-only ones by
                 		// their label (a Case_ID, or a bare record id on older rows).
                 		lookups = List:String();
                 		inviteKeys = inviteByTicket.keys();
                 		for each  invKey in inviteKeys
                 		{
                 			lookups.add("id:" + invKey);
                 		}
                 		rejectKeys = rejectByLabel.keys();
                 		for each  trKey in rejectKeys
                 		{
                 			lookups.add("label:" + trKey);
                 		}
                 		for each  lk in lookups
                 		{
                 			// Ticket ids as text, not records: Deluge cannot read a field off an item
                 			// taken back out of a plain List ("Function applied over invalid
                 			// expression"), so each id is re-queried from Create_Case below.
                 			caseIdTexts = List:String();
                 			if(lk.startsWith("id:"))
                 			{
                 				idPart = lk.subText(3);
                 				idLong = 0;
                 				try 
                 				{
                 					idLong = idPart.toLong();
                 				}				catch (lkEx)
                 				{
                 					idLong = 0;
                 				}
                 				if(idLong > 0)
                 				{
                 					for each  c1 in Create_Case[ID == idLong]
                 					{
                 						caseIdTexts.add(c1.ID.toString());
                 					}
                 				}
                 			}
                 			else
                 			{
                 				labelPart = lk.subText(6);
                 				// Guarded: if Case_ID cannot be used as a criteria here, the bare-id
                 				// route below still runs instead of the whole call failing.
                 				try 
                 				{
                 					for each  c2 in Create_Case[Case_ID == labelPart]
                 					{
                 						caseIdTexts.add(c2.ID.toString());
                 					}
                 				}				catch (cidEx)
                 				{
                 					info "getMyInviteOutcomes - Case_ID lookup for " + labelPart + " failed: " + cidEx.toString();
                 				}
                 				if(caseIdTexts.size() == 0)
                 				{
                 					labelLong = 0;
                 					try 
                 					{
                 						labelLong = labelPart.toLong();
                 					}					catch (lbEx)
                 					{
                 						labelLong = 0;
                 					}
                 					if(labelLong > 0)
                 					{
                 						for each  c3 in Create_Case[ID == labelLong]
                 						{
                 							caseIdTexts.add(c3.ID.toString());
                 						}
                 					}
                 				}
                 			}
                 			for each  caseIdText in caseIdTexts
                 			{
                 				caseIdLong = 0;
                 				try 
                 				{
                 					caseIdLong = caseIdText.toLong();
                 				}				catch (cidLongEx)
                 				{
                 					caseIdLong = 0;
                 				}
                 				for each  caseRec in Create_Case[ID == caseIdLong]
                 				{
                 					tid = caseRec.ID.toString();
                 					if(seenTickets.contains(tid) == false)
                 					{
                 						seenTickets.add(tid);
                 						caseLabel = ifnull(caseRec.Case_ID,"").toString().trim();
                 						/* vehicle name - looked up once per id (as getVendorPayments) */
                 						vehicleText = "";
                 						vehRef = caseRec.Vehicle;
                 						if(vehRef != null)
                 						{
                 							vehId = vehRef.toString().trim();
                 							if(vehId != "")
                 							{
                 								if(vehicleNames.containKey(vehId))
                 								{
                 									vehicleText = vehicleNames.get(vehId);
                 								}
                 								else
                 								{
                 									vehLong = 0;
                 									try 
                 									{
                 										vehLong = vehId.toLong();
                 									}									catch (vehEx)
                 									{
                 										vehLong = 0;
                 									}
                 									if(vehLong > 0)
                 									{
                 										for each  vehRec in vehicle_master[ID == vehLong]
                 										{
                 											vehicleText = ifnull(vehRec.Name,"").toString().trim();
                 										}
                 									}
                 									vehicleNames.put(vehId,vehicleText);
                 								}
                 							}
                 						}
                 						/* issue names (as getVendorPayments) */
                 						issueText = "";
                 						issueRef = caseRec.Vehicle_Issue;
                 						if(issueRef != null)
                 						{
                 							issueRaw = issueRef.toString().replaceAll("[^0-9,]","");
                 							if(issueRaw != "")
                 							{
                 								issuePieces = issueRaw.toList(",");
                 								for each  issuePiece in issuePieces
                 								{
                 									if(issuePiece != "")
                 									{
                 										oneName = "";
                 										if(issueNames.containKey(issuePiece))
                 										{
                 											oneName = issueNames.get(issuePiece);
                 										}
                 										else
                 										{
                 											issueLong = 0;
                 											try 
                 											{
                 												issueLong = issuePiece.toLong();
                 											}											catch (issueEx)
                 											{
                 												issueLong = 0;
                 											}
                 											if(issueLong > 0)
                 											{
                 												for each  issueRec in Vehicle_Issue[ID == issueLong]
                 												{
                 													oneName = ifnull(issueRec.Issue_Name,"").toString().trim();
                 												}
                 											}
                 											issueNames.put(issuePiece,oneName);
                 										}
                 										if(oneName != "")
                 										{
                 											if(issueText == "")
                 											{
                 												issueText = oneName;
                 											}
                 											else
                 											{
                 												issueText = issueText + ", " + oneName;
                 											}
                 										}
                 									}
                 								}
                 							}
                 						}
                 						assignedText = "";
                 						if(caseRec.Assigned_Vendor != null)
                 						{
                 							assignedText = caseRec.Assigned_Vendor.toString().trim();
                 						}
                 						acceptRsr = "";
                 						if(caseRec.Service_Acceptance != null)
                 						{
                 							acceptRsr = caseRec.Service_Acceptance.toString();
                 						}
                 						acceptTow = "";
                 						if(caseRec.Service_Acceptance_For_Tow != null)
                 						{
                 							acceptTow = caseRec.Service_Acceptance_For_Tow.toString();
                 						}
                 						row = Map();
                 						row.put("ticketId",tid);
                 						row.put("Case_ID",caseLabel);
                 						row.put("Service_Type",ifnull(caseRec.Service_Type,"").toString());
                 						row.put("Status",ifnull(caseRec.Status,"").toString());
                 						row.put("Vehicle_Name",vehicleText);
                 						row.put("Issue_Names",issueText);
                 						row.put("Assigned_Vendor",assignedText);
                 						row.put("Service_Acceptance",acceptRsr);
                 						row.put("Service_Acceptance_For_Tow",acceptTow);
                 						if(inviteByTicket.containKey(tid))
                 						{
                 							row.put("invite",inviteByTicket.get(tid));
                 						}
                 						if(caseLabel != "")
                 						{
                 							if(rejectByLabel.containKey(caseLabel))
                 							{
                 								row.put("rejection",rejectByLabel.get(caseLabel));
                 							}
                 						}
                 						if(row.containKey("rejection") == false)
                 						{
                 							if(rejectByLabel.containKey(tid))
                 							{
                 								row.put("rejection",rejectByLabel.get(tid));
                 							}
                 						}
                 						rows.add(row);
                 					}
                 				}
                 			}
                 		}
                 		info "getMyInviteOutcomes - " + inviteByTicket.size() + " invite(s), " + rejectByLabel.size() + " rejection log row(s), " + rows.size() + " case(s) returned for vendor " + wanted;
                 		result.put("code","SUCCESS");
                 		result.put("verifiedBy",verifiedBy);
                 		result.put("vendorId",wanted);
                 		result.put("count",rows.size());
                 		result.put("rows",rows);
                 	}	catch (e)
                 	{
                 		info "getMyInviteOutcomes threw: " + e.toString();
                 		errMap = Map();
                 		errMap.put("code","ERROR");
                 		errMap.put("message","getMyInviteOutcomes threw an exception: " + e.toString());
                 		errMap.put("rows",emptyList);
                 		return errMap.toString();
                 	}
                 	return result.toString();
                 }
				 string getTaskRejections()
                 {
                 	returnstring = "";
                 	try 
                 	{
                 		// getTaskRejections - 2026-09-18, user request ("do the same thing for the
                 		// Task_Rejections_Report in vendorPerformance, get the info with refresh
                 		// token"). Same shape and same reasoning as getVehicleNames.deluge.
                 		//
                 		// Vendor/Technician/Driver portal profiles are refused
                 		// Task_Rejections_Report with {"code":2898,"message":"Permission denied to
                 		// view record(s)."}, and apiGetReport turns that refusal into an empty
                 		// array - so vendorPerformance silently reported zero rejections for every
                 		// vendor rather than saying it could not read them.
                 		//
                 		// This reads the report server-side with the app owner's own OAuth
                 		// credentials, the same refresh-token mechanism already proven in
                 		// submitCustomerLocation.deluge, paymentWebhook.deluge and
                 		// getVehicleNames.deluge.
                 		//
                 		// WHY A CUSTOM API: these credentials grant full Creator Data API access to
                 		// the whole application. Widget JavaScript is downloaded to every user's
                 		// browser, so a refresh token placed there would be readable by anyone who
                 		// opens the vendor app. Server-side Deluge is the only safe home for it.
                 		//
                 		// DELIBERATELY NARROW: returns only the three fields vendorPerformance
                 		// actually consumes - the record id, RSP_Name (how a rejection is matched
                 		// to a vendor, since Task_Rejections carries no confirmed vendor Lookup)
                 		// and Rejected_At (what the date-range filter reads). Not a general
                 		// report reader, which would let any portal user read anything.
                 		//
                 		// This is a FALLBACK. Granting the Vendor profile View on
                 		// Task_Rejections_Report is simpler and should be preferred; the widget
                 		// only calls this when the direct read comes back empty.
                 		ZC_CLIENT_ID = "1000.7BYOUWK2Q2XMJQWU62E6WHCRZOY9VW";
                 		ZC_CLIENT_SECRET = "a714fc6ab6c76d058196ceef8b49cad735422987fd";
                 		ZC_REFRESH_TOKEN = "1000.568bbdff83b5b398edb888ff31951dea.a5cbb7bbdd283c79ec801ebd10be426a";
                 		ZC_REPORT_URL = "https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/report/Task_Rejections_Report?max_records=1000&field_config=all";
                 		info "getTaskRejections - start " + zoho.currenttime;
                 		tokenResp = invokeurl
                 		[
                 			url :"https://accounts.zoho.in/oauth/v2/token?refresh_token=" + ZC_REFRESH_TOKEN + "&client_id=" + ZC_CLIENT_ID + "&client_secret=" + ZC_CLIENT_SECRET + "&grant_type=refresh_token"
                 			type :POST
                 		];
                 		accessToken = tokenResp.get("access_token");
                 		if(accessToken == null)
                 		{
                 			info "getTaskRejections - no access_token. Raw token response: " + tokenResp.toString();
                 			return "{\"code\": \"ERROR\", \"message\": \"Could not get an access token from the refresh token. See this Custom API execution log for the raw response.\", \"rejections\": []}";
                 		}
                 		readResp = invokeurl
                 		[
                 			url :ZC_REPORT_URL
                 			type :GET
                 			headers:{"Authorization":"Bearer " + accessToken}
                 		];
                 		respCode = readResp.get("code");
                 		info "getTaskRejections - read response code = " + ifnull(respCode,"(null)");
                 		if(respCode != 3000)
                 		{
                 			info "getTaskRejections - read FAILED. Raw response: " + readResp.toString();
                 			return "{\"code\": \"ERROR\", \"message\": \"Reading Task_Rejections_Report over the Data API did not return code 3000. See this Custom API execution log for the raw response.\", \"rejections\": []}";
                 		}
                 		// rejectionsList is initialised as a real List() before anything goes into
                 		// it. Deluge cannot infer the type of a value returned by .get(), and a
                 		// for-each over such a value fails to SAVE with "Variable is not defined"
                 		// - the exact error paymentWebhook.deluge hit on 2026-09-18.
                 		rejectionsList = List();
                 		if(readResp.get("data") != null)
                 		{
                 			rejectionsList = readResp.get("data").toList();
                 		}
                 		jsonParts = "";
                 		rowCount = 0;
                 		for each  rejectionRec in rejectionsList
                 		{
                 			idText = "";
                 			if(rejectionRec.get("ID") != null)
                 			{
                 				idText = rejectionRec.get("ID").toString().trim();
                 			}
                 			nameText = "";
                 			if(rejectionRec.get("RSP_Name") != null)
                 			{
                 				nameText = rejectionRec.get("RSP_Name").toString().trim();
                 			}
                 			rejectedAtText = "";
                 			if(rejectionRec.get("Rejected_At") != null)
                 			{
                 				rejectedAtText = rejectionRec.get("Rejected_At").toString().trim();
                 			}
                 			if(idText != "")
                 			{
                 				if(rowCount > 0)
                 				{
                 					jsonParts = jsonParts + ",";
                 				}
                 				jsonParts = jsonParts + "{\"id\":\"" + idText + "\",\"RSP_Name\":\"" + nameText + "\",\"Rejected_At\":\"" + rejectedAtText + "\"}";
                 				rowCount = rowCount + 1;
                 			}
                 		}
                 		info "getTaskRejections - returning " + rowCount + " rejection row(s).";
                 		returnstring = "{\"code\": \"SUCCESS\", \"count\": " + rowCount + ", \"rejections\": [" + jsonParts + "]}";
                 	}	catch (e)
                 	{
                 		info "getTaskRejections threw: " + e.toString();
                 		return "{\"code\": \"ERROR\", \"message\": \"getTaskRejections threw an exception. See this Custom API execution log.\", \"rejections\": []}";
                 	}
                 	return returnstring;
                 }
				 string getVehicleNames()
                 {
                 	returnstring = "";
                 	try 
                 	{
                 		// getVehicleNames - 2026-09-18. Vendor/Technician/Driver portal profiles
                 		// get {"code":2898,"message":"Permission denied to view record(s)."} when
                 		// their widget reads Vehicle_Master_Report directly, so every ticket card
                 		// shows a raw Lookup id (448881000000474018) instead of the vehicle name.
                 		// Issue names resolve fine on the same cards, which is what proves this is
                 		// access to this ONE report rather than anything wrong with the resolver.
                 		//
                 		// This reads the report server-side with the app owner's own OAuth
                 		// credentials and hands back just id + name - the same refresh-token
                 		// mechanism already proven in submitCustomerLocation.deluge and
                 		// paymentWebhook.deluge for writes the portal user was refused.
                 		//
                 		// WHY A CUSTOM API AND NOT THE WIDGET: these credentials grant full
                 		// Creator Data API access to the whole application. Widget JavaScript is
                 		// downloaded to every user's browser, so a refresh token placed there is
                 		// readable by anyone who opens the vendor app. Server-side Deluge is the
                 		// only place it can live safely.
                 		//
                 		// DELIBERATELY NARROW: this returns vehicle id/name pairs and nothing
                 		// else. A general "read any report" helper would let any portal user read
                 		// every report in the app through it, which is a bigger hole than the
                 		// permission gap it was meant to work around.
                 		//
                 		// This is a FALLBACK, not the primary path. Granting the Vendor profile
                 		// View on Vehicle_Master_Report is simpler and should be preferred; the
                 		// widget only calls this when the direct read comes back empty.
                 		ZC_CLIENT_ID = "1000.7BYOUWK2Q2XMJQWU62E6WHCRZOY9VW";
                 		ZC_CLIENT_SECRET = "a714fc6ab6c76d058196ceef8b49cad735422987fd";
                 		ZC_REFRESH_TOKEN = "1000.568bbdff83b5b398edb888ff31951dea.a5cbb7bbdd283c79ec801ebd10be426a";
                 		ZC_REPORT_URL = "https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/report/Vehicle_Master_Report?max_records=1000&field_config=all";
                 		info "getVehicleNames - start " + zoho.currenttime;
                 		tokenResp = invokeurl
                 		[
                 			url :"https://accounts.zoho.in/oauth/v2/token?refresh_token=" + ZC_REFRESH_TOKEN + "&client_id=" + ZC_CLIENT_ID + "&client_secret=" + ZC_CLIENT_SECRET + "&grant_type=refresh_token"
                 			type :POST
                 		];
                 		accessToken = tokenResp.get("access_token");
                 		if(accessToken == null)
                 		{
                 			info "getVehicleNames - no access_token. Raw token response: " + tokenResp.toString();
                 			return "{\"code\": \"ERROR\", \"message\": \"Could not get an access token from the refresh token. See this Custom API execution log for the raw response.\", \"vehicles\": []}";
                 		}
                 		readResp = invokeurl
                 		[
                 			url :ZC_REPORT_URL
                 			type :GET
                 			headers:{"Authorization":"Bearer " + accessToken}
                 		];
                 		respCode = readResp.get("code");
                 		info "getVehicleNames - read response code = " + ifnull(respCode,"(null)");
                 		if(respCode != 3000)
                 		{
                 			info "getVehicleNames - read FAILED. Raw response: " + readResp.toString();
                 			return "{\"code\": \"ERROR\", \"message\": \"Reading Vehicle_Master_Report over the Data API did not return code 3000. See this Custom API execution log for the raw response.\", \"vehicles\": []}";
                 		}
                 		// vehiclesList is initialised as a real List() before anything goes into
                 		// it. Deluge cannot infer the type of a value returned by .get(), and a
                 		// for-each over such a value fails to SAVE with "Variable is not defined"
                 		// - the exact error paymentWebhook.deluge hit on 2026-09-18.
                 		vehiclesList = List();
                 		if(readResp.get("data") != null)
                 		{
                 			vehiclesList = readResp.get("data").toList();
                 		}
                 		jsonParts = "";
                 		rowCount = 0;
                 		for each  vehicleRec in vehiclesList
                 		{
                 			idText = "";
                 			if(vehicleRec.get("ID") != null)
                 			{
                 				idText = vehicleRec.get("ID").toString().trim();
                 			}
                 			nameText = "";
                 			if(vehicleRec.get("Name") != null)
                 			{
                 				nameText = vehicleRec.get("Name").toString().trim();
                 			}
                 			if(nameText == "")
                 			{
                 				if(vehicleRec.get("Vehicle_Name") != null)
                 				{
                 					nameText = vehicleRec.get("Vehicle_Name").toString().trim();
                 				}
                 			}
                 			if(nameText == "")
                 			{
                 				if(vehicleRec.get("vehicle_name") != null)
                 				{
                 					nameText = vehicleRec.get("vehicle_name").toString().trim();
                 				}
                 			}
                 			if(idText != "")
                 			{
                 				if(nameText != "")
                 				{
                 					if(rowCount > 0)
                 					{
                 						jsonParts = jsonParts + ",";
                 					}
                 					jsonParts = jsonParts + "{\"id\":\"" + idText + "\",\"name\":\"" + nameText + "\"}";
                 					rowCount = rowCount + 1;
                 				}
                 			}
                 		}
                 		info "getVehicleNames - returning " + rowCount + " vehicle name(s).";
                 		if(rowCount == 0)
                 		{
                 			info "getVehicleNames - the report read succeeded but produced no id/name pairs. Either the report is empty, or its name field is not Name / Vehicle_Name / vehicle_name. First row keys would show which.";
                 		}
                 		returnstring = "{\"code\": \"SUCCESS\", \"count\": " + rowCount + ", \"vehicles\": [" + jsonParts + "]}";
                 	}	catch (e)
                 	{
                 		info "getVehicleNames threw: " + e.toString();
                 		return "{\"code\": \"ERROR\", \"message\": \"getVehicleNames threw an exception. See this Custom API execution log.\", \"vehicles\": []}";
                 	}
                 	return returnstring;
                 }
				 string getVehicleOptions()
                 {
                 	returnstring = "";
                 	try 
                 	{
                 		vehicleList = List();
                 		for each  veh in vehicle_master[ID != 0]
                 		{
                 			v = Map();
                 			v.put("id",veh.ID);
                 			vName = veh.Name;
                 			if(vName == null)
                 			{
                 				vName = "";
                 			}
                 			if(vName.toString() == "")
                 			{
                 				vName = "Vehicle " + veh.ID;
                 			}
                 			v.put("name",vName);
                 			vCategory = "";
                 			if(veh.Category != null)
                 			{
                 				vCategory = veh.Category.toString();
                 			}
                 			v.put("category",vCategory);
                 			vehicleList.add(v);
                 		}
                 		result = Map();
                 		result.put("code","SUCCESS");
                 		result.put("vehicles",vehicleList);
                 		returnstring = result.toString();
                 	}	catch (e)
                 	{
                 		errResult = Map();
                 		errResult.put("code","ERROR");
                 		errResult.put("message",e.toString());
                 		errResult.put("vehicles",List());
                 		returnstring = errResult.toString();
                 	}
                 	return returnstring;
                 }
				 string getVendorPayments(string vendorId)
                 {
                 	/* getVendorPayments - 2026-10-22, for the vendorPaymentInfo widget: the
                 	   logged-in vendor's OWN recorded payments, and nothing else.
                 
                 	   WHY A NEW API RATHER THAN getVendorTickets. That API serves
                 	   vendorPerformance and is left untouched. It also returns only four of the
                 	   payment fields, and it trusts whatever vendorId the browser sends - so any
                 	   logged-in vendor could ask for another vendor's cases. For a payment
                 	   statement that is not acceptable, so this API decides WHO is asking itself.
                 
                 	   IDENTITY, decided on the server:
                 	     1. zoho.loginuser is matched to a Vendors record by Email.
                 	     2. When it matches, that vendor's own id is used - and a request naming a
                 	        DIFFERENT vendor is refused outright, with no data.
                 	     3. When the login matches no vendor (an internal user testing the page,
                 	        or a portal setup where loginuser does not carry the portal user), the
                 	        requested vendorId is used - the same trust getVendorTickets gives
                 	        today, so the page still works. REQUIRE_LOGIN_MATCH = true closes that
                 	        route entirely once the reply's "verifiedBy" has been seen to read
                 	        "login" for real vendors.
                 
                 	   PAID CASES, PLUS APPROVED-BUT-UNPAID. The query asks Zoho for cases whose fee
                 	   is Paid, that carry GST_Paid, or that Operations has approved for payment
                 	   (Settlement_Status Payable - Task Tracker #7, 2026-10-29: the client's
                 	   "Unaccounted Tickets" view, "unaccounted means APPROVED but unpaid"), and keeps
                 	   only this vendor's. Unapproved work, and any other vendor's work, never leaves
                 	   the server. The page's Payment and GST views filter on Paid / GST_Paid
                 	   themselves, so the approved rows show only in the new Unaccounted view.
                 
                 	   READ-ONLY. No insert, update or delete anywhere in this function.
                 
                 	   Forms are queried directly (Create_Case, Vendors, vehicle_master,
                 	   Vehicle_Issue - the same direct form access createTicket and
                 	   getInboundCallerInfo already use), so no OAuth refresh token is needed and
                 	   none is copied into yet another file.
                 
                 	   Deluge shapes match ones already used live in this repo: no &&, no ternary,
                 	   a lookup null-checked before .toString(), at most two methods off ifnull(),
                 	   and the reply built as a Map so every value is escaped correctly. */
                 	REQUIRE_LOGIN_MATCH = false;
                 	result = Map();
                 	emptyList = List();
                 	try 
                 	{
                 		requested = ifnull(vendorId,"").trim();
                 		/* ---------- 1. who is calling ---------- */
                 		callerEmail = ifnull(zoho.loginuser,"").trim();
                 		callerEmail = callerEmail.toLowerCase();
                 		verifiedId = "";
                 		if(callerEmail != "")
                 		{
                 			for each  vRec in vendors[ID != 0]
                 			{
                 				if(verifiedId == "")
                 				{
                 					vEmail = ifnull(vRec.Email,"").trim();
                 					if(vEmail.toLowerCase() == callerEmail)
                 					{
                 						verifiedId = vRec.ID.toString();
                 					}
                 				}
                 			}
                 		}
                 		wanted = "";
                 		verifiedBy = "";
                 		if(verifiedId != "")
                 		{
                 			if(requested != "")
                 			{
                 				if(requested != verifiedId)
                 				{
                 					info "getVendorPayments - REFUSED: login " + callerEmail + " is vendor " + verifiedId + " but asked for vendor " + requested;
                 					result.put("code","ERROR");
                 					result.put("message","This login belongs to a different vendor than the one requested, so nothing was returned.");
                 					result.put("tickets",emptyList);
                 					return result.toString();
                 				}
                 			}
                 			wanted = verifiedId;
                 			verifiedBy = "login";
                 		}
                 		else
                 		{
                 			if(REQUIRE_LOGIN_MATCH)
                 			{
                 				result.put("code","ERROR");
                 				result.put("message","This login is not linked to any vendor record, so no payments can be shown.");
                 				result.put("tickets",emptyList);
                 				return result.toString();
                 			}
                 			wanted = requested;
                 			verifiedBy = "request";
                 		}
                 		if(wanted == "")
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","No vendor could be identified for this login, and no vendorId was sent.");
                 			result.put("tickets",emptyList);
                 			return result.toString();
                 		}
                 		info "getVendorPayments - vendor " + wanted + " (identified by " + verifiedBy + ", login " + callerEmail + ")";
                 		/* ---------- 2. the vendor's own record ---------- */
                 		wantedLong = 0;
                 		try 
                 		{
                 			wantedLong = wanted.toLong();
                 		}		catch (idEx)
                 		{
                 			wantedLong = 0;
                 		}
                 		vendorFound = false;
                 		vendorEmail = "";
                 		vendorName = "";
                 		fleetId = "";
                 		gstNo = "";
                 		for each  meRec in vendors[ID == wantedLong]
                 		{
                 			vendorFound = true;
                 			vendorEmail = ifnull(meRec.Email,"").trim();
                 			vendorEmail = vendorEmail.toLowerCase();
                 			vendorName = ifnull(meRec.vendor_name,"").trim();
                 			fleetId = ifnull(meRec.Fleet_ID,"").trim();
                 			gstNo = ifnull(meRec.Vendor_GST_Number,"").trim();
                 		}
                 		if(vendorFound == false)
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","No vendor record exists with id " + wanted + ".");
                 			result.put("tickets",emptyList);
                 			return result.toString();
                 		}
                 		/* ---------- 3. this vendor's paid cases ---------- */
                 		vehicleNames = Map();
                 		issueNames = Map();
                 		tickets = List();
                 		/* Every vendor id, and email -> vendor id - 2026-10-27. Lets each case be
                 		   given to a vendor by the SAME rule Accounts Payable pays it under (see
                 		   below), so whatever Accounts pay shows on that vendor's page and on no
                 		   other. Email is the only email field on the Vendors form (FIELDS.md); the
                 		   first vendor holding an address keeps it. */
                 		allVendorIds = List:String();
                 		vendorIdByEmail = Map();
                 		for each  avRec in vendors[ID != 0]
                 		{
                 			avId = avRec.ID.toString();
                 			allVendorIds.add(avId);
                 			avEmail = ifnull(avRec.Email,"").trim();
                 			avEmail = avEmail.toLowerCase();
                 			if(avEmail != "")
                 			{
                 				if(vendorIdByEmail.containKey(avEmail) == false)
                 				{
                 					vendorIdByEmail.put(avEmail,avId);
                 				}
                 			}
                 		}
                 		for each  caseRec in Create_Case[Vendor_Payment_Status == "Paid" || GST_Paid > 0 || Settlement_Status == "Payable"]
                 		{
                 			/* Assigned_Vendor first; the ticket's vendor email only when that is
                 			   blank - the same order Accounts Payable uses, which is what keeps
                 			   cases accepted during the old vendor-identity bug visible. */
                 			mine = false;
                 			assignedText = "";
                 			assignedRef = caseRec.Assigned_Vendor;
                 			if(assignedRef != null)
                 			{
                 				assignedText = assignedRef.toString().trim();
                 			}
                 			/* SAME RULE AS ACCOUNTS PAYABLE - 2026-10-27 (its vendorOptForTicket()).
                 			   1. Assigned_Vendor, when it names a real vendor, decides the case.
                 			   2. Otherwise - blank, or an id that is no vendor - the FIRST filled email
                 			      field (Vendor_Email, then Vendor_Email1, then Vendor_Email2) that belongs
                 			      to a vendor decides it.
                 			   Before this, a stale Assigned_Vendor hid a case Accounts had paid, and a
                 			   case could show to any vendor named in ANY of the three email fields. */
                 			ownerResolved = false;
                 			if(assignedText != "")
                 			{
                 				if(allVendorIds.contains(assignedText))
                 				{
                 					ownerResolved = true;
                 					if(assignedText == wanted)
                 					{
                 						mine = true;
                 					}
                 				}
                 			}
                 			if(ownerResolved == false)
                 			{
                 				emailOwner = "";
                 				e1 = ifnull(caseRec.Vendor_Email,"").trim();
                 				e2 = ifnull(caseRec.Vendor_Email1,"").trim();
                 				e3 = ifnull(caseRec.Vendor_Email2,"").trim();
                 				e1 = e1.toLowerCase();
                 				e2 = e2.toLowerCase();
                 				e3 = e3.toLowerCase();
                 				if(e1 != "")
                 				{
                 					if(vendorIdByEmail.containKey(e1))
                 					{
                 						emailOwner = vendorIdByEmail.get(e1);
                 					}
                 				}
                 				if(emailOwner == "")
                 				{
                 					if(e2 != "")
                 					{
                 						if(vendorIdByEmail.containKey(e2))
                 						{
                 							emailOwner = vendorIdByEmail.get(e2);
                 						}
                 					}
                 				}
                 				if(emailOwner == "")
                 				{
                 					if(e3 != "")
                 					{
                 						if(vendorIdByEmail.containKey(e3))
                 						{
                 							emailOwner = vendorIdByEmail.get(e3);
                 						}
                 					}
                 				}
                 				if(emailOwner != "")
                 				{
                 					if(emailOwner == wanted)
                 					{
                 						mine = true;
                 					}
                 				}
                 			}
                 			if(mine)
                 			{
                 				/* vehicle name - looked up once per id */
                 				vehicleText = "";
                 				vehRef = caseRec.Vehicle;
                 				if(vehRef != null)
                 				{
                 					vehId = vehRef.toString().trim();
                 					if(vehId != "")
                 					{
                 						if(vehicleNames.containKey(vehId))
                 						{
                 							vehicleText = vehicleNames.get(vehId);
                 						}
                 						else
                 						{
                 							vehLong = 0;
                 							try 
                 							{
                 								vehLong = vehId.toLong();
                 							}							catch (vehEx)
                 							{
                 								vehLong = 0;
                 							}
                 							if(vehLong > 0)
                 							{
                 								for each  vehRec in vehicle_master[ID == vehLong]
                 								{
                 									vehicleText = ifnull(vehRec.Name,"").toString().trim();
                 								}
                 							}
                 							vehicleNames.put(vehId,vehicleText);
                 						}
                 					}
                 				}
                 				/* issue names - a multi-lookup, read as text and split, the same
                 				   list handling createTicket uses for its own issue input */
                 				issueText = "";
                 				issueRef = caseRec.Vehicle_Issue;
                 				if(issueRef != null)
                 				{
                 					// Keep digits and commas only - drops the brackets and spaces a
                 					// list prints with, without needing any escaped regex characters.
                 					issueRaw = issueRef.toString().replaceAll("[^0-9,]","");
                 					if(issueRaw != "")
                 					{
                 						issuePieces = issueRaw.toList(",");
                 						for each  issuePiece in issuePieces
                 						{
                 							if(issuePiece != "")
                 							{
                 								oneName = "";
                 								if(issueNames.containKey(issuePiece))
                 								{
                 									oneName = issueNames.get(issuePiece);
                 								}
                 								else
                 								{
                 									issueLong = 0;
                 									try 
                 									{
                 										issueLong = issuePiece.toLong();
                 									}									catch (issueEx)
                 									{
                 										issueLong = 0;
                 									}
                 									if(issueLong > 0)
                 									{
                 										for each  issueRec in Vehicle_Issue[ID == issueLong]
                 										{
                 											oneName = ifnull(issueRec.Issue_Name,"").toString().trim();
                 										}
                 									}
                 									issueNames.put(issuePiece,oneName);
                 								}
                 								if(oneName != "")
                 								{
                 									if(issueText == "")
                 									{
                 										issueText = oneName;
                 									}
                 									else
                 									{
                 										issueText = issueText + ", " + oneName;
                 									}
                 								}
                 							}
                 						}
                 					}
                 				}
                 				row = Map();
                 				row.put("ID",caseRec.ID.toString());
                 				row.put("Case_ID",ifnull(caseRec.Case_ID,"").toString());
                 				row.put("Service_Type",ifnull(caseRec.Service_Type,"").toString());
                 				row.put("Status",ifnull(caseRec.Status,"").toString());
                 				row.put("Closure_Status",ifnull(caseRec.Closure_Status,"").toString());
                 				row.put("Service_Acceptance",ifnull(caseRec.Service_Acceptance,"").toString());
                 				row.put("Service_Acceptance_For_Tow",ifnull(caseRec.Service_Acceptance_For_Tow,"").toString());
                 				row.put("Vehicle_Name",vehicleText);
                 				row.put("Issue_Names",issueText);
                 				row.put("Vendor_Payment_Status",ifnull(caseRec.Vendor_Payment_Status,"").toString());
                 				row.put("Settlement_Status",ifnull(caseRec.Settlement_Status,"").toString());
                 				row.put("Vendor_Payment_Date",ifnull(caseRec.Vendor_Payment_Date,"").toString());
                 				row.put("Vendor_UTR_No",ifnull(caseRec.Vendor_UTR_No,"").toString());
                 				row.put("Vendor_Amount_Paid",ifnull(caseRec.Vendor_Amount_Paid,"").toString());
                 				row.put("Vendor_Gross_Fee",ifnull(caseRec.Vendor_Gross_Fee,"").toString());
                 				row.put("Vendor_KM_Fee",ifnull(caseRec.Vendor_KM_Fee,"").toString());
                 				row.put("Extras",ifnull(caseRec.Extras,"").toString());
                 				row.put("Vendor_Net_Fee",ifnull(caseRec.Vendor_Net_Fee,"").toString());
                 				row.put("TDS_Amount",ifnull(caseRec.TDS_Amount,"").toString());
                 				row.put("Cash_Collected",ifnull(caseRec.Cash_Collected,"").toString());
                 				row.put("Vendor_Balance_Before_TDS",ifnull(caseRec.Vendor_Balance_Before_TDS,"").toString());
                 				row.put("Final_Payable",ifnull(caseRec.Final_Payable,"").toString());
                 				row.put("GST_Payable",ifnull(caseRec.GST_Payable,"").toString());
                 				row.put("GST_Paid",ifnull(caseRec.GST_Paid,"").toString());
                 				row.put("GST_Paid_Date",ifnull(caseRec.GST_Paid_Date,"").toString());
                 				row.put("GST_UTR_No",ifnull(caseRec.GST_UTR_No,"").toString());
                 				// Comments from Operations Approval / Accounts Payable - shown to the vendor
                 				// by client decision 2026-10-27.
                 				row.put("Ops_Approval_Comments",ifnull(caseRec.Ops_Approval_Comments,"").toString());
                 				tickets.add(row);
                 			}
                 		}
                 		vendorMap = Map();
                 		vendorMap.put("id",wanted);
                 		vendorMap.put("name",vendorName);
                 		vendorMap.put("fleetId",fleetId);
                 		gstApplicable = "false";
                 		if(gstNo != "")
                 		{
                 			gstApplicable = "true";
                 		}
                 		vendorMap.put("gstApplicable",gstApplicable);
                 		info "getVendorPayments - returning " + tickets.size() + " paid or approved case(s) for vendor " + wanted;
                 		result.put("code","SUCCESS");
                 		result.put("verifiedBy",verifiedBy);
                 		result.put("vendor",vendorMap);
                 		result.put("count",tickets.size());
                 		result.put("tickets",tickets);
                 	}	catch (e)
                 	{
                 		info "getVendorPayments threw: " + e.toString();
                 		errMap = Map();
                 		errMap.put("code","ERROR");
                 		errMap.put("message","getVendorPayments threw an exception: " + e.toString());
                 		errMap.put("tickets",emptyList);
                 		return errMap.toString();
                 	}
                 	return result.toString();
                 }
				 string getVendorTickets(string vendorId)
                 {
                 	returnstring = "";
                 	try 
                 	{
                 		// getVendorTickets - 2026-09-18, user request: Agent_Ticket_Report and
                 		// Task_Rejections_Report should both be read with the refresh token on the
                 		// Vendor Performance page. Task_Rejections is covered by
                 		// getTaskRejections.deluge; this is the ticket half.
                 		//
                 		// FILTERS SERVER-SIDE, which the direct read never did. vendorPerformance
                 		// used to pull all 1000 tickets into the vendor's browser and keep only the
                 		// ones assigned to them - so every vendor was downloading every other
                 		// vendor's cases, including customer names and money fields. Filtering here
                 		// fixes that as well as making the response small enough to build as JSON,
                 		// which a 1000-row dump would not be.
                 		//
                 		// Returns the 23 fields vendorPerformance actually reads. The four closure
                 		// timestamps were added 2026-09-23: without them that page could only date
                 		// a ticket by Added_Time, so "Completed" for a period meant "created in
                 		// that period AND complete" rather than "completed in that period". Assigned_Vendor
                 		// is included as a bare id so the widget's own existing client-side filter
                 		// still matches and needed no change.
                 		//
                 		// Credentials live here rather than in the widget for the reason set out in
                 		// getVehicleNames.deluge: widget JavaScript is downloaded to every user's
                 		// browser.
                 		//
                 		// THIS IS THE PRIMARY AND ONLY PATH as of 2026-09-18. vendorPerformance no
                 		// longer reads Agent_Ticket_Report directly at all - that call was removed
                 		// on the user's instruction once this API was working, because a Vendor
                 		// portal profile is refused the report anyway and the read was a
                 		// guaranteed-wasted fetch of all 1000 rows. If this API stops working, the
                 		// Vendor Performance page shows no cases; there is no second route behind
                 		// it any more.
                 		if(vendorId == null)
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"vendorId is required\", \"tickets\": []}";
                 		}
                 		if(vendorId.trim() == "")
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"vendorId is required\", \"tickets\": []}";
                 		}
                 		wantedVendor = vendorId.trim();
                 		ZC_CLIENT_ID = "1000.7BYOUWK2Q2XMJQWU62E6WHCRZOY9VW";
                 		ZC_CLIENT_SECRET = "a714fc6ab6c76d058196ceef8b49cad735422987fd";
                 		ZC_REFRESH_TOKEN = "1000.568bbdff83b5b398edb888ff31951dea.a5cbb7bbdd283c79ec801ebd10be426a";
                 		ZC_REPORT_URL = "https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/report/Agent_Ticket_Report?max_records=1000&field_config=all";
                 		info "getVendorTickets - start " + zoho.currenttime + " | vendorId = " + wantedVendor;
                 		tokenResp = invokeurl
                 		[
                 			url :"https://accounts.zoho.in/oauth/v2/token?refresh_token=" + ZC_REFRESH_TOKEN + "&client_id=" + ZC_CLIENT_ID + "&client_secret=" + ZC_CLIENT_SECRET + "&grant_type=refresh_token"
                 			type :POST
                 		];
                 		accessToken = tokenResp.get("access_token");
                 		if(accessToken == null)
                 		{
                 			info "getVendorTickets - no access_token. Raw token response: " + tokenResp.toString();
                 			return "{\"code\": \"ERROR\", \"message\": \"Could not get an access token from the refresh token. See this Custom API execution log.\", \"tickets\": []}";
                 		}
                 		readResp = invokeurl
                 		[
                 			url :ZC_REPORT_URL
                 			type :GET
                 			headers:{"Authorization":"Bearer " + accessToken}
                 		];
                 		respCode = readResp.get("code");
                 		info "getVendorTickets - read response code = " + ifnull(respCode,"(null)");
                 		if(respCode != 3000)
                 		{
                 			info "getVendorTickets - read FAILED. Raw response: " + readResp.toString();
                 			return "{\"code\": \"ERROR\", \"message\": \"Reading Agent_Ticket_Report over the Data API did not return code 3000. See this Custom API execution log.\", \"tickets\": []}";
                 		}
                 		// Real List() before the for-each - Deluge cannot infer the type of a value
                 		// returned by .get(), and a for-each over one fails to SAVE.
                 		ticketsList = List();
                 		if(readResp.get("data") != null)
                 		{
                 			ticketsList = readResp.get("data").toList();
                 		}
                 		info "getVendorTickets - " + ticketsList.size() + " total ticket(s) fetched, filtering to vendor " + wantedVendor;
                 		fieldNames = List();
                 		fieldNames.add("Case_ID");
                 		fieldNames.add("Added_Time");
                 		fieldNames.add("Status");
                 		fieldNames.add("Closure_Status");
                 		fieldNames.add("Issue_Resolved");
                 		fieldNames.add("Cx_Feedback_Score");
                 		fieldNames.add("Reach_Time");
                 		fieldNames.add("ETA");
                 		fieldNames.add("ETA_TOW");
                 		fieldNames.add("Agent_ETA_Override");
                 		fieldNames.add("Agent_ETA_Override_TOW");
                 		fieldNames.add("Service_Acceptance");
                 		fieldNames.add("Service_Acceptance_For_Tow");
                 		fieldNames.add("RSP_Closure_Time");
                 		fieldNames.add("Agent_Closure_Time");
                 		fieldNames.add("RSP_Completion_Time");
                 		fieldNames.add("Cancellation_Time");
                 		fieldNames.add("Settlement_Status");
                 		fieldNames.add("Vendor_Payment_Status");
                 		fieldNames.add("Vendor_Balance_Before_TDS");
                 		fieldNames.add("Vendor_Amount_Paid");
                 		fieldNames.add("TDS_Amount");
                 		jsonParts = "";
                 		rowCount = 0;
                 		for each  ticketRec in ticketsList
                 		{
                 			// Assigned_Vendor comes back either as a bare id or as a Lookup object
                 			// carrying an ID - unwrap both, same convention the widgets' own
                 			// lookupId() uses.
                 			vendorOnTicket = "";
                 			assignedRaw = ticketRec.get("Assigned_Vendor");
                 			if(assignedRaw != null)
                 			{
                 				try 
                 				{
                 					if(assignedRaw.get("ID") != null)
                 					{
                 						vendorOnTicket = assignedRaw.get("ID").toString().trim();
                 					}
                 				}				catch (unwrapEx)
                 				{
                 					vendorOnTicket = "";
                 				}
                 				if(vendorOnTicket == "")
                 				{
                 					vendorOnTicket = assignedRaw.toString().trim();
                 				}
                 			}
                 			if(vendorOnTicket == wantedVendor)
                 			{
                 				rowJson = "{\"ID\":\"" + ifnull(ticketRec.get("ID"),"").toString() + "\",\"Assigned_Vendor\":\"" + vendorOnTicket + "\"";
                 				for each  fieldName in fieldNames
                 				{
                 					fieldValue = "";
                 					if(ticketRec.get(fieldName) != null)
                 					{
                 						fieldValue = ticketRec.get(fieldName).toString().trim();
                 					}
                 					rowJson = rowJson + ",\"" + fieldName + "\":\"" + fieldValue + "\"";
                 				}
                 				rowJson = rowJson + "}";
                 				if(rowCount > 0)
                 				{
                 					jsonParts = jsonParts + ",";
                 				}
                 				jsonParts = jsonParts + rowJson;
                 				rowCount = rowCount + 1;
                 			}
                 		}
                 		info "getVendorTickets - returning " + rowCount + " ticket(s) for vendor " + wantedVendor;
                 		returnstring = "{\"code\": \"SUCCESS\", \"count\": " + rowCount + ", \"tickets\": [" + jsonParts + "]}";
                 	}	catch (e)
                 	{
                 		info "getVendorTickets threw: " + e.toString();
                 		return "{\"code\": \"ERROR\", \"message\": \"getVendorTickets threw an exception. See this Custom API execution log.\", \"tickets\": []}";
                 	}
                 	return returnstring;
                 }
				 string getVoiceCallbackDetails(string customerId, string phoneNumber, string callbackMessage, string accountId, string agentId)
                 {
                 	try 
                 	{
                 		OZONETEL_API_URL = "https://in1-ccaas-api.ozonetel.com/ca_apis/AgentManualDial";
                 		OZONETEL_CAMPAIGN = "zoho_08045614580";
                 		OZONETEL_ACCOUNT = "rescue_vehicle";
                 		OZONETEL_AGENT_ID = "Sagar";
                 		OZONETEL_API_KEY = "KKb437079c7866db0ac92b8a90420a0602";
                 		info "========== VOICE CALLBACK REQUEST ==========";
                 		if(OZONETEL_API_URL == "REPLACE_WITH_REAL_OZONETEL_API_URL")
                 		{
                 			info "CONFIG ERROR: OZONETEL_API_URL is still the placeholder.";
                 			return "{\"code\": \"ERROR\", \"message\": \"Ozonetel API URL is not configured in getVoiceCallbackDetails.deluge - no call was placed.\"}";
                 		}
                 		if(OZONETEL_CAMPAIGN == "REPLACE_WITH_REAL_CAMPAIGN_NAME")
                 		{
                 			info "CONFIG ERROR: OZONETEL_CAMPAIGN is still the placeholder.";
                 			return "{\"code\": \"ERROR\", \"message\": \"Ozonetel campaign name is not configured in getVoiceCallbackDetails.deluge - no call was placed.\"}";
                 		}
                 		if(customerId == null || customerId == "")
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"Customer ID is required\"}";
                 		}
                 		if(phoneNumber == null || phoneNumber == "")
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"Phone Number is required\"}";
                 		}
                 		callbackMessageText = "";
                 		if(callbackMessage != null)
                 		{
                 			callbackMessageText = callbackMessage;
                 		}
                 		accountToUse = OZONETEL_ACCOUNT;
                 		if(accountId != null)
                 		{
                 			if(accountId.trim() != "")
                 			{
                 				accountToUse = accountId.trim();
                 			}
                 		}
                 		agentToUse = OZONETEL_AGENT_ID;
                 		if(agentId != null)
                 		{
                 			if(agentId.trim() != "")
                 			{
                 				agentToUse = agentId.trim();
                 			}
                 		}
                 		info "ALL VALIDATIONS PASSED";
                 		info "Ticket reference (customerId) = " + customerId + " | callbackMessage = " + callbackMessageText;
                 		info "Using account '" + accountToUse + "' and agent '" + agentToUse + "' and campaign '" + OZONETEL_CAMPAIGN + "'";
                 		callbackPayload = Map();
                 		callbackPayload.put("userName",accountToUse);
                 		callbackPayload.put("customerNumber",phoneNumber);
                 		callbackPayload.put("agentID",agentToUse);
                 		callbackPayload.put("campaignName",OZONETEL_CAMPAIGN);
                 		jsonPayload = callbackPayload.toString();
                 		info "Callback Payload: " + jsonPayload;
                 		apiKeyMasked = OZONETEL_API_KEY.subText(0,8) + "...(" + OZONETEL_API_KEY.length() + " chars)";
                 		info "---------- BEFORE API CALL ----------";
                 		info "  Time         : " + zoho.currenttime;
                 		info "  Method       : POST";
                 		info "  URL          : " + OZONETEL_API_URL;
                 		info "  Header accept: application/json";
                 		info "  Header Content-Type: application/json";
                 		info "  Header apiKey: " + apiKeyMasked;
                 		info "  Body         : " + jsonPayload;
                 		info "  userName     : [" + accountToUse + "]";
                 		info "  agentID      : [" + agentToUse + "]";
                 		info "  campaignName : [" + OZONETEL_CAMPAIGN + "]";
                 		info "  customerNumber: [" + phoneNumber + "]";
                 		callbackResp = invokeurl
                 		[
                 			url :OZONETEL_API_URL
                 			type :POST
                 			parameters:jsonPayload
                 			headers:{"accept":"application/json","Content-Type":"application/json","apiKey":OZONETEL_API_KEY}
                 		];
                 		info "---------- AFTER API CALL ----------";
                 		info "  Time         : " + zoho.currenttime;
                 		rawRespText = callbackResp.toString();
                 		rawRespLength = rawRespText.length();
                 		info "  Response length: " + rawRespLength;
                 		if(rawRespLength > 500)
                 		{
                 			rawRespText = rawRespText.subText(0,500);
                 		}
                 		info "  Raw response : " + rawRespText;
                 		try 
                 		{
                 			info "  field status : [" + ifnull(callbackResp.get("status"),"(missing)") + "]";
                 			info "  field message: [" + ifnull(callbackResp.get("message"),"(missing)") + "]";
                 			info "  field ucid   : [" + ifnull(callbackResp.get("ucid"),"(missing)") + "]";
                 			info "  field code   : [" + ifnull(callbackResp.get("code"),"(missing)") + "]";
                 			info "  field result : [" + ifnull(callbackResp.get("result"),"(missing)") + "]";
                 		}		catch (fieldEx)
                 		{
                 			info "  could not read named fields from the response - it is probably not a JSON object. Raw text above is the full answer. " + fieldEx.toString();
                 		}
                 		info "-------------------------------------";
                 		if(rawRespLength > 5000)
                 		{
                 			info "WARNING: the response is " + rawRespLength + " characters. A real API reply is small; this size means OZONETEL_API_URL is almost certainly pointing at a web page rather than an API endpoint.";
                 		}
                 		respStatus = callbackResp.get("status");
                 		statusText = ifnull(respStatus,"").toString().trim();
                 		statusLower = statusText.toLowerCase();
                 		callFailed = false;
                 		if(statusLower == "false")
                 		{
                 			callFailed = true;
                 		}
                 		if(statusLower.contains("fail"))
                 		{
                 			callFailed = true;
                 		}
                 		if(statusLower.contains("error"))
                 		{
                 			callFailed = true;
                 		}
                 		if(callFailed)
                 		{
                 			errMsg = ifnull(callbackResp.get("message"),statusText).toString();
                 			info "Dial request REJECTED by Ozonetel: " + errMsg;
                 			return "{\"code\": \"ERROR\", \"message\": \"" + errMsg + "\", \"status\": \"FAILED\"}";
                 		}
                 		uniqueCallId = callbackResp.get("ucid");
                 		ucidText = "";
                 		if(uniqueCallId != null)
                 		{
                 			ucidText = uniqueCallId.toString().trim();
                 		}
                 		if(ucidText == "null")
                 		{
                 			ucidText = "";
                 		}
                 		callAccepted = false;
                 		if(ucidText != "")
                 		{
                 			callAccepted = true;
                 		}
                 		if(statusLower.contains("queue"))
                 		{
                 			callAccepted = true;
                 		}
                 		if(statusLower.contains("success"))
                 		{
                 			callAccepted = true;
                 		}
                 		if(callAccepted == false)
                 		{
                 			info "Ozonetel neither accepted nor rejected clearly - status was [" + statusText + "] and no ucid was returned. Treating as a failure so it is not reported as a placed call.";
                 			return "{\"code\": \"ERROR\", \"message\": \"Ozonetel did not confirm the dial request. Raw status: " + statusText + "\", \"status\": \"UNCONFIRMED\"}";
                 		}
                 		info "DIAL REQUEST ACCEPTED - status [" + statusText + "] ucid [" + ucidText + "]";
                 		successResponse = "{\"code\": \"SUCCESS\", \"message\": \"" + statusText + "\", \"ucid\": \"" + ucidText + "\", \"phone_number\": \"" + phoneNumber + "\", \"reference\": \"" + customerId + "\"}";
                 		info "========== COMPLETE ==========";
                 		return successResponse;
                 	}	catch (e)
                 	{
                 		info "Exception: " + e.toString();
                 		return "{\"code\": \"ERROR\", \"message\": \"Exception: " + e.toString() + "\", \"status\": \"ERROR\"}";
                 	}
                 	return "{\"code\": \"ERROR\", \"message\": \"Unknown script execution error\"}";
                 }
				 string notifyVendorInvite(string vendorEmails, string caseId, string serviceType, string vehicle, string issue, string customerArea)
                 {
                 	try 
                 	{
                 		info "========== VENDOR INVITE NOTIFICATION ==========";
                 		info "  time         = " + zoho.currenttime;
                 		info "  vendorEmails = [" + ifnull(vendorEmails,"(null)") + "]";
                 		info "  caseId       = [" + ifnull(caseId,"(null)") + "]";
                 		recipients = ifnull(vendorEmails,"").trim();
                 		if(recipients == "")
                 		{
                 			info "  NO RECIPIENTS - nothing sent. The ticket and its Invites records are unaffected.";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NO_RECIPIENTS\", \"sent\": false, \"message\": \"No vendor email addresses were supplied, so no invite notification was sent. The assignment itself is unaffected. Check that the selected vendors have an email on their Vendors record.\"}";
                 		}
                 		caseText = ifnull(caseId,"").trim();
                 		if(caseText == "")
                 		{
                 			caseText = "(no case id)";
                 		}
                 		serviceText = ifnull(serviceType,"").trim();
                 		if(serviceText == "")
                 		{
                 			serviceText = "-";
                 		}
                 		vehicleText = ifnull(vehicle,"").trim();
                 		if(vehicleText == "")
                 		{
                 			vehicleText = "-";
                 		}
                 		issueText = ifnull(issue,"").trim();
                 		if(issueText == "")
                 		{
                 			issueText = "-";
                 		}
                 		areaText = ifnull(customerArea,"").trim();
                 		if(areaText == "")
                 		{
                 			areaText = "-";
                 		}
                 		subjectLine = "New RESCUE job available - " + caseText + " (" + serviceText + ")";
                 		bodyText = "A new Roadside Assistance job has been offered to you.";
                 		bodyText = bodyText + "\n\nCase ID      : " + caseText;
                 		bodyText = bodyText + "\nService Type : " + serviceText;
                 		bodyText = bodyText + "\nVehicle      : " + vehicleText;
                 		bodyText = bodyText + "\nIssue        : " + issueText;
                 		bodyText = bodyText + "\nArea         : " + areaText;
                 		bodyText = bodyText + "\n\nOpen your RESCUE vendor app to accept or reject this job.";
                 		bodyText = bodyText + "\nJobs are offered to more than one provider, so please respond promptly.";
                 		bodyText = bodyText + "\n\nThis is an automated message - please do not reply.";
                 		info "  subject = " + subjectLine;
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :recipients
                 			subject :subjectLine
                 			message :bodyText
                 		]
                 		info "  SENT to " + recipients;
                 		info "===============================================";
                 		return "{\"code\": \"SUCCESS\", \"result\": \"SENT\", \"sent\": true, \"recipients\": \"" + recipients + "\", \"case_id\": \"" + caseText + "\", \"message\": \"Invite notification emailed to the vendors listed in recipients.\"}";
                 	}	catch (e)
                 	{
                 		info "notifyVendorInvite threw (no email sent, assignment unaffected): " + e.toString();
                 		return "{\"code\": \"SUCCESS\", \"result\": \"EXCEPTION\", \"sent\": false, \"exception\": \"" + e.toString() + "\", \"message\": \"The notification failed. This never blocks the assignment - the Invites records were still created and the vendor can still see the job in their app.\"}";
                 	}
                 	return "{\"code\": \"SUCCESS\", \"result\": \"NO_RESULT\", \"sent\": false, \"message\": \"The script finished without reaching any known outcome.\"}";
                 }
				 string onDemandInvoicing(string recordId, string referenceNumber, string customerName, string customerPhone, string customerEmail, string gstNumber, string serviceLabel, string totalAmount, string serviceCharges, string cgst, string sgst, string roundOff, string applyTax, string customerPhoneDigits, string expiresAt, string bookingFeeAmount, string bookingFeeRef, string remainingFeeAmount, string remainingFeeRef, string vehicleMake, string registrationNumber, string serviceDate, string serviceType, string serviceDescription, string paymentMode)
                 {
                 	// ⚠ 4 NEW PARAMETERS ADDED 2026-09-14 (bookingFeeAmount, bookingFeeRef,
                 	// remainingFeeAmount, remainingFeeRef) — for the "one final invoice per
                 	// ticket, with both collected payments recorded against it" flow
                 	// (explicit user decision, 2026-09-14: booking fee up front + remaining
                 	// fee at closure, but ONE invoice showing all fees). REMEMBER: Zoho
                 	// Creator Custom APIs require every parameter to ALSO be registered in
                 	// the Custom API's own setup screen — a parameter that exists only in
                 	// this signature silently arrives as null no matter what the widget
                 	// sends. That exact trap already bit this file once before (see
                 	// applyTax's own "belt-and-braces fallback" comment further down).
                 	// Register all 4 there before testing, or payment recording will simply
                 	// no-op (safely — the invoice itself is unaffected).
                 	//
                 	// ⚠ This comment block deliberately lives INSIDE the function body, not
                 	// above the signature (2026-09-14, confirmed live): Deluge's own editor
                 	// rejects anything before the declaration outright — "Expected 'VOID',
                 	// 'INT','FLOAT','STRING','DATE','BOOL','MAP' or 'LIST' but found '//...'"
                 	// — so line 1 of a Custom API script must always be the signature itself.
                 	organization_id = "60078911104";
                 	books_base_url = "https://www.zohoapis.in/books/v3";
                 	// Real GST18 Tax Group id, user-confirmed 2026-08-25 directly in Zoho
                 	// Books Settings -> Taxes — a group combining CGST 9% + SGST 9%. NOT
                 	// the same as IGST18 (an inter-state tax, wrong for this use case) or
                 	// the individual CGST-only/SGST-only ids tried earlier (rejected by
                 	// Books' own API — see this file's own header comment for the full
                 	// two-round debugging history).
                 	gst18_tax_id = "3988332000000079033";
                 	// Real Tax Exemption reason id, user-confirmed 2026-09-08 via a live
                 	// test invoice created directly in Zoho Books (code "TAX") — used
                 	// instead of tax_id on the line item when applyTax="false" (explicit
                 	// client decision: the Booking Fee invoice should carry no tax at
                 	// all). Books requires a line item to carry EITHER a real tax_id OR an
                 	// explicit tax_exemption_id — simply omitting tax_id isn't enough on
                 	// its own for a GST-registered org, confirmed by the live test's own
                 	// response shape (tax_id blank, tax_percentage 0, this exemption id
                 	// present).
                 	gst_exemption_id = "3988332000000091002";
                 	// The exemption reason's own code, also confirmed via that same live
                 	// test's response ("tax_exemption_code":"TAX"). Zoho's public API docs
                 	// are ambiguous on whether this needs to be sent explicitly alongside
                 	// tax_exemption_id on line-item creation (vs. auto-derived from it) —
                 	// sent explicitly here to exactly match the one example proven to work,
                 	// rather than relying on an unconfirmed assumption either way.
                 	gst_exemption_code = "TAX";
                 	invoiceURL = "";
                 	// Real bug fixed (user-reported live: invokeCustomApi failed with the
                 	// generic {"code":9430,"message":"There is an error while executing
                 	// Custom API."} — Zoho's OWN crash message, not one of this script's
                 	// graceful JSON error returns). Root cause: everything from here down
                 	// used to sit OUTSIDE the try/catch below, so any exception in this
                 	// setup code (or in STEP 1's own untested GET-request syntax) escaped
                 	// uncaught and surfaced as this opaque code instead of a readable
                 	// message. The entire function body is now inside ONE try block, from
                 	// here to the very end, so any future failure returns a real message
                 	// we can actually act on.
                 	try 
                 	{
                 		// Diagnostic log (2026-09-08, actively debugging live: a real
                 		// invokeCustomApi() call from the widget sent a confirmed-correct
                 		// payload (applyTax:"false", referenceNumber ending "-BF") yet the
                 		// resulting invoice still showed CGST/SGST — while a manual Execute-
                 		// dialog test with the same shape correctly produced no tax. This
                 		// logs exactly what THIS deployed script actually received on a
                 		// real call, so a mismatch between "what the browser sent" and
                 		// "what Zoho bound into these variables" (or a stale/un-published
                 		// version of this script actually being the one invoked) becomes
                 		// directly visible in the Custom API's own execution log. Remove
                 		// once resolved — see the "remove logs" entry earlier the same day
                 		// for why this file is normally log-free.
                 		info "onDemandInvoicing received — recordId=" + recordId + " | referenceNumber=" + referenceNumber + " | applyTax=" + applyTax + " | serviceCharges=" + serviceCharges + " | cgst=" + cgst + " | sgst=" + sgst;
                 		referenceNumberResolved = referenceNumber;
                 		if(referenceNumberResolved == null)
                 		{
                 			referenceNumberResolved = recordId;
                 		}
                 		if(referenceNumberResolved == "")
                 		{
                 			referenceNumberResolved = recordId;
                 		}
                 		// Real bug fixed (user-reported live: "Unable to convert the input
                 		// text to decimal") — guard serviceCharges is actually present and
                 		// non-blank BEFORE calling toDecimal() on it, so a missing/blank
                 		// value returns this script's own clear message instead of a raw
                 		// Deluge parse-crash with no context about which field caused it.
                 		if(serviceCharges == null)
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"serviceCharges is missing\", \"url\": \"\"}";
                 		}
                 		if(serviceCharges == "")
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"serviceCharges is EMPTY\", \"url\": \"\"}";
                 		}
                 		// Real bug fixed (user-reported live: "Unable to convert the input
                 		// text to decimal", caught by the outer try/catch but without
                 		// saying WHICH value failed) — this narrower try/catch echoes the
                 		// actual raw serviceCharges string back in the error message, so
                 		// if this fails again we see exactly what value caused it instead
                 		// of guessing.
                 		try 
                 		{
                 			serviceChargesAmt = serviceCharges.toString().toDecimal();
                 		}		catch (decimalEx)
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"serviceCharges could not be parsed as a decimal - raw value: '" + serviceCharges + "'\", \"url\": \"\"}";
                 		}
                 		if(serviceChargesAmt <= 0)
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"serviceCharges must be > 0\", \"url\": \"\"}";
                 		}
                 		roundOffAmt = "0";
                 		if(roundOff != null)
                 		{
                 			roundOffAmt = roundOff.toString();
                 		}
                 		descriptionText = serviceLabel;
                 		if(descriptionText == null)
                 		{
                 			descriptionText = "Service Charge";
                 		}
                 		if(descriptionText == "")
                 		{
                 			descriptionText = "Service Charge";
                 		}
                 		// STEP 1 — find or create the customer in Zoho Books, by phone.
                 		customer_id = "";
                 		if(customerPhone != null)
                 		{
                 			if(customerPhone != "")
                 			{
                 				searchResp = invokeurl
                 				[
                 					url :books_base_url + "/contacts?organization_id=" + organization_id + "&phone=" + customerPhone
                 					type :GET
                 					connection:"zoho_books_connection"
                 				];
                 				contactsList = searchResp.get("contacts");
                 				if(contactsList != null)
                 				{
                 					if(contactsList.size() > 0)
                 					{
                 						firstContact = contactsList.get(0);
                 						customer_id = firstContact.get("contact_id");
                 					}
                 				}
                 			}
                 		}
                 		if(customer_id == "")
                 		{
                 			contactMap = Map();
                 			nameForContact = customerName;
                 			if(nameForContact == null)
                 			{
                 				nameForContact = "Customer";
                 			}
                 			if(nameForContact == "")
                 			{
                 				nameForContact = "Customer";
                 			}
                 			contactMap.put("contact_name",nameForContact);
                 			if(customerPhone != null)
                 			{
                 				if(customerPhone != "")
                 				{
                 					contactMap.put("phone",customerPhone);
                 				}
                 			}
                 			if(customerEmail != null)
                 			{
                 				if(customerEmail != "")
                 				{
                 					contactMap.put("email",customerEmail);
                 				}
                 			}
                 			if(gstNumber != null)
                 			{
                 				if(gstNumber != "")
                 				{
                 					contactMap.put("gst_no",gstNumber);
                 					contactMap.put("gst_treatment","business_gst");
                 				}
                 			}
                 			createContactResp = invokeurl
                 			[
                 				url :books_base_url + "/contacts?organization_id=" + organization_id
                 				type :POST
                 				parameters:contactMap.toString()
                 				headers:{"Content-Type":"application/json"}
                 				connection:"zoho_books_connection"
                 			];
                 			newContact = createContactResp.get("contact");
                 			if(newContact == null)
                 			{
                 				createContactErr = createContactResp.get("message");
                 				return "{\"code\": \"ERROR\", \"message\": \"Could not find or create customer in Zoho Books: " + createContactErr + "\", \"url\": \"\"}";
                 			}
                 			customer_id = newContact.get("contact_id");
                 		}
                 		// STEP 2 — one "Service Charge" line item. Two shapes depending on
                 		// applyTax (2026-09-08, explicit client decision — see this
                 		// function's own header comment for the "no tax_id at all" pitfall
                 		// this avoids): tax-inclusive invoices (Remaining Fee, and every
                 		// pre-existing caller) get the real GST18 Tax Group as their one
                 		// tax_id — Zoho Books itself splits this into CGST 9% + SGST 9%
                 		// internally for this intra-state transaction — at the
                 		// reverse-calculated rate the caller already backed the tax out of.
                 		// Tax-exempt invoices (Booking Fee) get the confirmed tax exemption
                 		// id instead, at the FULL rate (nothing to add tax on top of, so
                 		// the caller sends the whole amount as serviceCharges, not a
                 		// GST-backed-out figure). Round Off applies as the invoice's own
                 		// top-level adjustment either way; Place of Supply Karnataka.
                 		taxExempt = false;
                 		if(applyTax != null)
                 		{
                 			if(applyTax.toString() == "false")
                 			{
                 				taxExempt = true;
                 			}
                 		}
                 		// Belt-and-braces fallback (2026-09-08, real live bug: a Booking Fee
                 		// invoice still showed CGST/SGST even after this script itself was
                 		// redeployed) — Zoho Creator Custom APIs typically require each
                 		// parameter to be explicitly (re-)registered in the Custom API's own
                 		// setup screen, separate from just being named in this function's
                 		// signature. applyTax is a brand-new parameter; if it wasn't
                 		// registered there, it silently arrives as null here no matter what
                 		// the widget sends, defaulting back to "tax applied" — which is
                 		// exactly the symptom reported. referenceNumber is a pre-existing,
                 		// already-proven-working parameter (visible correctly on real
                 		// invoices' own P.O.# field, e.g. "RSID508006-BF") — its own "-BF"
                 		// suffix (added only by Send_Payment_Link, the Booking Fee call —
                 		// see widget.html's own comment there) is a second, independent
                 		// signal that doesn't depend on any new parameter registration at
                 		// all. Either signal alone is now enough to trigger the exemption.
                 		if(referenceNumberResolved != null)
                 		{
                 			if(referenceNumberResolved.toString().contains("-BF"))
                 			{
                 				taxExempt = true;
                 			}
                 		}
                 		info "onDemandInvoicing — resolved taxExempt=" + taxExempt + " (referenceNumberResolved=" + referenceNumberResolved + ")";
                 		lineItem = Map();
                 		lineItem.put("description",descriptionText);
                 		lineItem.put("quantity","1");
                 		// Real per-ticket amount — deliberately NEVER hardcoded, even in the
                 		// taxExempt branch below (2026-09-08, explicit user request: "use
                 		// hard core line item ... exactly like Test 1"). Test 1's own rate
                 		// (20) is specific to that one manual test invoice — hardcoding it
                 		// here would charge every real customer a flat ₹20 for their
                 		// Booking Fee regardless of the real amount, a genuine billing bug,
                 		// not a tax-configuration choice. Flagged rather than silently
                 		// done either way.
                 		lineItem.put("rate",serviceChargesAmt.toString());
                 		if(taxExempt)
                 		{
                 			// Hardcoded to reference the exact same catalog item ("Test 1",
                 			// item_id 3988332000000091063) the user's own live test proved
                 			// produces a genuinely tax-exempt invoice — explicit user
                 			// request, 2026-09-08. Zoho Books inherits that item's own
                 			// account/HSN/unit from the catalog when item_id is set, while
                 			// still honoring the description/rate/tax_exemption fields sent
                 			// alongside it here (real per-ticket service label and amount,
                 			// not the item's own catalog values). tax_exemption_id/code are
                 			// kept too, sent directly on the line item as belt-and-braces —
                 			// harmless if the item-level config alone already covers it.
                 			lineItem.put("item_id","3988332000000091063");
                 			lineItem.put("tax_exemption_id",gst_exemption_id);
                 			lineItem.put("tax_exemption_code",gst_exemption_code);
                 		}
                 		else
                 		{
                 			lineItem.put("tax_id",gst18_tax_id);
                 		}
                 		lineItems = List();
                 		lineItems.add(lineItem);
                 		invoiceMap = Map();
                 		invoiceMap.put("customer_id",customer_id);
                 		invoiceMap.put("line_items",lineItems);
                 		invoiceMap.put("place_of_supply","KA");
                 		invoiceMap.put("adjustment",roundOffAmt);
                 		invoiceMap.put("adjustment_description","Round Off");
                 		invoiceMap.put("reference_number",referenceNumberResolved);
                 		// CLIENT TAX INVOICE TEMPLATE FIELDS — 2026-09-30, from the client's own
                 		// sample "TAX INVOICE" PDF. That layout carries six per-ticket values a
                 		// stock Zoho Books invoice has nowhere to put: Service Date, Vehicle Make,
                 		// Registration No, Service Type, Service Description and Mode. Everything
                 		// else on the sample (SAC, CIN, the reverse-charge line, Place of Supply,
                 		// the declaration, the footer address and the signature) is static text and
                 		// belongs in the Books template itself, not here.
                 		//
                 		// Sent as top-level cf_* keys, which is what Zoho Books generates from a
                 		// custom field's own label ("Service Date" -> cf_service_date). The
                 		// alternative form is a custom_fields array keyed by customfield_id; if
                 		// these keys ever stop taking, the real ids are already visible in the GET
                 		// invoice response this function logs further down — read them from there
                 		// rather than guessing, the same rule this file learned the hard way over
                 		// the /share/paymentlink guess.
                 		//
                 		// ⚠ SERVICE DESCRIPTION IS DELIBERATELY ITS OWN FIELD rather than reusing
                 		// the line item description. serviceLabel already feeds that description on
                 		// every invoice created to date ("RSR - Battery Assistance"), and the
                 		// client's layout wants Type and Description in two separate columns.
                 		// Repurposing serviceLabel would have changed what appears on the existing
                 		// invoices; adding a field changes nothing that already works.
                 		customFieldCount = 0;
                 		if(serviceDate != null)
                 		{
                 			if(serviceDate != "")
                 			{
                 				invoiceMap.put("cf_service_date",serviceDate);
                 				customFieldCount = customFieldCount + 1;
                 			}
                 		}
                 		if(vehicleMake != null)
                 		{
                 			if(vehicleMake != "")
                 			{
                 				invoiceMap.put("cf_vehicle_make",vehicleMake);
                 				customFieldCount = customFieldCount + 1;
                 			}
                 		}
                 		if(registrationNumber != null)
                 		{
                 			if(registrationNumber != "")
                 			{
                 				invoiceMap.put("cf_registration_no",registrationNumber);
                 				customFieldCount = customFieldCount + 1;
                 			}
                 		}
                 		if(serviceType != null)
                 		{
                 			if(serviceType != "")
                 			{
                 				invoiceMap.put("cf_service_type",serviceType);
                 				customFieldCount = customFieldCount + 1;
                 			}
                 		}
                 		if(serviceDescription != null)
                 		{
                 			if(serviceDescription != "")
                 			{
                 				invoiceMap.put("cf_service_description",serviceDescription);
                 				customFieldCount = customFieldCount + 1;
                 			}
                 		}
                 		if(paymentMode != null)
                 		{
                 			if(paymentMode != "")
                 			{
                 				invoiceMap.put("cf_mode",paymentMode);
                 				customFieldCount = customFieldCount + 1;
                 			}
                 		}
                 		// GST No — the client's sample prints a literal "NA" for a customer with no
                 		// GSTIN, while Zoho Books renders an absent GSTIN as an empty space with no
                 		// placeholder of any kind. So this is its own field and is ALWAYS sent,
                 		// never conditionally: a blank here is exactly the thing being avoided.
                 		//
                 		// Deliberately reuses the existing gstNumber parameter rather than adding a
                 		// new one — gstNumber is already registered on the Custom API and already
                 		// proven to arrive (it is what sets gst_no on the contact above), so this
                 		// field cannot fall into the "declared in the signature, never registered,
                 		// silently null" trap that this file has hit twice.
                 		gstNoText = "NA";
                 		if(gstNumber != null)
                 		{
                 			if(gstNumber != "")
                 			{
                 				gstNoText = gstNumber;
                 			}
                 		}
                 		invoiceMap.put("cf_gst_no",gstNoText);
                 		customFieldCount = customFieldCount + 1;
                 		/* THE FORM ZOHO BOOKS ACTUALLY READS - 2026-10-13. See this change's own
                 		   note. The top-level cf_* keys above are silently ignored by Books v3, so
                 		   every custom field on every invoice to date has been blank with no error
                 		   raised anywhere. Books reads them from this array instead.
                 
                 		   Built by reading back the cf_ keys just put into invoiceMap rather than
                 		   naming the seven fields a second time: one list to keep in step, so a
                 		   field added above can never be forgotten here.
                 
                 		   subText rather than startsWith - the shape this file has proven. */
                 		customFieldsList = List();
                 		for each  cfKey in invoiceMap.keys()
                 		{
                 			cfKeyText = cfKey.toString();
                 			if(cfKeyText.length() > 3)
                 			{
                 				if(cfKeyText.subText(0,3) == "cf_")
                 				{
                 					cfEntry = Map();
                 					cfEntry.put("api_name",cfKeyText);
                 					cfEntry.put("value",invoiceMap.get(cfKeyText));
                 					customFieldsList.add(cfEntry);
                 				}
                 			}
                 		}
                 		if(customFieldsList.size() > 0)
                 		{
                 			invoiceMap.put("custom_fields",customFieldsList);
                 			info "onDemandInvoicing - sending " + customFieldsList.size() + " custom field(s) to Books as a custom_fields array: " + customFieldsList.toString();
                 		}
                 		jsonPayload = invoiceMap.toString();
                 		createInvoiceResp = invokeurl
                 		[
                 			url :books_base_url + "/invoices?organization_id=" + organization_id
                 			type :POST
                 			parameters:jsonPayload
                 			headers:{"Content-Type":"application/json"}
                 			connection:"zoho_books_connection"
                 		];
                 		invoiceRespCode = createInvoiceResp.get("code");
                 		// SELF-HEALING RETRY — the whole reason the custom fields above are safe to
                 		// ship before anyone has created them in Zoho Books. Books rejects the whole
                 		// invoice when a cf_* key names a field that does not exist in the org, and
                 		// creating that invoice is this function's one critical job. So: if the
                 		// create failed AND we sent custom fields, drop them and create exactly the
                 		// invoice this function has always created. Worst case the invoice is made
                 		// without the template fields — today's behaviour, unchanged — and the log
                 		// line below says precisely which step to finish in Books.
                 		/* RUNG 2 - 2026-10-14. See this change's own note. Books refuses the whole
                 		   invoice when ANY cf_* key names a field that is not set up in the org, and
                 		   dropping all of them was turning one missing field into seven blank ones.
                 		   Service Date, Service Description and Mode are the three that have never
                 		   existed in this Books org; the other four are proven to, so they get their
                 		   own attempt before anything is given up. */
                 		if(invoiceRespCode != 0)
                 		{
                 			if(customFieldCount > 0)
                 			{
                 				info "onDemandInvoicing - invoice creation was rejected while sending all " + customFieldCount + " tax-invoice custom field(s) (" + createInvoiceResp.get("message") + "). Retrying WITHOUT Service Date, Service Description and Mode, which are the three that have never been created in this Books org. Create them in Settings -> Preferences -> Invoices -> Field Customization (labels exactly: Service Date, Service Description, Mode) and all seven will go in on the first attempt.";
                 				invoiceMap.remove("cf_service_date");
                 				invoiceMap.remove("cf_service_description");
                 				invoiceMap.remove("cf_mode");
                 				/* Rebuilt from what is LEFT in the map, the same subText rule the first
                 				   array was built with - so the two can never disagree about which
                 				   fields are in play. */
                 				invoiceMap.remove("custom_fields");
                 				coreFieldsList = List();
                 				for each  coreKey in invoiceMap.keys()
                 				{
                 					coreKeyText = coreKey.toString();
                 					if(coreKeyText.length() > 3)
                 					{
                 						if(coreKeyText.subText(0,3) == "cf_")
                 						{
                 							coreEntry = Map();
                 							coreEntry.put("api_name",coreKeyText);
                 							coreEntry.put("value",invoiceMap.get(coreKeyText));
                 							coreFieldsList.add(coreEntry);
                 						}
                 					}
                 				}
                 				if(coreFieldsList.size() > 0)
                 				{
                 					invoiceMap.put("custom_fields",coreFieldsList);
                 				}
                 				/* Honest reporting for the read-back diagnostic further down: this is
                 				   what is actually being sent now, not what was first intended. */
                 				customFieldCount = coreFieldsList.size();
                 				info "onDemandInvoicing - second attempt carries " + customFieldCount + " custom field(s): " + coreFieldsList.toString();
                 				jsonPayload = invoiceMap.toString();
                 				createInvoiceResp = invokeurl
                 				[
                 					url :books_base_url + "/invoices?organization_id=" + organization_id
                 					type :POST
                 					parameters:jsonPayload
                 					headers:{"Content-Type":"application/json"}
                 					connection:"zoho_books_connection"
                 				];
                 				invoiceRespCode = createInvoiceResp.get("code");
                 			}
                 		}
                 		/* RUNG 3 - the original all-or-nothing fallback, unchanged in effect: creating
                 		   the invoice is this function's one critical job, so if custom fields are
                 		   still what stands in the way, they go entirely. Reached only when rung 2 was
                 		   also refused, which means the problem is not the three template extras. */
                 		if(invoiceRespCode != 0)
                 		{
                 			if(customFieldCount > 0)
                 			{
                 				info "onDemandInvoicing - the invoice was STILL rejected with only the four core custom fields (" + createInvoiceResp.get("message") + "). Retrying with none of them, so the invoice itself is created. One of cf_vehicle_make / cf_registration_no / cf_service_type / cf_gst_no is not set up in this Books org, or is refusing the value sent - the message in brackets names it.";
                 				invoiceMap.remove("cf_service_date");
                 				invoiceMap.remove("cf_vehicle_make");
                 				invoiceMap.remove("cf_registration_no");
                 				invoiceMap.remove("cf_service_type");
                 				invoiceMap.remove("cf_service_description");
                 				invoiceMap.remove("cf_mode");
                 				invoiceMap.remove("cf_gst_no");
                 				invoiceMap.remove("custom_fields");
                 				customFieldCount = 0;
                 				jsonPayload = invoiceMap.toString();
                 				createInvoiceResp = invokeurl
                 				[
                 					url :books_base_url + "/invoices?organization_id=" + organization_id
                 					type :POST
                 					parameters:jsonPayload
                 					headers:{"Content-Type":"application/json"}
                 					connection:"zoho_books_connection"
                 				];
                 				invoiceRespCode = createInvoiceResp.get("code");
                 			}
                 		}
                 		if(invoiceRespCode != 0)
                 		{
                 			errMsg = createInvoiceResp.get("message");
                 			return "{\"code\": \"ERROR\", \"message\": \"" + errMsg + "\", \"url\": \"\"}";
                 		}
                 		invoiceRec = createInvoiceResp.get("invoice");
                 		if(invoiceRec == null)
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"No invoice in response\", \"url\": \"\"}";
                 		}
                 		invoice_id = invoiceRec.get("invoice_id");
                 		invoice_number = invoiceRec.get("invoice_number");
                 		if(invoice_id == null)
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"Invoice ID is NULL\", \"url\": \"\"}";
                 		}
                 		if(invoice_id == "")
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"Invoice ID is EMPTY\", \"url\": \"\"}";
                 		}
                 		if(invoice_number == null)
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"Invoice Number is NULL\", \"url\": \"\"}";
                 		}
                 		if(invoice_number == "")
                 		{
                 			return "{\"code\": \"ERROR\", \"message\": \"Invoice Number is EMPTY\", \"url\": \"\"}";
                 		}
                 		/* WHAT BOOKS ACTUALLY STORED - 2026-10-13. The old failure mode was a
                 		   clean log and seven empty fields, which told nobody anything. This prints
                 		   what came back against each custom field, with its real customfield_id,
                 		   so a field that did not take is one line in the log rather than a trip
                 		   into Books. Wrapped in its own try: a diagnostic must never be able to
                 		   fail an invoice that has already been created. */
                 		try 
                 		{
                 			storedFields = invoiceRec.get("custom_fields");
                 			if(storedFields == null)
                 			{
                 				info "onDemandInvoicing - Books returned NO custom_fields on invoice " + invoice_id + ". The fields are not set up on the Invoice module in this org, or their API names differ from the cf_* names sent above. Settings -> Preferences -> Invoices -> Field Customization.";
                 			}
                 			else
                 			{
                 				info "onDemandInvoicing - custom fields as Books stored them on invoice " + invoice_id + ": " + storedFields.toString();
                 				filledCount = 0;
                 				for each  storedField in storedFields
                 				{
                 					storedValue = ifnull(storedField.get("value"),"").toString().trim();
                 					if(storedValue != "")
                 					{
                 						filledCount = filledCount + 1;
                 					}
                 				}
                 				info "onDemandInvoicing - " + filledCount + " of " + storedFields.size() + " custom field(s) on the invoice carry a value. Sent: " + customFieldCount + ". A gap between these numbers means an api_name sent above does not match a field in this Books org.";
                 			}
                 		}		catch (cfDiagEx)
                 		{
                 			info "onDemandInvoicing - could not read back the custom fields (diagnostic only, the invoice itself is fine): " + cfDiagEx.toString();
                 		}
                 		invoice_pdf_url = "https://books.zoho.in/invoices/" + invoice_id + "?organization_id=" + organization_id;
                 		// MARK THE INVOICE AS SENT (2026-09-15) - REQUIRED before STEP 3 below.
                 		//
                 		// Zoho Books creates an invoice through POST /invoices in DRAFT status,
                 		// and it refuses to record a customer payment against a draft invoice.
                 		// STEP 3 therefore could not have worked on a freshly created invoice:
                 		// every /customerpayments call would be rejected, paymentsRecorded would
                 		// stay 0, and an invoice whose money was already collected would still
                 		// show its full amount outstanding - exactly the "invoice created but
                 		// balance not zero" symptom the end-to-end test is meant to catch.
                 		//
                 		// The /invoices/{id}/email call much further down DOES move an invoice
                 		// out of draft, which is probably why this was never noticed - but it
                 		// runs after the payment steps, far too late to help them.
                 		//
                 		// Own try/catch, non-fatal, same contract as every other secondary step
                 		// here: if this fails, the invoice itself still exists and is still
                 		// returned. The log line says plainly what it means for STEP 3.
                 		try 
                 		{
                 			markSentResp = invokeurl
                 			[
                 				url :books_base_url + "/invoices/" + invoice_id + "/status/sent?organization_id=" + organization_id
                 				type :POST
                 				connection:"zoho_books_connection"
                 			];
                 			info "onDemandInvoicing - mark invoice as sent, raw response: " + markSentResp.toString();
                 		}		catch (sentEx)
                 		{
                 			info "onDemandInvoicing - could NOT mark invoice " + invoice_id + " as sent (non-fatal in itself, but the payment steps below will most likely be rejected because Zoho Books does not accept payments against a draft invoice): " + sentEx.toString();
                 		}
                 		// STEP 3 — record the payments already collected against THIS one
                 		// invoice (2026-09-14, explicit user decision: booking fee is taken up
                 		// front and the remaining fee at closure, but the customer should get
                 		// exactly ONE invoice per ticket showing all fees). Both payments were
                 		// collected through standalone Zoho Payments links that were never
                 		// attached to any invoice, so without this the invoice would show the
                 		// full amount as still outstanding even though it's fully paid.
                 		//
                 		// Each payment is recorded with its OWN try/catch and can only ever
                 		// no-op: a payment-recording failure must NEVER take down the invoice
                 		// itself, which by this point already exists in Books and is this
                 		// function's one critical output — same deliberate "swallow, don't
                 		// block" pattern the invoice-email step further down already uses.
                 		//
                 		// ⚠ The /customerpayments endpoint and its payload shape are NEW to
                 		// this project — no prior confirmed use anywhere in this codebase.
                 		// payment_mode "other" is the safest generic value (these came in via
                 		// UPI/card through Zoho Payments, so neither "cash" nor "creditcard"
                 		// is strictly right); if Books rejects the call, its own response is
                 		// logged below via info — check the Custom API's execution log and
                 		// adjust payment_mode first, that's the most likely thing to be wrong.
                 		// The widget caps what it sends so the two amounts can never exceed
                 		// the invoice total (a refund at closure makes the invoice smaller
                 		// than the sum actually collected — see the widget's own matching
                 		// comment), so over-application shouldn't be possible from here.
                 		paymentsRecorded = 0;
                 		paymentDateText = zoho.currentdate.toString("yyyy-MM-dd");
                 		try 
                 		{
                 			if(bookingFeeAmount != null)
                 			{
                 				if(bookingFeeAmount != "")
                 				{
                 					bfAmt = bookingFeeAmount.toString().toDecimal();
                 					if(bfAmt > 0)
                 					{
                 						bfRefText = bookingFeeRef;
                 						if(bfRefText == null)
                 						{
                 							bfRefText = referenceNumberResolved + "-BF";
                 						}
                 						if(bfRefText == "")
                 						{
                 							bfRefText = referenceNumberResolved + "-BF";
                 						}
                 						bfApplied = Map();
                 						bfApplied.put("invoice_id",invoice_id);
                 						bfApplied.put("amount_applied",bfAmt);
                 						bfAppliedList = List();
                 						bfAppliedList.add(bfApplied);
                 						bfPaymentMap = Map();
                 						bfPaymentMap.put("customer_id",customer_id);
                 						bfPaymentMap.put("payment_mode","other");
                 						bfPaymentMap.put("amount",bfAmt);
                 						bfPaymentMap.put("date",paymentDateText);
                 						bfPaymentMap.put("reference_number",bfRefText);
                 						bfPaymentMap.put("description","Booking Fee — collected via Zoho Payments");
                 						bfPaymentMap.put("invoices",bfAppliedList);
                 						bfPayResp = invokeurl
                 						[
                 							url :books_base_url + "/customerpayments?organization_id=" + organization_id
                 							type :POST
                 							parameters:bfPaymentMap.toString()
                 							headers:{"Content-Type":"application/json"}
                 							connection:"zoho_books_connection"
                 						];
                 						info "onDemandInvoicing — booking fee payment raw response: " + bfPayResp.toString();
                 						if(bfPayResp.get("code") == 0)
                 						{
                 							paymentsRecorded = paymentsRecorded + 1;
                 						}
                 					}
                 				}
                 			}
                 		}		catch (bfPayEx)
                 		{
                 			info "onDemandInvoicing — booking fee payment could NOT be recorded (non-fatal; the invoice itself is created and unaffected): " + bfPayEx.toString();
                 		}
                 		try 
                 		{
                 			if(remainingFeeAmount != null)
                 			{
                 				if(remainingFeeAmount != "")
                 				{
                 					rfAmt = remainingFeeAmount.toString().toDecimal();
                 					if(rfAmt > 0)
                 					{
                 						rfRefText = remainingFeeRef;
                 						if(rfRefText == null)
                 						{
                 							rfRefText = referenceNumberResolved + "-RF";
                 						}
                 						if(rfRefText == "")
                 						{
                 							rfRefText = referenceNumberResolved + "-RF";
                 						}
                 						rfApplied = Map();
                 						rfApplied.put("invoice_id",invoice_id);
                 						rfApplied.put("amount_applied",rfAmt);
                 						rfAppliedList = List();
                 						rfAppliedList.add(rfApplied);
                 						rfPaymentMap = Map();
                 						rfPaymentMap.put("customer_id",customer_id);
                 						rfPaymentMap.put("payment_mode","other");
                 						rfPaymentMap.put("amount",rfAmt);
                 						rfPaymentMap.put("date",paymentDateText);
                 						rfPaymentMap.put("reference_number",rfRefText);
                 						rfPaymentMap.put("description","Remaining Fee — collected via Zoho Payments");
                 						rfPaymentMap.put("invoices",rfAppliedList);
                 						rfPayResp = invokeurl
                 						[
                 							url :books_base_url + "/customerpayments?organization_id=" + organization_id
                 							type :POST
                 							parameters:rfPaymentMap.toString()
                 							headers:{"Content-Type":"application/json"}
                 							connection:"zoho_books_connection"
                 						];
                 						info "onDemandInvoicing — remaining fee payment raw response: " + rfPayResp.toString();
                 						if(rfPayResp.get("code") == 0)
                 						{
                 							paymentsRecorded = paymentsRecorded + 1;
                 						}
                 					}
                 				}
                 			}
                 		}		catch (rfPayEx)
                 		{
                 			info "onDemandInvoicing — remaining fee payment could NOT be recorded (non-fatal; the invoice itself is created and unaffected): " + rfPayEx.toString();
                 		}
                 		// Real, CONFIRMED Zoho Payments "Payment Links" API (2026-09-10, user
                 		// request: "before [the booking amount is sent] we need to generate
                 		// the payment link... pass the dynamic account and other details and
                 		// then send this payment link on whatsapp" — user provided a real
                 		// curl request + real response for this exact endpoint). Replaces
                 		// the old Zoho Books "/share/paymentlink" GUESS this block used to
                 		// try (never confirmed against any real documented response field
                 		// name) with a real, user-confirmed endpoint and response shape. A
                 		// link from THIS API is genuinely payable (UPI/Card) — not an
                 		// invoice view.
                 		// Auth: manual refresh-token -> access-token exchange (explicit user
                 		// decision, 2026-09-10: "I don't create connections use the Refresh
                 		// token and access token methodology") — deliberately NOT a Zoho
                 		// Creator Connection (unlike zoho_books_connection above). REPLACE
                 		// the 3 placeholder values below with the real ones from the Zoho
                 		// Payments OAuth app's own console (client_id/client_secret from the
                 		// app registration, refresh_token from the initial OAuth consent
                 		// grant) before this works at all — it fails safely (falls back to
                 		// invoice_pdf_url) until then, same as every other not-yet-configured
                 		// piece in this file. Token endpoint is Zoho's own standard OAuth v2
                 		// issuer (accounts.zoho.in — same regional domain as every other
                 		// Zoho API call in this file), shared across all Zoho products, not
                 		// specific to Payments.
                 		// Real values, user-provided 2026-09-10 (self-client refresh-token
                 		// flow, scope ZohoPay.payments.CREATE). scope/redirect_uri are
                 		// deliberately NOT sent on this refresh_token grant call below (only
                 		// grant_type=refresh_token + these 3 values) — both are only
                 		// meaningful on the ORIGINAL authorization_code exchange that first
                 		// issued this refresh token, not on a refresh_token grant itself
                 		// (standard OAuth2 behavior, not specific to Zoho).
                 		zoho_payments_client_id = "1000.7BYOUWK2Q2XMJQWU62E6WHCRZOY9VW";
                 		zoho_payments_client_secret = "a714fc6ab6c76d058196ceef8b49cad735422987fd";
                 		zoho_payments_refresh_token = "1000.7b9a45adfe6300ed5fb43cf9d29eef7b.65c3a6df18bedb83f887bf1f4fbc44d6";
                 		zoho_payments_account_id = "60078772586";
                 		zoho_payments_base_url = "https://payments.zoho.in/api/v1";
                 		// return_url fixed (explicit user decision, 2026-09-10: "return url
                 		// will be the provided url") — the exact static value from the
                 		// user's own original confirmed example, not computed per-ticket.
                 		zoho_payments_return_url = "https://creatorapp.zoho.in/getrescued/get-rescue";
                 		payment_url = "";
                 		try 
                 		{
                 			tokenResp = invokeurl
                 			[
                 				url :"https://accounts.zoho.in/oauth/v2/token?refresh_token=" + zoho_payments_refresh_token + "&client_id=" + zoho_payments_client_id + "&client_secret=" + zoho_payments_client_secret + "&grant_type=refresh_token"
                 				type :POST
                 			];
                 			info "onDemandInvoicing — Zoho Payments token refresh raw response: " + tokenResp.toString();
                 			access_token = tokenResp.get("access_token");
                 			if(access_token == null)
                 			{
                 				info "onDemandInvoicing — Zoho Payments token refresh returned no access_token (placeholder credentials still in place? see this block's own header comment) — skipping payment link generation this call.";
                 			}
                 			else
                 			{
                 				paymentLinkMap = Map();
                 				// .toString() on the parsed decimal (not the raw totalAmount
                 				// string) — same "always send numeric fields as strings"
                 				// convention already used for every other amount in this file
                 				// (see lineItem.put("rate",...) above) — Zoho Books' own API in
                 				// this exact project already tolerates this, assumed to
                 				// transfer to Zoho Payments (same company); flagged, not
                 				// silently assumed risk-free.
                 				paymentLinkMap.put("amount",totalAmount.toDecimal().toString());
                 				paymentLinkMap.put("currency","INR");
                 				if(customerEmail != null)
                 				{
                 					if(customerEmail != "")
                 					{
                 						paymentLinkMap.put("email",customerEmail);
                 					}
                 				}
                 				// Bare 10-digit number expected here (confirmed example:
                 				// "phone": "8127112543", no "+91"/spaces) — cleaned in the
                 				// widget's own onDemandInvoicing() JS wrapper
                 				// (customerPhoneDigits), not here — no confirmed-safe way in
                 				// this codebase to strip non-digit characters from a string
                 				// in Deluge itself.
                 				if(customerPhoneDigits != null)
                 				{
                 					if(customerPhoneDigits != "")
                 					{
                 						paymentLinkMap.put("phone",customerPhoneDigits);
                 						paymentLinkMap.put("phone_country_code","IN");
                 					}
                 				}
                 				paymentLinkMap.put("reference_id",referenceNumberResolved);
                 				paymentLinkMap.put("description",descriptionText);
                 				if(expiresAt != null)
                 				{
                 					if(expiresAt != "")
                 					{
                 						paymentLinkMap.put("expires_at",expiresAt);
                 					}
                 				}
                 				// Both false deliberately — this function's own caller sends
                 				// its OWN WhatsApp message with the link immediately after
                 				// this returns; Zoho Payments' own email/SMS notification
                 				// would be a second, separate, unrequested message to the
                 				// same customer.
                 				notifyMap = Map();
                 				notifyMap.put("email",false);
                 				notifyMap.put("sms",false);
                 				paymentLinkMap.put("notify_customer",notifyMap);
                 				paymentLinkMap.put("return_url",zoho_payments_return_url);
                 				configMap = Map();
                 				allowedMethods = List();
                 				allowedMethods.add("upi");
                 				allowedMethods.add("card");
                 				configMap.put("allowed_payment_methods",allowedMethods);
                 				paymentLinkMap.put("configurations",configMap);
                 				metaList = List();
                 				metaEntry = Map();
                 				metaEntry.put("key","Case_ID");
                 				metaEntry.put("value",referenceNumberResolved);
                 				metaList.add(metaEntry);
                 				paymentLinkMap.put("meta_data",metaList);
                 				createPaymentLinkResp = invokeurl
                 				[
                 					url :zoho_payments_base_url + "/paymentlinks?account_id=" + zoho_payments_account_id
                 					type :POST
                 					parameters:paymentLinkMap.toString()
                 					headers:{"Content-Type":"application/json","Authorization":"Zoho-oauthtoken " + access_token}
                 				];
                 				info "onDemandInvoicing — Zoho Payments payment link raw response: " + createPaymentLinkResp.toString();
                 				paymentLinkRespCode = createPaymentLinkResp.get("code");
                 				if(paymentLinkRespCode == 0)
                 				{
                 					paymentLinksRec = createPaymentLinkResp.get("payment_links");
                 					if(paymentLinksRec != null)
                 					{
                 						if(paymentLinksRec.get("url") != null)
                 						{
                 							payment_url = paymentLinksRec.get("url").toString();
                 						}
                 					}
                 				}
                 			}
                 		}		catch (paymentLinkEx)
                 		{
                 			info "onDemandInvoicing — Zoho Payments payment link generation failed (non-fatal, falling back to invoice_pdf_url): " + paymentLinkEx.toString();
                 		}
                 		// PUBLIC / SHAREABLE INVOICE URL (2026-09-17, explicit user decision:
                 		// "do not need to login book switch to a shareable link").
                 		//
                 		// invoice_pdf_url below is https://books.zoho.in/invoices/<id>?... —
                 		// the INTERNAL Books app screen. It only opens for someone already
                 		// signed into Zoho Books with access to this organization, so an agent
                 		// without a Books login hits a sign-in wall instead of the invoice.
                 		//
                 		// Zoho Books' own invoice object carries a customer-facing URL that
                 		// needs no login. It is read here from the invoice record rather than
                 		// constructed, because a share URL contains a server-generated hash
                 		// that cannot be derived — an earlier attempt in this same file did
                 		// guess at a "/share/paymentlink" endpoint and was removed precisely
                 		// because it was never confirmed against a real documented response.
                 		// So: read it, never build it.
                 		//
                 		// Checked in two places, cheapest first: the create response already in
                 		// hand, then a fresh GET (the field is commonly absent on a DRAFT and
                 		// present once the invoice has been marked sent, which happened above).
                 		// Own try/catch, non-fatal: if neither yields anything, bestUrl simply
                 		// stays on today's internal URL, so this can only improve the link,
                 		// never break it. The full GET response is logged so the real field
                 		// name is visible in the execution log if this org returns a different
                 		// shape.
                 		public_invoice_url = "";
                 		if(invoiceRec.get("invoice_url") != null)
                 		{
                 			createUrlCandidate = invoiceRec.get("invoice_url").toString().trim();
                 			if(createUrlCandidate != "")
                 			{
                 				public_invoice_url = createUrlCandidate;
                 			}
                 		}
                 		if(public_invoice_url == "")
                 		{
                 			try 
                 			{
                 				getInvoiceResp = invokeurl
                 				[
                 					url :books_base_url + "/invoices/" + invoice_id + "?organization_id=" + organization_id
                 					type :GET
                 					connection:"zoho_books_connection"
                 				];
                 				info "onDemandInvoicing - GET invoice (looking for a public share URL), raw response: " + getInvoiceResp.toString();
                 				refreshedInvoice = getInvoiceResp.get("invoice");
                 				if(refreshedInvoice != null)
                 				{
                 					if(refreshedInvoice.get("invoice_url") != null)
                 					{
                 						getUrlCandidate = refreshedInvoice.get("invoice_url").toString().trim();
                 						if(getUrlCandidate != "")
                 						{
                 							public_invoice_url = getUrlCandidate;
                 						}
                 					}
                 				}
                 			}			catch (shareLinkEx)
                 			{
                 				info "onDemandInvoicing - could NOT fetch a public invoice URL (non-fatal, falling back to the internal Books URL): " + shareLinkEx.toString();
                 			}
                 		}
                 		if(public_invoice_url == "")
                 		{
                 			info "onDemandInvoicing - no public invoice_url came back from Zoho Books. The link handed to the agent will be the INTERNAL Books URL, which requires a Books login. If this keeps happening, enable the Client Portal for this organization in Zoho Books (Settings -> Portal) - the customer-facing invoice URL only exists once that is on.";
                 		}
                 		else
                 		{
                 			info "onDemandInvoicing - public invoice URL resolved: " + public_invoice_url;
                 		}
                 		// bestUrl prefers, in order: the PUBLIC invoice URL (no login needed —
                 		// 2026-09-17), then the internal Books URL as a fallback. The
                 		// zero-payments case is unchanged from 2026-09-14 and still wins over
                 		// both: an invoice with nothing paid against it should hand back a
                 		// genuinely payable link, while a settled one should open the invoice
                 		// document. Every pre-existing caller therefore behaves identically;
                 		// the only difference is that the invoice link now actually opens for
                 		// someone without a Zoho Books account.
                 		// ALWAYS THE INVOICE - changed 2026-09-18, user-reported live: clicking
                 		// "Invoice Link / Open Invoice" on the Closure page opened a Zoho Payments
                 		// "pay now" page for Rs.214 instead of the invoice document.
                 		//
                 		// This used to hand back payment_url whenever paymentsRecorded was 0. That
                 		// rule dates from when this same function also produced the Booking Fee
                 		// link, where a pay-now page was the right answer. Both live callers are
                 		// now the CLOSURE invoice (the Generate Invoice button and the automatic
                 		// closure run), and the field this URL lands in is labelled "Invoice Link"
                 		// with an "Open Invoice" action - so a payment page is the wrong document
                 		// whatever the balance happens to be.
                 		//
                 		// Note the symptom is a SECOND problem, not just a link one: a closure
                 		// invoice showing a balance means the fees already collected were not
                 		// applied to it, i.e. payments_recorded came back 0. That is worth
                 		// chasing separately - it is reported in this function's own success
                 		// response and logged for each fee below.
                 		//
                 		// payment_url is still generated and still returned as its own
                 		// "payment_url" field in the response, so nothing that wants it has lost
                 		// it; only which URL is offered as `url` has changed.
                 		bestUrl = invoice_pdf_url;
                 		if(public_invoice_url != "")
                 		{
                 			bestUrl = public_invoice_url;
                 		}
                 		if(paymentsRecorded == 0)
                 		{
                 			info "onDemandInvoicing - WARNING: payments_recorded is 0, so this invoice will show its full amount outstanding even though the booking/remaining fees may already have been collected. Check the two payment responses logged above. Most likely causes, in order: the four payment parameters (bookingFeeAmount, bookingFeeRef, remainingFeeAmount, remainingFeeRef) are not registered on this Custom API's setup screen, or the fees were not marked confirmed-paid on the ticket, or Books rejected payment_mode 'other'.";
                 		}
                 		// EMAIL THE INVOICE TO THE CUSTOMER — rewritten 2026-10-05, client item 17.
                 		//
                 		// The old version sent no recipient at all, leaving Books to fall back on
                 		// whatever email the CONTACT happened to carry. Contacts here are matched by
                 		// PHONE (see STEP 1), so one created by an earlier ticket without an email
                 		// keeps having none, and Books has nowhere to send to.
                 		//
                 		// It also failed completely silently: emailResp was assigned and never read,
                 		// and the catch was deliberately empty. That is why a non-working email went
                 		// unnoticed for so long — there was nothing to notice. The response is now
                 		// logged and reported back as invoice_emailed.
                 		//
                 		// Still non-fatal in every path: an email failure must never take down an
                 		// invoice that already exists in Books.
                 		invoiceEmailed = "no";
                 		emailTarget = "";
                 		if(customerEmail != null)
                 		{
                 			if(customerEmail.trim() != "")
                 			{
                 				emailTarget = customerEmail.trim();
                 			}
                 		}
                 		if(emailTarget == "")
                 		{
                 			invoiceEmailed = "no email on ticket";
                 			info "onDemandInvoicing - invoice NOT emailed: this ticket has no customer email address. Books is given no recipient and the contact is matched by phone, so it may well have none either. Capture the customer email on the ticket if the invoice should be sent automatically.";
                 		}
                 		else
                 		{
                 			try 
                 			{
                 				emailParams = Map();
                 				emailParams.put("send_customer_statement","false");
                 				toList = List();
                 				toList.add(emailTarget);
                 				emailParams.put("to_mail_ids",toList);
                 				emailResp = invokeurl
                 				[
                 					url :books_base_url + "/invoices/" + invoice_id + "/email?organization_id=" + organization_id
                 					type :POST
                 					parameters:emailParams.toString()
                 					headers:{"Content-Type":"application/json"}
                 					connection:"zoho_books_connection"
                 				];
                 				info "onDemandInvoicing - invoice email raw response (to " + emailTarget + "): " + emailResp.toString();
                 				if(emailResp.get("code") == 0)
                 				{
                 					invoiceEmailed = "yes";
                 				}
                 				else
                 				{
                 					// SELF-HEALING RETRY, same shape as the cf_* custom fields above.
                 					// to_mail_ids is the documented way to name a recipient, but it has no
                 					// prior confirmed use in this project — so if Books rejects the call
                 					// with it, fall back to EXACTLY the request this function sent before
                 					// today. The worst case is therefore the old behaviour, never worse.
                 					info "onDemandInvoicing - invoice email was rejected while naming the recipient explicitly. Retrying the way this function sent it before 2026-10-05 (no to_mail_ids, Books uses the contact email).";
                 					retryParams = Map();
                 					retryParams.put("send_customer_statement","false");
                 					retryResp = invokeurl
                 					[
                 						url :books_base_url + "/invoices/" + invoice_id + "/email?organization_id=" + organization_id
                 						type :POST
                 						parameters:retryParams.toString()
                 						headers:{"Content-Type":"application/json"}
                 						connection:"zoho_books_connection"
                 					];
                 					info "onDemandInvoicing - invoice email retry raw response: " + retryResp.toString();
                 					if(retryResp.get("code") == 0)
                 					{
                 						invoiceEmailed = "yes (contact email)";
                 					}
                 				}
                 			}			catch (emailEx)
                 			{
                 				// Still swallowed — an email failure must not block the invoice itself,
                 				// which is already created and returned successfully. The difference is
                 				// that it now says so instead of vanishing.
                 				info "onDemandInvoicing - invoice email threw (non-fatal; the invoice exists and is still returned): " + emailEx.toString();
                 			}
                 		}
                 		// INVOICE PDF ONTO THE TICKET — 2026-10-05, client item 16: "the invoice is
                 		// not available for viewing or downloading on Zoho Creator".
                 		//
                 		// accept=pdf is Books' own documented way to get the RENDERED invoice (the
                 		// same document the customer would be emailed), so this picks up whatever
                 		// invoice template the org has configured — including the client's TAX
                 		// INVOICE layout and the cf_* fields sent further up — rather than anything
                 		// rebuilt here.
                 		//
                 		// Runs LAST on purpose: the invoice has been marked sent and both payments
                 		// recorded by this point, so the stored PDF shows the real balance instead
                 		// of a draft with the full amount outstanding.
                 		//
                 		// ⚠ Needs a File Upload field named Invoice_PDF on the Create_Case form.
                 		// Until it exists this logs and no-ops — the invoice, the link and the
                 		// response are all completely unaffected.
                 		invoicePdfSaved = "no";
                 		// Set inside the try below; declared here so the response can read it even
                 		// when the fetch threw before reaching the classification.
                 		pdfKind = "not attempted";
                 		try 
                 		{
                 			if(recordId != null)
                 			{
                 				if(recordId.trim() != "")
                 				{
                 					pdfResp = invokeurl
                 					[
                 						url :books_base_url + "/invoices/" + invoice_id + "?organization_id=" + organization_id + "&accept=pdf"
                 						type :GET
                 						connection:"zoho_books_connection"
                 					];
                 					// .trim() before .toLong() — same defensive pattern as
                 					// generateZohoPaymentLink.deluge, added there after a real live crash
                 					// on a recordId carrying a trailing space.
                 					/* What did Books actually hand back? A real PDF starts "%PDF-". JSON or
                 					   HTML here means the request was refused and there is no document to
                 					   store, which otherwise still reported "yes" because assigning a bad
                 					   value to a file field throws nothing. Truncated deliberately — the
                 					   whole file would flood the log and tell us no more than its head. */
                 					pdfPeek = "";
                 					// "yes" when toString() threw. That is not a failure to diagnose - it is
                 					// the diagnosis: JSON and HTML stringify cleanly, a PDF's bytes do not.
                 					pdfPeekThrew = "no";
                 					try 
                 					{
                 						pdfPeek = pdfResp.toString();
                 						if(pdfPeek.length() > 60)
                 						{
                 							pdfPeek = pdfPeek.subString(0,60);
                 						}
                 					}					catch (peekEx)
                 					{
                 						pdfPeekThrew = "yes";
                 						pdfPeek = "(not readable as text)";
                 					}
                 					/* ONE OF FOUR FIXED TOKENS, never the bytes themselves: this value is
                 					   concatenated into the hand-built successResponse JSON further down, and a
                 					   quote or backslash in it would break the widget's parse and hide the very
                 					   answer it carries. The full text stays in the log line below. */
                 					pdfKind = "something else - see this execution log";
                 					/* THE FIX - 2026-10-07. A response that cannot be read as text is a binary
                 					   file, which is what was being asked for. Checked FIRST, because the
                 					   %PDF- test below can only ever run on text and would reject this. */
                 					if(pdfPeekThrew == "yes")
                 					{
                 						pdfKind = "a real PDF";
                 					}
                 					else if(pdfPeek.contains("%PDF-"))
                 					{
                 						pdfKind = "a real PDF";
                 					}
                 					else if(pdfPeek.toUpperCase().contains("DOCTYPE"))
                 					{
                 						pdfKind = "an HTML page - not a document";
                 					}
                 					else if(pdfPeek.contains("message"))
                 					{
                 						pdfKind = "JSON - Books refused the request";
                 					}
                 					info "onDemandInvoicing - PDF fetch returned [" + pdfKind + "], first 60 chars: [" + pdfPeek + "]. A real PDF starts with %PDF- .";
                 					/* SECOND ATTEMPT - 2026-10-07. Readable text means Books did not hand back a
                 					   document. It accepts the request two ways; the other one is the Accept
                 					   header rather than the ?accept=pdf parameter. Same self-healing-retry shape
                 					   as the cf_* fields and to_mail_ids above: try, fall back, and say which
                 					   form worked so the loser can be dropped later. Only runs on the path that
                 					   has already failed, so a working org pays nothing. */
                 					if(pdfKind != "a real PDF")
                 					{
                 						try 
                 						{
                 							pdfRespAlt = invokeurl
                 							[
                 								url :books_base_url + "/invoices/" + invoice_id + "?organization_id=" + organization_id
                 								type :GET
                 								headers:{"Accept":"application/pdf"}
                 								connection:"zoho_books_connection"
                 							];
                 							pdfAltThrew = "no";
                 							pdfPeekAlt = "";
                 							try 
                 							{
                 								pdfPeekAlt = pdfRespAlt.toString();
                 								if(pdfPeekAlt.length() > 60)
                 								{
                 									pdfPeekAlt = pdfPeekAlt.subString(0,60);
                 								}
                 							}							catch (peekAltEx)
                 							{
                 								pdfAltThrew = "yes";
                 								pdfPeekAlt = "(not readable as text)";
                 							}
                 							info "onDemandInvoicing - PDF retry using the Accept header returned, first 60 chars: [" + pdfPeekAlt + "]";
                 							if(pdfAltThrew == "yes")
                 							{
                 								pdfResp = pdfRespAlt;
                 								pdfKind = "a real PDF";
                 							}
                 							else if(pdfPeekAlt.contains("%PDF-"))
                 							{
                 								pdfResp = pdfRespAlt;
                 								pdfKind = "a real PDF";
                 							}
                 							if(pdfKind == "a real PDF")
                 							{
                 								info "onDemandInvoicing - the Accept-header form returned a document where ?accept=pdf did not. If this keeps happening, make it the only form and drop the query-parameter attempt.";
                 							}
                 						}						catch (pdfAltEx)
                 						{
                 							info "onDemandInvoicing - PDF retry using the Accept header threw (non-fatal; the invoice is unaffected): " + pdfAltEx.toString();
                 						}
                 					}
                 					ticketRec = Create_Case[ID == recordId.trim().toLong()];
                 					if(ticketRec == null)
                 					{
                 						invoicePdfSaved = "no - no Create_Case record with ID " + recordId;
                 						info "onDemandInvoicing - invoice PDF NOT attached: no Create_Case record with ID " + recordId + ".";
                 					}
                 					else if(pdfKind != "a real PDF")
                 					{
                 						/* ONLY STORE WHAT IS ACTUALLY A PDF - 2026-10-06. Assigning a non-file
                 						   to a File Upload field throws nothing, so the old code reported "yes"
                 						   for a write that stored nothing at all. The peek decides now. */
                 						invoicePdfSaved = "no - Books returned " + pdfKind;
                 						info "onDemandInvoicing - invoice PDF NOT attached: Books returned " + pdfKind + " instead of a document. Nothing was written to Invoice_PDF.";
                 					}
                 					else
                 					{
                 						/* THE ASSIGNMENT GETS ITS OWN GUARD - 2026-10-07, from a live error:
                 						   "Value of the field Invoice_PDF length should be lesser than or equal to
                 						   MaxLength 255." That length check only exists on a TEXT field, so it says
                 						   plainly that Invoice_PDF was created as Single Line rather than File
                 						   Upload - and the raw exception that surfaced it named a line number, not
                 						   the cause. Reaching this line at all proves the fetch WORKED: nothing gets
                 						   here unless Books returned a real document. */
                 						try 
                 						{
                 							ticketRec.Invoice_PDF=pdfResp;
                 						}						catch (attachEx)
                 						{
                 							attachMsg = attachEx.toString();
                 							info "onDemandInvoicing - the PDF was fetched successfully but could NOT be stored: " + attachMsg;
                 							if(attachMsg.contains("MaxLength"))
                 							{
                 								return "{\"code\": \"ERROR\", \"message\": \"Zoho Books returned the invoice PDF correctly, but it could not be saved: Invoice_PDF on Create_Case is a TEXT field (max 255 characters) and a text field cannot hold a file. Change Invoice_PDF to a FILE UPLOAD field in Zoho Creator, then press Fetch PDF again. Nothing else about the invoice is affected.\"}";
                 							}
                 							return "{\"code\": \"ERROR\", \"message\": \"The invoice PDF was fetched but could not be saved onto the ticket. See this Custom API execution log for what Zoho refused.\"}";
                 						}
                 						invoicePdfSaved = "yes";
                 						info "onDemandInvoicing - invoice PDF attached to ticket " + recordId + " (Create_Case.Invoice_PDF) - it can now be opened from Creator without a Zoho Books login.";
                 					}
                 				}
                 			}
                 		}		catch (pdfEx)
                 		{
                 			info "onDemandInvoicing - invoice PDF could NOT be attached (non-fatal; the invoice exists in Books and its link is still returned). Most likely the Invoice_PDF File Upload field does not exist on Create_Case yet: " + pdfEx.toString();
                 		}
                 		// payments_recorded added 2026-09-14 — lets the widget (and anyone
                 		// reading the console) see at a glance whether 0/1/2 of the collected
                 		// payments actually made it onto the invoice, without having to open
                 		// Books. 0 on a ticket that genuinely had money collected is the
                 		// signal to check this Custom API's own execution log (most likely
                 		// causes, in order: the 4 new parameters not registered in the Custom
                 		// API setup screen, or payment_mode "other" being rejected).
                 		successResponse = "{\"code\": \"SUCCESS\", \"message\": \"Invoice created successfully\", \"invoice_id\": \"" + invoice_id + "\", \"invoice_number\": \"" + invoice_number + "\", \"total_amount\": " + totalAmount + ", \"service_charges\": " + serviceChargesAmt + ", \"cgst\": " + cgst + ", \"sgst\": " + sgst + ", \"round_off\": " + roundOffAmt + ", \"payments_recorded\": " + paymentsRecorded + ", \"invoice_pdf_saved\": \"" + invoicePdfSaved + "\", \"invoice_pdf_type\": \"" + pdfKind + "\", \"invoice_emailed\": \"" + invoiceEmailed + "\", \"url\": \"" + bestUrl + "\", \"public_invoice_url\": \"" + public_invoice_url + "\", \"payment_url\": \"" + payment_url + "\"}";
                 		invoiceURL = successResponse;
                 	}	catch (mainEx)
                 	{
                 		return "{\"code\": \"ERROR\", \"message\": \"Exception: " + mainEx.toString() + "\", \"url\": \"\"}";
                 	}
                 	return invoiceURL;
                 }
				 string paymentWebhook(string event_type, string event_id, map event_object, string token)
                 {
                 	try 
                 	{
                 		// REWRITTEN AGAINST THE REAL PAYLOAD - 2026-09-18. Zoho Payments' own
                 		// Developer Space delivery log was opened and the actual request body
                 		// read. Everything before this was written against an assumed shape and
                 		// was wrong in the simplest possible way:
                 		//
                 		// THE WRAPPER KEY IS event_object, NOT data. There is no key called
                 		// data anywhere in Zoho Payments' webhook body, so that parameter could
                 		// never have bound, whatever type it was declared as. That single
                 		// mismatch is the whole reason no payment ever reached a ticket.
                 		//
                 		// The real body, confirmed from a live delivery:
                 		//   event_id, event_type, account_id, live_mode, event_time  at top level
                 		//   event_object -> payment_links -> reference_id            e.g. RSID645006-BF
                 		//   event_object -> payment_links -> meta_data[]             key/value pairs,
                 		//                                                            one of which is recordId
                 		//   event_object -> payment_links -> payments[]              each with payment_id
                 		//
                 		// So payment_id is NOT a direct child of the link - it sits inside a
                 		// payments ARRAY, which is why every earlier attempt to read it came
                 		// back empty even when the payload was right in front of us.
                 		//
                 		// REGISTER event_object WITH TYPE MAP on this Custom API's setup screen,
                 		// alongside event_type, event_id and token. A parameter that is only
                 		// named in this signature binds null.
                 		//
                 		// Note from the same delivery: live_mode was true, and BOTH
                 		// payment_link.paid and payment.succeeded fired for the one payment.
                 		// Two deliveries updating the same ticket to the same values is
                 		// harmless - the second write is identical to the first.
                 		dataText = "";
                 		if(event_object != null)
                 		{
                 			dataText = event_object.toString();
                 		}
                 		EXPECTED_TOKEN = "grx9K4mQ7pT2vL8sN3dW6yB1cZ5hJ0fE";
                 		ZC_CLIENT_ID = "1000.7BYOUWK2Q2XMJQWU62E6WHCRZOY9VW";
                 		ZC_CLIENT_SECRET = "a714fc6ab6c76d058196ceef8b49cad735422987fd";
                 		ZC_REFRESH_TOKEN = "1000.568bbdff83b5b398edb888ff31951dea.a5cbb7bbdd283c79ec801ebd10be426a";
                 		ZC_RECORD_URL_BASE = "https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/report/Agent_Ticket_Report/";
                 		info "=== paymentWebhook fired ===";
                 		info "  time       = " + zoho.currenttime;
                 		info "  event_type = [" + ifnull(event_type,"(null)") + "]";
                 		info "  event_id   = [" + ifnull(event_id,"(null)") + "]";
                 		info "  token      = [" + ifnull(token,"(null)") + "]";
                 		info "  data       = [" + dataText + "]";
                 		// data bound (2026-09-18) - the one line that settles whether Zoho
                 		// Payments' nested JSON object can reach a Creator string parameter.
                 		// Written as an if/else rather than concatenating the comparison itself
                 		// because Deluge CANNOT parse a parenthesised comparison inside a string
                 		// concatenation. That exact line is what made this file refuse to save
                 		// with "Improper Statement", and the line number Zoho reported for it
                 		// pointed somewhere else entirely, which cost several rounds to find.
                 		// Do not reintroduce that shape anywhere in this project.
                 		dataBoundText = "false";
                 		if(dataText != "")
                 		{
                 			dataBoundText = "true";
                 		}
                 		info "  data bound = " + dataBoundText;
                 		payloadText = ifnull(event_type,"") + " " + ifnull(event_id,"") + " " + dataText;
                 		info "  combined payload length = " + payloadText.length();
                 		info "  contains recordId=" + payloadText.contains("recordId") + " | -BF=" + payloadText.contains("-BF") + " | -RF=" + payloadText.contains("-RF") + " | reference_id=" + payloadText.contains("reference_id") + " | meta_data=" + payloadText.contains("meta_data") + " | payment_id=" + payloadText.contains("payment_id") + " | amount=" + payloadText.contains("amount");
                 		tokenGiven = ifnull(token,"").trim();
                 		if(EXPECTED_TOKEN != "")
                 		{
                 			if(tokenGiven != "")
                 			{
                 				if(tokenGiven != EXPECTED_TOKEN)
                 				{
                 					info "paymentWebhook REJECTED - a token arrived but does not match the expected value. NOTHING was updated. This is a genuine mismatch, not a registration problem.";
                 					return "{\"code\": \"SUCCESS\", \"result\": \"TOKEN_MISMATCH\", \"updated\": false, \"message\": \"A token arrived but it does not match the expected value. Nothing was updated. Check the token on the end of the webhook URL in Zoho Payments.\"}";
                 				}
                 				info "  token gate: OK (matched).";
                 			}
                 			else
                 			{
                 				info "  token gate: WARNING - no token bound to this call. Proceeding anyway because the request already passed Zoho's own publickey authentication. FIX: register a parameter named exactly 'token' on this Custom API's setup screen; until then this second auth layer is not actually being enforced.";
                 			}
                 		}
                 		if(payloadText.trim() == "")
                 		{
                 			info "paymentWebhook - NOTHING BOUND. Not one of event_type / event_id / data carried a value, so the webhook body never reached this script. Two things to check, in order: (1) are 'event_type', 'event_id', 'data' and 'token' all registered on this Custom API's setup screen? (2) does Zoho Payments post a nested JSON object for 'data'? A Creator 'string' parameter cannot receive an object - if that is what is happening, this signature needs a different shape. No record touched.";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NOTHING_BOUND\", \"updated\": false, \"message\": \"No parameter carried a value, so the webhook body never reached this script. Check that event_type, event_id, data and token are all registered on the Custom API setup screen, and that data is registered with type Map.\"}";
                 		}
                 		eventLower = ifnull(event_type,"").trim().toLowerCase();
                 		treatAsPaid = false;
                 		// isFailureEvent - 2026-09-18. payment.failed used to return immediately,
                 		// before the recordId extraction below had even run, so a failed attempt
                 		// left no trace anywhere an agent could see. It now falls through the same
                 		// extraction as a successful payment and appends a line to the ticket's
                 		// Payment_Failure_Log instead of writing any payment fields.
                 		isFailureEvent = false;
                 		if(eventLower == "")
                 		{
                 			treatAsPaid = true;
                 			info "  event gate: WARNING - event_type did not bind. Treating this as a successful payment so a real payment is not lost, but that means a FAILED payment would also be marked PAID. FIX: register a parameter named exactly 'event_type' on this Custom API's setup screen.";
                 		}
                 		else if(eventLower == "payment.succeeded")
                 		{
                 			treatAsPaid = true;
                 			info "  event gate: payment.succeeded - money received, proceeding.";
                 		}
                 		else if(eventLower == "payment_link.paid")
                 		{
                 			treatAsPaid = true;
                 			info "  event gate: payment_link.paid - money received, proceeding.";
                 		}
                 		else if(eventLower == "payment.failed")
                 		{
                 			isFailureEvent = true;
                 			info "  event gate: payment.failed - the customer's payment did NOT go through. This will be appended to the ticket's Payment_Failure_Log and NO payment field will be touched. Payment_Status is deliberately left exactly as it was rather than forced to PENDING: a customer who retries produces a failed event and a succeeded event, webhook delivery order is not guaranteed, and writing PENDING here could overwrite a PAID that had already landed.";
                 		}
                 		else if(eventLower == "payment_link.expired")
                 		{
                 			info "  event gate: payment_link.expired - the link timed out unused. No money moved. Nothing written.";
                 		}
                 		else if(eventLower == "payment_link.canceled")
                 		{
                 			info "  event gate: payment_link.canceled - link cancelled. No money moved. Nothing written.";
                 		}
                 		else if(eventLower == "payment_link.cancelled")
                 		{
                 			info "  event gate: payment_link.cancelled - link cancelled. No money moved. Nothing written.";
                 		}
                 		else if(eventLower == "refund.succeeded")
                 		{
                 			info "  event gate: refund.succeeded - refunds are recorded in the app at Closure (Refund_Due / Refund_Amount), by an agent, against the closure total. Writing here would fight that existing flow, so nothing is written. Reconcile refunds on the Closure page.";
                 		}
                 		else if(eventLower == "refund.failed")
                 		{
                 			info "  event gate: refund.failed - nothing written, same reasoning as refund.succeeded.";
                 		}
                 		else if(eventLower == "payout.initiated")
                 		{
                 			info "  event gate: payout.initiated - this is Zoho Payments settling collected money into YOUR bank account. It has no connection to any single ticket. Nothing written.";
                 		}
                 		else if(eventLower == "payout.paid")
                 		{
                 			info "  event gate: payout.paid - merchant settlement, not a customer payment. Nothing written.";
                 		}
                 		else if(eventLower == "payout.failed")
                 		{
                 			info "  event gate: payout.failed - merchant settlement, not a customer payment. Nothing written.";
                 		}
                 		else
                 		{
                 			info "  event gate: UNRECOGNISED event_type [" + event_type + "]. Nothing written, deliberately - marking a ticket paid on an event this script does not understand is not safe. Send this exact value over and it will be added to the list.";
                 		}
                 		// A failure event is allowed PAST this gate so it can reach the recordId
                 		// extraction below and append to Payment_Failure_Log. Every other
                 		// non-payment event still stops here exactly as before.
                 		if(treatAsPaid == false)
                 		{
                 			if(isFailureEvent == false)
                 			{
                 				return "{\"code\": \"SUCCESS\", \"result\": \"EVENT_IGNORED\", \"updated\": false, \"event\": \"" + eventLower + "\", \"message\": \"This event does not mean money was received, so nothing was written. Only payment.succeeded and payment_link.paid update a ticket.\"}";
                 			}
                 		}
                 		// STRUCTURAL EXTRACTION - 2026-09-18, after a Postman call returned
                 		// NO_RECORD_ID even though the payload plainly contained one.
                 		//
                 		// Root cause: data is a Map now, and a Deluge Map's toString() is NOT
                 		// JSON. It renders as
                 		//     {payment={payment_id=555..., meta_data=[{key=recordId, value=448...}]}}
                 		// with equals signs and NO double quotes. Every extraction below this
                 		// point was written to split JSON on the double-quote character, so with
                 		// none present it got one giant token that could never convert to a
                 		// number - hence NO_RECORD_ID on a payload that clearly had one.
                 		//
                 		// The fix is to stop scraping text and read the Map structurally, which
                 		// is both correct and immune to whichever notation toString() happens to
                 		// use. The old string-scraping is KEPT below as a fallback, and now only
                 		// runs if this structural pass found nothing - so a payload in a shape
                 		// this does not expect still behaves exactly as it did before.
                 		refIdText = "";
                 		txnId = "";
                 		resolvedRecordId = 0;
                 		foundRecordId = false;
                 		paymentMap = event_object;
                 		if(event_object != null)
                 		{
                 			if(event_object.get("payment_links") != null)
                 			{
                 				paymentMap = event_object.get("payment_links");
                 			}
                 			else if(event_object.get("payments") != null)
                 			{
                 				paymentMap = event_object.get("payments");
                 			}
                 			else if(event_object.get("payment") != null)
                 			{
                 				paymentMap = event_object.get("payment");
                 			}
                 		}
                 		if(paymentMap != null)
                 		{
                 			if(paymentMap.get("reference_id") != null)
                 			{
                 				refIdText = paymentMap.get("reference_id").toString();
                 			}
                 			if(paymentMap.get("payment_id") != null)
                 			{
                 				txnId = paymentMap.get("payment_id").toString();
                 			}
                 		}
                 		// paymentsList is initialised as a real List() BEFORE anything is put in
                 		// it - 2026-09-18, fixes "Variable 'payEntry' is not defined" at save.
                 		// Deluge cannot infer the type of a value that came out of .get(), so a
                 		// for-each over it never defines its loop variable. Assigning into a
                 		// variable that is already a List gives the parser the type it needs.
                 		// Same reason the meta_data loop further down builds metaEntries first.
                 		if(txnId == "")
                 		{
                 			try 
                 			{
                 				paymentsList = List();
                 				if(paymentMap != null)
                 				{
                 					if(paymentMap.get("payments") != null)
                 					{
                 						paymentsList = paymentMap.get("payments").toList();
                 					}
                 				}
                 				for each  payEntry in paymentsList
                 				{
                 					if(txnId == "")
                 					{
                 						if(payEntry.get("payment_id") != null)
                 						{
                 							txnId = payEntry.get("payment_id").toString();
                 						}
                 					}
                 				}
                 			}			catch (payListEx)
                 			{
                 				info "  payments node could not be walked as a list of maps - skipping it: " + payListEx.toString();
                 			}
                 		}
                 		if(txnId == "")
                 		{
                 			if(paymentMap != null)
                 			{
                 				if(paymentMap.get("transaction_id") != null)
                 				{
                 					txnId = paymentMap.get("transaction_id").toString();
                 				}
                 			}
                 		}
                 		if(txnId == "")
                 		{
                 			if(paymentMap != null)
                 			{
                 				if(paymentMap.get("payment_link_id") != null)
                 				{
                 					txnId = paymentMap.get("payment_link_id").toString();
                 				}
                 			}
                 		}
                 		// metaEntries starts life as a real List() for the same reason
                 		// paymentsList above does - see that comment. Without it the for-each
                 		// below fails to save with "Variable 'metaEntry' is not defined".
                 		metaEntries = List();
                 		try 
                 		{
                 			rawMeta = null;
                 			if(paymentMap != null)
                 			{
                 				rawMeta = paymentMap.get("meta_data");
                 			}
                 			if(rawMeta == null)
                 			{
                 				if(event_object != null)
                 				{
                 					rawMeta = event_object.get("meta_data");
                 				}
                 			}
                 			if(rawMeta != null)
                 			{
                 				metaEntries = rawMeta.toList();
                 			}
                 		}		catch (metaListEx)
                 		{
                 			info "  meta_data node could not be read as a list - skipping it: " + metaListEx.toString();
                 		}
                 		for each  metaEntry in metaEntries
                 		{
                 			if(foundRecordId == false)
                 			{
                 				metaKey = "";
                 				if(metaEntry.get("key") != null)
                 				{
                 					metaKey = metaEntry.get("key").toString().trim();
                 				}
                 				if(metaKey == "recordId")
                 				{
                 					metaValue = "";
                 					if(metaEntry.get("value") != null)
                 					{
                 						metaValue = metaEntry.get("value").toString().trim();
                 					}
                 					if(metaValue != "")
                 					{
                 						try 
                 						{
                 							maybeMetaId = metaValue.toLong();
                 							if(maybeMetaId > 0)
                 							{
                 								resolvedRecordId = maybeMetaId;
                 								foundRecordId = true;
                 							}
                 						}						catch (metaEx)
                 						{
                 							foundRecordId = false;
                 						}
                 					}
                 				}
                 			}
                 		}
                 		info "  structural read - reference_id=[" + refIdText + "] | payment_id=[" + txnId + "] | recordId found=" + foundRecordId + " | recordId=" + resolvedRecordId;
                 		// BANK / UPI REFERENCE (UTR) - Task Tracker #97, 2026-11-02. The Payment ID above is Zoho
                 		// Payments' own id. A payment can also carry the bank / UPI reference the customer sees. Its key
                 		// is not yet confirmed from a live delivery, so the usual names are tried, and every payment's
                 		// own field names are logged - the first real payment shows exactly what Zoho sends.
                 		// Read only; it is saved on its own AFTER the payment write (see below).
                 		bankRef = "";
                 		bankRefKeys = List();
                 		bankRefKeys.add("bank_reference_number");
                 		bankRefKeys.add("bank_reference_id");
                 		bankRefKeys.add("bank_ref_no");
                 		bankRefKeys.add("utr");
                 		bankRefKeys.add("utr_number");
                 		bankRefKeys.add("rrn");
                 		refSources = List();
                 		if(paymentMap != null)
                 		{
                 			refSources.add(paymentMap);
                 		}
                 		try 
                 		{
                 			if(paymentMap != null)
                 			{
                 				info "  #97 payment fields: " + paymentMap.keys().toString();
                 			}
                 			refPayList = List();
                 			if(paymentMap != null)
                 			{
                 				if(paymentMap.get("payments") != null)
                 				{
                 					refPayList = paymentMap.get("payments").toList();
                 				}
                 			}
                 			for each  refPay in refPayList
                 			{
                 				refSources.add(refPay);
                 				info "  #97 payment entry fields: " + refPay.keys().toString();
                 				if(refPay.get("payment_method") != null)
                 				{
                 					refSources.add(refPay.get("payment_method"));
                 				}
                 			}
                 		}		catch (refListEx)
                 		{
                 			info "  #97 payments could not be listed for a bank reference - skipping: " + refListEx.toString();
                 		}
                 		for each  refSrc in refSources
                 		{
                 			try 
                 			{
                 				for each  refKey in bankRefKeys
                 				{
                 					if(bankRef == "")
                 					{
                 						if(refSrc.get(refKey) != null)
                 						{
                 							bankRef = refSrc.get(refKey).toString().trim();
                 						}
                 					}
                 				}
                 			}			catch (refKeyEx)
                 			{
                 				info "  #97 one payment node could not be read for a bank reference - skipping it: " + refKeyEx.toString();
                 			}
                 		}
                 		info "  #97 bank reference=[" + bankRef + "]";
                 		// Fee type comes from reference_id when the structural read found one
                 		// (that is the field the app puts the -BF / -RF suffix on), falling back
                 		// to scanning the whole payload exactly as before.
                 		feeSource = refIdText;
                 		if(feeSource == "")
                 		{
                 			feeSource = payloadText;
                 		}
                 		isBookingFee = false;
                 		if(feeSource.contains("-BF"))
                 		{
                 			isBookingFee = true;
                 		}
                 		isRemainingFee = false;
                 		if(feeSource.contains("-RF"))
                 		{
                 			isRemainingFee = true;
                 		}
                 		if(foundRecordId == false)
                 		{
                 			idParts = payloadText.toList("recordId");
                 			if(idParts.size() > 1)
                 			{
                 				afterKey = idParts.get(1);
                 				idTokens = afterKey.toList("\"");
                 				for each  idToken in idTokens
                 				{
                 					if(foundRecordId == false)
                 					{
                 						idTokenTrim = idToken.trim();
                 						if(idTokenTrim.length() >= 15)
                 						{
                 							try 
                 							{
                 								maybeRecordId = idTokenTrim.toLong();
                 								if(maybeRecordId > 0)
                 								{
                 									resolvedRecordId = maybeRecordId;
                 									foundRecordId = true;
                 								}
                 							}							catch (idEx)
                 							{
                 								foundRecordId = false;
                 							}
                 						}
                 					}
                 				}
                 			}
                 		}
                 		if(txnId == "")
                 		{
                 			txnKeys = List();
                 			txnKeys.add("payment_id");
                 			txnKeys.add("transaction_id");
                 			txnKeys.add("payment_link_id");
                 			for each  txnKey in txnKeys
                 			{
                 				if(txnId == "")
                 				{
                 					txnParts = payloadText.toList(txnKey);
                 					if(txnParts.size() > 1)
                 					{
                 						afterTxnKey = txnParts.get(1);
                 						txnTokens = afterTxnKey.toList("\"");
                 						for each  txnToken in txnTokens
                 						{
                 							if(txnId == "")
                 							{
                 								txnTrim = txnToken.trim();
                 								txnOk = true;
                 								if(txnTrim == "")
                 								{
                 									txnOk = false;
                 								}
                 								if(txnTrim.length() < 4)
                 								{
                 									txnOk = false;
                 								}
                 								if(txnTrim.length() > 64)
                 								{
                 									txnOk = false;
                 								}
                 								if(txnTrim.contains("{"))
                 								{
                 									txnOk = false;
                 								}
                 								if(txnTrim.contains("}"))
                 								{
                 									txnOk = false;
                 								}
                 								if(txnTrim.contains(":"))
                 								{
                 									txnOk = false;
                 								}
                 								if(txnTrim.contains(","))
                 								{
                 									txnOk = false;
                 								}
                 								if(txnTrim.contains(" "))
                 								{
                 									txnOk = false;
                 								}
                 								if(txnOk)
                 								{
                 									txnId = txnTrim;
                 								}
                 							}
                 						}
                 					}
                 				}
                 			}
                 		}
                 		info "paymentWebhook - isBookingFee=" + isBookingFee + " | isRemainingFee=" + isRemainingFee + " | foundRecordId=" + foundRecordId + " | resolvedRecordId=" + resolvedRecordId + " | txnId=" + txnId;
                 		if(foundRecordId == false)
                 		{
                 			info "paymentWebhook - no recordId could be read out of the payload. Nothing updated. Check the data dump above for where the metadata actually sits.";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NO_RECORD_ID\", \"updated\": false, \"message\": \"The payload arrived but carried no recordId, so there is no way to tell which ticket was paid. Nothing was updated. Check that the payment link was created by this app - links made outside it carry no recordId metadata.\"}";
                 		}
                 		feeTypeCount = 0;
                 		if(isBookingFee)
                 		{
                 			feeTypeCount = feeTypeCount + 1;
                 		}
                 		if(isRemainingFee)
                 		{
                 			feeTypeCount = feeTypeCount + 1;
                 		}
                 		if(feeTypeCount == 0)
                 		{
                 			info "paymentWebhook - payload carries neither a '-BF' nor a '-RF' marker, so this is not a Booking Fee or Remaining Fee link. Nothing updated.";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NO_FEE_MARKER\", \"updated\": false, \"message\": \"The payload has no -BF or -RF marker, so this payment is neither a Booking Fee nor a Remaining Fee. Nothing was updated.\"}";
                 		}
                 		if(feeTypeCount > 1)
                 		{
                 			info "paymentWebhook - payload carries BOTH a '-BF' and a '-RF' marker, so which fee was actually paid is ambiguous. Nothing updated, deliberately - marking the wrong fee paid would put real money on the wrong line. Check the data dump above and mark the ticket by hand.";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"AMBIGUOUS_FEE_TYPE\", \"updated\": false, \"message\": \"The payload carries BOTH a -BF and a -RF marker, so which fee was paid is ambiguous. Nothing was updated on purpose - marking the wrong fee would put real money on the wrong line. Mark the ticket by hand.\"}";
                 		}
                 		ticketRec = Create_Case[ID == resolvedRecordId];
                 		if(ticketRec == null)
                 		{
                 			info "paymentWebhook - recordId " + resolvedRecordId + " does not match any Create_Case record. Nothing updated.";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"TICKET_NOT_FOUND\", \"updated\": false, \"recordId\": \"" + resolvedRecordId + "\", \"message\": \"A recordId was read from the payload but no Create_Case record has that ID. Nothing was updated.\"}";
                 		}
                 		feeLabelEarly = "Remaining Fee";
                 		if(isBookingFee)
                 		{
                 			feeLabelEarly = "Booking Fee";
                 		}
                 		fieldMap = Map();
                 		if(isFailureEvent)
                 		{
                 			// FAILED PAYMENT - 2026-09-18, once Payment_Failure_Log was created on
                 			// Create_Case. Appends one line per failed attempt and writes NOTHING
                 			// else. Payment_Status is deliberately left untouched: a customer who
                 			// retries produces a failed event and a succeeded event, Zoho does not
                 			// guarantee delivery order, and forcing PENDING here could overwrite a
                 			// PAID that had already landed.
                 			//
                 			// Append rather than replace, so an agent sees how many times a
                 			// customer bounced rather than only the last attempt - the same
                 			// append-only convention Remarks already uses in this app. ticketRec
                 			// was fetched just above, so the existing text is already in hand and
                 			// no extra read is needed.
                 			failureLine = zoho.currenttime.toString("dd-MMM-yyyy hh:mm a") + " - " + feeLabelEarly + " payment FAILED";
                 			if(txnId != "")
                 			{
                 				failureLine = failureLine + " (payment id " + txnId + ")";
                 			}
                 			existingLog = ifnull(ticketRec.Payment_Failure_Log,"").toString();
                 			if(existingLog.trim() == "")
                 			{
                 				fieldMap.put("Payment_Failure_Log",failureLine);
                 			}
                 			else
                 			{
                 				fieldMap.put("Payment_Failure_Log",existingLog + "\n" + failureLine);
                 			}
                 			info "paymentWebhook - FAILED payment recorded on record " + resolvedRecordId + ": " + failureLine;
                 		}
                 		else
                 		{
                 			fieldMap.put("Payment_Status","PAID");
                 			// Booking fee receipt time - 2026-10-07, LOCATIONS-DISTANCES-DATETIME
                 			// spec #3 ("BOOKING FEE SUCCESS TIME FROM ZOHO PAYMENT"). Only on the
                 			// booking-fee branch: the remaining fee has its own field, already wired
                 			// at the Final Payment stage.
                 			if(isBookingFee)
                 			{
                 				fieldMap.put("Booking_Fee_Receipt_Time",zoho.currenttime.toString("dd-MMM-yyyy HH:mm:ss"));
                 				/* ADVANCE THE TICKET STATUS - 2026-10-08, client-reported: a ticket shows
                 				   the green PAID flag and the pill BOOKING FEE PENDING at the same time.
                 				
                 				   Both are right about their own field, which is the problem. The flag
                 				   reads Payment_Status, which this webhook sets. The pill reads Status,
                 				   which this webhook never touched - it was only ever recomputed by
                 				   quoteStatus() when an AGENT reopened the Quote step and saved. Nobody
                 				   does that after a gateway payment, so the ticket sat contradicting
                 				   itself on the dashboard until someone happened to open it.
                 				
                 				   LOCATION PENDING is exactly what quoteStatus() returns for a paid
                 				   booking fee, so this writes the value the app would have written.
                 				   Guarded on the ticket still being at one of the two early statuses -
                 				   the same statusStillEarly() rule quoteStatus uses - so a ticket that
                 				   has since been assigned, accepted or closed is never dragged back. */
                 				curStatus = ifnull(ticketRec.Status,"").toString().trim().toUpperCase();
                 				if(curStatus == "SERVICE FEE QUOTE" || curStatus == "BOOKING FEE PENDING")
                 				{
                 					fieldMap.put("Status","LOCATION PENDING");
                 					info "paymentWebhook - advancing Status from [" + curStatus + "] to LOCATION PENDING, matching what the Quote step would set for a paid booking fee.";
                 				}
                 				else
                 				{
                 					info "paymentWebhook - Status left as [" + curStatus + "]: the ticket has already moved past the booking-fee stage, so advancing it would undo real progress.";
                 				}
                 			}
                 			if(isBookingFee)
                 			{
                 				/* Payment_Method / Payment_Method_Final (2026-09-22, client feedback:
                 				   "after payment is done the mode is payment not being updated").
                 				   "Payment Gateway" must ALSO exist as an option on the Zoho field or
                 				   Zoho rejects the WHOLE record write - every other field in this map
                 				   included. modeFreeFieldMap below is the safety net: it carries the
                 				   identical payload minus these two keys, and is retried automatically
                 				   if the first PATCH is refused, so a missing dropdown option can
                 				   never cost us Payment_Status, Payment_received or the transaction
                 				   ids, which all work today. */
                 				fieldMap.put("Payment_Method","Payment Gateway");
                 				if(txnId != "")
                 				{
                 					fieldMap.put("Booking_Fee_Transaction_ID",txnId);
                 				}
                 			}
                 			if(isRemainingFee)
                 			{
                 				fieldMap.put("Payment_Method_Final","Payment Gateway");
                 				fieldMap.put("Payment_received","Yes");
                 				if(txnId != "")
                 				{
                 					fieldMap.put("Remaining_Fee_Transaction_ID",txnId);
                 				}
                 			}
                 		}
                 		info "paymentWebhook - fields to write on record " + resolvedRecordId + ": " + fieldMap.toString();
                 		patchDone = false;
                 		try 
                 		{
                 			tokenResp = invokeurl
                 			[
                 				url :"https://accounts.zoho.in/oauth/v2/token?refresh_token=" + ZC_REFRESH_TOKEN + "&client_id=" + ZC_CLIENT_ID + "&client_secret=" + ZC_CLIENT_SECRET + "&grant_type=refresh_token"
                 				type :POST
                 			];
                 			zcAccessToken = tokenResp.get("access_token");
                 			if(zcAccessToken == null)
                 			{
                 				info "paymentWebhook - no access_token returned by the token endpoint. Raw response: " + tokenResp.toString();
                 			}
                 			else
                 			{
                 				patchBody = Map();
                 				modeFreeFieldMap = Map();
                 				modeKeyList = List();
                 				modeKeyList = fieldMap.keys();
                 				for each  modeKey in modeKeyList
                 				{
                 					if(modeKey != "Payment_Method")
                 					{
                 						if(modeKey != "Payment_Method_Final")
                 						{
                 							modeFreeFieldMap.put(modeKey,fieldMap.get(modeKey));
                 						}
                 					}
                 				}
                 				patchBody.put("data",fieldMap);
                 				patchResp = invokeurl
                 				[
                 					url :ZC_RECORD_URL_BASE + resolvedRecordId
                 					type :PATCH
                 					parameters:patchBody.toString()
                 					headers:{"Content-Type":"application/json","Authorization":"Bearer " + zcAccessToken}
                 				];
                 				info "paymentWebhook - Data API PATCH response: " + patchResp.toString();
                 				if(patchResp.get("code") != 3000)
                 				{
                 					if(modeFreeFieldMap.size() > 0)
                 					{
                 						info "paymentWebhook - full write refused. Retrying WITHOUT Payment_Method/Payment_Method_Final - the most likely cause is that 'Payment Gateway' is not yet an option on that field in Zoho. Add it on the Create_Case form to capture the payment mode too; everything else is still being written by this retry.";
                 						modeFreeBody = Map();
                 						modeFreeBody.put("data",modeFreeFieldMap);
                 						modeFreeResp = invokeurl
                 						[
                 							url :ZC_RECORD_URL_BASE + resolvedRecordId
                 							type :PATCH
                 							parameters:modeFreeBody.toString()
                 							headers:{"Content-Type":"application/json","Authorization":"Bearer " + zcAccessToken}
                 						];
                 						info "paymentWebhook - retry (without payment mode) response: " + modeFreeResp.toString();
                 						patchResp = modeFreeResp;
                 					}
                 				}
                 				if(patchResp.get("code") == 3000)
                 				{
                 					patchDone = true;
                 				}
                 			}
                 		}		catch (patchEx)
                 		{
                 			info "paymentWebhook - Data API PATCH threw: " + patchEx.toString();
                 		}
                 		if(patchDone == false)
                 		{
                 			info "paymentWebhook - Data API PATCH did not succeed, falling back to the direct record write (the path this webhook used before 2026-09-16, confirmed working in this context).";
                 			updateRec = Create_Case[ID == resolvedRecordId];
                 			if(isFailureEvent)
                 			{
                 				// Failure path writes ONLY the log - never Payment_Status.
                 				updateRec.Payment_Failure_Log=fieldMap.get("Payment_Failure_Log");
                 			}
                 			else
                 			{
                 				updateRec.Payment_Status="PAID";
                 				// Same stamp as the PATCH path above - the two write paths must not
                 				// disagree, which this file has been bitten by before.
                 				if(isBookingFee)
                 				{
                 					updateRec.Booking_Fee_Receipt_Time=zoho.currenttime;
                 					// Same Status advance as the PATCH path - the two write paths must not
                 					// disagree, which this file has been bitten by before.
                 					curStatusD = ifnull(updateRec.Status,"").toString().trim().toUpperCase();
                 					if(curStatusD == "SERVICE FEE QUOTE" || curStatusD == "BOOKING FEE PENDING")
                 					{
                 						updateRec.Status="LOCATION PENDING";
                 					}
                 				}
                 				// Payment_Method was MISSING from this fallback — 2026-10-05. The PATCH
                 				// path above has always set it (fieldMap.put("Payment_Method",...)), so
                 				// the two paths wrote different things and only this one was running.
                 				//
                 				// Leaving it on the "Cash" default did three things at once: the method
                 				// read Cash for a card/UPI payment; BF Transaction ID vanished from the
                 				// screen because its own when() is Payment_Method != "Cash"; and the BF
                 				// Receipt Photo turned MANDATORY, because that is only waived for
                 				// "Payment Gateway" — blocking the agent behind a receipt that cannot
                 				// exist for an online payment.
                 				if(isBookingFee)
                 				{
                 					updateRec.Payment_Method="Payment Gateway";
                 					if(txnId != "")
                 					{
                 						updateRec.Booking_Fee_Transaction_ID=txnId;
                 					}
                 				}
                 				if(isRemainingFee)
                 				{
                 					updateRec.Payment_Method_Final="Payment Gateway";
                 					updateRec.Payment_received="Yes";
                 					if(txnId != "")
                 					{
                 						updateRec.Remaining_Fee_Transaction_ID=txnId;
                 					}
                 				}
                 			}
                 		}
                 		if(isFailureEvent)
                 		{
                 			writePathFail = "direct record write";
                 			if(patchDone)
                 			{
                 				writePathFail = "Creator Data API";
                 			}
                 			return "{\"code\": \"SUCCESS\", \"result\": \"FAILURE_LOGGED\", \"updated\": true, \"fee\": \"" + feeLabelEarly + "\", \"recordId\": \"" + resolvedRecordId + "\", \"transaction_id\": \"" + txnId + "\", \"written_via\": \"" + writePathFail + "\", \"message\": \"A FAILED " + feeLabelEarly + " payment attempt was appended to this ticket's Payment Failures log. No payment fields were changed.\"}";
                 		}
                 		// #97 - saved on its own, after the payment fields are already written, so a problem here can
                 		// never cost the payment. Nothing is written when Zoho sent no bank reference.
                 		if(bankRef != "")
                 		{
                 			try 
                 			{
                 				refRec = Create_Case[ID == resolvedRecordId];
                 				if(isBookingFee)
                 				{
                 					refRec.BF_Bank_Reference=bankRef;
                 				}
                 				if(isRemainingFee)
                 				{
                 					refRec.RF_Bank_Reference=bankRef;
                 				}
                 				info "paymentWebhook - #97 bank reference [" + bankRef + "] saved on record " + resolvedRecordId;
                 			}			catch (refWriteEx)
                 			{
                 				info "paymentWebhook - #97 bank reference could not be saved (the payment itself is already written): " + refWriteEx.toString();
                 			}
                 		}
                 		else
                 		{
                 			info "paymentWebhook - #97 no bank / UPI reference in this payment's data - see the #97 field lists above for what Zoho sent.";
                 		}
                 		feeLabel = "Remaining Fee";
                 		if(isBookingFee)
                 		{
                 			feeLabel = "Booking Fee";
                 		}
                 		writePath = "direct record write";
                 		if(patchDone)
                 		{
                 			writePath = "Creator Data API";
                 		}
                 		if(isBookingFee)
                 		{
                 			info "paymentWebhook - Booking Fee marked PAID on record " + resolvedRecordId + " | transaction ID: " + txnId + " | via Data API: " + patchDone;
                 		}
                 		if(isRemainingFee)
                 		{
                 			info "paymentWebhook - Remaining Fee marked PAID on record " + resolvedRecordId + " (Payment_received = Yes) | transaction ID: " + txnId + " | via Data API: " + patchDone;
                 		}
                 		return "{\"code\": \"SUCCESS\", \"result\": \"UPDATED\", \"updated\": true, \"fee\": \"" + feeLabel + "\", \"recordId\": \"" + resolvedRecordId + "\", \"transaction_id\": \"" + txnId + "\", \"written_via\": \"" + writePath + "\", \"message\": \"" + feeLabel + " marked PAID on ticket " + resolvedRecordId + ".\"}";
                 	}	catch (e)
                 	{
                 		info "paymentWebhook threw (no record was updated by this call): " + e.toString();
                 		return "{\"code\": \"SUCCESS\", \"result\": \"EXCEPTION\", \"updated\": false, \"message\": \"The script threw an error and nothing was updated. See this Custom API execution log for the exception text.\"}";
                 	}
                 	return "{\"code\": \"SUCCESS\", \"result\": \"NO_RESULT\", \"updated\": false, \"message\": \"The script finished without reaching any known outcome. This should not happen - send the execution log over.\"}";
                 }
				 string recordRingingCall(string callerID, string ucid, string type, string agentID)
                 {
                 	try 
                 	{
                 		info "========== RINGING CALL (SCREENPOP SERVER SIDE) ==========";
                 		info "  time     = " + zoho.currenttime;
                 		info "  callerID = [" + ifnull(callerID,"(null)") + "]";
                 		info "  ucid     = [" + ifnull(ucid,"(null)") + "]";
                 		info "  type     = [" + ifnull(type,"(null)") + "]";
                 		info "  agentID  = [" + ifnull(agentID,"(null)") + "]";
                 		rawPhone = ifnull(callerID,"").trim();
                 		digitsOnly = rawPhone.replaceAll("[^0-9]","");
                 		last10 = digitsOnly;
                 		if(last10.length() > 10)
                 		{
                 			last10 = last10.subText(last10.length() - 10);
                 		}
                 		info "  digits = [" + digitsOnly + "] | last10 = [" + last10 + "]";
                 		if(last10.length() < 6)
                 		{
                 			info "  NO USABLE NUMBER - nothing recorded.";
                 			echoCaller = ifnull(callerID,"(null)").toString().replaceAll("\"","'");
                 			echoUcid = ifnull(ucid,"(null)").toString().replaceAll("\"","'");
                 			echoType = ifnull(type,"(null)").toString().replaceAll("\"","'");
                 			echoAgent = ifnull(agentID,"(null)").toString().replaceAll("\"","'");
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NO_PHONE\", \"created\": false, \"received_callerID\": \"" + echoCaller + "\", \"received_ucid\": \"" + echoUcid + "\", \"received_type\": \"" + echoType + "\", \"received_agentID\": \"" + echoAgent + "\", \"digits_found\": \"" + digitsOnly + "\", \"message\": \"No usable caller number arrived, so no ringing row was recorded. The received_* fields above show exactly what each parameter arrived as. (null) means the parameter never reached this function at all - it is either not registered on the Custom API setup screen, or the caller did not send it. A literal placeholder such as $CallerID$ means the calling system opened the URL without substituting its own token.\"}";
                 		}
                 		resolvedUcid = ifnull(ucid,"").trim();
                 		if(resolvedUcid.contains("$"))
                 		{
                 			resolvedUcid = "";
                 		}
                 		if(resolvedUcid != "")
                 		{
                 			existingId = "";
                 			for each  dupRow in Call_Log[UCID == resolvedUcid]
                 			{
                 				if(existingId == "")
                 				{
                 					existingId = dupRow.ID.toString();
                 				}
                 			}
                 			if(existingId != "")
                 			{
                 				info "  Call_Log " + existingId + " already carries this UCID - nothing inserted.";
                 				return "{\"code\": \"SUCCESS\", \"result\": \"ALREADY_RECORDED\", \"created\": false, \"recordId\": \"" + existingId + "\", \"phone\": \"" + last10 + "\", \"ucid\": \"" + resolvedUcid + "\", \"message\": \"A Call_Log row already exists for this UCID, so this hit was ignored. This is expected when ScreenPop is set to Client&Server, which fires twice for one call.\"}";
                 			}
                 		}
                 		vType = "Inbound";
                 		typeLower = ifnull(type,"").trim().toLowerCase();
                 		if(typeLower.contains("out"))
                 		{
                 			vType = "Outbound";
                 		}
                 		agentText = ifnull(agentID,"").trim();
                 		if(agentText.contains("$"))
                 		{
                 			agentText = "";
                 		}
                 		newRowId = insert into Call_Log
                 		[
                 			Phone_Number=last10
                 			UCID=resolvedUcid
                 			Call_Status="RINGING"
                 			Call_Direction=vType
                 			Agent_Name=agentText
                 			Added_User=zoho.loginuser
                 		];
                 		newRowIdText = newRowId.toString();
                 		info "  Created Call_Log " + newRowIdText + " for the ringing call.";
                 		matchedCaseId = 0;
                 		matchedCaseLabel = "";
                 		// Closed work is not what a new call is about - see this change's own 2026-10-09 note.
                 		// A delimited string rather than a list literal: Deluge reads {} as a map.
                 		closedStatuses = "|CLOSED|RSP CLOSED|RSP CANCELLED|CX REJECT|";
                 		skippedClosed = 0;
                 		for each  caseRec in Create_Case[Phone_Number1.contains(last10) || Phone_Number.contains(last10)]
                 		{
                 			recIdNum = caseRec.ID.toString().toLong();
                 			caseStatusText = ifnull(caseRec.Status,"").toString().trim();
                 			// Wrapped in pipes so "CLOSED" cannot match inside "RSP CLOSED".
                 			statusKey = "|" + caseStatusText + "|";
                 			if(closedStatuses.contains(statusKey))
                 			{
                 				skippedClosed = skippedClosed + 1;
                 			}
                 			else
                 			{
                 				// Highest id wins, compared explicitly rather than relying on the
                 				// fetch order - the previous "sort by ID desc" was not taking effect
                 				// and this loop kept the OLDEST case.
                 				if(recIdNum > matchedCaseId)
                 				{
                 					matchedCaseId = recIdNum;
                 					matchedCaseLabel = ifnull(caseRec.Case_ID,"").toString().trim();
                 				}
                 			}
                 		}
                 		info "  skipped " + skippedClosed + " closed/cancelled case(s) for this number.";
                 		// NOT LINKED HERE - 2026-10-09. Step 2 of the Ozonetel spec attaches the
                 		// RSID when the agent creates the case or saves the assignment, which is the
                 		// only moment anything knows which case the call is actually about. Guessing
                 		// it from the phone number at ring time attached calls to old cases AND
                 		// blocked the real link, because the widget will not overwrite an existing
                 		// one. The match is still reported below so the screen-pop can show the
                 		// agent which case this caller already has.
                 		if(matchedCaseId > 0)
                 		{
                 			info "  Caller has a live case (" + matchedCaseLabel + ") - reported to the screen-pop, deliberately NOT linked. See step 2.";
                 		}
                 		info "===========================================";
                 		return "{\"code\": \"SUCCESS\", \"result\": \"RINGING_RECORDED\", \"created\": true, \"recordId\": \"" + newRowIdText + "\", \"phone\": \"" + last10 + "\", \"ucid\": \"" + resolvedUcid + "\", \"direction\": \"" + vType + "\", \"agent\": \"" + agentText + "\", \"caseId\": \"" + matchedCaseLabel + "\", \"message\": \"A Call_Log row was created with Call_Status RINGING. The Call Center page polls for it and opens the screen-pop; getCallbackStatus completes this same row when the call ends.\"}";
                 	}	catch (e)
                 	{
                 		info "recordRingingCall threw: " + e.toString();
                 		return "{\"code\": \"ERROR\", \"result\": \"EXCEPTION\", \"created\": false, \"message\": \"" + e.toString().replaceAll("\"","'") + "\"}";
                 	}
                 	return "{\"code\": \"ERROR\", \"result\": \"NO_RESULT\", \"created\": false, \"message\": \"The script finished without reaching any known outcome.\"}";
                 }
				 string recordVendorPayment(string booksVendorId, string vendorName, string vendorEmail, string vendorPhone, string caseLabelsCsv, string netFeesCsv, string tdsPercent, string cashCollectedTotal, string paymentDate, string utrNo)
                 {
                 	organization_id = "60078911104";
                 	books_base_url = "https://www.zohoapis.in/books/v3";
                 	// NEEDS SETUP: EXPENSE_ACCOUNT_ID = a Zoho Books Chart of Accounts id for vendor payouts.
                 	// NEEDS SETUP: PAID_THROUGH_ACCOUNT_ID = the bank or cash account payments are made from.
                 	EXPENSE_ACCOUNT_ID = "3988332000000174002";
                 	// Vendor Service Charges
                 	PAID_THROUGH_ACCOUNT_ID = "3988332000000000459";
                 	// Petty Cash
                 	// All return values are built via a Map + toString() rather than
                 	// hand-concatenated strings. Real bug fixed live: an error message
                 	// coming back from Zoho Books itself (e.g. a duplicate-vendor-name
                 	// message) can contain a double quote or other character that breaks
                 	// a hand-built JSON string, which then fails to parse on the widget
                 	// side and hides the real error. Map().toString() escapes correctly
                 	// no matter what any upstream message contains.
                 	errMap = Map();
                 	errMap.put("code","ERROR");
                 	resultOut = "";
                 	try 
                 	{
                 		info "recordVendorPayment called with booksVendorId=" + booksVendorId + " | vendorName=" + vendorName + " | caseLabelsCsv=" + caseLabelsCsv + " | netFeesCsv=" + netFeesCsv + " | tdsPercent=" + tdsPercent + " | cashCollectedTotal=" + cashCollectedTotal + " | paymentDate=" + paymentDate + " | utrNo=" + utrNo;
                 		if(EXPENSE_ACCOUNT_ID == "")
                 		{
                 			errMap.put("message","EXPENSE_ACCOUNT_ID is not configured in recordVendorPayment.deluge.");
                 			return errMap.toString();
                 		}
                 		if(PAID_THROUGH_ACCOUNT_ID == "")
                 		{
                 			errMap.put("message","PAID_THROUGH_ACCOUNT_ID is not configured in recordVendorPayment.deluge.");
                 			return errMap.toString();
                 		}
                 		if(caseLabelsCsv == null || caseLabelsCsv == "")
                 		{
                 			errMap.put("message","caseLabelsCsv is missing or empty.");
                 			return errMap.toString();
                 		}
                 		caseLabelsList = caseLabelsCsv.toList(",");
                 		netFeesList = netFeesCsv.toList(",");
                 		if(caseLabelsList.size() != netFeesList.size())
                 		{
                 			errMap.put("message","caseLabelsCsv and netFeesCsv have different lengths.");
                 			return errMap.toString();
                 		}
                 		tdsPercentAmt = 0.0;
                 		try 
                 		{
                 			tdsPercentAmt = tdsPercent.toDecimal();
                 		}		catch (tdsEx)
                 		{
                 			tdsPercentAmt = 0.0;
                 		}
                 		cashCollectedAmt = 0.0;
                 		try 
                 		{
                 			cashCollectedAmt = cashCollectedTotal.toDecimal();
                 		}		catch (ccEx)
                 		{
                 			cashCollectedAmt = 0.0;
                 		}
                 		// Step 1: find or create the vendor contact in Zoho Books.
                 		// If booksVendorId was already passed in, reuse it and skip this.
                 		vendor_id = booksVendorId;
                 		if(vendor_id == null)
                 		{
                 			vendor_id = "";
                 		}
                 		if(vendor_id == "")
                 		{
                 			if(vendorPhone != null)
                 			{
                 				if(vendorPhone != "")
                 				{
                 					searchResp = invokeurl
                 					[
                 						url :books_base_url + "/contacts?organization_id=" + organization_id + "&phone=" + vendorPhone + "&contact_type=vendor"
                 						type :GET
                 						connection:"zoho_books_connection"
                 					];
                 					contactsList = searchResp.get("contacts");
                 					if(contactsList != null)
                 					{
                 						if(contactsList.size() > 0)
                 						{
                 							firstContact = contactsList.get(0);
                 							vendor_id = firstContact.get("contact_id");
                 						}
                 					}
                 				}
                 			}
                 		}
                 		// NAME LOOKUP BEFORE CREATING — 2026-10-05. The phone search above misses
                 		// any vendor whose Books record carries a different phone, or none, and the
                 		// create that followed then collided on the duplicate name Books enforces.
                 		// Searching the field Books actually treats as unique closes that gap.
                 		//
                 		// Own try/catch, miss treated as "not found": a refused or unexpected search
                 		// leaves us exactly where we already were - about to create - so this can
                 		// only ever find more, never break what works.
                 		nameForContact = vendorName;
                 		if(nameForContact == null)
                 		{
                 			nameForContact = "Vendor";
                 		}
                 		if(nameForContact == "")
                 		{
                 			nameForContact = "Vendor";
                 		}
                 		if(vendor_id == "")
                 		{
                 			try 
                 			{
                 				nameForSearch = nameForContact.replaceAll(" ","%20");
                 				nameSearchResp = invokeurl
                 				[
                 					url :books_base_url + "/contacts?organization_id=" + organization_id + "&contact_name=" + nameForSearch + "&contact_type=vendor"
                 					type :GET
                 					connection:"zoho_books_connection"
                 				];
                 				info "recordVendorPayment - vendor name lookup for [" + nameForContact + "], raw response: " + nameSearchResp.toString();
                 				nameContacts = nameSearchResp.get("contacts");
                 				if(nameContacts != null)
                 				{
                 					for each  nameContact in nameContacts
                 					{
                 						if(vendor_id == "")
                 						{
                 							// Matched here rather than trusting the filter: a "contains"-style
                 							// search would otherwise bind this payment to a similarly named vendor.
                 							foundName = "";
                 							if(nameContact.get("contact_name") != null)
                 							{
                 								foundName = nameContact.get("contact_name").toString().trim();
                 							}
                 							if(foundName.equalsIgnoreCase(nameForContact.trim()))
                 							{
                 								vendor_id = nameContact.get("contact_id").toString();
                 								info "recordVendorPayment - matched existing Books vendor by NAME (the phone search had missed it): " + foundName + " -> " + vendor_id;
                 							}
                 						}
                 					}
                 				}
                 			}			catch (nameSearchEx)
                 			{
                 				info "recordVendorPayment - vendor name lookup failed, falling through to create exactly as before: " + nameSearchEx.toString();
                 			}
                 		}
                 		if(vendor_id == "")
                 		{
                 			contactMap = Map();
                 			if(nameForContact == "")
                 			{
                 				nameForContact = "Vendor";
                 			}
                 			contactMap.put("contact_name",nameForContact);
                 			contactMap.put("contact_type","vendor");
                 			if(vendorPhone != null)
                 			{
                 				if(vendorPhone != "")
                 				{
                 					contactMap.put("phone",vendorPhone);
                 				}
                 			}
                 			if(vendorEmail != null)
                 			{
                 				if(vendorEmail != "")
                 				{
                 					contactMap.put("email",vendorEmail);
                 				}
                 			}
                 			createContactResp = invokeurl
                 			[
                 				url :books_base_url + "/contacts?organization_id=" + organization_id
                 				type :POST
                 				parameters:contactMap.toString()
                 				headers:{"Content-Type":"application/json"}
                 				connection:"zoho_books_connection"
                 			];
                 			newContact = createContactResp.get("contact");
                 			if(newContact == null)
                 			{
                 				createContactErr = createContactResp.get("message");
                 				errMap.put("message","Could not find or create vendor in Zoho Books: " + createContactErr + " If this says the name is already taken, that vendor exists in Books but could not be matched - open them in Books, copy their Contact ID, and paste it into Zoho_Books_Vendor_ID on the vendor record. That skips this lookup entirely.");
                 				return errMap.toString();
                 			}
                 			vendor_id = newContact.get("contact_id");
                 		}
                 		// THE VENDOR ID TRAVELS WITH ERRORS TOO - 2026-10-26. From here on the Books
                 		// vendor exists, and every later failure (bill, TDS, credit, payment) returns
                 		// errMap. Carrying the id on it lets the caller save it to Zoho_Books_Vendor_ID
                 		// even when the payment itself fails, so a retry skips the find-or-create.
                 		// The success replies already carry it under the same key.
                 		if(vendor_id != null)
                 		{
                 			if(vendor_id.toString() != "")
                 			{
                 				errMap.put("books_vendor_id",vendor_id.toString());
                 			}
                 		}
                 		// Step 2: create the Bill. One line item per case, at that case's
                 		// own Net Fee. This is the gross amount, before TDS or cash
                 		// collected are subtracted - those apply at payment time below.
                 		lineItems = List();
                 		billTotal = 0.0;
                 		for each index i in caseLabelsList
                 		{
                 			caseLabelRaw = caseLabelsList.get(i);
                 			netFeeRaw = netFeesList.get(i);
                 			netFeeAmt = 0.0;
                 			try 
                 			{
                 				netFeeAmt = netFeeRaw.toString().toDecimal();
                 			}			catch (nfEx)
                 			{
                 				errMap.put("message","Could not parse a Net Fee value as a decimal for case index " + i + ".");
                 				return errMap.toString();
                 			}
                 			billTotal = billTotal + netFeeAmt;
                 			lineItem = Map();
                 			lineItem.put("name","Vendor payout - " + caseLabelRaw);
                 			lineItem.put("account_id",EXPENSE_ACCOUNT_ID);
                 			lineItem.put("rate",netFeeAmt.toString());
                 			lineItem.put("quantity","1");
                 			lineItems.add(lineItem);
                 		}
                 		if(billTotal <= 0)
                 		{
                 			errMap.put("message","Bill total is not greater than 0.");
                 			return errMap.toString();
                 		}
                 		// PRE-FLIGHT GUARD (2026-09-15) - deliberately placed AHEAD of every
                 		// Zoho Books write in this function.
                 		//
                 		// The same negative-Final-Payable check already existed, but at Step 5,
                 		// which is AFTER the Bill has been created (Step 2) and AFTER the Vendor
                 		// Credit has been created and applied (Step 4). So a vendor whose Cash
                 		// Collected exceeded their Net Fee produced a real Bill and a real Vendor
                 		// Credit in Zoho Books, and only THEN returned an error - leaving two
                 		// orphaned financial documents behind with no payment against them. Worse,
                 		// the natural reaction to that error is to retry, which created another
                 		// orphaned pair every time.
                 		//
                 		// Computing the same figures here first makes the whole operation
                 		// all-or-nothing from Books' point of view: either the numbers are sound
                 		// and every document gets created, or nothing is written at all. The
                 		// original Step 5 check is left in place as belt-and-braces; it should
                 		// now be unreachable.
                 		preflightTds = (billTotal * tdsPercentAmt / 100.0).round(2);
                 		preflightPayable = (billTotal - preflightTds - cashCollectedAmt).round(2);
                 		// NEGATIVE IS ALLOWED - 2026-10-13. This used to reject outright and write
                 		// nothing. A vendor who collected more cash than their net fee owes US the
                 		// difference, which is a real settlement that has to be recordable. See this
                 		// change note for how it lands in Books. Left as a log line because the
                 		// figures are still worth having when one of these is queried later.
                 		if(preflightPayable < 0)
                 		{
                 			info "recordVendorPayment - Final Payable is NEGATIVE: billTotal=" + billTotal + " tds=" + preflightTds + " cashCollected=" + cashCollectedAmt + " -> payable=" + preflightPayable + ". The vendor owes this back; it will be left as an unapplied Vendor Credit and no Vendor Payment will be created.";
                 		}
                 		// TDS TAX ID — resolved here, before any Books write (2026-10-05).
                 		//
                 		// Books refuses tax_amount_withheld at payment level and wants the TDS
                 		// declared on the Bill, which needs the id of a configured TDS tax.
                 		//
                 		// Two routes, in order (2026-10-06): the TDS tax set on the vendor's own
                 		// Books record, which is exact; failing that, a match by name and rate
                 		// against the configured taxes, which is a guess and is kept only so a
                 		// vendor with nothing set behaves as it did before. Neither is hardcoded,
                 		// so vendors on different rates work with no code change.
                 		//
                 		// Both raw responses are logged: the shapes Books returns here have never
                 		// been confirmed in this project, and if a lookup finds nothing those log
                 		// lines are the answer.
                 		tdsTaxId = "";
                 		// -1 means "the rate behind tdsTaxId could not be read", which is NOT the
                 		// same as a rate of 0 and must not be compared as though it were.
                 		tdsTaxPctFound = -1.0;
                 		if(preflightTds > 0)
                 		{
                 			// PRIMARY SOURCE: the vendor's own TDS tax in Books (2026-10-06).
                 			//
                 			// Their Books vendor record already carries one - "TDS: Technical Fees
                 			// (2%)" - chosen by whoever does the accounts. That is an exact answer,
                 			// where matching on name and percentage is a guess: Indian TDS taxes are
                 			// named for their section (Technical Fees, Professional Fees, Contractor)
                 			// and almost never contain the letters "TDS", which is precisely why the
                 			// name rule below could not have matched this org's real tax.
                 			//
                 			// Raw response logged: tds_tax_id on the contact is documented for the
                 			// India edition but unconfirmed in this project, and this file's history
                 			// is a catalogue of what assuming a Zoho shape costs.
                 			try 
                 			{
                 				vendorTaxResp = invokeurl
                 				[
                 					url :books_base_url + "/contacts/" + vendor_id + "?organization_id=" + organization_id
                 					type :GET
                 					connection:"zoho_books_connection"
                 				];
                 				info "recordVendorPayment - Books vendor record read for its TDS tax, raw response: " + vendorTaxResp.toString();
                 				vendorContact = vendorTaxResp.get("contact");
                 				if(vendorContact != null)
                 				{
                 					if(vendorContact.get("tds_tax_id") != null)
                 					{
                 						tdsTaxId = vendorContact.get("tds_tax_id").toString().trim();
                 						// Books returns "0" for a vendor with no TDS tax chosen, which would
                 						// otherwise sail through as a perfectly valid-looking id.
                 						if(tdsTaxId == "0")
                 						{
                 							tdsTaxId = "";
                 						}
                 					}
                 				}
                 				if(tdsTaxId != "")
                 				{
                 					info "recordVendorPayment - using the TDS tax set on the vendor's own Books record -> tax_id " + tdsTaxId;
                 				}
                 				else
                 				{
                 					info "recordVendorPayment - no TDS tax is set on the vendor's Books record; falling back to matching the configured taxes by name and rate.";
                 				}
                 			}			catch (vendorTaxEx)
                 			{
                 				// Treated as "not set", so a refused or oddly shaped read drops us into
                 				// exactly the name match that ran before this change - never worse.
                 				info "recordVendorPayment - could not read the vendor's TDS tax from Books, falling back to the name match: " + vendorTaxEx.toString();
                 			}
                 			try 
                 			{
                 				taxesResp = invokeurl
                 				[
                 					url :books_base_url + "/settings/taxes?organization_id=" + organization_id
                 					type :GET
                 					connection:"zoho_books_connection"
                 				];
                 				info "recordVendorPayment - configured taxes in Books, raw response: " + taxesResp.toString();
                 				taxList = taxesResp.get("taxes");
                 				if(taxList != null)
                 				{
                 					for each  taxEntry in taxList
                 					{
                 						// RATE CROSS-CHECK. Creator's TDS_Percentage decides what we deduct from
                 						// the payment; the Books tax decides what the Bill withholds. If the two
                 						// disagree the documents describe different money, quietly, for months.
                 						// Only possible when the tax appears in this list - see the check below
                 						// for what happens when it does not.
                 						if(tdsTaxId != "")
                 						{
                 							if(taxEntry.get("tax_id") != null)
                 							{
                 								if(taxEntry.get("tax_id").toString() == tdsTaxId)
                 								{
                 									try 
                 									{
                 										if(taxEntry.get("tax_percentage") != null)
                 										{
                 											tdsTaxPctFound = taxEntry.get("tax_percentage").toString().toDecimal();
                 										}
                 									}									catch (foundPctEx)
                 									{
                 										tdsTaxPctFound = -1.0;
                 									}
                 								}
                 							}
                 						}
                 						if(tdsTaxId == "")
                 						{
                 							taxPct = 0.0;
                 							try 
                 							{
                 								if(taxEntry.get("tax_percentage") != null)
                 								{
                 									taxPct = taxEntry.get("tax_percentage").toString().toDecimal();
                 								}
                 							}							catch (pctEx)
                 							{
                 								taxPct = -1.0;
                 							}
                 							// Name checked as well as percentage: a plain 2% GST would otherwise
                 							// match a 2% TDS rate and post the withholding against the wrong head.
                 							taxNameText = "";
                 							if(taxEntry.get("tax_name") != null)
                 							{
                 								taxNameText = taxEntry.get("tax_name").toString().toUpperCase();
                 							}
                 							taxTypeText = "";
                 							if(taxEntry.get("tax_type") != null)
                 							{
                 								taxTypeText = taxEntry.get("tax_type").toString().toUpperCase();
                 							}
                 							looksLikeTds = false;
                 							if(taxNameText.contains("TDS"))
                 							{
                 								looksLikeTds = true;
                 							}
                 							if(taxTypeText.contains("TDS"))
                 							{
                 								looksLikeTds = true;
                 							}
                 							if(looksLikeTds)
                 							{
                 								if(taxPct == tdsPercentAmt)
                 								{
                 									tdsTaxId = taxEntry.get("tax_id").toString();
                 									info "recordVendorPayment - matched TDS tax [" + taxNameText + "] at " + taxPct + "% -> tax_id " + tdsTaxId;
                 								}
                 							}
                 						}
                 					}
                 				}
                 			}			catch (taxEx)
                 			{
                 				info "recordVendorPayment - could not read the configured taxes from Books: " + taxEx.toString();
                 			}
                 			if(tdsTaxId == "")
                 			{
                 				info "recordVendorPayment PRE-FLIGHT REJECT - no TDS tax on the vendor record and none configured matching " + tdsPercentAmt + "%. Nothing was written.";
                 				errMap.put("message","This vendor has TDS of " + tdsPercentAmt + "% in Creator, and Zoho Books requires the withholding to be declared on the Bill using a configured TDS tax - but no TDS tax could be found for them, so NOTHING was written: no Bill, no Credit, no Payment. Fix it in Zoho Books: open Purchases -> Vendors -> this vendor -> Edit, and set the TDS field (e.g. Technical Fees (2%)) to the rate that matches. To pay this vendor without any withholding instead, set TDS_Percentage to 0 on their Creator record.");
                 				return errMap.toString();
                 			}
                 			// The two rates disagree, and that is worth stopping for: the Bill would
                 			// withhold one figure while the payment deducted another, leaving the
                 			// vendor over- or under-paid against their own TDS certificate.
                 			// Only reached when the rate was actually readable - an unverifiable tax
                 			// leaves tdsTaxPctFound at -1 and proceeds, since the accountant's own
                 			// per-vendor setting in Books is the more authoritative of the two.
                 			if(tdsTaxPctFound >= 0.0)
                 			{
                 				if(tdsTaxPctFound != tdsPercentAmt)
                 				{
                 					info "recordVendorPayment PRE-FLIGHT REJECT - TDS rate mismatch: Creator says " + tdsPercentAmt + "%, the Books tax " + tdsTaxId + " is " + tdsTaxPctFound + "%. Nothing was written.";
                 					errMap.put("message","TDS rate mismatch, so NOTHING was written - no Bill, no Credit, no Payment. This vendor's TDS_Percentage in Creator is " + tdsPercentAmt + "%, but the TDS tax set on their Zoho Books record is " + tdsTaxPctFound + "%. The Bill would withhold one figure while the payment deducted the other. Make the two match - either change TDS_Percentage on the Creator vendor record, or change the TDS field on the vendor in Zoho Books - then retry.");
                 					return errMap.toString();
                 				}
                 			}
                 		}
                 		// Bills need an explicit bill_number - unlike Invoices, Zoho Books
                 		// has no auto-generate toggle for Bills, since a Bill is meant to
                 		// carry the VENDOR's own invoice number. There isn't one here (this
                 		// is an internal payout, not the vendor's own paper invoice), so a
                 		// value is built from the UTR (the real bank reference the user
                 		// enters) plus the first case label, for a readable, traceable id.
                 		billNumber = "VP-" + caseLabelsList.get(0);
                 		if(utrNo != null)
                 		{
                 			if(utrNo != "")
                 			{
                 				billNumber = billNumber + "-" + utrNo;
                 			}
                 		}
                 		billMap = Map();
                 		billMap.put("vendor_id",vendor_id);
                 		billMap.put("bill_number",billNumber);
                 		billMap.put("line_items",lineItems);
                 		// TDS declared HERE rather than on the payment — the whole point of this
                 		// change. tdsTaxId is only ever non-blank when the pre-flight above resolved
                 		// a real configured tax at this vendor's own rate.
                 		if(tdsTaxId != "")
                 		{
                 			billMap.put("is_tds_applied",true);
                 			billMap.put("tds_tax_id",tdsTaxId);
                 		}
                 		billDate = paymentDate;
                 		if(billDate == null)
                 		{
                 			billDate = "";
                 		}
                 		if(billDate != "")
                 		{
                 			billMap.put("date",billDate);
                 		}
                 		jsonPayload = billMap.toString();
                 		info "Bill jsonPayload sent to Zoho Books: " + jsonPayload;
                 		createBillResp = invokeurl
                 		[
                 			url :books_base_url + "/bills?organization_id=" + organization_id
                 			type :POST
                 			parameters:jsonPayload
                 			headers:{"Content-Type":"application/json"}
                 			connection:"zoho_books_connection"
                 		];
                 		billRespCode = createBillResp.get("code");
                 		// LEFTOVER BILL FROM AN EARLIER ATTEMPT - 2026-10-27, client-reported. The bill
                 		// number is built from the first case and the UTR, so a retry of the same
                 		// payment asks for the SAME number - and if an earlier attempt left its bill in
                 		// Books (its rollback could not delete it, or an earlier test created it), Books
                 		// refuses with "A bill with this number has already been created for this
                 		// vendor". Instead of stopping there, the existing bill is looked up:
                 		//   - it has a payment (or reads paid / partially paid): this case was already
                 		//     paid - stop, record nothing again, and say so plainly;
                 		//   - it is unpaid with no payments: it is a leftover - delete it (the same
                 		//     DELETE the rollbacks below already use) and create the bill again ONCE with
                 		//     today's figures. Recreated rather than reused so the amounts are always
                 		//     the ones being paid now, never what the failed attempt had;
                 		//   - void, not found, or the lookup fails: stop with a message naming the bill.
                 		// Every other bill-creation error is untouched and reported exactly as before.
                 		if(billRespCode != 0)
                 		{
                 			dupErrText = ifnull(createBillResp.get("message"),"").toString();
                 			dupErrLower = dupErrText.toLowerCase();
                 			if(dupErrLower.contains("already been created"))
                 			{
                 				info "recordVendorPayment - bill number " + billNumber + " already exists for vendor " + vendor_id + "; looking it up before deciding.";
                 				existingBillId = "";
                 				existingStatus = "";
                 				existingPaymentCount = 0;
                 				lookupOk = "no";
                 				try 
                 				{
                 					dupSearchResp = invokeurl
                 					[
                 						url :books_base_url + "/bills?organization_id=" + organization_id + "&vendor_id=" + vendor_id + "&bill_number=" + billNumber.replaceAll(" ","%20")
                 						type :GET
                 						connection:"zoho_books_connection"
                 					];
                 					info "recordVendorPayment - existing-bill search, raw response: " + dupSearchResp.toString();
                 					dupBills = List();
                 					if(dupSearchResp.get("bills") != null)
                 					{
                 						dupBills = dupSearchResp.get("bills").toList();
                 					}
                 					for each  dupBill in dupBills
                 					{
                 						if(existingBillId == "")
                 						{
                 							dupNum = ifnull(dupBill.get("bill_number"),"").toString();
                 							if(dupNum.equalsIgnoreCase(billNumber))
                 							{
                 								existingBillId = ifnull(dupBill.get("bill_id"),"").toString();
                 								existingStatus = ifnull(dupBill.get("status"),"").toString();
                 							}
                 						}
                 					}
                 					if(existingBillId != "")
                 					{
                 						dupDetailResp = invokeurl
                 						[
                 							url :books_base_url + "/bills/" + existingBillId + "?organization_id=" + organization_id
                 							type :GET
                 							connection:"zoho_books_connection"
                 						];
                 						dupDetail = dupDetailResp.get("bill");
                 						if(dupDetail != null)
                 						{
                 							if(dupDetail.get("status") != null)
                 							{
                 								existingStatus = dupDetail.get("status").toString();
                 							}
                 							if(dupDetail.get("payments") != null)
                 							{
                 								dupPayments = dupDetail.get("payments").toList();
                 								existingPaymentCount = dupPayments.size();
                 							}
                 							lookupOk = "yes";
                 						}
                 					}
                 				}				catch (dupEx)
                 				{
                 					info "recordVendorPayment - could not look up the existing bill " + billNumber + ": " + dupEx.toString();
                 				}
                 				statusLower = existingStatus.toLowerCase();
                 				info "recordVendorPayment - existing bill " + billNumber + ": id=" + existingBillId + " status=" + existingStatus + " payments=" + existingPaymentCount + " detailRead=" + lookupOk;
                 				if(existingBillId == "")
                 				{
                 					errMap.put("message","A bill numbered " + billNumber + " already exists for this vendor in Zoho Books, but it could not be looked up automatically, so nothing was recorded. Open Zoho Books -> Purchases -> Bills and search " + billNumber + ": if it is unpaid, delete it and retry; if it is paid, this case has already been paid.");
                 					return errMap.toString();
                 				}
                 				alreadyPaid = false;
                 				if(existingPaymentCount > 0)
                 				{
                 					alreadyPaid = true;
                 				}
                 				if(statusLower == "paid")
                 				{
                 					alreadyPaid = true;
                 				}
                 				if(statusLower == "partially_paid")
                 				{
                 					alreadyPaid = true;
                 				}
                 				if(alreadyPaid)
                 				{
                 					errMap.put("already_paid","yes");
                 					errMap.put("bill_id",existingBillId);
                 					errMap.put("message","This case was already paid in Zoho Books (bill " + billNumber + ", status " + existingStatus + "). Nothing was recorded again. If this screen still shows it as unpaid, the earlier payment reached Books but not the case - correct the case in Creator rather than paying it twice.");
                 					return errMap.toString();
                 				}
                 				// A void bill, or a detail read that failed: not safe to delete on a guess.
                 				if(statusLower == "void")
                 				{
                 					errMap.put("message","A VOID bill numbered " + billNumber + " already exists for this vendor in Zoho Books, and Books will not reuse its number, so nothing was recorded. Delete that void bill in Zoho Books (Purchases -> Bills), then retry.");
                 					return errMap.toString();
                 				}
                 				if(lookupOk != "yes")
                 				{
                 					errMap.put("message","A bill numbered " + billNumber + " already exists for this vendor in Zoho Books, and whether it has been paid could not be confirmed, so nothing was recorded. Check it in Zoho Books -> Purchases -> Bills: if it is unpaid, delete it and retry; if it is paid, this case has already been paid.");
                 					return errMap.toString();
                 				}
                 				// Unpaid, no payments: a leftover from a failed attempt. Remove it, then
                 				// create the bill once more with the figures being paid now.
                 				leftoverDeleted = "no";
                 				try 
                 				{
                 					leftoverDelResp = invokeurl
                 					[
                 						url :books_base_url + "/bills/" + existingBillId + "?organization_id=" + organization_id
                 						type :DELETE
                 						connection:"zoho_books_connection"
                 					];
                 					info "recordVendorPayment - delete of leftover bill " + existingBillId + ", raw response: " + leftoverDelResp.toString();
                 					if(leftoverDelResp.get("code") == 0)
                 					{
                 						leftoverDeleted = "yes";
                 					}
                 				}				catch (leftoverDelEx)
                 				{
                 					info "recordVendorPayment - could not delete leftover bill " + existingBillId + ": " + leftoverDelEx.toString();
                 				}
                 				if(leftoverDeleted != "yes")
                 				{
                 					errMap.put("message","An unpaid bill numbered " + billNumber + " was left in Zoho Books by an earlier attempt, and it could not be removed automatically, so nothing was recorded. Delete it in Zoho Books (Purchases -> Bills), then retry.");
                 					return errMap.toString();
                 				}
                 				info "recordVendorPayment - leftover bill " + billNumber + " removed; creating it again with the current figures.";
                 				createBillResp = invokeurl
                 				[
                 					url :books_base_url + "/bills?organization_id=" + organization_id
                 					type :POST
                 					parameters:jsonPayload
                 					headers:{"Content-Type":"application/json"}
                 					connection:"zoho_books_connection"
                 				];
                 				billRespCode = createBillResp.get("code");
                 			}
                 		}
                 		if(billRespCode != 0)
                 		{
                 			bookErr = createBillResp.get("message");
                 			info "Bill creation FAILED: " + bookErr;
                 			errMap.put("message","Bill creation failed: " + bookErr);
                 			return errMap.toString();
                 		}
                 		billRec = createBillResp.get("bill");
                 		if(billRec == null)
                 		{
                 			errMap.put("message","No bill in response.");
                 			return errMap.toString();
                 		}
                 		bill_id = billRec.get("bill_id");
                 		if(bill_id == null || bill_id == "")
                 		{
                 			errMap.put("message","Bill ID is missing from the response.");
                 			return errMap.toString();
                 		}
                 		// Diagnostic only - 2026-10-24. The TDS Books actually applied to the Bill comes
                 		// from the vendor's TDS tax in Books, and when it differs from Creator's
                 		// TDS_Percentage the payment below is refused as "more than the balance due".
                 		// This line shows Books' own total, TDS and balance for the bill.
                 		info "recordVendorPayment - Bill " + bill_id + " as created by Books: total=" + billRec.get("total") + " tds_amount=" + billRec.get("tds_amount") + " balance=" + billRec.get("balance") + " | Creator expects TDS " + preflightTds + " (" + tdsPercentAmt + "%)";
                 		// Step 3: TDS. Computed here from the vendor TDS percent rather
                 		// than trusted from the caller, so it always matches billTotal
                 		// exactly.
                 		//
                 		// CHANGED 2026-10-05. This used to be applied at payment time via
                 		// tax_amount_withheld, because the Bill's own is_tds_applied/tds_tax_id
                 		// fields need a configured TDS tax id per percentage in Books. Zoho Books
                 		// then refused the payment outright - "You cannot apply the Withholding Tax
                 		// at the payment level. Kindly apply it at the bill level." - so the id is
                 		// now resolved from Books by percentage in the pre-flight section above and
                 		// declared on the Bill. The amount below is still what the payment leaves
                 		// unpaid, so the arithmetic here is unchanged.
                 		tdsAmount = (billTotal * tdsPercentAmt / 100.0).round(2);
                 		// Step 4: Cash Collected. This is money the vendor already
                 		// received directly from the customer, so the company owes them
                 		// less - it is not a tax withholding, so it is handled as a
                 		// Vendor Credit applied to this Bill instead.
                 		// THE BILL CAN ONLY ABSORB WHAT IT STILL OWES - 2026-10-13. Books rejects a
                 		// credit application larger than the bill balance, and with TDS already
                 		// declared on the Bill that balance is billTotal - tdsAmount. Capping here is
                 		// what lets the negative case through: the full Cash Collected is still
                 		// recorded as a Vendor Credit, but only the part the bill can take is applied
                 		// to it, and the remainder stays on the vendor account as what they owe us.
                 		// No-op whenever Final Payable is positive, which is every case working today.
                 		billBalanceForCredit = (billTotal - tdsAmount).round(2);
                 		creditApplyAmt = cashCollectedAmt;
                 		if(creditApplyAmt > billBalanceForCredit)
                 		{
                 			creditApplyAmt = billBalanceForCredit;
                 		}
                 		if(cashCollectedAmt > 0)
                 		{
                 			creditLineItem = Map();
                 			creditLineItem.put("name","Cash collected directly by vendor");
                 			creditLineItem.put("account_id",EXPENSE_ACCOUNT_ID);
                 			creditLineItem.put("rate",cashCollectedAmt.toString());
                 			creditLineItem.put("quantity","1");
                 			creditLineItems = List();
                 			creditLineItems.add(creditLineItem);
                 			creditMap = Map();
                 			creditMap.put("vendor_id",vendor_id);
                 			creditMap.put("line_items",creditLineItems);
                 			// REQUIRED IN THIS ORG - 2026-10-13, live error "Please enter the vendor
                 			// credit number." Auto-numbering is off for vendor credits here, the same
                 			// way it is for Bills (see billNumber above and its own note). Built from
                 			// the same inputs as the bill number so a credit is traceable to the
                 			// settlement that produced it and two settlements cannot collide.
                 			creditNumber = "VC-" + caseLabelsList.get(0);
                 			if(utrNo != null)
                 			{
                 				if(utrNo != "")
                 				{
                 					creditNumber = creditNumber + "-" + utrNo;
                 				}
                 			}
                 			creditMap.put("vendor_credit_number",creditNumber);
                 			// THE CREDIT NAMES ITS BILL - 2026-10-24, live error "Select the associated
                 			// bill number or bill type." Books (India/GST) now refuses a Vendor Credit
                 			// that is not tied to a bill. bill_id is the Bill created just above - the
                 			// same one this credit is applied to below - so nothing else changes.
                 			creditMap.put("bill_id",bill_id);
                 			if(billDate != "")
                 			{
                 				creditMap.put("date",billDate);
                 			}
                 			createCreditResp = invokeurl
                 			[
                 				url :books_base_url + "/vendorcredits?organization_id=" + organization_id
                 				type :POST
                 				parameters:creditMap.toString()
                 				headers:{"Content-Type":"application/json"}
                 				connection:"zoho_books_connection"
                 			];
                 			creditRespCode = createCreditResp.get("code");
                 			if(creditRespCode != 0)
                 			{
                 				bookErr = createCreditResp.get("message");
                 				info "Vendor Credit creation FAILED: " + bookErr;
                 				// ROLL THE BILL BACK - 2026-10-13. Without this a refused credit leaves a
                 				// real unpaid Bill behind and every retry adds another. Same move, same
                 				// reasoning, as the payment failure path further down.
                 				billCleanedCr = "no";
                 				try 
                 				{
                 					deleteBillCrResp = invokeurl
                 					[
                 						url :books_base_url + "/bills/" + bill_id + "?organization_id=" + organization_id
                 						type :DELETE
                 						connection:"zoho_books_connection"
                 					];
                 					info "recordVendorPayment - rollback delete of bill " + bill_id + " after the vendor credit was refused, raw response: " + deleteBillCrResp.toString();
                 					if(deleteBillCrResp.get("code") == 0)
                 					{
                 						billCleanedCr = "yes";
                 					}
                 				}				catch (delCrEx)
                 				{
                 					info "recordVendorPayment - could not roll back bill " + bill_id + " after the vendor credit was refused (it will need removing by hand in Zoho Books): " + delCrEx.toString();
                 				}
                 				if(billCleanedCr == "yes")
                 				{
                 					errMap.put("message","The Cash Collected vendor credit was refused by Zoho Books, so nothing was recorded: " + bookErr + " (the draft bill was removed again, so you can safely retry once this is resolved.)");
                 				}
                 				else
                 				{
                 					errMap.put("message","Bill " + bill_id + " was created, but the Cash Collected vendor credit failed: " + bookErr + " That bill could NOT be removed automatically - delete it in Zoho Books before retrying, or you will end up with duplicates.");
                 				}
                 				return errMap.toString();
                 			}
                 			creditRec = createCreditResp.get("vendorcredit");
                 			vendor_credit_id = "";
                 			if(creditRec != null)
                 			{
                 				vendor_credit_id = creditRec.get("vendor_credit_id");
                 			}
                 			if(vendor_credit_id != "" && creditApplyAmt > 0)
                 			{
                 				applyMap = Map();
                 				applyList = List();
                 				applyEntry = Map();
                 				applyEntry.put("bill_id",bill_id);
                 				applyEntry.put("amount_applied",creditApplyAmt.toString());
                 				// capped - see the note above this block
                 				applyList.add(applyEntry);
                 				applyMap.put("bills",applyList);
                 				applyCreditResp = invokeurl
                 				[
                 					url :books_base_url + "/vendorcredits/" + vendor_credit_id + "/bills?organization_id=" + organization_id
                 					type :POST
                 					parameters:applyMap.toString()
                 					headers:{"Content-Type":"application/json"}
                 					connection:"zoho_books_connection"
                 				];
                 				applyCreditCode = applyCreditResp.get("code");
                 				if(applyCreditCode != 0)
                 				{
                 					bookErr = applyCreditResp.get("message");
                 					info "Applying vendor credit to bill FAILED: " + bookErr;
                 					errMap.put("message","Bill " + bill_id + " and Vendor Credit " + vendor_credit_id + " were both created, but applying the credit to the bill failed: " + bookErr);
                 					return errMap.toString();
                 				}
                 			}
                 		}
                 		// Step 5: record the actual bank transfer as a Vendor Payment, for
                 		// the Final Payable amount (Net Fee minus TDS minus Cash
                 		// Collected), declaring the TDS withheld on the same call so the
                 		// Bill closes to zero: amount_applied plus tax_amount_withheld
                 		// plus the vendor credit applied above should sum to billTotal.
                 		finalPayable = (billTotal - tdsAmount - cashCollectedAmt).round(2);
                 		// NOTHING LEFT TO PAY - 2026-10-13. Negative means the vendor owes us, zero
                 		// means TDS and the credit already closed the Bill. Either way there is no
                 		// bank transfer to record, and Books refuses a 0.00 Vendor Payment - which,
                 		// before this, took the whole settlement down and rolled the Bill back.
                 		//
                 		// Everything that matters has already been written at this point: the Bill
                 		// carries the net fee and the TDS, and the Vendor Credit carries the full
                 		// Cash Collected with only the bill-sized part applied to it. The unapplied
                 		// remainder sits on the vendor account as the amount they owe back, and Books
                 		// offsets it against their next bill on its own.
                 		if(finalPayable <= 0)
                 		{
                 			vendorOwesUs = 0.0;
                 			if(finalPayable < 0)
                 			{
                 				vendorOwesUs = (0 - finalPayable).round(2);
                 			}
                 			info "recordVendorPayment - no Vendor Payment created: finalPayable=" + finalPayable + " vendorOwesUs=" + vendorOwesUs + " on bill " + bill_id + ".";
                 			okMapNeg = Map();
                 			okMapNeg.put("code","SUCCESS");
                 			if(vendorOwesUs > 0)
                 			{
                 				okMapNeg.put("message","Recorded. This vendor collected more cash than their net fee, so there is nothing to pay out - the excess of " + vendorOwesUs + " is held as an unapplied Vendor Credit in Zoho Books and will be set against their next bill.");
                 			}
                 			else
                 			{
                 				okMapNeg.put("message","Recorded. TDS and the cash already collected cover this bill in full, so no bank transfer was needed and no Vendor Payment was created.");
                 			}
                 			okMapNeg.put("bill_id",bill_id);
                 			okMapNeg.put("vendor_payment_id","");
                 			okMapNeg.put("books_vendor_id",vendor_id);
                 			okMapNeg.put("bill_total",billTotal);
                 			okMapNeg.put("tds_amount",tdsAmount);
                 			okMapNeg.put("cash_collected",cashCollectedAmt);
                 			okMapNeg.put("final_payable",finalPayable);
                 			okMapNeg.put("vendor_owes_us",vendorOwesUs);
                 			return okMapNeg.toString();
                 		}
                 		paymentBillEntry = Map();
                 		paymentBillEntry.put("bill_id",bill_id);
                 		paymentBillEntry.put("amount_applied",finalPayable.toString());
                 		// tax_amount_withheld is NOT sent any more when the Bill already carries the
                 		// TDS — Books rejects the whole payment for it, which is the error that
                 		// started this. Kept for the tdsTaxId == "" case, which now only arises when
                 		// TDS is zero, so in practice it no longer fires at all; left in place rather
                 		// than deleted so a future rate of 0% behaves exactly as it always did.
                 		if(tdsAmount > 0)
                 		{
                 			if(tdsTaxId == "")
                 			{
                 				paymentBillEntry.put("tax_amount_withheld",tdsAmount.toString());
                 			}
                 		}
                 		paymentBillsList = List();
                 		paymentBillsList.add(paymentBillEntry);
                 		paymentMap = Map();
                 		paymentMap.put("vendor_id",vendor_id);
                 		paymentMap.put("amount",finalPayable.toString());
                 		paymentMap.put("paid_through_account_id",PAID_THROUGH_ACCOUNT_ID);
                 		if(billDate != "")
                 		{
                 			paymentMap.put("date",billDate);
                 		}
                 		if(utrNo != null)
                 		{
                 			if(utrNo != "")
                 			{
                 				paymentMap.put("reference_number",utrNo);
                 			}
                 		}
                 		paymentMap.put("bills",paymentBillsList);
                 		paymentJsonPayload = paymentMap.toString();
                 		info "Vendor Payment jsonPayload sent to Zoho Books: " + paymentJsonPayload;
                 		createPaymentResp = invokeurl
                 		[
                 			url :books_base_url + "/vendorpayments?organization_id=" + organization_id
                 			type :POST
                 			parameters:paymentJsonPayload
                 			headers:{"Content-Type":"application/json"}
                 			connection:"zoho_books_connection"
                 		];
                 		paymentRespCode = createPaymentResp.get("code");
                 		if(paymentRespCode != 0)
                 		{
                 			bookErr = createPaymentResp.get("message");
                 			info "Vendor Payment creation FAILED: " + bookErr;
                 			// CLEAN UP THE BILL WE JUST CREATED — 2026-10-05. Without this, every
                 			// failed attempt leaves a real unpaid Bill behind, and a retry adds
                 			// another. Books permits deleting a bill that has no payment against it,
                 			// which is precisely the state a failed payment leaves us in.
                 			billCleaned = "no";
                 			try 
                 			{
                 				deleteBillResp = invokeurl
                 				[
                 					url :books_base_url + "/bills/" + bill_id + "?organization_id=" + organization_id
                 					type :DELETE
                 					connection:"zoho_books_connection"
                 				];
                 				info "recordVendorPayment - rollback delete of bill " + bill_id + ", raw response: " + deleteBillResp.toString();
                 				if(deleteBillResp.get("code") == 0)
                 				{
                 					billCleaned = "yes";
                 				}
                 			}			catch (delEx)
                 			{
                 				// Deliberately swallowed: the PAYMENT error is the one worth reporting,
                 				// and losing it to a cleanup failure would leave nothing to act on.
                 				info "recordVendorPayment - could not roll back bill " + bill_id + " (it will need removing by hand in Zoho Books): " + delEx.toString();
                 			}
                 			// WHAT "MORE THAN THE BALANCE DUE" MEANS HERE - 2026-10-24. Books works out the
                 			// bill balance with the TDS tax set on the vendor in Books; the payment amount
                 			// uses TDS_Percentage from Creator. When Books withholds more, the balance is
                 			// lower than our payment and Books refuses it. Message text only.
                 			bookErrText = ifnull(bookErr,"").toString();
                 			bookErrLower = bookErrText.toLowerCase();
                 			if(bookErrLower.contains("balance due"))
                 			{
                 				bookErr = bookErrText + " This usually means the vendor's TDS in Zoho Books is not " + tdsPercentAmt + "% (the TDS_Percentage in Creator), so Books withheld a different amount and the bill balance is lower than the Final Payable of " + finalPayable + ". Make the two match - the TDS field on the vendor in Zoho Books (Purchases -> Vendors -> Edit) or TDS_Percentage on the Creator vendor record - then retry.";
                 			}
                 			if(billCleaned == "yes")
                 			{
                 				errMap.put("message","Payment was refused by Zoho Books, so nothing was recorded: " + bookErr + " (the draft bill was removed again, so you can safely retry once this is resolved.)");
                 			}
                 			else
                 			{
                 				errMap.put("message","Bill " + bill_id + " was created, but recording the payment failed: " + bookErr + " That bill could NOT be removed automatically - delete it in Zoho Books before retrying, or you will end up with duplicates.");
                 			}
                 			return errMap.toString();
                 		}
                 		paymentRec = createPaymentResp.get("vendorpayment");
                 		vendor_payment_id = "";
                 		if(paymentRec != null)
                 		{
                 			vendor_payment_id = paymentRec.get("vendor_payment_id");
                 		}
                 		okMap = Map();
                 		okMap.put("code","SUCCESS");
                 		okMap.put("message","Bill and payment recorded successfully");
                 		okMap.put("bill_id",bill_id);
                 		okMap.put("vendor_payment_id",vendor_payment_id);
                 		okMap.put("books_vendor_id",vendor_id);
                 		okMap.put("bill_total",billTotal);
                 		okMap.put("tds_amount",tdsAmount);
                 		okMap.put("cash_collected",cashCollectedAmt);
                 		okMap.put("final_payable",finalPayable);
                 		// Always present so the caller never has to tell "no excess" apart from "this
                 		// build does not report it" - 2026-10-13.
                 		okMap.put("vendor_owes_us",0);
                 		resultOut = okMap.toString();
                 	}	catch (mainEx)
                 	{
                 		info "Exception in main try: " + mainEx.toString();
                 		errMap.put("message","Exception: " + mainEx.toString());
                 		return errMap.toString();
                 	}
                 	return resultOut;
                 }
				 string Scheduler()
                 {
                 	scheduledRecords = Create_Case[Status == "SCHEDULED"];
                 	recordCount = scheduledRecords.count();
                 	thresholdMillis = zoho.currenttime.toLong() + 120 * 60000;
                 	promotedCount = 0;
                 	skippedCount = 0;
                 	skippedInfo = "";
                 	for each  rec in scheduledRecords
                 	{
                 		try 
                 		{
                 			if(rec.Computed_Service_Time == null)
                 			{
                 				skippedCount = skippedCount + 1;
                 				skippedInfo = skippedInfo + " [ID " + rec.ID + ", reason=Computed_Service_Time is null]";
                 			}
                 			else
                 			{
                 				recMillis = rec.Computed_Service_Time.toLong();
                 				if(recMillis <= thresholdMillis)
                 				{
                 					rec.Status="READY FOR ASSIGNMENT";
                 					promotedCount = promotedCount + 1;
                 				}
                 			}
                 		}		catch (ex)
                 		{
                 			skippedCount = skippedCount + 1;
                 			skippedInfo = skippedInfo + " [ID " + rec.ID + ", error=" + ex.toString() + "]";
                 		}
                 	}
                 	return "Promoted " + promotedCount + " of " + recordCount + " SCHEDULED ticket(s). Skipped " + skippedCount + "." + skippedInfo;
                 }
				 string SchedulerFun(string status)
                 {
                 	return "";
                 }
				 string searchTickets(string query, string limit)
                 {
                 	try 
                 	{
                 		info "========== TICKET SEARCH ==========";
                 		info "  time  = " + zoho.currenttime;
                 		info "  query = [" + ifnull(query,"(null)") + "]";
                 		info "  limit = [" + ifnull(limit,"(null)") + "]";
                 		term = ifnull(query,"").trim();
                 		if(term.length() < 3)
                 		{
                 			info "  TOO SHORT - refused. A 1-2 character term matches most of the table.";
                 			return "{\"code\": \"ERROR\", \"result\": \"QUERY_TOO_SHORT\", \"count\": 0, \"tickets\": [], \"message\": \"Send at least 3 characters. A shorter term matches most of the table and is never what the caller intended.\"}";
                 		}
                 		maxRows = 20;
                 		wantedLimit = ifnull(limit,"").trim();
                 		if(wantedLimit != "")
                 		{
                 			try 
                 			{
                 				parsedLimit = wantedLimit.toLong();
                 				if(parsedLimit > 0)
                 				{
                 					maxRows = parsedLimit;
                 				}
                 			}			catch (limitEx)
                 			{
                 				maxRows = 20;
                 			}
                 		}
                 		if(maxRows > 100)
                 		{
                 			maxRows = 100;
                 		}
                 		digitsOnly = term.replaceAll("[^0-9]","");
                 		phoneMatch = digitsOnly;
                 		if(phoneMatch.length() > 10)
                 		{
                 			phoneMatch = phoneMatch.subText(phoneMatch.length() - 10);
                 		}
                 		if(phoneMatch.length() < 6)
                 		{
                 			phoneMatch = "__NO_PHONE_MATCH__";
                 		}
                 		info "  term = [" + term + "] | phone tail = [" + phoneMatch + "] | max " + maxRows;
                 		termSafe = term.replaceAll("\"","'");
                 		ticketsJson = "";
                 		foundCount = 0;
                 		// UCID matches the term AS SENT: it is a 17-digit Ozonetel call id, so the
                 		// last-10-digits treatment used for phones would match the wrong thing.
                 		// callerID matches the phone tail instead, because Ozonetel stores it as
                 		// "+917210036790" (or with a leading space) while an agent searching will
                 		// type the bare 10 digits.
                 		for each  caseRec in Create_Case[Case_ID.contains(term) || Vehicle_Registration_Number.contains(term) || Client_Tracking_Id.contains(term) || Customer_Name.contains(term) || UCID.contains(term) || Phone_Number.contains(phoneMatch) || Phone_Number1.contains(phoneMatch) || callerID.contains(phoneMatch)] sort by ID desc
                 		{
                 			if(foundCount < maxRows)
                 			{
                 				recId = caseRec.ID.toString();
                 				caseIdText = ifnull(caseRec.Case_ID,"").toString().trim().replaceAll("\"","'");
                 				nameText = ifnull(caseRec.Customer_Name,"").toString().trim().replaceAll("\"","'");
                 				phoneText = ifnull(caseRec.Phone_Number1,"").toString().trim();
                 				if(phoneText == "")
                 				{
                 					phoneText = ifnull(caseRec.Phone_Number,"").toString().trim();
                 				}
                 				phoneText = phoneText.replaceAll("\"","'");
                 				statusText = ifnull(caseRec.Status,"").toString().trim().replaceAll("\"","'");
                 				serviceText = ifnull(caseRec.Service_Type,"").toString().trim().replaceAll("\"","'");
                 				regText = ifnull(caseRec.Vehicle_Registration_Number,"").toString().trim().replaceAll("\"","'");
                 				trackingText = ifnull(caseRec.Client_Tracking_Id,"").toString().trim().replaceAll("\"","'");
                 				closureText = ifnull(caseRec.Closure_Status,"").toString().trim().replaceAll("\"","'");
                 				addedText = ifnull(caseRec.Added_Time,"").toString().trim().replaceAll("\"","'");
                 				feeText = ifnull(caseRec.Total_Service_Fee,0).toString().trim();
                 				// Returned as well as searched — a caller who finds a ticket by UCID
                 				// needs to see which call it was, and a blank here tells the client the
                 				// ticket was not created from a phone call at all.
                 				ucidText = ifnull(caseRec.UCID,"").toString().trim().replaceAll("\"","'");
                 				callerIdText = ifnull(caseRec.callerID,"").toString().trim().replaceAll("\"","'");
                 				rowJson = "{\"id\": \"" + recId + "\", \"caseId\": \"" + caseIdText + "\", \"customerName\": \"" + nameText + "\", \"phone\": \"" + phoneText + "\", \"status\": \"" + statusText + "\", \"serviceType\": \"" + serviceText + "\", \"vehicleRegistration\": \"" + regText + "\", \"clientTrackingId\": \"" + trackingText + "\", \"callerId\": \"" + callerIdText + "\", \"ucid\": \"" + ucidText + "\", \"closureStatus\": \"" + closureText + "\", \"totalServiceFee\": \"" + feeText + "\", \"createdAt\": \"" + addedText + "\"}";
                 				if(ticketsJson == "")
                 				{
                 					ticketsJson = rowJson;
                 				}
                 				else
                 				{
                 					ticketsJson = ticketsJson + ", " + rowJson;
                 				}
                 				foundCount = foundCount + 1;
                 			}
                 		}
                 		info "  matched " + foundCount + " ticket(s)";
                 		info "===================================";
                 		if(foundCount == 0)
                 		{
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NO_MATCH\", \"query\": \"" + termSafe + "\", \"count\": 0, \"tickets\": [], \"message\": \"No ticket matches this term on case ID, phone number, caller ID, UCID, vehicle registration, client tracking ID or customer name.\"}";
                 		}
                 		return "{\"code\": \"SUCCESS\", \"result\": \"MATCHED\", \"query\": \"" + termSafe + "\", \"count\": " + foundCount + ", \"tickets\": [" + ticketsJson + "], \"message\": \"Matching tickets, newest first. Case ID, UCID, vehicle registration, client tracking ID and customer name match on the term as sent; phone number and caller ID match on the last 10 digits, so +91, spaces and dashes make no difference.\"}";
                 	}	catch (e)
                 	{
                 		info "searchTickets threw: " + e.toString();
                 		return "{\"code\": \"ERROR\", \"result\": \"EXCEPTION\", \"count\": 0, \"tickets\": [], \"message\": \"" + e.toString().replaceAll("\"","'") + "\"}";
                 	}
                 	return "{\"code\": \"ERROR\", \"result\": \"NO_RESULT\", \"count\": 0, \"tickets\": [], \"message\": \"The script finished without reaching any known outcome.\"}";
                 }
				 string sendWhatsAppMessage(string phone, string templateName, string param1, string param2, string param3, string buttonParam)
                 {
                 	headers = Map();
                 	headers.put("Content-Type","application/json");
                 	headers.put("x-api-key","wp_live_UFs9sZS6Ab2ix99uKY1IhzkQ31dJ3bzm14h2Wi");
                 	headers.put("Authorization","Bearer wp_live_UFs9sZS6Ab2ix99uKY1IhzkQ31dJ3bzm14h2Wi");
                 	urlButtonTemplates = List();
                 	urlButtonTemplates.add("confirm_booking_fee_and_total_fee");
                 	urlButtonTemplates.add("balance_payment_link");
                 	urlButtonTemplates.add("confirm_customer_location_details_copy");
                 	urlButtonTemplates.add("tow_confirm_customer_location_details");
                 	templateHasUrlButton = false;
                 	if(templateName != null)
                 	{
                 		if(urlButtonTemplates.contains(templateName.trim()))
                 		{
                 			templateHasUrlButton = true;
                 		}
                 	}
                 	buttonText = "";
                 	if(buttonParam != null)
                 	{
                 		if(buttonParam.trim() != "")
                 		{
                 			buttonText = buttonParam.trim();
                 		}
                 	}
                 	param3IsButton = false;
                 	if(buttonText == "")
                 	{
                 		if(templateHasUrlButton)
                 		{
                 			if(param3 != null)
                 			{
                 				if(param3.trim() != "")
                 				{
                 					buttonText = param3.trim();
                 					param3IsButton = true;
                 				}
                 			}
                 		}
                 	}
                 	info "sendWhatsAppMessage -> template [" + templateName + "] hasUrlButton=" + templateHasUrlButton + " | buttonParam=[" + ifnull(buttonParam,"(null)") + "] | param3=[" + ifnull(param3,"(null)") + "] | resolved buttonText=[" + buttonText + "] | param3UsedAsButton=" + param3IsButton;
                 	if(templateHasUrlButton)
                 	{
                 		if(buttonText == "")
                 		{
                 			info "sendWhatsAppMessage WARNING - template [" + templateName + "] has a URL button with a {{1}} variable but no button value arrived in either buttonParam or param3. The message will be sent, but its button will point at the bare domain. Check that the widget passed a button path.";
                 		}
                 	}
                 	template_map = Map();
                 	template_map.put("name",templateName);
                 	template_map.put("language","en_US");
                 	if(buttonText == "")
                 	{
                 		params_list = List();
                 		if(param1 != null)
                 		{
                 			if(param1.trim() != "")
                 			{
                 				params_list.add(param1);
                 			}
                 		}
                 		if(param2 != null)
                 		{
                 			if(param2.trim() != "")
                 			{
                 				params_list.add(param2);
                 			}
                 		}
                 		if(param3 != null)
                 		{
                 			if(param3.trim() != "")
                 			{
                 				params_list.add(param3);
                 			}
                 		}
                 		if(params_list.size() > 0)
                 		{
                 			template_map.put("parameters",params_list);
                 		}
                 	}
                 	else
                 	{
                 		params_keyed = Map();
                 		bodyIndex = 0;
                 		if(param1 != null)
                 		{
                 			if(param1.trim() != "")
                 			{
                 				bodyIndex = bodyIndex + 1;
                 				params_keyed.put("body_" + bodyIndex,param1);
                 			}
                 		}
                 		if(param2 != null)
                 		{
                 			if(param2.trim() != "")
                 			{
                 				bodyIndex = bodyIndex + 1;
                 				params_keyed.put("body_" + bodyIndex,param2);
                 			}
                 		}
                 		if(param3IsButton == false)
                 		{
                 			if(param3 != null)
                 			{
                 				if(param3.trim() != "")
                 				{
                 					bodyIndex = bodyIndex + 1;
                 					params_keyed.put("body_" + bodyIndex,param3);
                 				}
                 			}
                 		}
                 		params_keyed.put("button_0_1",buttonText);
                 		template_map.put("parameters",params_keyed);
                 	}
                 	body_map = Map();
                 	body_map.put("type","template");
                 	body_map.put("to",phone);
                 	body_map.put("template",template_map);
                 	jsonBody = body_map.toString();
                 	info "sendWhatsAppMessage -> body: " + jsonBody;
                 	response = invokeurl
                 	[
                 		url :"https://api.whatsportal.io/v1/messages"
                 		type :POST
                 		parameters:jsonBody
                 		headers:headers
                 	];
                 	info "sendWhatsAppMessage <- response: " + response.toString();
                 	return response.toString();
                 }
				 string submitCustomerFeedback(string recordId, string score, string feedbackText)
                 {
                 	try 
                 	{
                 		result = Map();
                 		// ================= CREATOR DATA API (OAuth) =================
                 		// 2026-09-16 - converted from a direct Deluge write to an authenticated
                 		// PATCH, for exactly the same reason as submitCustomerLocation.deluge.
                 		//
                 		// This function is invoked the same way, from the same public Customer
                 		// Page, and had the identical shape: fetch Create_Case, then assign to
                 		// rec.Field. submitCustomerLocation's own logging PROVED that in that
                 		// context the record is READABLE but NOT WRITABLE - the user a public
                 		// invocation runs as has View but not Edit on Create_Case - so the write
                 		// fails with the misleading "'rec' has no matching records". Nothing
                 		// about the Deluge write can fix that; it is a permission.
                 		//
                 		// The comment this file used to carry here blamed re-fetching the record
                 		// twice, and a run of fixes were made on that theory. It was wrong: the
                 		// single-fetch version failed identically once tested over the public
                 		// URL. Recording that plainly so the same dead end is not re-explored.
                 		//
                 		// An OAuth token carries its OWN authorization instead of inheriting the
                 		// caller's, which is why this works - the same principle that lets
                 		// onDemandInvoicing/recordVendorPayment write to Zoho Books from a public
                 		// context via a connection.
                 		//
                 		// Credentials user-provided 2026-09-16, scope ZohoCreator.report.ALL.
                 		// Authorization header is "Bearer", matching the request the user
                 		// confirmed working in Postman (NOT "Zoho-oauthtoken").
                 		ZC_CLIENT_ID = "1000.7BYOUWK2Q2XMJQWU62E6WHCRZOY9VW";
                 		ZC_CLIENT_SECRET = "a714fc6ab6c76d058196ceef8b49cad735422987fd";
                 		ZC_REFRESH_TOKEN = "1000.568bbdff83b5b398edb888ff31951dea.a5cbb7bbdd283c79ec801ebd10be426a";
                 		ZC_RECORD_URL_BASE = "https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/report/Agent_Ticket_Report/";
                 		info "========== submitCustomerFeedback CALLED ==========";
                 		info "  recordId     = [" + ifnull(recordId,"(null)") + "]";
                 		info "  score        = [" + ifnull(score,"(null)") + "]";
                 		info "  feedbackText = [" + ifnull(feedbackText,"(null)") + "]";
                 		// .trim() before .toLong(), and resolved into its own variable first -
                 		// same defensive pattern as submitCustomerLocation. A stray trailing
                 		// space in recordId has crashed .toLong() outright in this project before.
                 		targetRecordId = recordId.trim().toLong();
                 		info "  targetRecordId = " + targetRecordId;
                 		rec = Create_Case[ID == targetRecordId];
                 		// The if/else-if/else shape below is deliberate and must be preserved:
                 		// a real "Missing return statement: Provide STRING expression to return"
                 		// error was hit live 2026-09-07 writing this as a sequence of independent
                 		// early-return guards. Zoho's static return-path checker does not prove
                 		// every path returns in that form.
                 		if(rec == null)
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","Ticket not found");
                 			return result.toString();
                 		}
                 		else if(score == null || score == "")
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","Score is required");
                 			return result.toString();
                 		}
                 		else
                 		{
                 			// STEP 1 - refresh token to access token. Only grant_type plus the
                 			// three credentials: scope and redirect_uri matter on the original
                 			// authorization_code exchange, not on a refresh grant.
                 			tokenResp = invokeurl
                 			[
                 				url :"https://accounts.zoho.in/oauth/v2/token?refresh_token=" + ZC_REFRESH_TOKEN + "&client_id=" + ZC_CLIENT_ID + "&client_secret=" + ZC_CLIENT_SECRET + "&grant_type=refresh_token"
                 				type :POST
                 			];
                 			zcAccessToken = tokenResp.get("access_token");
                 			if(zcAccessToken == null)
                 			{
                 				info "  TOKEN FAILED - no access_token came back. Raw response: " + tokenResp.toString();
                 				result.put("code","ERROR");
                 				result.put("message","Could not authorise with Zoho Creator (no access token). Nothing was written - see this Custom API's execution log.");
                 				return result.toString();
                 			}
                 			info "  TOKEN OK - access token obtained";
                 			// STEP 2 - PATCH both fields in ONE call. Unlike the location
                 			// function's timestamp, these are both plain text/number fields with
                 			// no format risk, so there is nothing to gain from splitting them.
                 			fbMap = Map();
                 			fbMap.put("Cx_Feedback_Score",score);
                 			if(feedbackText != null)
                 			{
                 				fbMap.put("Cx_Feedback_Text",feedbackText);
                 			}
                 			fbBody = Map();
                 			fbBody.put("data",fbMap);
                 			info "  ABOUT TO WRITE: " + fbBody.toString() + " on record " + targetRecordId;
                 			patchResp = invokeurl
                 			[
                 				url :ZC_RECORD_URL_BASE + targetRecordId
                 				type :PATCH
                 				parameters:fbBody.toString()
                 				headers:{"Content-Type":"application/json","Authorization":"Bearer " + zcAccessToken}
                 			];
                 			info "  PATCH response: " + patchResp.toString();
                 			patchCode = patchResp.get("code");
                 			if(patchCode != 3000)
                 			{
                 				patchMsg = patchResp.get("message");
                 				info "  PATCH FAILED - code " + patchCode + " message " + patchMsg;
                 				result.put("code","ERROR");
                 				result.put("message","Could not save your feedback - Zoho Creator API said: " + patchMsg);
                 				return result.toString();
                 			}
                 			info "  WRITE OK - feedback saved on record " + targetRecordId;
                 			result.put("code","SUCCESS");
                 			return result.toString();
                 		}
                 	}	catch (e)
                 	{
                 		errResult = Map();
                 		errResult.put("code","ERROR");
                 		errResult.put("message",e.toString());
                 		return errResult.toString();
                 	}
                 }
				 string submitCustomerLocation(string recordId, string locationType, string lat, string lon)
                 {
                 	returnstr = "";
                 	try 
                 	{
                 		result = Map();
                 		// ================= CREATOR DATA API (OAuth) =================
                 		// 2026-09-16. The direct Deluge write (rec.Latitude = ...) is REPLACED by
                 		// an authenticated PATCH to the Creator Data API, because the direct
                 		// write is impossible to make work here.
                 		//
                 		// PROVEN by this function's own logging, running the identical script
                 		// against the identical record: from the Execute dialog the read probe
                 		// passes AND the write succeeds; over the public URL the read probe
                 		// passes and the write fails with "'rec' has no matching records". Read
                 		// allowed, write refused - i.e. the user a public invocation runs as has
                 		// View but not Edit on Create_Case. No change to the Deluge write itself
                 		// can fix that; it is a permission, not a syntax.
                 		//
                 		// The Data API carries its OWN authorization via this OAuth token rather
                 		// than inheriting the caller's, which is exactly how onDemandInvoicing/
                 		// recordVendorPayment already write to Zoho Books from a public context.
                 		// Same principle, Creator instead of Books.
                 		//
                 		// Credentials user-provided 2026-09-16, scope ZohoCreator.report.ALL.
                 		// client_id/client_secret are the same OAuth app already used for Zoho
                 		// Payments in onDemandInvoicing.deluge; the REFRESH TOKEN is a different
                 		// one, issued for the Creator scope.
                 		ZC_CLIENT_ID = "1000.7BYOUWK2Q2XMJQWU62E6WHCRZOY9VW";
                 		ZC_CLIENT_SECRET = "a714fc6ab6c76d058196ceef8b49cad735422987fd";
                 		ZC_REFRESH_TOKEN = "1000.568bbdff83b5b398edb888ff31951dea.a5cbb7bbdd283c79ec801ebd10be426a";
                 		// Report, not form - the Data API addresses records through a report.
                 		// Agent_Ticket_Report is the same report the whole app already reads and
                 		// updates Create_Case through (see getRescueTicket CONFIG.reportName).
                 		ZC_RECORD_URL_BASE = "https://www.zohoapis.in/creator/v2.1/data/getrescued/get-rescue/report/Agent_Ticket_Report/";
                 		// ENTRY LOG (2026-09-16, user request) - every parameter exactly as it
                 		// arrived, before anything touches it. Values are wrapped in [square
                 		// brackets] on purpose: that is the only way to see leading/trailing
                 		// whitespace, an empty string, or a stray punctuation character at a
                 		// glance - all three have already caused real bugs in this one function
                 		// (a trailing space that crashed .toLong(), and a trailing "." on
                 		// locationType). "(null)" means the parameter was not bound at all,
                 		// which for a Custom API usually means it is not registered in the
                 		// API's own setup screen.
                 		info "========== submitCustomerLocation CALLED ==========";
                 		info "  recordId     = [" + ifnull(recordId,"(null)") + "]";
                 		info "  locationType = [" + ifnull(locationType,"(null)") + "]";
                 		info "  lat          = [" + ifnull(lat,"(null)") + "]";
                 		info "  lon          = [" + ifnull(lon,"(null)") + "]";
                 		// .trim() added 2026-09-10 - same real, confirmed-live bug already
                 		// found and fixed in generateZohoPaymentLink.deluge the same day
                 		// (a stray trailing space in recordId crashed .toLong() outright
                 		// there); added here defensively too, zero risk either way.
                 		// 2026-09-16 - the record ID is now resolved into its OWN variable before
                 		// the criteria, instead of calling .trim().toLong() inline inside it.
                 		//
                 		// This mirrors paymentWebhook.deluge exactly, which is the ONE script in
                 		// this project CONFIRMED to write to Create_Case over a public URL (it
                 		// marks Booking Fee payments PAID, user-verified live). It resolves its
                 		// id first - resolvedRecordId = ...toLong(); then Create_Case[ID ==
                 		// resolvedRecordId] - and succeeds. This function did the conversion
                 		// inline in the criteria and has failed over a public URL every time,
                 		// with both a single fetch and a double fetch, so the fetch count is
                 		// ruled out and the inline expression is what is actually left.
                 		//
                 		// generateZohoPaymentLink.deluge uses the inline form and works, but it
                 		// is invoked through invokeCustomApi as a logged-in agent, not over a
                 		// public URL - a different execution context entirely, which is why it
                 		// is the weaker model to copy here and paymentWebhook is the better one.
                 		targetRecordId = recordId.trim().toLong();
                 		info "  targetRecordId (after trim + toLong) = " + targetRecordId;
                 		rec = Create_Case[ID == targetRecordId];
                 		// READABILITY PROBE (2026-09-14) - the key insight into why this call
                 		// has worked from the Execute dialog for days while failing over the
                 		// public URL with "'recForWrite' has no matching records".
                 		//
                 		// `rec == null` below is NOT a reliable existence test. When a Deluge
                 		// record query matches nothing - including when it matches nothing
                 		// because the EXECUTING USER cannot see the record - it does not
                 		// necessarily come back as null. The null check therefore passes, the
                 		// function runs all the way down to the write, and only THERE does it
                 		// fail, with a "has no matching records" error that names the write
                 		// variable and so looks like a problem with the write. It never was:
                 		// the fetch found nothing in the first place.
                 		//
                 		// That fits every symptom exactly. The Execute dialog runs as the
                 		// developer, who can see every record, so it succeeds. The public URL
                 		// runs as whatever user this Custom API is configured to execute as; if
                 		// that user has no permission on Create_Case, the query returns nothing
                 		// and the write blows up 130 lines later with a misleading message.
                 		//
                 		// This probe reads one harmless field immediately after the fetch, in
                 		// its own try/catch. If that throws, the record is not readable HERE and
                 		// now, and the caller gets told precisely that instead of a cryptic
                 		// failure at write time. It changes no behaviour for a working call.
                 		recReadable = true;
                 		try 
                 		{
                 			probeText = ifnull(rec.Case_ID,"").toString();
                 			info "  READ PROBE OK - rec.Case_ID = [" + probeText + "] (the record IS readable in this execution context)";
                 		}		catch (probeEx)
                 		{
                 			recReadable = false;
                 			info "submitCustomerLocation - record " + recordId + " matched no readable row. This is almost always a PERMISSION issue, not a data one: compare this Custom API's own 'Execute the script as' setting against paymentWebhook's, which does succeed over a public URL. Raw error: " + probeEx.toString();
                 		}
                 		if(rec == null)
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","Ticket not found");
                 			returnstr = result.toString();
                 		}
                 		else if(recReadable == false)
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","Ticket " + recordId + " could not be read by this Custom API. The ticket most likely exists - check this Custom API's 'Execute the script as' user and its permission on the Create_Case form. Nothing was written.");
                 			returnstr = result.toString();
                 		}
                 		else if(lat == null || lat == "" || lon == null || lon == "")
                 		{
                 			result.put("code","ERROR");
                 			result.put("message","Latitude/Longitude missing");
                 			returnstr = result.toString();
                 		}
                 		else
                 		{
                 			// Validate + normalize (2026-09-10, explicit user request:
                 			// "Validate the coordinates and handle both map-selected and
                 			// manually entered latitude/longitude values correctly") - lat/lon
                 			// arrive as raw strings from either the customer's map pin (its own
                 			// floating-point pan/zoom math) or a device GPS fix, both of which
                 			// can carry 15-17+ decimal digits. .toDecimal()/.round(6) (both
                 			// confirmed working Deluge syntax already used the same way
                 			// elsewhere in this project - see recordVendorPayment.deluge's own
                 			// ".toDecimal()"/".round(2)") caps that at ~11cm of real-world
                 			// precision, well under the real (unconfirmed exact value) "Decimal
                 			// field exceeded maximum digits" limit getRescueTicket's own
                 			// roundCoord()/saveWithCoordFallback() were built to work around on
                 			// these SAME Latitude/Longitude/DropLocationLat/DropLocationLong
                 			// fields - this call had no protection against that error at all
                 			// before now. Range-checked against real GPS bounds so a malformed
                 			// value (or a future caller hitting this Custom API directly)
                 			// never silently writes garbage into the ticket.
                 			latVal = lat.toDecimal().round(6);
                 			lonVal = lon.toDecimal().round(6);
                 			// locationType normalization (2026-09-10, widened after a live
                 			// "Unknown locationType: breakdown." failure - a stray trailing
                 			// period arrived from wherever this particular link/navigation was
                 			// generated, outside this repo's own confirmed-clean URL-building
                 			// code - see getRescueTicket/app/widget.html's buildCustomerPageUrl(),
                 			// checked and confirmed to build a plain "breakdown"/"drop" with no
                 			// punctuation). Rather than keep chasing one hardcoded punctuation
                 			// variant at a time (the previous fix only handled an exact
                 			// trailing "."), this matches by SUBSTRING on a trimmed, lowercased
                 			// value instead - covers "breakdown", "breakdown.", "Breakdown ",
                 			// "BREAKDOWN..", stray whitespace, etc. for BOTH Breakdown and Drop
                 			// symmetrically, not just the one case actually seen live so far.
                 			// .trim()/.toLowerCase()/.contains() are all already confirmed
                 			// working elsewhere in this project (see createServiceRequest.deluge's
                 			// own "issueTypeText.toLowerCase().contains("tow")") - no new/
                 			// unverified Deluge syntax introduced (the previous fix's brace-less
                 			// "if(...) x = y;" lines were a real, confirmed-live "Improper
                 			// Statement" error; every branch below is fully braced). Only
                 			// "breakdown"/"drop" are ever real values here, so a substring match
                 			// can't collide with anything else.
                 			locTypeNorm = ifnull(locationType,"").trim().toLowerCase();
                 			isDrop = locTypeNorm.contains("drop");
                 			isBreakdown = locTypeNorm.contains("breakdown");
                 			if(latVal < -90 || latVal > 90 || lonVal < -180 || lonVal > 180)
                 			{
                 				result.put("code","ERROR");
                 				result.put("message","Invalid coordinates");
                 				returnstr = result.toString();
                 			}
                 			else if(isDrop || isBreakdown)
                 			{
                 				// Real root cause CONFIRMED 2026-09-10 via a Zoho Studio
                 				// screenshot: Latitude/Longitude/DropLocationLat/DropLocationLong
                 				// were Decimal fields with Max Digits=16, Decimal Points=15.
                 				// Zoho's Decimal type works like SQL DECIMAL(precision,scale) -
                 				// the WHOLE-NUMBER part can only ever hold (Max Digits - Decimal
                 				// Points) digits. Every real-world latitude/longitude has a
                 				// 2-3 digit whole-number part (e.g. "28" in 28.613977, "77" in
                 				// 77.209023), so at Max Digits=16/Decimal Points=15 every
                 				// possible coordinate was mathematically too large for the
                 				// field's configuration at the time - no rounding or retry
                 				// could ever have worked around it.
                 				//
                 				// RESOLVED 2026-09-11 (user-confirmed): rather than keep
                 				// widening the Decimal config, all 4 of these fields (plus
                 				// RSP_Start_Latitude/Longitude, RSP_Drop_Latitude/Longitude,
                 				// and Cancel_Location_Lat/Lon elsewhere in this app) were
                 				// converted to Single Line Text instead - no digit limit at
                 				// all, so this entire error class can no longer fire on any
                 				// coordinate field in this app. The write below (a Deluge
                 				// string assigned to rec.Latitude/etc.) needed no code change
                 				// for this - it already wrote a string either way, which
                 				// Deluge auto-converts on assignment to a Decimal field, and
                 				// which a Text field accepts even more directly.
                 				//
                 				// An earlier version of this function retried the write at
                 				// 6/4/2/0 decimal places, hoping fewer decimals would fit -
                 				// that hypothesis was DISPROVEN by the Decimal-precision math
                 				// above: reducing decimal places never changes the whole-
                 				// number part, so all 4 of those attempts were guaranteed to
                 				// fail identically, every time. Removed as dead code even
                 				// before the Text conversion made it doubly unnecessary. The
                 				// returned error message (visible only in this Custom API's
                 				// own execution log and the browser console -
                 				// customerPage/app/widget.html's submitLocation() never shows
                 				// this raw message to the customer, only a generic "please try
                 				// again" - see its own renderError() call) now just surfaces
                 				// whatever Zoho actually says, since the old digit-limit cause
                 				// no longer applies.
                 				try 
                 				{
                 					latToWrite = latVal.toString();
                 					lonToWrite = lonVal.toString();
                 					// PRE-WRITE LOG - the exact values and the exact fields about
                 					// to be written. If the next thing in the log is the write
                 					// failure, this line is the last known-good state and says
                 					// precisely what was attempted.
                 					if(isDrop)
                 					{
                 						info "  ABOUT TO WRITE (drop): DropLocationLat=[" + latToWrite + "] DropLocationLong=[" + lonToWrite + "] on record " + targetRecordId;
                 					}
                 					else
                 					{
                 						info "  ABOUT TO WRITE (breakdown): Latitude=[" + latToWrite + "] Longitude=[" + lonToWrite + "] on record " + targetRecordId;
                 					}
                 					// 2026-09-13 - REVERTED the previous attempt here (a bulk
                 					// `update Create_Case set ... where ...;` statement),
                 					// confirmed live in Zoho's own script editor to be an
                 					// "Improper Statement" - that exact syntax is not valid in
                 					// this account/version, so it's ruled out cleanly, with no
                 					// live/customer-facing impact (it never got past Save).
                 					// Back to the dot-notation write, independently proven
                 					// working elsewhere in this project against this same
                 					// Create_Case form (generateZohoPaymentLink.deluge's own
                 					// `rec.Zoho_Payment_URL = ...`) - the one thing added this
                 					// time is a FRESH re-fetch of the record immediately before
                 					// the write (recForWrite, right below), using the exact
                 					// same already-proven `Create_Case[ID == ...]` pattern as
                 					// the original fetch at the top of this function - a
                 					// zero-new-syntax hedge against the original runtime error
                 					// ("'rec' has no matching records. Unable to update the
                 					// value rec.Latitude.") being caused by the much-earlier
                 					// `rec` reference having gone stale by the time this
                 					// point in the function runs, rather than the write
                 					// pattern itself. Not confirmed to fix the underlying
                 					// issue - if this exact error recurs even with a fresh
                 					// fetch right here, that rules out staleness and points
                 					// squarely at something Zoho-side (this Custom API's own
                 					// "Execute the script as" permission, compared against
                 					// generateZohoPaymentLink's - check that next, directly in
                 					// Zoho, not in code).
                 					// 2026-09-14 - the `recForWrite` SECOND FETCH that used to sit
                 					// here is REMOVED. It was added 2026-09-13 as a hedge against
                 					// `rec` having gone stale; that hypothesis is now disproven.
                 					// generateZohoPaymentLink.deluge hit this exact error for the
                 					// opposite reason, and its own comment records the finding:
                 					// every write in this project that WORKS fetches the record
                 					// once and writes onto it, and every one that failed this way
                 					// fetched the same record twice. The writes below now go to
                 					// `rec` - fetched at the top, and just proven readable by the
                 					// probe - which is the pattern with a live fix behind it.
                 					// STEP 1 - exchange the refresh token for an access token.
                 					// Only grant_type + the three credentials are sent: scope and
                 					// redirect_uri are meaningful on the ORIGINAL authorization_code
                 					// exchange that issued the refresh token, not on a refresh
                 					// grant. Same call shape onDemandInvoicing.deluge already uses
                 					// successfully for Zoho Payments.
                 					tokenResp = invokeurl
                 					[
                 						url :"https://accounts.zoho.in/oauth/v2/token?refresh_token=" + ZC_REFRESH_TOKEN + "&client_id=" + ZC_CLIENT_ID + "&client_secret=" + ZC_CLIENT_SECRET + "&grant_type=refresh_token"
                 						type :POST
                 					];
                 					zcAccessToken = tokenResp.get("access_token");
                 					if(zcAccessToken == null)
                 					{
                 						info "  TOKEN FAILED - no access_token came back. Raw response: " + tokenResp.toString();
                 						result.put("code","ERROR");
                 						result.put("message","Could not authorise with Zoho Creator (no access token). Nothing was written - see this Custom API's execution log.");
                 						return result.toString();
                 					}
                 					info "  TOKEN OK - access token obtained";
                 					// STEP 2 - PATCH the coordinate fields. The Data API answers
                 					// with code 3000 on success, the same convention the widgets'
                 					// own getRecords calls already check for.
                 					coordMap = Map();
                 					if(isDrop)
                 					{
                 						coordMap.put("DropLocationLat",latToWrite);
                 						coordMap.put("DropLocationLong",lonToWrite);
                 					}
                 					else
                 					{
                 						coordMap.put("Latitude",latToWrite);
                 						coordMap.put("Longitude",lonToWrite);
                 					}
                 					coordBody = Map();
                 					coordBody.put("data",coordMap);
                 					patchResp = invokeurl
                 					[
                 						url :ZC_RECORD_URL_BASE + targetRecordId
                 						type :PATCH
                 						parameters:coordBody.toString()
                 						headers:{"Content-Type":"application/json","Authorization":"Bearer " + zcAccessToken}
                 					];
                 					info "  PATCH response: " + patchResp.toString();
                 					patchCode = patchResp.get("code");
                 					if(patchCode != 3000)
                 					{
                 						patchMsg = patchResp.get("message");
                 						info "  PATCH FAILED - code " + patchCode + " message " + patchMsg;
                 						result.put("code","ERROR");
                 						result.put("message","Could not save this coordinate - Zoho Creator API said: " + patchMsg);
                 						return result.toString();
                 					}
                 					// Drop_Location_Received_Time / Location_Received_Time
                 					// (2026-09-11, part of the wider "capture location+time at
                 					// every relevant step" request) - user has now created
                 					// Drop_Location_Received_Time in Zoho (Location_Received_Time
                 					// already existed, but was previously only ever stamped
                 					// later, whenever the agent next happened to revisit the
                 					// Locations wizard step - see getRescueTicket/app/widget.html's
                 					// own "locations" stage extra(), which still runs too and is
                 					// left completely unchanged as a harmless no-op once this
                 					// field is already set - see that file's own matching
                 					// comment). Stamping it HERE instead means it now reflects
                 					// the ACTUAL moment the customer's coordinate was saved, not
                 					// whenever an agent's screen happened to catch up.
                 					// zoho.currenttime is Deluge's own documented "current date
                 					// + time" system variable (confirmed via Zoho's own Deluge
                 					// System Variables reference) - assigned directly to a
                 					// native Date-Time field, no string formatting. Wrapped in
                 					// its OWN try/catch, separate from the lat/lon write just
                 					// above: this is a genuinely new write in a genuinely new
                 					// context (a Custom API record UPDATE, not the simpler
                 					// form-submit-insert context most public examples show) and
                 					// hasn't been independently confirmed live yet - if the
                 					// exact value/format Deluge produces here turns out not to
                 					// be accepted by a Date-Time field in an update context,
                 					// this must NEVER be allowed to take down the actual
                 					// coordinate save above it, which is this function's one
                 					// truly critical job and was already working correctly
                 					// before this change. Reuses the same recForWrite reference
                 					// as the lat/lon write just above (already confirmed live by
                 					// this point), not a second fresh fetch.
                 					// Sent as its OWN SECOND PATCH, deliberately not bundled with the
                 					// coordinates above. A Date-Time field's accepted format over
                 					// the Data API has never been confirmed in this project; if it
                 					// is wrong, one combined PATCH would be rejected in full and
                 					// take the coordinates down with it. Separate calls mean the
                 					// critical write has already committed before this is even
                 					// attempted - the same "must never block the coordinate save"
                 					// contract this block has always had, now enforced structurally
                 					// rather than just by a try/catch.
                 					try 
                 					{
                 						tsMap = Map();
                 						if(isDrop)
                 						{
                 							tsMap.put("Drop_Location_Received_Time",zoho.currenttime.toString("dd-MMM-yyyy HH:mm:ss"));
                 						}
                 						else
                 						{
                 							tsMap.put("Location_Received_Time",zoho.currenttime.toString("dd-MMM-yyyy HH:mm:ss"));
                 						}
                 						tsBody = Map();
                 						tsBody.put("data",tsMap);
                 						tsResp = invokeurl
                 						[
                 							url :ZC_RECORD_URL_BASE + targetRecordId
                 							type :PATCH
                 							parameters:tsBody.toString()
                 							headers:{"Content-Type":"application/json","Authorization":"Bearer " + zcAccessToken}
                 						];
                 						info "  timestamp PATCH response: " + tsResp.toString();
                 					}					catch (tsEx)
                 					{
                 						info "submitCustomerLocation - timestamp write failed (non-blocking, the coordinate itself was still saved successfully): " + tsEx.toString();
                 					}
                 					info "  WRITE OK - coordinate saved on record " + targetRecordId;
                 					result.put("code","SUCCESS");
                 					returnstr = result.toString();
                 				}				catch (writeEx)
                 				{
                 					info "  WRITE FAILED on record " + targetRecordId + " - Zoho said: " + writeEx.toString();
                 					result.put("code","ERROR");
                 					// Message updated 2026-09-11 (later) - Latitude/Longitude/
                 					// DropLocationLat/DropLocationLong were converted from Decimal
                 					// to Single Line Text this same day (user-confirmed), so the
                 					// digit-limit cause this message used to describe no longer
                 					// applies at all - a stale explanation here would now be
                 					// actively misleading. If this branch fires, it's genuinely a
                 					// different cause; just surface Zoho's own error text and let
                 					// whoever's debugging look at the execution log directly.
                 					result.put("message","Could not save this coordinate - Zoho error: " + writeEx.toString());
                 					returnstr = result.toString();
                 				}
                 			}
                 			else
                 			{
                 				result.put("code","ERROR");
                 				result.put("message","Unknown locationType: " + locationType);
                 				returnstr = result.toString();
                 			}
                 		}
                 	}	catch (e)
                 	{
                 		errResult = Map();
                 		errResult.put("code","ERROR");
                 		errResult.put("message",e.toString());
                 		returnstr = errResult.toString();
                 	}
                 	return returnstr;
                 }
				 string whatsappWebhook(string token, string event, string from, map data, map message, map payload, list entry)
                 {
                 	try 
                 	{
                 		// INBOUND WHATSAPP — created 2026-10-06. The receiving half of the
                 		// WhatsPortal integration. Everything this system has sent so far has been
                 		// one-way: sendWhatsAppMessage posts to api.whatsportal.io/v1/messages and
                 		// nothing ever comes back, which is why the initiate_conversation CONTINUE
                 		// gate (feedback item 12) could not be built and why a customer's replies
                 		// are invisible to us.
                 		//
                 		// This endpoint is the URL WhatsPortal posts to. It does NOT make inbound
                 		// work on its own - WhatsPortal still has to support outbound webhooks and
                 		// be configured to call this. That question is with Chinmay. Building the
                 		// receiver first means the moment they say yes, there is a URL to give them.
                 		//
                 		// WRITTEN AGAINST AN UNKNOWN PAYLOAD, DELIBERATELY TOLERANT.
                 		// paymentWebhook is the cautionary tale: it was written against an assumed
                 		// shape, the wrapper key turned out to be event_object rather than data, and
                 		// because a parameter that is merely named in a Deluge signature binds null,
                 		// it failed silently for weeks with no payment ever reaching a ticket. So
                 		// this reads three shapes rather than betting on one:
                 		//
                 		//   flat      {"event":"...","from":"91...","text":{"body":"..."}}
                 		//   wrapped   {"event":"...","data":{...}}  or  {"payload":{...}}
                 		//   Meta      {"entry":[{"changes":[{"value":{"messages":[{...}]}}]}]}
                 		//
                 		// and logs the whole body regardless, so ONE test delivery from WhatsPortal
                 		// tells us the real shape instead of another round of guessing.
                 		//
                 		// REGISTER EVERY PARAMETER ON THE CUSTOM API SETUP SCREEN with the types in
                 		// the signature above - token/event/from as String, data/message/payload as
                 		// Map, entry as List. A parameter that is only named here binds null.
                 		//
                 		// WRITTEN IN DELIBERATELY PLAIN DELUGE. The first version of this file was
                 		// refused with "Improper Statement" because it used shapes Deluge's parser
                 		// rejects, every one of which reads perfectly well in any other language:
                 		//   - for each over an inline expression    (needs a variable first)
                 		//   - for each index i in 0 to len - 1      (no arithmetic in a range bound)
                 		//   - "0123456789".contains(c)              (no method call on a literal)
                 		//   - ifnull(x,"").toString()               (no chaining off ifnull)
                 		//   - a try nested inside a catch block
                 		// None of those appear below, and none should be reintroduced. Deluge also
                 		// reports the wrong line number for this error, so the fix is always to find
                 		// the bad SHAPE rather than to look where it points.
                 		EXPECTED_TOKEN = "wk7Qm2Ld9Rv4Xs6Tn1Yb8Hc3Jp5Ze0Ag";
                 		//
                 		// AUTO-REPLY IS NOT BUILT, ON PURPOSE. Item 12 wants a CONTINUE tap to
                 		// release messages 2 and 3. That is a real behaviour change on the customer's
                 		// phone, it contradicts this project's standing "agent clicks send" rule, and
                 		// it cannot be tested until a real tap arrives here. So this records the tap
                 		// and reports it; the send hooks in at the CONTINUE_TAPPED branch at the
                 		// bottom once the client has confirmed they want it automatic.
                 		info "=== whatsappWebhook fired ===";
                 		info "  time  = " + zoho.currenttime;
                 		info "  token = [" + ifnull(token,"(null)") + "]";
                 		info "  event = [" + ifnull(event,"(null)") + "]";
                 		info "  from  = [" + ifnull(from,"(null)") + "]";
                 		// Every bound parameter, in full. This single block is the whole point of
                 		// the first deployment: whatever WhatsPortal actually sends lands here.
                 		dataText = "";
                 		if(data != null)
                 		{
                 			dataText = data.toString();
                 		}
                 		messageText = "";
                 		if(message != null)
                 		{
                 			messageText = message.toString();
                 		}
                 		payloadText = "";
                 		if(payload != null)
                 		{
                 			payloadText = payload.toString();
                 		}
                 		entryText = "";
                 		if(entry != null)
                 		{
                 			entryText = entry.toString();
                 		}
                 		info "  data    = [" + dataText + "]";
                 		info "  message = [" + messageText + "]";
                 		info "  payload = [" + payloadText + "]";
                 		info "  entry   = [" + entryText + "]";
                 		if(EXPECTED_TOKEN != "")
                 		{
                 			tokenGiven = ifnull(token,"");
                 			if(tokenGiven != "")
                 			{
                 				if(tokenGiven != EXPECTED_TOKEN)
                 				{
                 					info "whatsappWebhook - TOKEN MISMATCH, nothing was read.";
                 					return "{\"code\": \"SUCCESS\", \"result\": \"TOKEN_MISMATCH\", \"handled\": false, \"message\": \"A token arrived but it does not match. Nothing was processed. Check the token on the end of the webhook URL configured at WhatsPortal.\"}";
                 				}
                 			}
                 		}
                 		// Nothing bound at all means the body never reached this script - almost
                 		// always a parameter missing from the Custom API setup screen rather than
                 		// anything wrong with what WhatsPortal sent.
                 		anythingBound = "no";
                 		if(dataText != "")
                 		{
                 			anythingBound = "yes";
                 		}
                 		if(messageText != "")
                 		{
                 			anythingBound = "yes";
                 		}
                 		if(payloadText != "")
                 		{
                 			anythingBound = "yes";
                 		}
                 		if(entryText != "")
                 		{
                 			anythingBound = "yes";
                 		}
                 		fromGiven = ifnull(from,"");
                 		if(fromGiven != "")
                 		{
                 			anythingBound = "yes";
                 		}
                 		eventGiven = ifnull(event,"");
                 		if(eventGiven != "")
                 		{
                 			anythingBound = "yes";
                 		}
                 		if(anythingBound == "no")
                 		{
                 			info "whatsappWebhook - NOTHING BOUND. The request arrived but no parameter carried a value.";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NOTHING_BOUND\", \"handled\": false, \"message\": \"The request arrived but no parameter carried a value, so the body never reached this script. Register token, event, from, data, message, payload and entry on the Custom API setup screen - data/message/payload as Map and entry as List - then resend. A parameter that is only named in the Deluge signature binds null.\"}";
                 		}
                 		// ---------- resolve the inbound message, whatever shape it came in ----------
                 		// Each unwrap is its own try/catch: a key that holds a string where we
                 		// expected a map throws, and one odd key must not take the whole webhook
                 		// down when another shape would have worked.
                 		msgMap = Map();
                 		statusMap = Map();
                 		haveMsg = "no";
                 		haveStatus = "no";
                 		// Shape 1 - the message object sent directly.
                 		if(messageText != "")
                 		{
                 			msgMap = message;
                 			haveMsg = "yes";
                 		}
                 		// Shape 2 - wrapped in data or payload. Both are checked because providers
                 		// are evenly split on which they use, and paymentWebhook proved that
                 		// guessing the wrapper key wrong costs weeks.
                 		wrapperList = List();
                 		if(dataText != "")
                 		{
                 			wrapperList.add(data);
                 		}
                 		if(payloadText != "")
                 		{
                 			wrapperList.add(payload);
                 		}
                 		for each  wrapper in wrapperList
                 		{
                 			try 
                 			{
                 				// A wrapper holding its own messages[] / statuses[] arrays.
                 				wrapMessages = wrapper.get("messages");
                 				if(wrapMessages != null)
                 				{
                 					for each  wrapMsg in wrapMessages
                 					{
                 						if(haveMsg == "no")
                 						{
                 							msgMap = wrapMsg;
                 							haveMsg = "yes";
                 						}
                 					}
                 				}
                 				wrapStatuses = wrapper.get("statuses");
                 				if(wrapStatuses != null)
                 				{
                 					for each  wrapStatus in wrapStatuses
                 					{
                 						if(haveStatus == "no")
                 						{
                 							statusMap = wrapStatus;
                 							haveStatus = "yes";
                 						}
                 					}
                 				}
                 				// A wrapper that IS the message - it carries a sender itself.
                 				if(haveMsg == "no")
                 				{
                 					wrapFrom = wrapper.get("from");
                 					if(wrapFrom != null)
                 					{
                 						msgMap = wrapper;
                 						haveMsg = "yes";
                 					}
                 				}
                 				// A wrapper holding a single nested message object.
                 				if(haveMsg == "no")
                 				{
                 					wrapInner = wrapper.get("message");
                 					if(wrapInner != null)
                 					{
                 						msgMap = wrapInner;
                 						haveMsg = "yes";
                 					}
                 				}
                 				// A wrapper that is a status on its own.
                 				if(haveStatus == "no")
                 				{
                 					wrapStatusVal = wrapper.get("status");
                 					if(wrapStatusVal != null)
                 					{
                 						statusMap = wrapper;
                 						haveStatus = "yes";
                 					}
                 				}
                 			}			catch (wrapEx)
                 			{
                 				info "whatsappWebhook - could not unwrap one payload wrapper (ignored, another shape may still match): " + wrapEx.toString();
                 			}
                 		}
                 		// Shape 3 - Meta's own nesting, entry[].changes[].value.messages[].
                 		// WhatsPortal sits on top of the WhatsApp Cloud API, so if they simply
                 		// forward what Meta gives them, this is what arrives.
                 		if(entryText != "")
                 		{
                 			try 
                 			{
                 				for each  entryItem in entry
                 				{
                 					entryChanges = entryItem.get("changes");
                 					if(entryChanges != null)
                 					{
                 						for each  entryChange in entryChanges
                 						{
                 							changeValue = entryChange.get("value");
                 							if(changeValue != null)
                 							{
                 								metaMessages = changeValue.get("messages");
                 								if(metaMessages != null)
                 								{
                 									for each  metaMsg in metaMessages
                 									{
                 										if(haveMsg == "no")
                 										{
                 											msgMap = metaMsg;
                 											haveMsg = "yes";
                 										}
                 									}
                 								}
                 								metaStatuses = changeValue.get("statuses");
                 								if(metaStatuses != null)
                 								{
                 									for each  metaStatus in metaStatuses
                 									{
                 										if(haveStatus == "no")
                 										{
                 											statusMap = metaStatus;
                 											haveStatus = "yes";
                 										}
                 									}
                 								}
                 							}
                 						}
                 					}
                 				}
                 			}			catch (entryEx)
                 			{
                 				info "whatsappWebhook - could not walk the Meta-style entry[] structure: " + entryEx.toString();
                 			}
                 		}
                 		info "whatsappWebhook - resolved message object: [" + msgMap.toString() + "]";
                 		info "whatsappWebhook - resolved status object:  [" + statusMap.toString() + "]";
                 		// ---------- delivery and read receipts ----------
                 		// Logged to THIS execution log and nowhere else, on purpose. Every single
                 		// message produces sent/delivered/read callbacks; writing them onto the
                 		// ticket would bury the one line an agent actually cares about - what the
                 		// customer said - under three machine lines per message.
                 		if(haveMsg == "no")
                 		{
                 			if(haveStatus == "yes")
                 			{
                 				statusValue = "(none)";
                 				statusRaw = statusMap.get("status");
                 				if(statusRaw != null)
                 				{
                 					statusValue = statusRaw.toString();
                 				}
                 				statusWamid = "(none)";
                 				statusIdRaw = statusMap.get("id");
                 				if(statusIdRaw != null)
                 				{
                 					statusWamid = statusIdRaw.toString();
                 				}
                 				statusTo = "(none)";
                 				statusToRaw = statusMap.get("recipient_id");
                 				if(statusToRaw != null)
                 				{
                 					statusTo = statusToRaw.toString();
                 				}
                 				info "whatsappWebhook - delivery receipt: status=" + statusValue + " wamid=" + statusWamid + " recipient=" + statusTo;
                 				return "{\"code\": \"SUCCESS\", \"result\": \"STATUS_RECEIPT\", \"handled\": true, \"status\": \"" + statusValue + "\", \"message\": \"A delivery or read receipt was received and logged. Receipts are deliberately not written onto the ticket - they would bury the customer's own replies.\"}";
                 			}
                 			info "whatsappWebhook - nothing recognisable in the payload. The raw body is in the log lines above.";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"UNRECOGNISED_SHAPE\", \"handled\": false, \"message\": \"The request arrived and parameters bound, but no message or status could be read out of it. The full raw body is in this execution log - send that over and the parser can be matched to it exactly.\"}";
                 		}
                 		// ---------- pull the pieces out of the message ----------
                 		senderPhone = fromGiven;
                 		try 
                 		{
                 			msgFrom = msgMap.get("from");
                 			if(msgFrom != null)
                 			{
                 				senderPhone = msgFrom.toString();
                 			}
                 			if(senderPhone == "")
                 			{
                 				msgWaId = msgMap.get("wa_id");
                 				if(msgWaId != null)
                 				{
                 					senderPhone = msgWaId.toString();
                 				}
                 			}
                 		}		catch (senderEx)
                 		{
                 			info "whatsappWebhook - could not read the sender from the message: " + senderEx.toString();
                 		}
                 		wamid = "";
                 		contextWamid = "";
                 		try 
                 		{
                 			msgId = msgMap.get("id");
                 			if(msgId != null)
                 			{
                 				wamid = msgId.toString();
                 			}
                 			// context.id is the wamid of OUR message the customer replied to. Worth
                 			// capturing even unused: it is the only thing that ties a reply to a
                 			// specific outbound message rather than just to a phone number.
                 			msgContext = msgMap.get("context");
                 			if(msgContext != null)
                 			{
                 				ctxId = msgContext.get("id");
                 				if(ctxId != null)
                 				{
                 					contextWamid = ctxId.toString();
                 				}
                 			}
                 		}		catch (idEx)
                 		{
                 			info "whatsappWebhook - could not read message ids: " + idEx.toString();
                 		}
                 		// A quick-reply tap - the CONTINUE button - arrives as "button" on a
                 		// template reply and as "interactive.button_reply" on an interactive
                 		// message. Both are read; which one WhatsPortal forwards is unknown.
                 		buttonText = "";
                 		btnObj = null;
                 		try 
                 		{
                 			btnObj = msgMap.get("button");
                 		}		catch (btnGetEx)
                 		{
                 			btnObj = null;
                 		}
                 		if(btnObj != null)
                 		{
                 			try 
                 			{
                 				btnTextRaw = btnObj.get("text");
                 				if(btnTextRaw != null)
                 				{
                 					buttonText = btnTextRaw.toString();
                 				}
                 				if(buttonText == "")
                 				{
                 					btnPayloadRaw = btnObj.get("payload");
                 					if(btnPayloadRaw != null)
                 					{
                 						buttonText = btnPayloadRaw.toString();
                 					}
                 				}
                 			}			catch (btnMapEx)
                 			{
                 				// A provider sending button as a plain string rather than an object.
                 				buttonText = "";
                 			}
                 			if(buttonText == "")
                 			{
                 				buttonText = btnObj.toString();
                 			}
                 		}
                 		if(buttonText == "")
                 		{
                 			interObj = null;
                 			try 
                 			{
                 				interObj = msgMap.get("interactive");
                 			}			catch (interGetEx)
                 			{
                 				interObj = null;
                 			}
                 			if(interObj != null)
                 			{
                 				try 
                 				{
                 					brObj = interObj.get("button_reply");
                 					if(brObj != null)
                 					{
                 						brTitle = brObj.get("title");
                 						if(brTitle != null)
                 						{
                 							buttonText = brTitle.toString();
                 						}
                 						if(buttonText == "")
                 						{
                 							brId = brObj.get("id");
                 							if(brId != null)
                 							{
                 								buttonText = brId.toString();
                 							}
                 						}
                 					}
                 				}				catch (interMapEx)
                 				{
                 					info "whatsappWebhook - could not read the interactive reply: " + interMapEx.toString();
                 				}
                 			}
                 		}
                 		bodyText = "";
                 		txtObj = null;
                 		try 
                 		{
                 			txtObj = msgMap.get("text");
                 		}		catch (txtGetEx)
                 		{
                 			txtObj = null;
                 		}
                 		if(txtObj != null)
                 		{
                 			try 
                 			{
                 				txtBodyRaw = txtObj.get("body");
                 				if(txtBodyRaw != null)
                 				{
                 					bodyText = txtBodyRaw.toString();
                 				}
                 			}			catch (txtMapEx)
                 			{
                 				// text sent as a plain string instead of {body:...}
                 				bodyText = "";
                 			}
                 			if(bodyText == "")
                 			{
                 				bodyText = txtObj.toString();
                 			}
                 		}
                 		// A shared location pin - 2026-10-10, see this change's own note. Read the
                 		// same guarded way the text body above is read: own try, own catch, no
                 		// nesting, so a payload shape this does not recognise logs and moves on.
                 		locLat = "";
                 		locLon = "";
                 		locObj = null;
                 		try 
                 		{
                 			locObj = msgMap.get("location");
                 		}		catch (locGetEx)
                 		{
                 			locObj = null;
                 		}
                 		if(locObj != null)
                 		{
                 			try 
                 			{
                 				latRaw = locObj.get("latitude");
                 				lonRaw = locObj.get("longitude");
                 				if(latRaw != null)
                 				{
                 					locLat = latRaw.toString().trim();
                 				}
                 				if(lonRaw != null)
                 				{
                 					locLon = lonRaw.toString().trim();
                 				}
                 			}			catch (locMapEx)
                 			{
                 				info "whatsappWebhook - a location message arrived but its latitude/longitude could not be read: " + locMapEx.toString();
                 				locLat = "";
                 				locLon = "";
                 			}
                 		}
                 		// Both halves or neither - a lone latitude is not a position.
                 		if(locLon == "")
                 		{
                 			locLat = "";
                 		}
                 		if(locLat == "")
                 		{
                 			locLon = "";
                 		}
                 		info "whatsappWebhook - sender=[" + senderPhone + "] button=[" + buttonText + "] text=[" + bodyText + "] location=[" + locLat + "," + locLon + "] wamid=[" + wamid + "] replyTo=[" + contextWamid + "]";
                 		if(senderPhone == "")
                 		{
                 			return "{\"code\": \"SUCCESS\", \"result\": \"NO_SENDER\", \"handled\": false, \"message\": \"A message was read out of the payload but it carries no sender number, so there is no way to tell which ticket it belongs to. The raw body is in this execution log.\"}";
                 		}
                 		// ---------- find the ticket ----------
                 		// Matched on the LAST 10 DIGITS. WhatsApp reports a sender as 919876543210
                 		// - country code, no plus - while the agent may have typed +91 98765 43210
                 		// or 9876543210 into the ticket. Comparing the two as written would never
                 		// match. Ten digits is the Indian subscriber number, so it is the longest
                 		// part both forms are guaranteed to share.
                 		//
                 		// Taken as the last ten CHARACTERS rather than by stripping punctuation,
                 		// because the WhatsApp Cloud API always reports a sender as bare digits -
                 		// any prefix sits at the FRONT, which trailing ten characters discards
                 		// anyway. No character loop, no regex, nothing for the parser to refuse.
                 		last10 = senderPhone;
                 		senderLen = senderPhone.length();
                 		if(senderLen > 10)
                 		{
                 			cutFrom = senderLen - 10;
                 			last10 = senderPhone.subString(cutFrom,senderLen);
                 		}
                 		info "whatsappWebhook - matching tickets on the last 10 characters: [" + last10 + "]";
                 		if(last10.length() < 10)
                 		{
                 			return "{\"code\": \"SUCCESS\", \"result\": \"BAD_SENDER_NUMBER\", \"handled\": false, \"sender\": \"" + senderPhone + "\", \"message\": \"The sender number has fewer than 10 digits, so it cannot be matched against a ticket. Nothing was written.\"}";
                 		}
                 		// Newest matching ticket wins. A repeat customer has several, and a reply
                 		// almost always concerns the one currently running.
                 		matchedId = 0;
                 		matchCount = 0;
                 		try 
                 		{
                 			ticketList = Create_Case[Phone_Number1.contains(last10)];
                 			for each  tkt in ticketList
                 			{
                 				matchCount = matchCount + 1;
                 				tktId = tkt.ID;
                 				if(tktId > matchedId)
                 				{
                 					matchedId = tktId;
                 				}
                 			}
                 		}		catch (lookupEx)
                 		{
                 			info "whatsappWebhook - ticket lookup threw: " + lookupEx.toString();
                 		}
                 		info "whatsappWebhook - " + matchCount + " ticket(s) matched that number; newest is " + matchedId;
                 		if(matchedId == 0)
                 		{
                 			return "{\"code\": \"SUCCESS\", \"result\": \"TICKET_NOT_FOUND\", \"handled\": false, \"sender\": \"" + senderPhone + "\", \"message\": \"A WhatsApp reply was received from " + senderPhone + " but no ticket carries that phone number, so there was nothing to write it to. The message itself is in this execution log.\"}";
                 		}
                 		// ---------- write it onto the ticket ----------
                 		isContinue = "no";
                 		if(buttonText != "")
                 		{
                 			buttonUpper = buttonText.toUpperCase();
                 			if(buttonUpper.contains("CONTINUE"))
                 			{
                 				isContinue = "yes";
                 			}
                 		}
                 		lineText = "Sent a message this system cannot display yet (see the webhook log for the raw content)";
                 		if(bodyText != "")
                 		{
                 			lineText = "Replied: " + bodyText;
                 		}
                 		if(buttonText != "")
                 		{
                 			lineText = "Tapped button: " + buttonText;
                 		}
                 		// Most specific wins: a location message carries no body and no button, so
                 		// this only ever replaces the "cannot display" fallback.
                 		if(locLat != "")
                 		{
                 			lineText = "Shared a location pin: " + locLat + ", " + locLon;
                 		}
                 		stampText = zoho.currenttime.toString("dd-MMM-yyyy hh:mm a");
                 		newLine = stampText + " - " + lineText;
                 		wroteOk = "no";
                 		try 
                 		{
                 			// Direct record write rather than the Data API. paymentWebhook keeps both
                 			// and its own logs show the direct write is what actually runs in this
                 			// context, so there is no reason to carry the OAuth refresh dance here.
                 			tktRec = Create_Case[ID == matchedId];
                 			if(tktRec != null)
                 			{
                 				existingLog = ifnull(tktRec.WhatsApp_Inbound_Log,"");
                 				existingText = existingLog.toString();
                 				combined = newLine;
                 				if(existingText != "")
                 				{
                 					// Newest first: an agent opening the ticket sees the latest reply
                 					// without scrolling to the bottom of a long conversation.
                 					combined = newLine + "\n" + existingText;
                 				}
                 				// Capped so a chatty customer cannot grow this past what the field
                 				// holds and start failing the save - the recent end is the useful end.
                 				if(combined.length() > 6000)
                 				{
                 					combined = combined.subString(0,6000);
                 				}
                 				tktRec.WhatsApp_Inbound_Log=combined;
                 				// The pin itself - 2026-10-10. Only into an EMPTY breakdown location:
                 				// an agent may have corrected a pin the customer sent to the wrong
                 				// place, and a TOW drop pin cannot be told apart from a breakdown one.
                 				if(locLat != "")
                 				{
                 					existingLat = ifnull(tktRec.Latitude,"").toString().trim();
                 					if(existingLat == "")
                 					{
                 						tktRec.Latitude=locLat;
                 						tktRec.Longitude=locLon;
                 						info "whatsappWebhook - breakdown location set on ticket " + matchedId + " from the customer's shared pin: " + locLat + ", " + locLon;
                 						existingLocTime = ifnull(tktRec.Location_Received_Time,"").toString().trim();
                 						if(existingLocTime == "")
                 						{
                 							tktRec.Location_Received_Time=zoho.currenttime.toString("dd-MMM-yyyy HH:mm:ss");
                 						}
                 					}
                 					else
                 					{
                 						info "whatsappWebhook - ticket " + matchedId + " already has a breakdown location, so the pin was logged but NOT written. If this is the DROP pin for a tow, an agent needs to place it.";
                 					}
                 				}
                 				wroteOk = "yes";
                 			}
                 		}		catch (writeEx)
                 		{
                 			// Reported, never thrown. A failed write must still return SUCCESS or
                 			// WhatsPortal will retry the same delivery indefinitely.
                 			info "whatsappWebhook - could not write to ticket " + matchedId + " (does WhatsApp_Inbound_Log exist on Create_Case?): " + writeEx.toString();
                 		}
                 		if(isContinue == "yes")
                 		{
                 			// ===== ITEM 12 HOOKS IN HERE =====
                 			// The customer has tapped CONTINUE on initiate_conversation. The spec
                 			// says messages 2 and 3 follow. Nothing is sent yet, deliberately: it
                 			// changes what the customer receives without an agent acting, which is
                 			// the opposite of how every other send in this system works, and it
                 			// cannot be tested until a real tap has arrived and been seen here.
                 			// Once the client confirms, the send goes in at this exact point.
                 			info "whatsappWebhook - CONTINUE tapped on ticket " + matchedId + ". No follow-up sent (auto-send is not enabled).";
                 			return "{\"code\": \"SUCCESS\", \"result\": \"CONTINUE_TAPPED\", \"handled\": true, \"recordId\": \"" + matchedId + "\", \"written\": \"" + wroteOk + "\", \"message\": \"The customer tapped CONTINUE. It has been recorded on ticket " + matchedId + ". No follow-up message was sent automatically.\"}";
                 		}
                 		return "{\"code\": \"SUCCESS\", \"result\": \"REPLY_LOGGED\", \"handled\": true, \"recordId\": \"" + matchedId + "\", \"written\": \"" + wroteOk + "\", \"message\": \"The customer's reply was recorded on ticket " + matchedId + ".\"}";
                 	}	catch (e)
                 	{
                 		// Still SUCCESS. A non-2xx reply makes most providers retry the same
                 		// delivery over and over; the error belongs in the log, not in the status
                 		// code.
                 		info "whatsappWebhook - EXCEPTION: " + e.toString();
                 		return "{\"code\": \"SUCCESS\", \"result\": \"EXCEPTION\", \"handled\": false, \"message\": \"The script threw an error and nothing was written. See this Custom API execution log for the exception text.\"}";
                 	}
                 	return "{\"code\": \"SUCCESS\", \"result\": \"NO_RESULT\", \"handled\": false, \"message\": \"The script finished without reaching any known outcome. This should not happen - send the execution log over.\"}";
                 }
			 }
		 }


